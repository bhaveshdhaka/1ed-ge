#!/usr/bin/env bash
# pre-push — refuse direct pushes to main or preprod.
# Routes the user to `bash scripts/ship.sh <direction>`.
#
# Reads the push spec from stdin: lines of "<local_ref> <local_sha> <remote_ref> <remote_sha>".
# Exits 1 (refuses the push) if any remote_ref is main or preprod.
# Exits 0 (allows the push) otherwise (feature branches, tags, etc.).
#
# Detect --no-verify by checking the GIT_PUSH_OPTION_COUNT / GIT_PUSH_OPTION_* env vars
# (git sets those when the user passes --push-option). We don't have a way to detect
# --no-verify directly, but the user can use it to bypass if they really need to.
#
# The intent: catching the COMMON case (muscle-memory `git push` after committing on
# the wrong branch). Power users can bypass with --no-verify when they know better.

set -euo pipefail

PROTECTED_BRANCHES="^(main|preprod)$"

violations=0
while read -r local_ref local_sha remote_ref remote_sha; do
  # Skip empty lines (defensive)
  [ -z "$local_ref" ] && continue
  # Extract branch name from refs/heads/<name>
  branch="${remote_ref#refs/heads/}"
  if [[ "$branch" =~ $PROTECTED_BRANCHES ]]; then
    echo "✗ refusing: direct push to '$branch' is blocked by the pipeline." >&2
    echo "  the path is scripts/ship.sh, not 'git push'." >&2
    echo "" >&2
    if [ "$branch" = "main" ]; then
      echo "  run from the preprod worktree:" >&2
      echo "    bash scripts/ship.sh preprod-to-main" >&2
    else
      echo "  run from the preprod worktree:" >&2
      echo "    bash scripts/ship.sh main-to-preprod" >&2
      echo "  (or for a preprod-only refresh:)" >&2
      echo "    bash scripts/ship.sh test-only" >&2
    fi
    echo "" >&2
    echo "  if you really need to bypass (you probably don't), use:" >&2
    echo "    git push --no-verify" >&2
    violations=$((violations + 1))
  fi
done

if [ "$violations" -gt 0 ]; then
  exit 1
fi
exit 0
