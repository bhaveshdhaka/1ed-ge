---
/**
 * LogList.astro — collapsible monospace log list.
 * Shows first `show` items, collapses rest in <details>.
 * Usage: <LogList items={['line1', 'line2', ...]} />
 */
interface Props {
  items: string[]
  show?: number
  class?: string
}

const { items, show = 4, class: cls = '' } = Astro.props
const head = items.slice(0, show)
const rest = items.slice(show)
---

{items.length === 0 ? (
  <span class="font-mono text-2xs text-dim">—</span>
) : (
  <div class={cls}>
    <ul class="space-y-0.5">
      {head.map((line) => (
        <li class="font-mono text-2xs leading-relaxed text-dim">{line.trim()}</li>
      ))}
    </ul>
    {rest.length > 0 && (
      <details class="mt-2">
        <summary class="cursor-pointer text-2xs text-faint select-none hover:text-dim">
          +{rest.length} more
        </summary>
        <ul class="mt-1 space-y-0.5">
          {rest.map((line) => (
            <li class="font-mono text-2xs leading-relaxed text-dim">{line.trim()}</li>
          ))}
        </ul>
      </details>
    )}
  </div>
)}
