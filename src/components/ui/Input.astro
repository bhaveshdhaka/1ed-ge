---
/** Input.astro — text/number input on the tokens. */
interface Props {
  type?: 'text' | 'number' | 'date' | 'email' | 'password' | 'search'
  name?: string
  value?: string
  placeholder?: string
  required?: boolean
  disabled?: boolean
  class?: string
  min?: string
  max?: string
  step?: string
}

const { type = 'text', name, value, placeholder, required, disabled, class: cls = '', min, max, step } = Astro.props
---

<input
  type={type}
  name={name}
  value={value}
  placeholder={placeholder}
  required={required}
  disabled={disabled}
  min={min}
  max={max}
  step={step}
  class={`input tabular-nums ${cls}`}
/>
