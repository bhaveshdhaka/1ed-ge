---
/** Dot.astro — status dot. `tone` maps to token colors; size 6px default. */
interface Props {
  tone?: 'up' | 'down' | 'warn' | 'accent' | 'clay' | 'muted' | 'faint'
  size?: number
  pulse?: boolean
  class?: string
  title?: string
}

const { tone = 'muted', size = 6, pulse = false, class: cls = '', title } = Astro.props

const tones = {
  up: 'var(--color-up)',
  down: 'var(--color-down)',
  warn: 'var(--color-warn)',
  accent: 'var(--color-accent)',
  clay: 'var(--color-clay)',
  muted: 'var(--color-line2)',
  faint: 'var(--color-faint)',
}
---

<span
  class={`inline-block shrink-0 rounded-full ${pulse ? 'animate-pulse' : ''} ${cls}`}
  style={`width:${size}px;height:${size}px;background:${tones[tone]}`}
  title={title}
  aria-hidden="true"
></span>
