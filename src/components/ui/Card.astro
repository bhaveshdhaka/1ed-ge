---
/** Card.astro — the one panel primitive. Optional title row + named `actions` slot. */
interface Props {
  title?: string
  pad?: 'none' | 'sm' | 'md'
  hero?: boolean
  class?: string
}

const { title, pad = 'md', hero = false, class: cls = '' } = Astro.props
const pads = { none: '', sm: 'p-2', md: 'p-4' }
---

<section class={`panel ${hero ? 'panel-hero' : ''} ${pads[pad]} ${cls}`}>
  {title !== undefined && (
    <div class="mb-3 flex items-center justify-between gap-3">
      <h2 class="text-2xs uppercase tracking-widest text-soft">{title}</h2>
      {Astro.slots.has('actions') && (
        <div class="flex items-center gap-2"><slot name="actions" /></div>
      )}
    </div>
  )}
  <slot />
</section>
