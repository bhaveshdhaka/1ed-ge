---
/** Textarea.astro — markdown/draft textarea on the tokens. */
interface Props {
  name?: string
  value?: string
  placeholder?: string
  required?: boolean
  rows?: number
  class?: string
}

const { name, value, placeholder, required, rows = 6, class: cls = '' } = Astro.props
---

<textarea
  name={name}
  value={value}
  placeholder={placeholder}
  required={required}
  rows={rows}
  class={`input resize-y leading-snug ${cls}`}
></textarea>
