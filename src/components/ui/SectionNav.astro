---
/**
 * SectionNav.astro — sticky section jump bar for long pages.
 * Usage: <SectionNav sections={[['label', 'id'], ...]} />          (flat)
 *        <SectionNav groups={[{ label, items: [['label', 'id'], ...] }, ...]} />  (grouped)
 * Target sections need id="..." and class="scroll-mt-28".
 */
interface Props {
  sections?: [string, string][]
  groups?: { label: string; items: [string, string][] }[]
  class?: string
}

const { sections, groups, class: cls = '' } = Astro.props
---

<div class:list={['sticky top-0 z-10 mt-6 -mx-1 border-b border-line bg-bg/95 px-1 py-1 backdrop-blur', cls]}>
  <div class="flex items-center gap-1 overflow-x-auto text-xs" tabindex="0">
    {groups ? (
      groups.map((group, gi) => (
        <>
          {gi > 0 && <span class="mx-2 h-4 w-px bg-line" aria-hidden="true"></span>}
          <span class="px-1 text-3xs uppercase tracking-widest text-faint select-none">{group.label}</span>
          {group.items.map(([label, id]) => (
            <a href={`#${id}`} class="flex h-8 items-center whitespace-nowrap px-2 text-dim transition-colors hover:text-ink">
              {label}
            </a>
          ))}
        </>
      ))
    ) : (
      sections?.map(([label, id]) => (
        <a href={`#${id}`} class="flex h-8 items-center whitespace-nowrap px-2 text-dim transition-colors hover:text-ink">
          {label}
        </a>
      ))
    )}
  </div>
</div>
