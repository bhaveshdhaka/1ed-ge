---
import EmptyState from './ui/EmptyState.astro'

interface Props {
  rs: number[]
  height?: number
}

const { rs, height = 160 } = Astro.props
const lo = -4
const hi = 12
const nBuckets = hi - lo
const W = 900
const H = height
const padX = 8
const padY = 18

const counts = Array.from({ length: nBuckets }, (_, i) => {
  const b = lo + i
  return rs.filter((r) => r >= b && r < b + 1).length
})
const maxCount = Math.max(1, ...counts)
const bw = (W - padX * 2) / nBuckets
const bh = (v: number) => (v / maxCount) * (H - padY)
---

<div class="relative">
  <div class="absolute -top-1 left-2 text-[11px] uppercase tracking-widest text-dim">R distribution</div>
  {
    rs.length === 0 ? (
      <div class="mt-2"><EmptyState text="no trades yet." /></div>
    ) : (
      <div class="mt-3 overflow-x-auto" tabindex="0">
        <svg viewBox={`0 0 ${W} ${H}`} class="w-full min-w-[540px]" role="img" aria-label="R distribution histogram">
          <title>R distribution histogram</title>
          {counts.map((c, i) => {
            const b = lo + i
            const x = padX + i * bw
            const color = b < 0 ? 'var(--color-down)' : 'var(--color-up)'
            return (
              <g>
                <rect x={x + 1} y={H - padY - bh(c)} width={bw - 2} height={Math.max(bh(c), c > 0 ? 2 : 0)} fill={color} opacity="0.85" />
                {i % 2 === 0 && (
                  <text x={x + bw / 2} y={H - 4} fill="var(--color-faint)" font-size="9" text-anchor="middle">
                    {b >= 0 ? `+${b}` : b}
                  </text>
                )}
              </g>
            )
          })}
        </svg>
      </div>
    )
  }
</div>
