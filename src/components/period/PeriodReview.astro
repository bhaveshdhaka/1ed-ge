---
/**
 * PeriodReview.astro — one posterized review surface for any horizon.
 * Zero-JS. R centerpiece + per-account + per-model + life metrics +
 * reflection + AI comparison + journal entries + stream thoughts.
 */
import { render } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import { periodHeader, TAPE, REFLECTION, COMPARISON, THE_NUMBERS, TREND, EMPTY_PERIOD } from '../../lib/copy'
import { fmtDay, fmtDayWUpper } from '../../lib/dates'
import { slugFromType, publicAnchor, resolvePeriod, type PeriodRange } from '../../lib/periods'
import { todayHkt } from '../../lib/sessions'
import { periodDelta, type TapePoint, type LadderEntry, type PeriodStats, type TrendPoint } from '../../lib/period-stats'
import type { ResolvedThought } from '../../lib/stream'
import Card from '../ui/Card.astro'
import StatCard from '../ui/StatCard.astro'
import Table from '../ui/Table.astro'
import Badge from '../ui/Badge.astro'
import EmptyState from '../ui/EmptyState.astro'
import ThoughtCard from '../stream/ThoughtCard.astro'

interface Props {
  range: PeriodRange
  stats: PeriodStats
  prevStats: PeriodStats | null
  trend: TrendPoint[]
  dayIsos: string[]
  reviewEntry: CollectionEntry<'reviews'> | null
  comparisonBody: string
  journals: CollectionEntry<'journal'>[]
  thoughts: ResolvedThought[]
  tape: TapePoint[]
  ladder: LadderEntry[]
}

const { range, stats, prevStats, trend, dayIsos, reviewEntry, comparisonBody, journals, thoughts, tape, ladder } = Astro.props

let Reflection: any = null
if (reviewEntry) {
  const r = await render(reviewEntry)
  Reflection = r.Content
}

const deltas = prevStats ? periodDelta(prevStats, stats) : []

const deltaLabels: Record<string, string> = {
  sumR: 'sum R',
  expectancyR: 'expectancy',
  winRate: 'win rate',
  profitFactor: 'profit factor',
  trades: 'trades',
  tradedDays: 'traded days',
}

/** Per-field formatting for the verified-data comparison: win rate as %, counts as integers, R/expectancy/PF as decimals. */
const fmtCmp = (field: string, v: number) => {
  if (Number.isNaN(v)) return '—'
  if (!Number.isFinite(v)) return v > 0 ? '∞' : '−∞'
  if (field === 'winRate') return `${(v * 100).toFixed(0)}%`
  if (field === 'trades' || field === 'tradedDays') return String(Math.round(v))
  return v.toFixed(2)
}

const winPct = stats.winRate * 100
const pfText = stats.profitFactor === Infinity ? '∞' : stats.profitFactor.toFixed(2)

const pathType = Astro.url.pathname.split('/')[1] ?? ''
const today = todayHkt()
const switcher = ['week', 'month', 'q1', 'q2', 'q3', 'q4', 'h1', 'h2', 'year'].map((slug) => ({
  slug,
  label: slug,
  // A period that starts after today doesn't exist yet — its chip is disabled.
  future: resolvePeriod(slug, undefined, today) === null,
}))

const prevUrl = `/${slugFromType(range.prev.type, range.prev.index)}/${publicAnchor(range.prev.type, range.prev.anchor)}`
const nextUrl = `/${slugFromType(range.next.type, range.next.index)}/${publicAnchor(range.next.type, range.next.anchor)}`
const nextIsFuture = range.next.startIso > today

const SPACING = 30
const TAPE_H = 140
const TAPE_PAD = 20
const cums = tape.map((p) => p.cumulative)
const tMin = Math.min(0, ...cums)
const tMax = Math.max(0, ...cums)
const tRange = tMax - tMin || 1
const tWidth = Math.max(tape.length * SPACING + 20, 420)
const tY = (c: number) => TAPE_H - TAPE_PAD - ((c - tMin) / tRange) * (TAPE_H - TAPE_PAD * 2)
const tX = (i: number) => i * SPACING + 10
const tLine = tape.map((p, i) => `${tX(i)},${tY(p.cumulative)}`).join(' ')
const tColor = (tape[tape.length - 1]?.cumulative ?? 0) >= 0 ? 'var(--color-up)' : 'var(--color-down)'
const dotColor = (sumR: number) => (sumR > 0 ? 'var(--color-up)' : sumR < 0 ? 'var(--color-down)' : 'var(--color-dim)')
const last = tape.length - 1
---

<div class="shell pt-12 pb-20">
  <header class="flex flex-col gap-2">
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2">
      <h1 class="text-2xl text-ink">/ {TAPE}</h1>
      <span class="text-xs text-faint">{stats.daysCount} days logged</span>
    </div>
    <div class="text-base text-soft">{periodHeader(range)}</div>
  </header>

  <nav class="mt-4 flex flex-wrap items-center justify-between gap-3">
    <div class="flex items-center gap-2">
      <a
        href={prevUrl}
        class="flex h-10 items-center border border-line px-3 text-xs text-dim transition-colors hover:border-accent hover:text-ink"
      >
        ← {range.prev.label}
      </a>
      {nextIsFuture ? (
        <span class="flex h-10 items-center px-3 text-xs text-faint">{range.next.label} →</span>
      ) : (
        <a
          href={nextUrl}
          class="flex h-10 items-center border border-line px-3 text-xs text-dim transition-colors hover:border-accent hover:text-ink"
        >
          {range.next.label} →
        </a>
      )}
    </div>
    <div class="flex flex-wrap gap-1.5">
      {switcher.map((s) => {
        const active = pathType === s.slug
        return s.future ? (
          <span class="cursor-not-allowed border border-line px-2.5 py-1 text-2xs text-faint opacity-60">{s.label}</span>
        ) : (
          <a
            href={`/${s.slug}`}
            aria-current={active ? 'page' : undefined}
            class:list={[
              'border px-2.5 py-1 text-2xs transition-colors',
              active ? 'border-accent text-accent' : 'border-line2 text-dim hover:border-accent hover:text-accent',
            ]}
          >
            {s.label}
          </a>
        )
      })}
    </div>
  </nav>

  {tape.length > 0 && (
    <section class="mt-10 panel panel-hero">
      <div class="card-hd border-b border-sep">
        <span class="card-ico">📈</span>
        <span class="card-lbl">{TAPE}</span>
        <span class="card-sub">cumulative R by period</span>
      </div>
      <div class="p-3 md:p-4">
        <div class="overflow-x-auto">
          <svg
            viewBox={`0 0 ${tWidth} ${TAPE_H}`}
            width="100%"
            height={TAPE_H}
            role="img"
            aria-label="the tape — cumulative R by period"
            class="min-w-[420px]"
          >
            <polyline points={tLine} fill="none" stroke={tColor} stroke-width="1.5" opacity="0.8" />
            {tape.map((p, i) => (
              <a href={p.href} title={`${p.short} · ${p.sumR >= 0 ? '+' : ''}${p.sumR.toFixed(2)}R`} aria-label={`${p.short}: ${p.sumR >= 0 ? '+' : ''}${p.sumR.toFixed(2)}R`}>
                <circle cx={tX(i)} cy={tY(p.cumulative)} r={p.current ? 5 : 3.5} fill={dotColor(p.sumR)} class:list={[p.current && 'tape-dot-now']} />
              </a>
            ))}
            {tape.map((p, i) =>
              i % 5 === 4 ? (
                <text x={tX(i)} y={TAPE_H - 4} fill="var(--color-dim)" font-size="9" text-anchor="middle">{p.short}</text>
              ) : null,
            )}
            {tape[last]?.current && (
              <g>
                <line x1={tX(last)} y1={10} x2={tX(last)} y2={Math.max(tY(tape[last].cumulative) - 10, 18)} stroke={tColor} stroke-width="1.5" />
                <text x={tX(last)} y={8} fill={tColor} font-size="9" text-anchor="middle">now</text>
              </g>
            )}
          </svg>
        </div>
        <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-xs">
          {ladder.map((l) => (
            <span>
              <span class="text-faint">{l.label}</span>{' '}
              <span class:list={['tabular-nums', l.sumR > 0 ? 'text-up' : l.sumR < 0 ? 'text-down' : 'text-ink']}>
                {l.sumR >= 0 ? '+' : ''}{l.sumR.toFixed(1)}R
              </span>
            </span>
          ))}
        </div>
      </div>
    </section>
  )}

  {stats.daysCount === 0 ? (
    <div class="mt-10">
      <EmptyState text={EMPTY_PERIOD} />
    </div>
  ) : (
    <div class="mt-10 flex flex-col gap-10">
      <section class="panel">
        <div class="card-hd border-b border-sep">
          <span class="card-ico">📊</span>
          <span class="card-lbl">{THE_NUMBERS}</span>
          <span class="card-sub">{stats.trades} trades</span>
        </div>
        <div class="grid grid-cols-2 gap-2 p-3 md:grid-cols-3 lg:grid-cols-6">
          <StatCard
            label="sum R"
            value={`${stats.sumR >= 0 ? '+' : ''}${stats.sumR.toFixed(2)}R`}
            tone={stats.sumR > 0 ? 'up' : stats.sumR < 0 ? 'down' : 'default'}
          />
          <StatCard
            label="expectancy"
            value={`${stats.expectancyR >= 0 ? '+' : ''}${stats.expectancyR.toFixed(2)}R`}
            tone={stats.expectancyR > 0 ? 'up' : stats.expectancyR < 0 ? 'down' : 'default'}
          />
          <StatCard label="win rate" value={stats.winRate > 0 ? `${winPct.toFixed(0)}%` : '—'} />
          <StatCard label="profit factor" value={pfText} />
          <StatCard label="trades" value={String(stats.trades)} />
          <StatCard label="traded days" value={String(stats.tradedDays)} />
        </div>
      </section>

      <section class="grid gap-6 lg:grid-cols-2">
        <div class="panel">
          <div class="card-hd border-b border-sep">
            <span class="card-ico">💰</span>
            <span class="card-lbl">per-account p&l</span>
          </div>
          <div class="p-2">
            {stats.pnlByAccount.length > 0 ? (
              <Table head={['account', 'pnl']}>
                {stats.pnlByAccount.map((row) => (
                  <tr>
                    <td class="td">{row.account}</td>
                    <td class:list={['td text-right tabular-nums', row.pnl >= 0 ? 'text-up' : 'text-down']}>
                      {row.pnl >= 0 ? '+' : ''}${row.pnl.toLocaleString()}
                    </td>
                  </tr>
                ))}
              </Table>
            ) : (
              <EmptyState text="no accounts traded this period." />
            )}
          </div>
        </div>
        <div class="panel">
          <div class="card-hd border-b border-sep">
            <span class="card-ico">🧩</span>
            <span class="card-lbl">per-model</span>
          </div>
          <div class="p-2">
            {stats.modelStats.length > 0 ? (
              <Table head={['model', 'trades', 'sum R']}>
                {stats.modelStats.map((row) => (
                  <tr>
                    <td class="td">
                      {row.models?.length ? row.models.map((m, i) => <Badge variant={i === 0 ? 'accent' : 'default'}>{m}</Badge>) : (
                        row.model ? <Badge variant="accent">{row.model}</Badge> : null
                      )}
                    </td>
                    <td class="td text-right tabular-nums">{row.count}</td>
                    <td
                      class:list={[
                        'td text-right tabular-nums',
                        row.sumR > 0 ? 'text-up' : row.sumR < 0 ? 'text-down' : '',
                      ]}
                    >
                      {row.sumR > 0 ? '+' : ''}
                      {row.sumR.toFixed(2)}R
                    </td>
                  </tr>
                ))}
              </Table>
            ) : (
              <EmptyState text="no model-tagged trades this period." />
            )}
          </div>
        </div>
      </section>

      <section class="panel">
        <div class="card-hd border-b border-sep">
          <span class="card-ico">🌱</span>
          <span class="card-lbl">life metrics</span>
        </div>
        <div class="p-3 md:p-4">
          <div class="grid grid-cols-2 gap-2 md:grid-cols-4">
            <StatCard label="avg sleep" value={stats.avgSleep !== null ? `${stats.avgSleep.toFixed(1)}h` : '—'} />
            <StatCard label="avg mood" value={stats.avgMood !== null ? `${stats.avgMood.toFixed(1)}/5` : '—'} />
            <StatCard
              label="avg screen"
              value={stats.avgScreenHours !== null ? `${stats.avgScreenHours.toFixed(1)}h` : '—'}
            />
            <StatCard label="habits tracked" value={String(stats.habitAdherence.length)} />
          </div>
          {stats.habitAdherence.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-2">
              {stats.habitAdherence.map((h) => (
                <span class="well flex items-center gap-2 px-3 py-1.5 text-sm text-dim">
                  {h.habit} <span class="tabular-nums text-ink">{h.pct.toFixed(0)}%</span>
                </span>
              ))}
            </div>
          )}
        </div>
      </section>

      <section class="panel">
        <div class="card-hd border-b border-sep">
          <span class="card-ico">📅</span>
          <span class="card-lbl">days</span>
          <span class="card-sub">{dayIsos.length}</span>
        </div>
        <div class="p-3 md:p-4">
          {dayIsos.length > 0 ? (
            <div class="flex flex-wrap gap-1.5">
              {dayIsos.map((iso) => (
                <a
                  href={`/day/${fmtDay(iso)}`}
                  class="border border-line px-2 py-1 text-2xs text-dim transition-colors hover:border-accent hover:text-accent"
                >
                  {fmtDayWUpper(iso)}
                </a>
              ))}
            </div>
          ) : (
            <EmptyState text="no day records in this period." />
          )}
        </div>
      </section>

      <section class="panel">
        <div class="card-hd border-b border-sep">
          <span class="card-ico">📈</span>
          <span class="card-lbl">{TREND}</span>
        </div>
        <div class="overflow-x-auto">
          {trend.length > 0 ? (
            <Table head={['period', 'sum R', 'win rate', 'trades']}>
              {trend.map((pt) => (
                <tr>
                  <td class="td">{pt.label}</td>
                  <td
                    class:list={['td text-right tabular-nums', pt.sumR > 0 ? 'text-up' : pt.sumR < 0 ? 'text-down' : '']}
                  >
                    {pt.sumR > 0 ? '+' : ''}
                    {pt.sumR.toFixed(2)}R
                  </td>
                  <td class="td text-right tabular-nums">{pt.winRate > 0 ? `${(pt.winRate * 100).toFixed(0)}%` : '—'}</td>
                  <td class="td text-right tabular-nums">{pt.trades}</td>
                </tr>
              ))}
            </Table>
          ) : (
            <div class="p-3">
              <EmptyState text="no trend data yet." />
            </div>
          )}
        </div>
      </section>

      <section class="panel">
        <div class="card-hd border-b border-sep">
          <span class="card-ico">✍️</span>
          <span class="card-lbl">{REFLECTION}</span>
        </div>
        <div class="p-4">
          {Reflection ? (
            <div class="prose max-w-3xl">
              <Reflection />
            </div>
          ) : (
            <EmptyState text="no reflection written for this period." />
          )}
        </div>
      </section>

      <section class="panel">
        <div class="card-hd border-b border-sep">
          <span class="card-ico">⚖️</span>
          <span class="card-lbl">{COMPARISON}</span>
        </div>
        <div class="p-4">
          {comparisonBody ? (
            <div class="flex max-w-3xl flex-col gap-1">
              {comparisonBody
                .split('\n')
                .map((line) => line.trim())
                .filter(Boolean)
                .map((line) => {
                  const bullet = line.replace(/^[-*]+\s*/, '')
                  return <p class="text-sm text-soft">· {bullet}</p>
                })}
            </div>
          ) : (
            <div class="max-w-3xl">
              {deltas.length > 0 ? (
                <div class="flex flex-col gap-1">
                  {deltas.map((d) => (
                    <p class="text-sm text-soft">
                      · {deltaLabels[d.field] ?? d.field}: {fmtCmp(d.field, d.cur)} vs {fmtCmp(d.field, d.prev)}
                      {d.pct !== null && Number.isFinite(d.pct)
                        ? ` (${d.pct > 0 ? '+' : ''}${(d.pct * 100).toFixed(0)}%)`
                        : ''}
                    </p>
                  ))}
                </div>
              ) : (
                <p class="text-sm text-faint">no previous period to compare.</p>
              )}
              {trend.length > 0 && (
                <div class="mt-3 border-t border-line/50 pt-3">
                  <p class="text-2xs uppercase tracking-widest text-dim">rolling trend</p>
                  <p class="mt-1 text-sm text-soft">
                    {trend
                      .map((pt) => `${pt.label} ${pt.sumR > 0 ? '+' : ''}${pt.sumR.toFixed(2)}R`)
                      .join(' · ')}
                  </p>
                </div>
              )}
            </div>
          )}
        </div>
      </section>

      <section class="panel">
        <div class="card-hd border-b border-sep">
          <span class="card-ico">📝</span>
          <span class="card-lbl">journal entries</span>
          <span class="card-sub">{journals.length}</span>
        </div>
        <div class="p-3 md:p-4">
          {journals.length > 0 ? (
            <div class="grid gap-3 md:grid-cols-2">
              {journals.map((j) => (
                <a
                  href={`/day/${fmtDay(j.data.date)}`}
                  class="well block p-4 transition-colors hover:border-accent"
                >
                  <div class="text-2xs text-faint">{fmtDayWUpper(j.data.date)}</div>
                  {j.data.summary && <p class="mt-1 text-sm text-soft">{j.data.summary}</p>}
                  {j.data.tags && j.data.tags.length > 0 && (
                    <div class="mt-2 flex flex-wrap gap-1.5">
                      {j.data.tags.map((tag: string) => (
                        <span class="text-2xs text-faint">#{tag}</span>
                      ))}
                    </div>
                  )}
                </a>
              ))}
            </div>
          ) : (
            <EmptyState text="no journal entries this period." />
          )}
        </div>
      </section>

      <section class="panel">
        <div class="card-hd border-b border-sep">
          <span class="card-ico">💭</span>
          <span class="card-lbl">stream thoughts</span>
          <span class="card-sub">{thoughts.length}</span>
        </div>
        <div class="p-3 md:p-4">
          {thoughts.length > 0 ? (
            <div class="flex max-w-2xl flex-col gap-3">
              {thoughts.map((t) => (
                <ThoughtCard thought={t} showDay />
              ))}
            </div>
          ) : (
            <EmptyState text="no stream thoughts this period." />
          )}
        </div>
      </section>
    </div>
  )}
</div>
