---
import EmptyState from './ui/EmptyState.astro'

interface Props {
  points: { i: number; equity: number }[]
  height?: number
  color?: string
  label?: string
  /** Footer count label; defaults to "{points.length} trades". */
  footer?: string
}

const { points, height = 220, color = 'var(--color-up)', label, footer } = Astro.props
const W = 900
const H = height
const padX = 8
const padY = 18

const maxX = points.length ? points[points.length - 1].i : 1
const ys = points.map((p) => p.equity)
const minY = points.length ? Math.min(0, ...ys) : 0
const maxY = points.length ? Math.max(0, ...ys) : 0
const span = maxY - minY || 1
const px = (i: number) => padX + (i / maxX) * (W - padX * 2)
const py = (v: number) => H - padY - ((v - minY) / span) * (H - padY * 2)
const line = points
  .map((p, i) => `${i === 0 ? 'M' : 'L'}${px(p.i).toFixed(1)},${py(p.equity).toFixed(1)}`)
  .join(' ')
const area = `${line} L${px(maxX).toFixed(1)},${py(0).toFixed(1)} L${padX},${py(0).toFixed(1)} Z`
const zeroY = py(0)
const last = points[points.length - 1]
---

{
  points.length === 0 ? (
    <div class="p-1"><EmptyState text="no trades yet — the curve starts the day the first trade is logged" /></div>
  ) : (
    <div class="relative">
      {label && (
        <div class="absolute -top-1 left-2 text-2xs uppercase tracking-widest text-dim">{label}</div>
      )}
      <div class="overflow-x-auto" tabindex="0">
        <svg viewBox={`0 0 ${W} ${H}`} class="w-full min-w-[540px]" role="img" aria-label={label ?? 'equity curve'}>
          {label && <title>{label}</title>}
          <line x1={padX} x2={W - padX} y1={zeroY} y2={zeroY} stroke="var(--color-line2)" stroke-width="1" stroke-dasharray="3 5" />
          <path d={area} fill={color} fill-opacity="0.12" />
          <path d={line} fill="none" stroke={color} stroke-width="1.6" />
          {last && <circle cx={px(last.i)} cy={py(last.equity)} r="3.2" fill={color} />}
          <text x={padX + 2} y={py(maxY) - 4} fill="var(--color-dim)" font-size="10" font-family="inherit">
            {maxY > 0 ? `+${maxY.toFixed(0)}` : maxY.toFixed(0)}
          </text>
          <text x={padX + 2} y={py(minY) + 12} fill="var(--color-dim)" font-size="10">
            {minY < 0 ? minY.toFixed(0) : `+${minY.toFixed(0)}`}
          </text>
          <text x={W - padX - 3} y={H - 4} fill="var(--color-faint)" font-size="10" text-anchor="end">
            {footer ?? `${points.length} trades`}
          </text>
        </svg>
      </div>
    </div>
  )
}
