---
/**
 * DayFacts.astro — the public facts strip (mood/sleep/screen/habits/trades/R).
 * Zero-JS. Value cells, tokenized; up/down color only for R.
 */
import type { FactCell } from '../../lib/stream'

interface Props {
  cells: FactCell[]
  class?: string
}

const { cells, class: cls = '' } = Astro.props

// mood/sleep cells carry word+emoji values (e.g. "😐 okay") — render them as
// muted text, not as up/down numerals. Only R carries color.
const valueCls = (c: FactCell) => {
  if (c.key === 'mood' || c.key === 'sleep') return 'font-normal text-faint'
  if (!c.ok) return 'font-semibold text-faint'
  if (c.up === true) return 'font-semibold text-up'
  if (c.up === false) return 'font-semibold text-down'
  return 'font-semibold text-ink'
}
---

<div class={`panel ${cls}`}>
  <div class="card-hd">
    <span class="card-ico">📊</span>
    <span class="card-lbl">day facts</span>
  </div>
  {cells.length > 0 && (
    <div class="flex flex-wrap gap-1 p-2">
      {cells.map((c) => (
        <div class="well flex min-w-[86px] flex-1 flex-col gap-1 px-3 py-2">
          <span class="text-2xs uppercase tracking-widest text-faint">{c.label}</span>
          <span class:list={['text-sm tabular-nums', valueCls(c)]}>
            {c.ok ? c.value : '—'}
          </span>
        </div>
      ))}
    </div>
  )}
</div>
