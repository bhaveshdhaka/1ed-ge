---
/**
 * MomentCard.astro — one published stream moment. Zero-JS.
 * Renders text/quote/trade-card uniformly with the shared ResolvedMoment shape.
 */
import { momentMeta } from '../../lib/stream'
import { fmtDay } from '../../lib/dates'
import { altFor } from '../../lib/media-alt'
import type { ResolvedMoment } from '../../lib/stream'

interface Props {
  moment: ResolvedMoment
  showDay?: boolean
  class?: string
}

const { moment, showDay = false, class: cls = '' } = Astro.props
const meta = momentMeta(moment.type)
const isTrade = moment.type === 'trade' && moment.trade !== null
const isQuote = moment.type === 'quote'
const R = moment.trade?.R ?? 0
const imgs: string[] = isTrade ? (moment.trade?.screenshots ?? []) : (moment.images ?? [])
const lbGroup = `${moment.iso}-${moment.at}`
// Frame identity: note (thought) = quiet hairline, quote = accent left rail,
// trade = up/down left rail matched to the ▲/▼ glyph.
const frameStyle = isTrade
  ? `border-left:2px solid ${moment.trade?.direction === 'long' ? 'var(--color-up)' : 'var(--color-down)'}`
  : isQuote
    ? 'border-left:2px solid var(--color-accent)'
    : undefined
---

<div class={`border border-line bg-panel ${cls}`} style={frameStyle}>
  <div class="flex items-center gap-3 border-b border-line/60 px-4 py-2 text-2xs text-faint">
    <span class="tabular-nums text-dim">{moment.at} hkt</span>
    <span class="uppercase tracking-widest">{meta.label}</span>
    {showDay && (
      <a href={`/day/${fmtDay(moment.iso)}`} class="ml-auto transition-colors hover:text-accent">
        {fmtDay(moment.iso)}
      </a>
    )}
  </div>

  {isTrade && moment.trade && (
    <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 px-4 pt-3 text-[13px]">
      <span class={moment.trade.direction === 'long' ? 'text-up' : 'text-down'}>
        {moment.trade.direction === 'long' ? '▲' : '▼'} {moment.trade.market}
      </span>
      <span class="text-faint">{moment.trade.session ?? '—'} · {moment.trade.models?.length ? moment.trade.models.join(' · ') : (moment.trade.model ?? moment.trade.setup ?? 'no model')}</span>
      <span class:list={['ml-auto font-semibold tabular-nums', R > 0 ? 'text-up' : R < 0 ? 'text-down' : 'text-dim']}>
        {R > 0 ? '+' : ''}{R.toFixed(2)}R
      </span>
    </div>
  )}

  {isQuote ? (
    <div class="px-4 py-3">
      <p class="text-[13px] leading-relaxed text-soft">"{moment.text ?? ''}"</p>
      {moment.author && <p class="mt-1 text-2xs text-faint">— {moment.author}</p>}
    </div>
  ) : (
    <div class="px-4 py-3">
      {moment.text && <p class="text-[13px] leading-relaxed text-soft">{moment.text}</p>}
      {isTrade && !moment.text && moment.trade && (
        <p class="text-2xs text-faint">
          {moment.trade.entry} → {moment.trade.exit}
          {moment.trade.stop ? ` · stop ${moment.trade.stop}` : ''}
          {moment.trade.points >= 0 ? ` · +${moment.trade.points}` : ` · ${moment.trade.points}`} pts
        </p>
      )}
    </div>
  )}

  {imgs.length > 0 && (
    <div class="mt-3 flex flex-wrap gap-2">
      {imgs.map((src) => (
        <a
          href={src}
          target="_blank"
          rel="noopener"
          data-lb={lbGroup}
          class="block w-32 border border-line bg-bg transition-colors hover:border-accent"
        >
          <img src={src} alt={altFor(src)} loading="lazy" class="h-20 w-full object-cover" />
        </a>
      ))}
    </div>
  )}
</div>
