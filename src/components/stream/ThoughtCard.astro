---
/**
 * ThoughtCard.astro — one published stream thought. Zero-JS.
 * Renders text/quote/trade-card uniformly with the shared ResolvedThought shape.
 */
import { thoughtMeta } from '../../lib/stream'
import { fmtDay } from '../../lib/dates'
import { altFor } from '../../lib/media-alt'
import type { ResolvedThought } from '../../lib/stream'
import Card from '../ui/Card.astro'

interface Props {
  thought: ResolvedThought
  showDay?: boolean
  hideDate?: boolean
  class?: string
}

const { thought, showDay = false, hideDate = false, class: cls = '' } = Astro.props
const meta = thoughtMeta(thought.type)
const isTrade = thought.type === 'trade' && thought.trade !== null
const isQuote = thought.type === 'quote'
const R = thought.trade?.R ?? 0
const imgs: string[] = isTrade ? (thought.trade?.screenshots ?? []) : (thought.images ?? [])
const lbGroup = `${thought.iso}-${thought.at}`
// Frame identity: note (thought) = quiet hairline, quote = accent left rail,
// trade = up/down left rail matched to the ▲/▼ glyph. Card.astro doesn't
// forward inline style, so the rail is expressed as a Tailwind arbitrary
// property class (same value the inline style carried).
const frameCls = isTrade
  ? thought.trade?.direction === 'long'
    ? '[border-left:2px_solid_var(--color-up)]'
    : '[border-left:2px_solid_var(--color-down)]'
  : isQuote
    ? '[border-left:2px_solid_var(--color-accent)]'
    : ''
---

<Card icon={isQuote ? '💬' : isTrade ? '📈' : '💭'} label={meta.label} pad="none" class={[cls, frameCls].filter(Boolean).join(' ')}>
  <Fragment slot="subtitle">
    <time datetime={`${thought.iso}T${thought.at}:00+08:00`} class="local-time">{thought.at} hkt</time>
  </Fragment>
  {showDay && !hideDate && (
    <Fragment slot="actions">
      <a href={`/day/${fmtDay(thought.iso)}`} class="text-2xs text-faint transition-colors hover:text-accent">
        {fmtDay(thought.iso)}
      </a>
    </Fragment>
  )}

  {isTrade && thought.trade && (
    <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 px-4 pt-3 text-sm">
      <span class={thought.trade.direction === 'long' ? 'text-up' : 'text-down'}>
        {thought.trade.direction === 'long' ? '▲' : '▼'} {thought.trade.market}
      </span>
      <span class="text-faint">{thought.trade.session ?? '—'} · {thought.trade.models?.length ? thought.trade.models.join(' · ') : (thought.trade.model ?? thought.trade.setup ?? 'no model')}</span>
      <span class:list={['ml-auto font-semibold tabular-nums', R > 0 ? 'text-up' : R < 0 ? 'text-down' : 'text-dim']}>
        {R > 0 ? '+' : ''}{R.toFixed(2)}R
      </span>
    </div>
  )}

  {isQuote ? (
    <div class="px-4 py-3">
      <p class="text-sm leading-relaxed text-soft">"{thought.text ?? ''}"</p>
      {thought.author && <p class="mt-1 text-2xs text-faint">— {thought.author}</p>}
    </div>
  ) : (
    <div class="px-4 py-3">
      {thought.text && <p class="text-sm leading-relaxed text-soft">{thought.text}</p>}
      {isTrade && !thought.text && thought.trade && (
        <p class="text-2xs text-faint">
          {thought.trade.entry} → {thought.trade.exit}
          {thought.trade.stop ? ` · stop ${thought.trade.stop}` : ''}
          {thought.trade.points >= 0 ? ` · +${thought.trade.points}` : ` · ${thought.trade.points}`} pts
        </p>
      )}
    </div>
  )}

  {imgs.length > 0 && (
    <div class="mt-3 flex flex-wrap gap-2">
      {imgs.map((src) => (
        <a
          href={src}
          target="_blank"
          rel="noopener"
          data-lb={lbGroup}
          class="block w-32 border border-line bg-bg transition-colors hover:border-accent"
        >
          <img src={src} alt={altFor(src)} loading="lazy" class="h-20 w-full object-cover" />
        </a>
      ))}
    </div>
  )}
</Card>
