---
import { getCollection } from 'astro:content'
import { todayHkt } from '../lib/sessions'
import { fmtDayWUpper } from '../lib/dates'
import { marketMarker } from '../lib/market'
import NewsEventsCard from './NewsEventsCard.astro'

const today = todayHkt()
const mk = marketMarker(today)
const news = await getCollection('market-news')
const day = news.find((n) => n.data.date === today)
const red = day?.data.red ?? []
const orange = day?.data.orange ?? []
---

<section class="panel">
  <div class="card-hd">
    <span class="card-ico">📅</span>
    <span class="card-lbl">today</span>
    <span class="card-sub">{fmtDayWUpper(today)}</span>
    <span class:list={['tmr', mk.status === 'open' ? 'text-up' : mk.status === 'early' ? 'text-warn' : 'text-down']}>
      {mk.glyph} {mk.text}{mk.status === 'open' ? ' · full day' : ''}
    </span>
  </div>
  <div class="p-3 md:p-4">
    <NewsEventsCard red={red} orange={orange} dayIso={today} isToday={true} hideDate={true} />
  </div>
</section>
