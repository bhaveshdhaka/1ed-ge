---
import { getCollection } from 'astro:content'
import { todayHkt } from '../lib/sessions'
import { fmtDayWUpper } from '../lib/dates'
import { marketMarker } from '../lib/market'
import NewsEventsCard from './NewsEventsCard.astro'

const today = todayHkt()
const mk = marketMarker(today)
const news = await getCollection('market-news')
const day = news.find((n) => n.data.date === today)
const red = day?.data.red ?? []
const orange = day?.data.orange ?? []
---

<section class="panel p-4">
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <span class="text-sm text-ink">{fmtDayWUpper(today)}</span>
    <span class:list={['text-xs tabular-nums', mk.status === 'open' ? 'text-up' : mk.status === 'early' ? 'text-warn' : 'text-down']}>
      {mk.glyph} {mk.text}{mk.status === 'open' ? ' · full day' : ''}
    </span>
  </div>
  <div class="mt-3">
    <NewsEventsCard red={red} orange={orange} dayIso={today} isToday={true} />
  </div>
</section>
