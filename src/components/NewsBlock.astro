---
import type { NewsItem } from '../lib/market-news'
import { newsEmoji, groupNewsHeadlines } from '../lib/market-news'

interface Props {
  red: NewsItem[]
  orange: NewsItem[]
  /** Show an emoji hint per title (default true). */
  emoji?: boolean
  /** Day ISO + now (ms) — events before `now` render dimmed + struck (posterity). */
  dayIso?: string
  now?: number
}

const { red, orange, emoji = true, dayIso, now } = Astro.props

const isPast = (time: string): boolean => {
  if (!dayIso || now == null) return false
  const [h, m] = time.split(':').map(Number)
  return Date.parse(`${dayIso}T00:00:00+08:00`) + (h * 60 + m) * 60000 < now
}

const groups = groupNewsHeadlines(red, orange)
---

{
  groups.map((g) => {
    const past = isPast(g.time)
    return (
      <div>
        <div class="flex items-baseline gap-3">
          <span
            class:list={['inline-block h-1.5 w-1.5 shrink-0 self-center rounded-full', g.kind === 'red' ? 'bg-down' : 'bg-warn', past && 'opacity-40']}
            title={g.kind}
          />
          <span class:list={['w-20 shrink-0 text-right text-[12px] tabular-nums', past ? 'text-faint' : g.kind === 'red' ? 'text-down' : 'text-warn opacity-70']}>
            {emoji && newsEmoji(g.title)} {g.time}
          </span>
          <span class="min-w-0 flex-1 text-[13px] leading-snug">
            <span class:list={[past ? 'text-faint line-through decoration-line/60' : g.kind === 'red' ? 'text-down' : 'text-warn']}>{g.title}</span>
            {g.source && <span class="ml-1.5 text-[10px] text-faint">[{g.source}]</span>}
            {g.verified && <span class="ml-1 text-[11px] text-accent">✦</span>}
          </span>
        </div>
        {g.rest.length > 0 && (
          <details class="group">
            <summary class="flex cursor-pointer list-none items-baseline gap-1.5 py-0.5 pl-24 text-[12px] text-faint">
              +{g.rest.length} more at {g.time}
              <span class="text-faint transition-transform group-open:rotate-180">▾</span>
            </summary>
            <div class="flex flex-col gap-1 pl-24">
              {g.rest.map((n) => {
                const rpast = isPast(n.time)
                return (
                  <div class="flex items-baseline gap-3">
                    <span
                      class:list={['inline-block h-1.5 w-1.5 shrink-0 self-center rounded-full', n.kind === 'red' ? 'bg-down' : 'bg-warn', rpast && 'opacity-40']}
                      title={n.kind}
                    />
                    <span class:list={['w-20 shrink-0 text-right text-[12px] tabular-nums', rpast ? 'text-faint' : n.kind === 'red' ? 'text-down' : 'text-warn opacity-70']}>
                      {emoji && newsEmoji(n.title)} {n.time}
                    </span>
                    <span class="min-w-0 flex-1 text-[13px] leading-snug">
                      <span class:list={[rpast ? 'text-faint line-through decoration-line/60' : n.kind === 'red' ? 'text-down' : 'text-warn']}>{n.title}</span>
                      {n.source && <span class="ml-1.5 text-[10px] text-faint">[{n.source}]</span>}
                      {n.verified && <span class="ml-1 text-[11px] text-accent">✦</span>}
                    </span>
                  </div>
                )
              })}
            </div>
          </details>
        )}
      </div>
    )
  })
}
