---
import { addDaysIso, marketEvents, todayHkt } from '../lib/sessions'
import type { MarketEvent } from '../lib/sessions'

// CME equity-index futures (master clock) events around today, for the live footer ticker.
const cmeEvents = marketEvents(addDaysIso(todayHkt(), -1), 4).filter((e) => e.market === 'cme')
---

<script type="application/json" id="mkt-data" set:html={JSON.stringify(cmeEvents).replace(/</g, '\\u003c')} is:inline></script>

<script is:inline>
  (() => {
    const el = document.getElementById('mkt-data')
    if (!el) return
    let EVENTS = []
    try { EVENTS = JSON.parse(el.textContent || '[]') } catch {}

    const p = (n) => String(n).padStart(2, '0')
    const fmtHMS = (sec) => {
      const s = Math.max(0, Math.round(sec))
      return p(Math.floor(s / 3600)) + ':' + p(Math.floor((s % 3600) / 60)) + ':' + p(s % 60)
    }
    const nowHkt = () => new Date(Date.now() + 8 * 3600 * 1000).toISOString().slice(0, 16) + '+08:00'
    const isOpenType = (t) => t === 'open' || t === 'resume'

    const apply = (text, color) => {
      document.querySelectorAll('[data-mkt-live]').forEach((n) => {
        n.textContent = text
        if (color) n.style.color = color
      })
    }

    const tick = () => {
      const now = nowHkt()
      let prev = null
      let next = null
      for (const e of EVENTS) {
        if (e.hkt <= now) prev = e
        else { next = e; break }
      }
      if (!next) return apply('✕ closed', 'var(--color-down)')
      const sec = (Date.parse(next.hkt) - Date.now()) / 1000

      if (prev && isOpenType(prev.type)) {
        return apply('● open · ' + fmtHMS(sec), 'var(--color-up)')
      }
      if (prev && prev.type === 'halt') {
        return apply('◐ maintenance · ' + fmtHMS(sec), 'var(--color-warn)')
      }
      return apply('✕ closed · opens in ' + fmtHMS(sec), 'var(--color-down)')
    }

    tick()
    setInterval(tick, 1000)
  })()
</script>
