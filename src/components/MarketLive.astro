---
import { todayHkt } from '../lib/sessions'
import { buildStrip, segmentAt, fmtHuman } from '../lib/strip'
import type { StripPayload } from '../lib/strip'

// CME equity-index futures (master clock) narrative for the live `[data-mkt-live]`
// markers on the widget header / Ambient / calendar / admin. Same phrases as the
// footer + homepage strip — all sourced from src/lib/strip.ts.
const today = todayHkt()
const payload: StripPayload = buildStrip(today, Date.now(), [], [])
---

<script type="application/json" id="mkt-data" set:html={JSON.stringify(payload.segments.cme).replace(/</g, '\\u003c')} is:inline></script>

<script is:inline>
  (() => {
    const el = document.getElementById('mkt-data')
    if (!el) return
    let SEGS = []
    try { SEGS = JSON.parse(el.textContent || '[]') } catch {}

    const p = (n) => String(n).padStart(2, '0')
    const fmtHuman = (sec) => {
      sec = Math.max(0, Math.round(sec))
      const d = Math.floor(sec / 86400)
      const h = Math.floor((sec % 86400) / 3600)
      const m = Math.floor((sec % 3600) / 60)
      const s = Math.floor(sec % 60)
      if (d > 0) return h > 0 ? d + 'd ' + h + 'h' : d + 'd'
      if (h > 0) return m > 0 ? h + 'h ' + m + 'm' : h + 'h'
      if (m >= 15) return m + 'm'
      return String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0')
    }
    const segAt = (segs, now) => {
      for (const s of segs) if (now >= s.at && now < s.until) return s
      return null
    }
    const color = (cls) =>
      cls === 'up' ? 'var(--color-up)' : cls === 'warn' ? 'var(--color-warn)' : cls === 'down' ? 'var(--color-down)' : 'var(--color-dim)'
    const glyph = (cls) => (cls === 'up' ? '●' : cls === 'warn' ? '◐' : '✕')

    const apply = (text, cls) => {
      document.querySelectorAll('[data-mkt-live]').forEach((n) => {
        n.textContent = text
        if (cls) n.style.color = color(cls)
      })
    }

    const tick = () => {
      const now = Date.now()
      const seg = segAt(SEGS, now)
      if (!seg) return apply('✕ CME closed', 'down')
      apply(glyph(seg.cls) + ' CME ' + seg.text + ' ' + fmtHuman((seg.until - now) / 1000), seg.cls)
    }

    tick()
    setInterval(tick, 1000)
  })()
</script>
