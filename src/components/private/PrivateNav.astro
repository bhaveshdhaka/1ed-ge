---
/**
 * PrivateNav.astro — bottom nav for the Private section.
 * Fixed to bottom, safe-area aware, dark terminal aesthetic.
 */
import Icon from '../ui/Icon.astro'

interface Props {
  active?: 'home' | 'quiet' | 'nature' | 'exercises' | 'intentions' | 'rewiring' | 'mindmovie'
  secret?: string
}

const { active = 'home', secret = '' } = Astro.props
const base = secret ? `/zen/${secret}/private` : '/zen/private'

const items = [
  { id: 'home', label: 'home', icon: 'home', href: `${base}/` },
  { id: 'quiet', label: 'quiet', icon: 'waves', href: '#', disabled: true },
  { id: 'nature', label: 'nature', icon: 'leaf', href: '#', disabled: true },
  { id: 'exercises', label: 'exercises', icon: 'book-open', href: '#', disabled: true },
  { id: 'intentions', label: 'intentions', icon: 'feather', href: `${base}/intentions/` },
  { id: 'rewiring', label: 're-wiring', icon: 'activity', href: '#', disabled: true },
  { id: 'mindmovie', label: 'mind movie', icon: 'film', href: '#', disabled: true },
]
---

<nav class="fixed bottom-0 inset-x-0 z-40 border-t border-line bg-panel/95 backdrop-blur pb-safe">
  <div class="flex items-center justify-around px-2 py-2" role="navigation" aria-label="Private navigation">
    {items.map((item) => (
      <a
        href={item.disabled ? undefined : item.href}
        class:list={[
          'flex flex-col items-center gap-0.5 px-1 py-1 min-w-[44px] min-h-[44px] justify-center transition-colors',
          item.disabled ? 'opacity-30 pointer-events-none' : '',
          active === item.id ? 'text-accent' : 'text-dim hover:text-ink',
        ]}
        aria-current={active === item.id ? 'page' : undefined}
        aria-disabled={item.disabled}
      >
        <Icon name={item.icon} size={18} />
        <span class="text-3xs font-semibold uppercase tracking-widest">{item.label}</span>
      </a>
    ))}
  </div>
</nav>
