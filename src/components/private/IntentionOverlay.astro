---
/**
 * IntentionOverlay.astro — full-screen overlay showing saved intentions.
 * Dark terminal aesthetic. Dismiss on backdrop click.
 */
import Card from '../ui/Card.astro'
import EmptyState from '../ui/EmptyState.astro'

interface Props {
  intentions?: { date: string; time?: string | null; text: string; file: string }[]
}

const { intentions = [] } = Astro.props
---

<div
  id="intention-overlay"
  class="fixed inset-0 z-50 hidden items-start justify-center overflow-y-auto bg-bg/95 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-label="My Intentions"
>
  <div class="w-full max-w-2xl px-6 py-16 pb-32">
    <!-- Header -->
    <div class="mb-8 text-center">
      <div class="text-2xs uppercase tracking-widest text-accent">my intentions</div>
      <div class="mt-2 text-2xl font-semibold text-ink">
        {intentions.length} {intentions.length === 1 ? 'intention' : 'intentions'} written
      </div>
    </div>

    <!-- Intention cards -->
    {intentions.length === 0 ? (
      <EmptyState text="no intentions yet." />
    ) : (
      <div class="flex flex-col gap-4">
        {intentions.map((intention, i) => (
          <Card variant="flat" class="p-5">
            <div class="text-2xs font-mono text-faint mb-2">
              #{intentions.length - i}
            </div>
            <p class="text-sm leading-relaxed text-soft whitespace-pre-wrap">{intention.text}</p>
            <div class="mt-3 text-2xs text-faint">
              {intention.time ? `${intention.time} · ` : ''}{intention.date}
            </div>
          </Card>
        ))}
      </div>
    )}
  </div>
</div>

<script>
  // Open/close the overlay
  const overlay = document.getElementById('intention-overlay')
  const openBtn = document.getElementById('read-intentions-btn')

  if (overlay && openBtn) {
    openBtn.addEventListener('click', () => {
      overlay.classList.remove('hidden')
      overlay.classList.add('flex')
      document.body.style.overflow = 'hidden'
    })

    // Dismiss on backdrop click (outside content)
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) {
        overlay.classList.add('hidden')
        overlay.classList.remove('flex')
        document.body.style.overflow = ''
      }
    })

    // Dismiss on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !overlay.classList.contains('hidden')) {
        overlay.classList.add('hidden')
        overlay.classList.remove('flex')
        document.body.style.overflow = ''
      }
    })
  }
</script>
