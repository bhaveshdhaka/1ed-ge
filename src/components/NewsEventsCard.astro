---
import { fmtDay, fmtDayWUpper } from '../lib/dates'
import type { NewsItem } from '../lib/market-news'
import Card from './ui/Card.astro'
import NewsBlock from './NewsBlock.astro'

interface Props {
  red: NewsItem[]
  orange: NewsItem[]
  dayIso: string
  isToday: boolean
  hideDate?: boolean
}

const { red, orange, dayIso, isToday, hideDate = false } = Astro.props
---

<Card icon="📰" label="news events" subtitle={hideDate ? undefined : fmtDayWUpper(dayIso)}>
    {red.length > 0 || orange.length > 0 ? (
      <div class="mt-1 flex flex-col gap-1">
        <NewsBlock red={red} orange={orange} dayIso={dayIso} now={Date.now()} />
      </div>
    ) : (
      <p class="text-xs text-faint">
        no <span class="inline-block h-1.5 w-1.5 rounded-full bg-down align-middle"></span>{' '}
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-warn align-middle"></span>{' '}
        news events {isToday ? 'today' : `for ${fmtDay(dayIso).toUpperCase()}`}.
      </p>
    )}
</Card>
