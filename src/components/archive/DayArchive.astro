---
import Base from '../../layouts/Base.astro'
import { listMds, readEntry } from '../../lib/content'
import { renderMarkdown } from '../../lib/markdown'
import { newsForDate } from '../../lib/market-news'
import { fmtDay, fmtDayW } from '../../lib/dates'
import { scheduledDayMarker } from '../../lib/sessions'
import { dayFacts, resolveThoughts, ROf } from '../../lib/stream'
import type { DayData } from '../../lib/stream'
import { altFor } from '../../lib/media-alt'
import ThoughtCard from '../stream/ThoughtCard.astro'
import DayFacts from '../stream/DayFacts.astro'
import NewsBlock from '../NewsBlock.astro'
import Badge from '../ui/Badge.astro'
import Card from '../ui/Card.astro'
import EmptyState from '../ui/EmptyState.astro'
import Separator from '../ui/Separator.astro'

interface Props { iso: string; allDates: string[] }
const { iso, allDates } = Astro.props

const dayFiles = listMds('days')
const accountFiles = listMds('accounts')
const journalFiles = listMds('journal')
const coachFiles = listMds('coach')
const habitFiles = listMds('habits')
const briefFiles = listMds('brief')

const entry = dayFiles.includes(`${iso}.md`) ? (readEntry('days', `${iso}.md`).data as unknown as DayData) : null
const journalFor = journalFiles.includes(`${iso}.mdx`) ? readEntry('journal', `${iso}.mdx`) : null
const coachFor = coachFiles.includes(`${iso}.md`) ? readEntry('coach', `${iso}.md`) : null
const newsFor = newsForDate(iso)
const briefFor = briefFiles.includes(`${iso}.md`) ? readEntry('brief', `${iso}.md`) : null
const dayRed = newsFor?.red ?? []
const dayOrange = newsFor?.orange ?? []

const accMap = new Map<string, { firm?: string; sizeLabel?: string; pointsValue?: number }>()
for (const f of accountFiles) {
  const a = readEntry('accounts', f).data as Record<string, unknown>
  accMap.set(String(a.id ?? ''), {
    firm: typeof a.firm === 'string' ? a.firm : undefined,
    sizeLabel: typeof a.sizeLabel === 'string' ? a.sizeLabel : undefined,
    pointsValue: typeof a.pointsValue === 'number' ? a.pointsValue : 2,
  })
}

const habits = habitFiles.map((f) => {
  const h = readEntry('habits', f).data as Record<string, unknown>
  return {
    id: f.replace(/\.md$/, ''),
    data: {
      active: h.active !== false,
      emoji: typeof h.emoji === 'string' ? h.emoji : undefined,
      name: typeof h.name === 'string' ? h.name : f,
      color: typeof h.color === 'string' ? h.color : '#6ea88a',
    },
  }
})

const dayIdx = allDates.indexOf(iso)
const prevIso = dayIdx > 0 ? allDates[dayIdx - 1] : null
const nextIso = dayIdx >= 0 && dayIdx < allDates.length - 1 ? allDates[dayIdx + 1] : null

const d = entry
const activeHabits = habits.filter((h) => h.data.active !== false)
const facts = dayFacts(d, activeHabits.length)
const thoughts = d ? resolveThoughts(d) : []
const trades = d?.trades ?? []
const mk = scheduledDayMarker(iso)

const journalSummary = journalFor && typeof journalFor.data.summary === 'string' ? journalFor.data.summary : null
const coachDate = coachFor && typeof coachFor.data.date === 'string' ? coachFor.data.date : iso
const coachSummary = coachFor && typeof coachFor.data.summary === 'string' ? coachFor.data.summary : null

let Reflection: string | null = null
let Coaching: string | null = null
let Brief: string | null = null
if (journalFor) Reflection = await renderMarkdown(journalFor.content)
if (coachFor) Coaching = await renderMarkdown(coachFor.content)
if (briefFor) Brief = await renderMarkdown(briefFor.content)
---

<Base
  title={`day ${fmtDay(iso)} — 1ed.ge`}
  description={`${fmtDay(iso)} — ${facts.find((f) => f.key === 'mood')?.value ?? '—'} mood, ${trades.length} trades, ${facts.find((f) => f.key === 'r')?.value ?? '—'} R. Everything public.`}
>
  <div class="shell pt-12 pb-20">
    <header class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <h1 class="text-2xl text-ink">/ day <span class="text-faint">{fmtDayW(iso)}</span></h1>
      <span class={`text-[12px] tabular-nums ${mk.cls}`}>
        {mk.glyph} {mk.text}
      </span>
    </header>

    <nav class="mt-4 flex items-center justify-between gap-3 text-[12px]">
      {prevIso ? (
        <a href={`/day/${fmtDay(prevIso)}`} class="flex h-10 items-center border border-line px-3 text-dim transition-colors hover:border-accent hover:text-ink">← {fmtDay(prevIso)}</a>
      ) : (<span class="text-faint">← older</span>)}
      {nextIso ? (
        <a href={`/day/${fmtDay(nextIso)}`} class="flex h-10 items-center border border-line px-3 text-dim transition-colors hover:border-accent hover:text-ink">{fmtDay(nextIso)} →</a>
      ) : (<span class="text-faint">newer →</span>)}
    </nav>

    <nav class="sticky top-0 z-10 mt-6 -mx-1 border-b border-line bg-bg/95 px-1 py-1 backdrop-blur">
      <div class="flex gap-1 overflow-x-auto text-[12px]" tabindex="0">
        {[
          ['facts', 'facts'],
          ['trades', 'trades'],
          ['news', 'news'],
          ['brief', 'brief'],
          ['reflection', 'reflection'],
          ['thoughts', 'thoughts'],
          ['habits', 'habits'],
          ['screen-time', 'screen-time'],
          ['coach', 'coach'],
        ].map(([label, id]) => (
          <a href={`#${id}`} class="flex h-8 items-center whitespace-nowrap px-2 text-dim transition-colors hover:text-ink">
            {label}
          </a>
        ))}
      </div>
    </nav>

    <section id="facts" class="mt-6 scroll-mt-28">
      <h2 class="text-lg">/ day facts</h2>
      <div class="mt-3"><DayFacts cells={facts} /></div>
    </section>

    <section id="trades" class="mt-10 scroll-mt-28">
      <h2 class="text-lg">/ trades {trades.length > 0 ? `(${trades.length})` : ''}</h2>
      {trades.length === 0 ? (
        <div class="mt-3"><EmptyState text="no trades logged this day." /></div>
      ) : (
        <div class="mt-4 space-y-4">
          {trades.map((t, ti) => {
            const R = ROf(t)
            const ex = t.executions ?? []
            const totalPnl = ex.reduce((s, e) => s + t.points * (accMap.get(e.account)?.pointsValue ?? 2) * (e.size ?? 1), 0)
            return (
              <Card>
                <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                  <span class="text-[15px] text-ink">{t.direction === 'long' ? '▲' : '▼'} {t.market}</span>
                  <span class="text-[12px] text-dim">{t.session ?? '—'} · {t.setup ?? 'no setup'}</span>
                  {t.models?.length ? t.models.map((m, i) => <Badge variant={i === 0 ? 'accent' : 'default'}>{m}</Badge>) : (
                    t.model ? <Badge variant="accent">{t.model}</Badge> : null
                  )}
                  <span class:list={['ml-auto text-[15px]', R > 0 ? 'num-up' : R < 0 ? 'num-down' : '']}>
                    {R > 0 ? '+' : ''}{R.toFixed(2)}R
                  </span>
                  <span class:list={['text-[13px]', totalPnl > 0 ? 'num-up' : totalPnl < 0 ? 'num-down' : 'text-dim']}>
                    {totalPnl > 0 ? '+' : ''}${totalPnl.toLocaleString('en-US', { maximumFractionDigits: 2 })}
                  </span>
                </div>
                <div class="mt-2 grid grid-cols-2 gap-x-6 gap-y-1 text-[12px] text-dim md:grid-cols-4">
                  <span>entry <span class="text-ink">{t.entry}</span></span>
                  <span>exit <span class="text-ink">{t.exit}</span></span>
                  <span>stop <span class="text-ink">{t.stop ?? '—'}</span></span>
                  <span>points <span class:list={[t.points > 0 ? 'text-up' : t.points < 0 ? 'text-down' : '']}>{t.points > 0 ? '+' : ''}{t.points}</span></span>
                </div>
                {t.commentary && (
                  <p class="mt-2 border-t border-line/60 pt-2 text-[13px] text-soft">{t.commentary}</p>
                )}
                {(ex.length > 0 || t.note) && (
                  <div class="mt-2 text-[12px] text-dim">
                    {ex.length > 0 && (
                      <span>accounts: {ex.map((e) => { const a = accMap.get(e.account); return `${a?.firm ?? ''} ${a?.sizeLabel ?? ''}${e.size && e.size > 1 ? ` ×${e.size}` : ''}` }).join(' · ')}</span>
                    )}
                    {t.note && <span class="text-soft"> — {t.note}</span>}
                  </div>
                )}
                {(t.screenshots?.length ?? 0) > 0 && (
                  <div class="mt-3 grid grid-cols-2 gap-3 md:grid-cols-4">
                    {t.screenshots!.map((s) => (
                      <a href={s} target="_blank" rel="noopener" data-lb={`day-${iso}-${ti}`} class="block border border-line bg-bg transition-colors hover:border-accent">
                        <img src={s} alt={altFor(s)} loading="lazy" class="w-full" />
                      </a>
                    ))}
                  </div>
                )}
              </Card>
            )
          })}
        </div>
      )}
    </section>

    {newsFor && (dayRed.length > 0 || dayOrange.length > 0) && (
      <details id="news" class="group mt-10 scroll-mt-28 border border-line bg-panel/50 px-4 py-3" open>
        <summary class="flex cursor-pointer list-none select-none items-center justify-between gap-3 text-[13px]">
          <span class="text-dim">News events</span>
          <span class="text-dim transition-transform group-open:rotate-180">▾</span>
        </summary>
        <div class="mt-2 flex flex-col gap-1 border-t border-line/50 pt-2">
          <NewsBlock red={dayRed} orange={dayOrange} dayIso={iso} now={Date.now()} />
        </div>
      </details>
    )}

    {briefFor && Brief && (
      <section id="brief" class="mt-10 scroll-mt-28 border border-line bg-panel/50 px-4 py-3">
        <div class="text-[13px] text-dim">/ brief</div>
        <div class="prose mt-2 [&>*]:text-[13px]" set:html={Brief} />
      </section>
    )}

    {journalFor && Reflection && (
      <section id="reflection" class="mt-10 scroll-mt-28">
        <h2 class="text-lg">/ reflection</h2>
        <div class="prose mt-4 max-w-3xl border border-accent bg-panel px-4 py-3">
          {journalSummary && <p class="text-[13px] text-soft">{journalSummary}</p>}
          <div set:html={Reflection} />
        </div>
      </section>
    )}

    <section id="thoughts" class="mt-10 scroll-mt-28">
      <h2 class="text-lg">/ thoughts</h2>
      {thoughts.length === 0 ? (
        <div class="mt-3"><EmptyState text="nothing published this day." /></div>
      ) : (
        <div class="mt-4 flex max-w-2xl flex-col gap-3">
          {thoughts.map((t) => <ThoughtCard thought={t} />)}
        </div>
      )}
    </section>

    {d && (
      <section id="habits" class="mt-10 scroll-mt-28">
        <h2 class="text-lg">/ habits</h2>
        <div class="mt-3 flex flex-wrap gap-2">
          {activeHabits.map((h) => {
            const val = (d.habits ?? {})[h.id]
            const done = val === true || (typeof val === 'number' && val > 0)
            return (
              <span class="flex items-center gap-2 border px-3 py-1.5 text-[13px]" style={done ? `border-color:${h.data.color};color:${h.data.color}` : 'border-color:var(--color-line);color:var(--color-dim)'}>
                {h.data.emoji ?? '·'} {h.data.name} {done ? '✓' : '×'}
              </span>
            )
          })}
        </div>
      </section>
    )}

    {d && (
      <section id="screen-time" class="mt-10 scroll-mt-28">
        <h2 class="text-lg">/ screen time — notes</h2>
        {d.device?.notes ? (
          <p class="mt-2 text-[13px] text-dim">{d.device.notes}</p>
        ) : (
          <div class="mt-3"><EmptyState text="no screen-time notes this day." /></div>
        )}
      </section>
    )}

    <Separator class="mt-10" />

    <section id="coach" class="mt-8 scroll-mt-28">
      <h2 class="text-lg">/ coach</h2>
      {coachFor && Coaching ? (
        <article class="mt-4 max-w-3xl border-l-2 border-line2 pl-6">
          <div class="flex flex-wrap items-center gap-3 text-[12px] text-dim">
            <span>{fmtDay(coachDate)}</span>
            {coachSummary && <span class="text-soft">{coachSummary}</span>}
          </div>
          <div class="prose mt-4" set:html={Coaching} />
        </article>
      ) : (
        <div class="mt-3"><EmptyState text="no coaching session this day." /></div>
      )}
    </section>
  </div>
</Base>
