---
import { getCollection } from 'astro:content'
import { addDaysIso, marketEvents, todayHkt } from '../lib/sessions'
import type { MarketEvent } from '../lib/sessions'
import { marketMarker } from '../lib/market'
import { groupNewsByTime, newsEmoji } from '../lib/market-news'

interface Props {
  news?: boolean
}

const { news: showNews = true } = Astro.props
const today = todayHkt()
const events = marketEvents(today, 3)
const news = showNews ? await getCollection('market-news') : []
const newsToday = news.find((n) => n.data.date === today)
const mk = marketMarker(today)

const redGroups = newsToday ? groupNewsByTime(newsToday.data.red) : []
const orangeGroups = newsToday ? groupNewsByTime(newsToday.data.orange) : []

const MON = ['jan', 'feb', 'mar', 'apr', 'may', 'jun', 'jul', 'aug', 'sep', 'oct', 'nov', 'dec']
const prettyDate = `${parseInt(today.slice(8, 10), 10)} ${MON[parseInt(today.slice(5, 7), 10) - 1]} ${today.slice(0, 4)}`

const todayEvents = events.filter((e) => e.hkt.slice(0, 10) === today)
const t = (e?: MarketEvent) => (e ? e.hkt.slice(11, 16) : '—')
const nyseOpen = todayEvents.find((e) => e.market === 'nyse' && e.type === 'open')
const nyseClose = todayEvents.find((e) => e.market === 'nyse' && e.type === 'close')
const tseOpen = todayEvents.find((e) => e.market === 'tse' && e.type === 'open')
const tseClose = todayEvents.find((e) => e.market === 'tse' && e.type === 'close')
const lseOpen = todayEvents.find((e) => e.market === 'lse' && e.type === 'open')
const lseClose = todayEvents.find((e) => e.market === 'lse' && e.type === 'close')

const markets = [
  { key: 'cme', flag: '📈', name: 'MNQ futures', window: '~24h' },
  { key: 'nyse', flag: '🇺🇸', name: 'New York · NYSE', window: `${t(nyseOpen)}→${t(nyseClose)}` },
  { key: 'tse', flag: '🇯🇵', name: 'Tokyo · TSE', window: `${t(tseOpen)}–${t(tseClose)}` },
  { key: 'lse', flag: '🇬🇧', name: 'London · LSE', window: `${t(lseOpen)}→${t(lseClose)}` },
]

// ---- HKT day timeline: session spans clipped to today's 00:00–24:00 bar ----
interface Seg {
  start: number
  end: number
  kind: 'open' | 'pause'
}

const segEvents = marketEvents(addDaysIso(today, -1), 3)
const hours = (hkt: string) => {
  const [hh, mm] = hkt.slice(11, 16).split(':').map(Number)
  return hh + mm / 60
}

function barSegments(market: string, pause: boolean): Seg[] {
  const list = segEvents.filter((e) => e.market === market)
  const opens = (typ: string) => (pause ? typ === 'halt' || typ === 'close' : typ === 'open' || typ === 'resume')
  const closes = (typ: string) => (pause ? typ === 'open' || typ === 'resume' : typ === 'close' || typ === 'halt')
  let active = false
  for (const e of list) {
    if (e.hkt.slice(0, 10) >= today) break
    if (opens(e.type)) active = true
    else if (closes(e.type)) active = false
  }
  const segs: Seg[] = []
  let cur: Seg | null = active ? { start: 0, end: 24, kind: pause ? 'pause' : 'open' } : null
  for (const e of list) {
    const d = e.hkt.slice(0, 10)
    if (d < today) continue
    if (d > today) {
      if (cur) {
        cur.end = 24
        segs.push(cur)
      }
      break
    }
    const h = hours(e.hkt)
    if (opens(e.type)) {
      if (!cur) cur = { start: h, end: 24, kind: pause ? 'pause' : 'open' }
    } else if (cur) {
      cur.end = h
      segs.push(cur)
      cur = null
    }
  }
  if (cur) {
    cur.end = 24
    segs.push(cur)
  }
  return segs
}

const barSegs = [
  { market: 'nyse', segs: barSegments('nyse', false), cls: 'bg-up/30' },
  { market: 'tse', segs: barSegments('tse', false), cls: 'bg-accent/25' },
  { market: 'lse', segs: barSegments('lse', false), cls: 'bg-purp/25' },
  { market: 'cme', segs: barSegments('cme', true), cls: 'bg-warn/40' },
]

const nowHktBuild = new Date(Date.now() + 8 * 3600 * 1000)
const nowFracBuild = (nowHktBuild.getUTCHours() + nowHktBuild.getUTCMinutes() / 60) / 24 * 100
---

<section class="panel p-4">
  <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1">
    <div class="flex items-baseline gap-2 text-[13px]">
      <span class="text-ink">market</span>
      <span class="text-faint">{prettyDate}</span>
    </div>
    <span data-mkt-live class="text-[12px] tabular-nums" style={`color:${mk.status === 'open' ? 'var(--color-up)' : mk.status === 'early' ? 'var(--color-warn)' : 'var(--color-down)'}`}>
      {mk.glyph} {mk.text}
    </span>
  </div>

  <div class="mt-3">
    <div class="relative h-3 border border-line bg-raise">
      {barSegs.flatMap((b) => b.segs).map((s, i) => (
        <div
          class:list={['absolute inset-y-0', barSegs.find((b) => b.segs.includes(s))!.cls]}
          style={`left:${(s.start / 24) * 100}%;width:${((s.end - s.start) / 24) * 100}%`}
          title={`${s.start.toFixed(1)}–${s.end.toFixed(1)} hkt`}
        />
      ))}
      <div class="absolute inset-y-0 w-px bg-accent" data-now-marker style={`left:${nowFracBuild}%`} title="now (HKT)"></div>
    </div>
    <div class="mt-1 flex justify-between text-[10px] text-faint tabular-nums">
      <span>00</span><span>04</span><span>08</span><span>12</span><span>16</span><span>20</span><span>24</span>
    </div>
    <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-[11px] text-dim">
      <span class="flex items-center gap-1.5"><span class="h-2 w-3 bg-up/30"></span>🇺🇸 New York</span>
      <span class="flex items-center gap-1.5"><span class="h-2 w-3 bg-accent/25"></span>🇯🇵 Tokyo</span>
      <span class="flex items-center gap-1.5"><span class="h-2 w-3 bg-purp/25"></span>🇬🇧 London</span>
      <span class="flex items-center gap-1.5"><span class="h-2 w-3 bg-warn/40"></span>📈 futures closed</span>
    </div>
  </div>

  <div id="mkt-rows" class="mt-2">
    {markets.map((m) => (
      <div class="flex items-center justify-between gap-x-4 border-t border-line/60 py-2" data-session-row={m.key}>
        <div class="flex min-w-0 items-center gap-2">
          <span class="shrink-0 text-[15px] leading-none">{m.flag}</span>
          <span class="truncate text-[13px] text-ink">{m.name}</span>
        </div>
        <div class="flex shrink-0 items-center gap-x-3">
          <span class="hidden text-[11px] text-faint tabular-nums sm:inline">{m.window}</span>
          <span class="w-[4.6rem] text-right text-[13px] tabular-nums" data-session={m.key}>--:--:--</span>
          <span class="w-[3.4rem] text-right text-[10px] text-faint" data-session-label={m.key}>—</span>
        </div>
      </div>
    ))}
  </div>

  {showNews && newsToday && (newsToday.data.red.length > 0 || newsToday.data.orange.length > 0) && (
    <details class="group mt-2 border-t border-line/60">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-3 py-2 text-[13px]">
        <span class="flex flex-wrap items-center gap-2 text-dim">
          <span>USD news</span>
          {redGroups.length > 0 && <span class="text-down">{newsEmoji(redGroups[0].titles[0])} red {redGroups[0].time}</span>}
          {redGroups.length === 0 && orangeGroups.length > 0 && (
            <span class="opacity-70 text-warn">{newsEmoji(orangeGroups[0].titles[0])} orange {orangeGroups[0].time}</span>
          )}
        </span>
        <span class="text-faint transition-transform group-open:rotate-180">▾</span>
      </summary>
      <div class="mt-1 flex flex-col gap-1 border-t border-line/50 pt-2 text-[13px]">
        {redGroups.map((g) => (
          <div class="flex items-baseline gap-3">
            <span class="w-20 shrink-0 text-right text-[12px] tabular-nums text-down">{newsEmoji(g.titles[0])} {g.time}</span>
            <span class="text-down">{g.titles.join(' · ')}</span>
          </div>
        ))}
        {orangeGroups.map((g) => (
          <div class="flex items-baseline gap-3">
            <span class="w-20 shrink-0 text-right text-[12px] tabular-nums opacity-70 text-warn">{newsEmoji(g.titles[0])} {g.time}</span>
            <span class="opacity-70 text-warn">{g.titles.join(' · ')}</span>
          </div>
        ))}
      </div>
    </details>
  )}
  {showNews && (!newsToday || (newsToday.data.red.length === 0 && newsToday.data.orange.length === 0)) && (
    <p class="mt-2 border-t border-line/60 pt-2 text-[11px] text-faint">no major USD news for today.</p>
  )}

  <p class="mt-2 border-t border-line/60 pt-2 text-[11px] text-faint">all times HKT · DST-aware</p>
</section>

<script type="application/json" id="mkt-sessions" set:html={JSON.stringify(events).replace(/</g, '\\u003c')} is:inline></script>

<script is:inline>
  (() => {
    const el = document.getElementById('mkt-sessions')
    const container = document.getElementById('mkt-rows')
    if (!el || !container) return
    let EVENTS = []
    try { EVENTS = JSON.parse(el.textContent || '[]') } catch {}
    const byMarket = {}
    for (const e of EVENTS) (byMarket[e.market] = byMarket[e.market] || []).push(e)

    const p = (n) => String(n).padStart(2, '0')
    const fmtHMS = (sec) => {
      const s = Math.max(0, Math.round(sec))
      return p(Math.floor(s / 3600)) + ':' + p(Math.floor((s % 3600) / 60)) + ':' + p(s % 60)
    }
    const nowHkt = () => new Date(Date.now() + 8 * 3600 * 1000).toISOString().slice(0, 16) + '+08:00'
    const isOpenType = (type) => type === 'open' || type === 'resume'

    const nowMarker = document.querySelector('[data-now-marker]')

    const render = () => {
      const now = nowHkt()
      const order = []
      for (const row of container.querySelectorAll('[data-session-row]')) {
        const market = row.getAttribute('data-session-row')
        const cd = row.querySelector('[data-session]')
        const lb = row.querySelector('[data-session-label]')
        const list = byMarket[market] || []
        let prev = null
        let next = null
        for (const e of list) {
          if (e.hkt <= now) prev = e
          else { next = e; break }
        }
        if (!next) {
          cd.textContent = '--:--:--'
          lb.textContent = '—'
          order.push({ sec: Infinity, row })
          continue
        }
        const sec = (Date.parse(next.hkt) - Date.now()) / 1000
        const open = prev ? isOpenType(prev.type) : false
        let label
        let color
        if (prev && prev.type === 'halt') {
          label = 'to reopen'
          color = 'var(--color-warn)'
        } else if (open) {
          label = next.type === 'close' || next.type === 'halt' ? 'to close' : 'to open'
          color = 'var(--color-up)'
        } else {
          label = next.type === 'open' || next.type === 'resume' ? 'to open' : 'to close'
          color = 'var(--color-down)'
        }
        cd.textContent = fmtHMS(sec)
        cd.style.color = color
        lb.textContent = label
        order.push({ sec, row })
      }
      order.sort((a, b) => a.sec - b.sec)
      for (const o of order) container.appendChild(o.row)
      if (nowMarker) {
        const hh = +now.slice(11, 13)
        const mm = +now.slice(14, 16)
        nowMarker.style.left = ((hh + mm / 60) / 24) * 100 + '%'
      }
    }

    render()
    setInterval(render, 1000)
  })()
</script>
