---
import { getCollection } from 'astro:content'
import { todayHkt, daySessionWindows, HKT_OFFSET_MS } from '../lib/sessions'
import { fmtDayW } from '../lib/dates'
import { buildStrip, segmentAt, nextNewsAt, nextSpeakerAt, fmtHuman } from '../lib/strip'
import type { StripPayload } from '../lib/strip'
import type { MarketKey } from '../lib/sessions'
import { marketMarker } from '../lib/market'
import { groupNewsHeadlines } from '../lib/market-news'
import NewsBlock from './NewsBlock.astro'

interface Props {
  news?: boolean
}

const { news: showNews = true } = Astro.props
const today = todayHkt()
const news = showNews ? await getCollection('market-news') : []
const newsToday = news.find((n) => n.data.date === today)
const red = newsToday?.data.red ?? []
const orange = newsToday?.data.orange ?? []

const payload: StripPayload = buildStrip(today, Date.now(), red, orange)
const now = payload.now

const wins = daySessionWindows(today)
const mk = marketMarker(today)

const prettyDate = fmtDayW(today)

const markets: { key: MarketKey; flag: string; name: string; window: string }[] = [
  { key: 'cme', flag: '📈', name: 'CME Globex', window: wins.cme },
  { key: 'nyse', flag: '🇺🇸', name: 'New York · NYSE', window: wins.nyse },
  { key: 'tse', flag: '🇯🇵', name: 'Tokyo · TSE', window: wins.tse },
  { key: 'lse', flag: '🇬🇧', name: 'London · LSE', window: wins.lse },
]

const segOf = (key: MarketKey) => segmentAt(payload.segments[key], now)
const nextRed = nextNewsAt(payload.news, now)
const speaker = nextSpeakerAt(payload.speaker, now)
const redKind = nextRed?.kind === 'red'

const clsColor = (cls: string) =>
  cls === 'up' ? 'var(--color-up)' : cls === 'warn' ? 'var(--color-warn)' : cls === 'down' ? 'var(--color-down)' : 'var(--color-dim)'
const clsClass = (cls: string) =>
  cls === 'up' ? 'text-up' : cls === 'warn' ? 'text-warn' : cls === 'down' ? 'text-down' : 'text-dim'

const nowHktBuild = new Date(Date.now() + HKT_OFFSET_MS)
const nowFracBuild = (nowHktBuild.getUTCHours() + nowHktBuild.getUTCMinutes() / 60) / 24 * 100

const evDots = groupNewsHeadlines(red, orange).map((g) => {
  const [h, m] = g.time.split(':').map(Number)
  return {
    at: Date.parse(`${today}T00:00:00+08:00`) + (h * 60 + m) * 60000,
    kind: g.kind,
    pct: ((h + m / 60) / 24) * 100,
    title: g.title,
  }
})
---

<section class="panel p-4">
  <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1">
    <div class="flex items-baseline gap-2 text-[13px]">
      <span class="text-ink">market</span>
      <span class="text-faint">{prettyDate}</span>
    </div>
    <span data-mkt-live class="text-[12px] tabular-nums" style={`color:${mk.status === 'open' ? 'var(--color-up)' : mk.status === 'early' ? 'var(--color-warn)' : 'var(--color-down)'}`}>
      {mk.glyph} {mk.text}
    </span>
  </div>

  <div class="mt-3 px-2" data-rail>
    <div class="relative h-10">
      {/* event severity dots on the rail */}
      {evDots.map((d) => (
        <span
          data-ev-at={d.at}
          class:list={['absolute top-5 z-10 h-1.5 w-1.5 -translate-x-1/2 rounded-full', d.kind === 'red' ? 'bg-down' : 'bg-warn']}
          style={`left:${d.pct}%`}
          title={d.title}
        ></span>
      ))}

      {/* now-marker: live clock + hairline + caret — chip rides inside the rail, caret sits on the rail */}
      <div class="absolute bottom-0 z-20 flex h-10 -translate-x-1/2 flex-col items-center" data-now-marker style={`left:${nowFracBuild}%`} title="now (HKT)">
        <span data-now-clock class="mt-1 whitespace-nowrap rounded-sm border border-accent/40 bg-bg px-1.5 py-0.5 text-2xs tabular-nums text-accent shadow-sm">--:--:--</span>
        <span class="w-px flex-1 bg-accent/70"></span>
        <span class="h-0 w-0 border-x-4 border-t-4 border-x-transparent border-t-accent"></span>
      </div>

      {/* the rail: hour tick markings on the line */}
      <div class="absolute bottom-0 left-0 right-0 flex items-end">
        <div class="absolute bottom-0 left-0 right-0 h-px bg-line"></div>
        {Array.from({ length: 25 }, (_, i) => {
          const major = i % 6 === 0
          return (
            <div class="flex flex-1 flex-col items-center">
              <span
                class:list={[
                  'w-px',
                  major ? 'h-3 bg-line2' : 'h-1.5 bg-line',
                  !major && i % 2 !== 0 ? 'hidden lg:block' : !major && i % 2 === 0 ? 'hidden sm:block' : '',
                ]}
              ></span>
              {major && <span class="mt-0.5 text-2xs tabular-nums text-faint">{String(i).padStart(2, '0')}</span>}
            </div>
          )
        })}
      </div>
    </div>
  </div>

  <div id="mkt-rows" class="mt-2">
    {markets.map((m) => {
      const seg = segOf(m.key)
      return (
        <div class="flex items-center justify-between gap-x-4 border-t border-line/60 py-2" data-session-row={m.key}>
          <div class="flex min-w-0 items-center gap-2">
            <span class="shrink-0 text-[15px] leading-none">{m.flag}</span>
            <span class="truncate text-[13px] text-ink">{m.name}</span>
          </div>
          <div class="flex min-w-0 items-center gap-x-3 text-right">
            <span data-session-text={m.key} class:list={['min-w-0 truncate text-[13px]', seg ? clsClass(seg.cls) : 'text-faint']}>
              {seg ? seg.text : 'closed'}
            </span>
            <span data-session-cd={m.key} class="shrink-0 w-[5.5rem] text-right text-[13px] tabular-nums" style={`color:${seg ? clsColor(seg.cls) : 'var(--color-faint)'}`}>
              {seg ? fmtHuman((seg.until - now) / 1000) : '—'}
            </span>
            <span class="hidden w-[7rem] text-right text-[11px] text-faint tabular-nums sm:inline">{m.window}</span>
          </div>
        </div>
      )
    })}
  </div>

  {showNews && (payload.news.length > 0 || speaker) && (
    <div class="mt-2 flex flex-col gap-1 border-t border-line/60 pt-2 text-[13px]" data-news-lines>
      <div class="flex items-baseline gap-3" data-news-row style={nextRed ? '' : 'display:none'}>
        <span data-news-dot class:list={['inline-block h-1.5 w-1.5 shrink-0 rounded-full', redKind ? 'bg-down' : 'bg-warn']}></span>
        <span data-news-text class:list={['min-w-0 flex-1', redKind ? 'text-down' : 'text-warn']}>{nextRed?.text ?? ''}</span>
        <span data-news-cd class="shrink-0 text-[12px] tabular-nums" style={nextRed ? `color:${redKind ? 'var(--color-down)' : 'var(--color-warn)'}` : ''}>
          {nextRed ? fmtHuman((nextRed.at - now) / 1000) : ''}
        </span>
      </div>
      {speaker && (
        <div class="flex items-baseline gap-3" data-speaker-row>
          <span class="inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-accent"></span>
          <span data-speaker-text class="min-w-0 flex-1 text-accent">{speaker.text}</span>
          <span data-speaker-cd class="shrink-0 text-[12px] tabular-nums text-accent">{fmtHuman((speaker.at - now) / 1000)}</span>
        </div>
      )}
    </div>
  )}

  {showNews && (red.length > 0 || orange.length > 0) && (
    <details class="group mt-2 border-t border-line/60">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-3 py-2 text-[13px]">
        <span class="text-dim">News events · all today</span>
        <span class="text-faint transition-transform group-open:rotate-180">▾</span>
      </summary>
      <div class="mt-1 flex flex-col gap-1 border-t border-line/50 pt-2">
        <NewsBlock red={red} orange={orange} dayIso={today} now={Date.now()} />
      </div>
    </details>
  )}

  <p class="mt-2 border-t border-line/60 pt-2 text-[11px] text-faint">all times HKT · CME Globex is the master clock</p>
</section>

<script type="application/json" id="mkt-strip" set:html={JSON.stringify(payload).replace(/</g, '\\u003c')} is:inline></script>

<script is:inline>
  (() => {
    const el = document.getElementById('mkt-strip')
    const container = document.getElementById('mkt-rows')
    if (!el || !container) return
    let PAYLOAD = null
    try { PAYLOAD = JSON.parse(el.textContent || 'null') } catch {}
    if (!PAYLOAD) return

    const p = (n) => String(n).padStart(2, '0')
    const fmtHuman = (sec) => {
      sec = Math.max(0, Math.round(sec))
      const d = Math.floor(sec / 86400)
      const h = Math.floor((sec % 86400) / 3600)
      const m = Math.floor((sec % 3600) / 60)
      const s = Math.floor(sec % 60)
      if (d > 0) return h > 0 ? d + 'd ' + h + 'h' : d + 'd'
      if (h > 0) return m > 0 ? h + 'h ' + m + 'm' : h + 'h'
      if (m >= 15) return m + 'm'
      return String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0')
    }
    const segAt = (segs, now) => {
      for (const s of segs) if (now >= s.at && now < s.until) return s
      return null
    }
    const nextAt = (list, now) => {
      const up = list.filter((n) => n.at > now)
      if (!up.length) return null
      const red = up.find((n) => n.kind === 'red')
      return red || up.reduce((a, b) => (b.at < a.at ? b : a))
    }
    const color = (cls) =>
      cls === 'up' ? 'var(--color-up)' : cls === 'warn' ? 'var(--color-warn)' : cls === 'down' ? 'var(--color-down)' : 'var(--color-dim)'
    const clsName = (cls) =>
      cls === 'up' ? 'text-up' : cls === 'warn' ? 'text-warn' : cls === 'down' ? 'text-down' : 'text-dim'

    const nowMarker = document.querySelector('[data-now-marker]')

    const render = () => {
      const now = Date.now()
      const order = []
      for (const row of container.querySelectorAll('[data-session-row]')) {
        const key = row.getAttribute('data-session-row')
        const seg = segAt(PAYLOAD.segments[key], now)
        const txt = row.querySelector('[data-session-text="' + key + '"]')
        const cd = row.querySelector('[data-session-cd="' + key + '"]')
        if (!seg) {
          txt.textContent = 'closed'
          txt.className = 'min-w-0 truncate text-[13px] text-faint'
          cd.textContent = '—'
          cd.style.color = 'var(--color-faint)'
          order.push({ sec: Infinity, row })
          continue
        }
        txt.textContent = seg.text
        txt.className = 'min-w-0 truncate text-[13px] ' + clsName(seg.cls)
        cd.textContent = fmtHuman((seg.until - now) / 1000)
        cd.style.color = color(seg.cls)
        order.push({ sec: (seg.until - now) / 1000, row })
      }
      order.sort((a, b) => a.sec - b.sec)
      for (const o of order) container.appendChild(o.row)

      const newsRow = document.querySelector('[data-news-row]')
      const news = nextAt(PAYLOAD.news, now)
      if (newsRow) {
        if (news) {
          newsRow.style.display = ''
          newsRow.querySelector('[data-news-text]').textContent = news.text
          newsRow.querySelector('[data-news-cd]').textContent = fmtHuman((news.at - now) / 1000)
          const red = news.kind === 'red'
          const dot = newsRow.querySelector('[data-news-dot]')
          dot.className = 'inline-block h-1.5 w-1.5 shrink-0 rounded-full ' + (red ? 'bg-down' : 'bg-warn')
          const t = newsRow.querySelector('[data-news-text]')
          t.className = 'min-w-0 flex-1 ' + (red ? 'text-down' : 'text-warn')
          const cd = newsRow.querySelector('[data-news-cd]')
          cd.style.color = red ? 'var(--color-down)' : 'var(--color-warn)'
        } else {
          newsRow.style.display = 'none'
        }
      }

      const spRow = document.querySelector('[data-speaker-row]')
      const sp = nextAt(PAYLOAD.speaker, now)
      if (spRow) {
        if (sp) {
          spRow.style.display = ''
          spRow.querySelector('[data-speaker-text]').textContent = sp.text
          spRow.querySelector('[data-speaker-cd]').textContent = fmtHuman((sp.at - now) / 1000)
        } else {
          spRow.style.display = 'none'
        }
      }

      const hk = new Date(Date.now() + 8 * 3600 * 1000)
      if (nowMarker) {
        nowMarker.style.left = ((hk.getUTCHours() + hk.getUTCMinutes() / 60) / 24) * 100 + '%'
      }
      const clockEl = document.querySelector('[data-now-clock]')
      if (clockEl) {
        clockEl.textContent = p(hk.getUTCHours()) + ':' + p(hk.getUTCMinutes()) + ':' + p(hk.getUTCSeconds())
        if (nowMarker) {
          const railW = nowMarker.parentElement.clientWidth
          const chipW = clockEl.offsetWidth
          const inset = 8
          const markerCenter = (parseFloat(nowMarker.style.left) / 100) * railW
          const half = chipW / 2
          const desired = Math.max(half + inset, Math.min(markerCenter, railW - half - inset))
          clockEl.style.transform = 'translateX(' + (desired - markerCenter) + 'px)'
        }
      }
      for (const dot of document.querySelectorAll('[data-ev-at]')) {
        const at = Number(dot.getAttribute('data-ev-at'))
        if (at <= now) {
          dot.classList.add('opacity-40')
          dot.classList.remove('animate-pulse')
        } else {
          dot.classList.remove('opacity-40')
          if (at - now < 15 * 60 * 1000) dot.classList.add('animate-pulse')
          else dot.classList.remove('animate-pulse')
        }
      }
    }

    render()
    setInterval(render, 1000)
  })()
</script>
