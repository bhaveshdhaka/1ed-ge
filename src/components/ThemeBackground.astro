<div class="theme-bg" aria-hidden="true">
  <div class="tb-stars tb-stars-a"></div>
  <div class="tb-stars tb-stars-b"></div>
  <svg class="tb-mountain" viewBox="0 0 1440 320" preserveAspectRatio="none" focusable="false">
    <defs>
      <linearGradient id="tb-ridge" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#1c2340" />
        <stop offset="0.45" stop-color="#151a30" />
        <stop offset="1" stop-color="#0c0f1c" />
      </linearGradient>
      <radialGradient id="tb-peak" cx="0.5" cy="0.5" r="0.5">
        <stop offset="0" stop-color="#eaf4ff" stop-opacity="0.75" />
        <stop offset="1" stop-color="#eaf4ff" stop-opacity="0" />
      </radialGradient>
    </defs>
    <path
      d="M0 300 L120 250 L200 268 L320 180 L420 240 L520 210 L640 120 L720 70 L820 160 L900 120 L1020 220 L1140 180 L1260 250 L1320 230 L1440 280 L1440 320 L0 320 Z"
