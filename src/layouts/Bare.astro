---
import '../styles/global.css'
import ThemeBackground from '../components/ThemeBackground.astro'
import MarketLive from '../components/MarketLive.astro'

interface Props {
  title?: string
}

const { title = '1ed.ge' } = Astro.props
---

<!doctype html>
<html lang="en" class="bg-bg" data-theme="summit">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
  </head>
  <body class="crt min-h-screen">
    <ThemeBackground />
    <slot />
    <MarketLive />
  </body>
</html>
