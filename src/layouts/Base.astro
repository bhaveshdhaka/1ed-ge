---
import '../styles/global.css'
import Nav from '../components/Nav.astro'
import ThemeBackground from '../components/ThemeBackground.astro'
import MarketLive from '../components/MarketLive.astro'

interface Props {
  title?: string
  description?: string
  ogImage?: string
  noindex?: boolean
}

const {
  title = '1ed.ge — public trading journal',
  description = 'A two-year public trading experiment. Every trade, every account, every R. Live and uncensored.',
  ogImage = '/og.png',
  noindex = false,
} = Astro.props

const theme = 'summit'
const SITE = 'https://1ed.ge'
const canonical = new URL(Astro.url.pathname, SITE)
---

<!doctype html>
<html lang="en" class="bg-bg" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#07080c" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="format-detection" content="telephone=no" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="1ed.ge" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.startsWith('http') ? ogImage : SITE + ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: '1ed.ge',
      url: SITE,
      description,
    })} is:inline></script>
    <script is:inline>
      if ('serviceWorker' in navigator && location.protocol.startsWith('http')) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {})
        })
      }
    </script>
  </head>
  <body class="crt flex min-h-screen flex-col">
    <ThemeBackground />
    <Nav />
    <main class="flex-1">
      <slot />
    </main>
    <footer class="shell py-10 pb-safe">
      <div class="flex flex-col gap-2 border-t border-line pt-6 text-[12px] text-dim md:flex-row md:items-center md:justify-between">
        <span>1edge — everything public, nothing hidden</span>
        <span class="text-faint">R is the only metric that matters.</span>
      </div>
      <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 border-t border-line/50 pt-3 text-[12px]">
        <span class="text-faint uppercase tracking-widest">market</span>
        <span data-mkt-live class="text-dim">—</span>
      </div>
    </footer>
    <MarketLive />
  </body>
</html>
