---
import Base from '../layouts/Base.astro'
import { getCollection } from 'astro:content'
import { render } from 'astro:content'
import { buildStats, fmtPnl } from '../lib/stats'
import { buildHabitStats, todayKey } from '../lib/habits'

const [accounts, days, journal, habits, payouts] = await Promise.all([
  getCollection('accounts'),
  getCollection('days'),
  getCollection('journal'),
  getCollection('habits'),
  getCollection('payouts'),
])

const stats = buildStats(days, accounts, payouts)
const habitStats = buildHabitStats(habits, days)
const today = todayKey()

const latestJournal = [...journal].sort((a, b) => b.data.date.localeCompare(a.data.date))[0]
let latestContent: { Content: any } | null = null
if (latestJournal) {
  try {
    latestContent = await render(latestJournal)
  } catch {}
}

const latestDay = [...days].sort((a, b) => b.data.date.localeCompare(a.data.date))[0]
const doneToday = habitStats.filter((h) => h.doneToday === true).length
const totalHabits = habitStats.length
const journalDays = new Set(journal.map((j) => j.data.date)).size
const s = stats.overall
const activeAccounts = stats.perAccount.filter((a) => a.active).length
const live = (n: number | null, suffix = '') => {
  if (n === null) return '—'
  const v = typeof n === 'number' && !Number.isInteger(n) ? n.toFixed(1) : String(n)
  return v + suffix
}
---

<Base>
  <section class="shell pt-16 pb-20">
    <div class="max-w-3xl">
      <p class="text-[13px] text-dim">
        <span class="text-faint">$</span> whoami<span class="cursor-blink text-accent">▋</span>
      </p>
      <h1 class="mt-4 text-3xl leading-tight md:text-5xl">
        trader. building a hedge fund <span class="text-dim">in public</span>.
      </h1>
      <p class="mt-6 max-w-2xl text-[15px] leading-relaxed text-soft">
        a two-year public experiment. every trade, every account, every mood,
        every screen-time screenshot, every miss — logged live and uncensored.
        no cherry-picking, no hidden P&amp;L. if i wouldn't show it, i shouldn't do it.
      </p>
      <p class="mt-3 text-[15px] leading-relaxed text-soft">
        the centerpiece is <span class="text-up font-semibold">R</span> — the points risked vs the
        points made. and the way i do one thing is the way i do everything —
        <span class="text-dim">everything is linked.</span>
      </p>
    </div>

    <div class="mt-14 grid grid-cols-2 gap-px border border-line bg-line md:grid-cols-6">
      <div class="bg-bg p-5">
        <div class="text-[11px] uppercase tracking-widest text-dim">cumulative R</div>
        <div class="mt-2 text-2xl num-up">{s.totalTrades ? (s.sumR > 0 ? '+' : '') + s.sumR.toFixed(2) + 'R' : '—'}</div>
      </div>
      <div class="bg-bg p-5">
        <div class="text-[11px] uppercase tracking-widest text-dim">win rate</div>
        <div class="mt-2 text-2xl text-ink">{s.totalTrades ? s.winRate!.toFixed(0) + '%' : '—'}</div>
      </div>
      <div class="bg-bg p-5">
        <div class="text-[11px] uppercase tracking-widest text-dim">trades logged</div>
        <div class="mt-2 text-2xl text-ink">{s.totalTrades || '0'}</div>
      </div>
      <div class="bg-bg p-5">
        <div class="text-[11px] uppercase tracking-widest text-dim">expectancy</div>
        <div class="mt-2 text-2xl num-up">{s.totalTrades ? live(s.expectancy, 'R') : '—'}</div>
      </div>
      <div class="bg-bg p-5">
        <div class="text-[11px] uppercase tracking-widest text-dim">payouts</div>
        <div class="mt-2 text-2xl text-ink">{stats.payoutTotal ? fmtPnl(stats.payoutTotal) : '—'}</div>
      </div>
      <div class="bg-bg p-5">
        <div class="text-[11px] uppercase tracking-widest text-dim">accounts</div>
        <div class="mt-2 text-2xl text-ink">{activeAccounts}</div>
      </div>
    </div>

    <div class="mt-3 flex flex-wrap items-center gap-x-6 gap-y-2 text-[12px] text-dim">
      <span>
        habits today: <span class={doneToday === totalHabits && totalHabits ? 'text-up' : ''}>{doneToday}/{totalHabits}</span>
      </span>
      <span>journal days: {journalDays}</span>
      <span>today: {today}</span>
      <span class="text-faint">status: public</span>
    </div>
  </section>

  <section class="border-t border-line bg-panel/40">
    <div class="shell py-14">
      <div class="mb-6 flex items-baseline justify-between">
        <h2 class="text-lg">/ latest journal</h2>
        <a href="/journal" class="text-[13px] text-dim transition-colors hover:text-ink">all entries →</a>
      </div>
      {latestJournal && latestContent ? (
        <article class="max-w-3xl">
          <div class="flex items-center gap-3 text-[12px] text-dim">
            <span>{latestJournal.data.date}</span>
            {latestJournal.data.day && <span class="text-ink">{latestJournal.data.day}</span>}
            {latestJournal.data.tags?.map((t) => <span class="tag">#{t}</span>)}
            <a href={`/day/${latestJournal.data.date}`} class="ml-auto text-accent hover:text-ink">structured day →</a>
          </div>
          <div class="prose mt-4 line-clamp-[8] [&>*]:text-[14px]">
            <latestContent.Content />
          </div>
          <a href={`/journal/${latestJournal.id}`} class="btn mt-6">read full entry</a>
        </article>
      ) : (
        <p class="text-[13px] text-faint">no journal entries yet.</p>
      )}
    </div>
  </section>

  <section class="shell py-14">
    <div class="mb-6 flex items-baseline justify-between">
      <h2 class="text-lg">/ latest day</h2>
      {latestDay && (
        <a href={`/day/${latestDay.data.date}`} class="text-[13px] text-dim transition-colors hover:text-ink">all days →</a>
      )}
    </div>
    {latestDay ? (
      <div class="panel max-w-3xl p-6">
        <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 text-[13px]">
          <a href={`/day/${latestDay.data.date}`} class="text-[15px] text-ink hover:text-accent">{latestDay.data.date}</a>
          <span class="text-dim">{latestDay.data.trades?.length ?? 0} trades</span>
          <span class="text-dim">mood {latestDay.data.mood ?? '—'}/5</span>
          <span class="text-dim">sleep {latestDay.data.sleep?.hours ?? '—'}h</span>
          <span class="text-dim">screen {latestDay.data.device?.iphoneHours ?? '—'}h</span>
        </div>
      </div>
    ) : (
      <p class="text-[13px] text-faint">no day logged yet.</p>
    )}

    <h2 class="mt-14 text-lg">/ go deeper</h2>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      <a href="/trends" class="panel group p-6 transition-colors hover:border-accent">
        <div class="text-[12px] text-dim">[04]</div>
        <div class="mt-3 text-[15px] text-ink group-hover:text-accent">trends</div>
        <p class="mt-2 text-[13px] leading-relaxed text-dim">
          how sleep, mood, habits and screen time move the R. the patterns, in public.
        </p>
      </a>
      <a href="/accounts" class="panel group p-6 transition-colors hover:border-accent">
        <div class="text-[12px] text-dim">[05]</div>
        <div class="mt-3 text-[15px] text-ink group-hover:text-accent">accounts</div>
        <p class="mt-2 text-[13px] leading-relaxed text-dim">
          every prop account live — stage, buffer, payouts. what i have right now.
        </p>
      </a>
      <a href="/coach" class="panel group p-6 transition-colors hover:border-accent">
        <div class="text-[12px] text-dim">[06]</div>
        <div class="mt-3 text-[15px] text-ink group-hover:text-accent">coach</div>
        <p class="mt-2 text-[13px] leading-relaxed text-dim">
          f-R-iend reading the numbers and calling it straight. no sugar-coating.
        </p>
      </a>
    </div>
  </section>
</Base>
