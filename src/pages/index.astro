---
import Base from '../layouts/Base.astro'
import { listMds, readEntry } from '../lib/content'
import { cmeToday, nowHkt, hktDayNumber } from '../lib/sessions'
import { fmtDay, fmtDayWUpper } from '../lib/dates'
import { resolveThoughts, dayFacts } from '../lib/stream'
import type { DayData } from '../lib/stream'
import { readLiveState } from '../lib/live'
import { liveLine, pendingReflectionsLine } from '../lib/copy'
import { accountabilityStatus } from '../lib/accountability'
import ThoughtCard from '../components/stream/ThoughtCard.astro'
import DayFacts from '../components/stream/DayFacts.astro'
import EmptyState from '../components/ui/EmptyState.astro'
import MarketWidget from '../components/MarketWidget.astro'
import { getCollection } from 'astro:content'
import { marketMarker } from '../lib/market'
import NewsEventsCard from '../components/NewsEventsCard.astro'

export const prerender = false

const iso = cmeToday()
const dayFiles = listMds('days')
const habitFiles = listMds('habits')
const journalFiles = listMds('journal')
const reviewFiles = listMds('reviews').filter((f) => !f.endsWith('.cmp.md'))

const dayEntries = dayFiles.map((f) => readEntry('days', f))
const habitEntries = habitFiles.map((f) => readEntry('habits', f))
const journalEntries = journalFiles.map((f) => readEntry('journal', f))
const reviewEntries = reviewFiles.map((f) => readEntry('reviews', f))

const byDate = new Map(dayEntries.map((d) => [d.data.date as string, d.data as unknown as DayData]))
const today: DayData | null = byDate.get(iso) ?? null
const thoughts = today ? resolveThoughts(today) : []

const activeHabits = habitEntries.filter((h) => h.data.active).length

const dataDays = dayEntries
  .filter((d) => ((d.data as unknown as DayData).trades?.length ?? 0) > 0 || (((d.data as unknown as DayData).stream?.length ?? 0) > 0))
  .sort((a, b) => String(b.data.date).localeCompare(String(a.data.date)))
const latestIso = dataDays.length ? String(dataDays[0].data.date) : null

const latestThoughts = latestIso && latestIso !== iso ? resolveThoughts(byDate.get(latestIso) as DayData).slice(-3) : []
const cells = dayFacts(today, activeHabits)

// A day record with no mood/sleep/device/habits/trades/thoughts would render
// the facts strip as all-dashes — swap in a single-panel empty state instead.
const dayHasContent =
  today != null &&
  (today.mood !== undefined ||
    today.sleep?.hours !== undefined ||
    today.sleep?.quality !== undefined ||
    (today.habits != null && Object.keys(today.habits).length > 0) ||
    today.device?.iphoneHours !== undefined ||
    today.device?.macHours !== undefined ||
    (today.trades?.length ?? 0) > 0 ||
    (today.stream?.length ?? 0) > 0)

const live = readLiveState()

// --- moniker line: live + pending-reflection nudge (one compact line) ---
// nowIso = current HKT wall time (YYYY-MM-DDTHH:MM); accountabilityStatus
// compares it lexicographically against the 03:00-HKT grace boundaries.
const nowIso = nowHkt()
const account = accountabilityStatus(
  dayEntries.map((d) => d.data as unknown as DayData),
  journalEntries.map((j) => String(j.data.date)),
  reviewEntries.map((r) => ({ type: String(r.data.type), anchor: String(r.data.anchor) })),
  nowIso,
)
// Calendar-day difference in HKT between the durable stamp and now.
const lastSeenDays = live.lastOnlineIso
  ? Math.max(0, hktDayNumber(`${nowIso}:00+08:00`) - hktDayNumber(live.lastOnlineIso))
  : null
const moniker = [liveLine(live.live, lastSeenDays), pendingReflectionsLine(account.pendingDays, account.pendingPeriods)]
  .filter(Boolean)
  .join(' · ')

// Market day data (same as MarketDay component, inlined for single-card template)
const mk = marketMarker(iso)
const news = await getCollection('market-news')
const dayNews = news.find((n) => n.data.date === iso)
const red = dayNews?.data.red ?? []
const orange = dayNews?.data.orange ?? []

// Live page — never serve a stale cached copy (a published thought must show immediately).
Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate')
---

<Base
  title="1ed.ge — a public trading journal"
  description="I open every position, show every ticket, log every trade. Nothing hidden. Trading is kaizen."
>
  <section class="shell pt-12 pb-10">
    <h1 class="max-w-3xl text-3xl font-semibold leading-tight text-ink md:text-4xl">
      1edge — a public trading journal.
    </h1>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-soft">
      I open every position, show every ticket, log every trade, every result, every move.
      Nothing hidden. Everything here for anyone who wants to watch the process unfold.
    </p>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-dim">
      Trading is kaizen: continuous daily improvement. I keep what works, drop what doesn't,
      and tweak the exact same things every single day.
    </p>
  </section>

  <section class="shell pb-6">
    <MarketWidget />
  </section>

  <section class="shell pb-6">
    <div class="panel panel-hero">
      <div class="card-hd">
        <span class="card-ico">📅</span>
        <span class="card-lbl">today</span>
        <span class="card-sub">{fmtDayWUpper(iso)}</span>
        <span class:list={['tmr', mk.status === 'open' ? 'text-up' : mk.status === 'early' ? 'text-warn' : 'text-down']}>
          {mk.glyph} {mk.text}{mk.status === 'open' ? ' · full day' : ''}
        </span>
        {latestIso && latestIso !== iso && (
          <a href={`/day/${fmtDay(latestIso)}`} class="ml-auto text-2xs text-dim transition-colors hover:text-accent">
            last logged day {fmtDayWUpper(latestIso)} →
          </a>
        )}
      </div>
      <div class="p-3 md:p-4">
        <NewsEventsCard red={red} orange={orange} dayIso={iso} isToday={true} hideDate={true} />
        <div class="mt-3">
          {dayHasContent ? (
            <DayFacts cells={cells} />
          ) : (
            <EmptyState text="no day logged yet." />
          )}
        </div>
      </div>
    </div>
  </section>

  <section class="shell pb-20">
    <div class="panel">
      <div class="card-hd">
        <span class="card-ico">📡</span>
        <span class="card-lbl">stream</span>
        <span class:list={['ml-auto flex items-center gap-2 text-xs', live.live ? 'text-up' : 'text-faint']}>
          <span class:list={['inline-block h-1.5 w-1.5 rounded-full', live.live ? 'bg-up' : 'bg-line2']}></span>
          {moniker}
        </span>
        <a href="/stream" class="text-2xs text-dim transition-colors hover:text-accent">all streams →</a>
      </div>
      <div class="p-3 md:p-4">
        {thoughts.length > 0 ? (
          <div class="flex max-w-2xl flex-col gap-3">
            {thoughts.map((t) => <ThoughtCard thought={t} />)}
          </div>
        ) : (
          <div class="max-w-2xl">
            <EmptyState text="no stream yet today — nothing logged." />
            {latestIso && latestThoughts.length > 0 && (
              <div class="mt-5">
                <p class="mb-3 text-2xs uppercase tracking-widest text-dim">latest from {fmtDayWUpper(latestIso)}</p>
                <div class="flex flex-col gap-3">
                  {latestThoughts.map((t) => <ThoughtCard thought={t} showDay hideDate />)}
                </div>
              </div>
            )}
          </div>
        )}
      </div>
    </div>
  </section>
</Base>
