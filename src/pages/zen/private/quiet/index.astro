---
/**
 * Quiet Time — 20-minute threshold with meditation audio.
 * Auth-gated. Private aesthetic (panel / panel-hero / capsule).
 */
import Bare from '../../../../layouts/Bare.astro'
import PrivateNav from '../../../../components/private/PrivateNav.astro'
import PrivateStep from '../../../../components/private/PrivateStep.astro'
import Icon from '../../../../components/ui/Icon.astro'
import { sessionOk } from '../../../../lib/auth'

export const prerender = false

if (!sessionOk(Astro.request)) {
  return Astro.redirect('/zen')
}

const meditations = [
  { by: 'Francesco Cracolici', title: 'Full Moon Meditation', src: '/private/audio/full-moon-meditation.mp3' },
  { by: 'Trevor G. Blake', title: 'Mini Mind Movie', src: '/private/audio/trevor-mini-mind-movie-meditation.mp3' },
]
const library = [
  { title: 'Energetic Cleansing', subtitle: 'Friction and Light', freqs: [220, 330, 440, 660], lowpass: 1200 },
  { title: 'Grounding', subtitle: 'Deep roots', freqs: [110, 165, 220], lowpass: 500 },
  { title: 'Thought Management', subtitle: 'Clouds passing by', freqs: [261.6, 329.6, 392], lowpass: 900 },
  { title: 'Non-Directive Meditation', subtitle: 'Spontaneous drift', freqs: [196, 246.9, 293.7, 369.9], lowpass: 700 },
  { title: 'Sigh of Relief', subtitle: 'The Audible Exhale', noise: true },
]
---

<Bare title="quiet — private — 1ed.ge">
  <section class="shell pt-12 pb-32">
    <PrivateStep
      step="step one"
      title="Quiet Time"
      desc="Twenty minutes. As you cross this Threshold, a node lights up on your Neural Map and the Chamber of Intentions opens — your brain will be receptive."
    />

    <!-- Timer -->
    <div class="mx-auto mt-8 max-w-2xl">
      <div class="panel-hero overflow-hidden">
        <div class="card-hd">
          <div class="card-ico"><Icon name="waves" size={15} /></div>
          <div class="card-lbl">Threshold</div>
          <div id="qt-status" class="tmr">ready</div>
        </div>
        <div class="p-6 text-center">
          <div id="qt-display" class="font-mono text-6xl tabular-nums text-ink tracking-tight">20:00</div>
          <div class="mt-5 flex flex-wrap justify-center gap-2">
            {[5, 10, 20, 30].map((m) => (
              <button data-preset={m} class="capsule cursor-pointer hover:border-accent/50 hover:text-ink">{m} min</button>
            ))}
          </div>
          <div class="mt-6 flex justify-center gap-3">
            <button id="qt-start" class="btn btn-primary min-h-[48px] px-8 text-sm">Begin</button>
            <button id="qt-reset" class="btn min-h-[48px] px-6 text-sm">Reset</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Francesco & Trevor Meditations -->
    <div class="mx-auto mt-8 max-w-2xl">
      <div class="panel">
        <div class="card-hd">
          <div class="card-ico"><Icon name="headphones" size={15} /></div>
          <div class="card-lbl">Francesco &amp; Trevor Meditations</div>
        </div>
        <div class="divide-y divide-line/60">
          {meditations.map((m) => (
            <div class="flex flex-col gap-3 p-4 sm:flex-row sm:items-center">
              <div class="flex-1">
                <div class="card-sub">Meditation by {m.by}</div>
                <div class="mt-0.5 text-sm font-medium text-ink">{m.title}</div>
              </div>
              <audio class="w-full sm:w-64" controls preload="none" src={m.src}></audio>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Library -->
    <div class="mx-auto mt-6 max-w-2xl">
      <div class="text-2xs uppercase tracking-widest text-faint mb-3">the library</div>
      <div id="library" class="flex flex-col gap-2">
        {library.map((item, i) => (
          <button type="button" data-library={i} class="panel-flat flex items-center gap-3 px-3 py-3 text-left hover:border-accent/50 transition-colors">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-ink/10 text-accent">
              <Icon name="play" size={14} />
            </span>
            <div class="flex-1 min-w-0">
              <div class="text-sm font-medium text-ink">{item.title}</div>
              <div class="text-2xs uppercase tracking-widest text-faint">{item.subtitle}</div>
            </div>
          </button>
        ))}
      </div>
    </div>
  </section>

  <PrivateNav active="quiet" />
</Bare>

<script>
  // ── Web Audio library generators ──
  const libData = [
    { freqs: [220, 330, 440, 660], lowpass: 1200 },
    { freqs: [110, 165, 220], lowpass: 500 },
    { freqs: [261.6, 329.6, 392], lowpass: 900 },
    { freqs: [196, 246.9, 293.7, 369.9], lowpass: 700 },
    { noise: true },
  ]

  function oscBank(freqs, lpFreq) {
    return (ctx) => {
      const gain = ctx.createGain()
      gain.gain.setValueAtTime(0, ctx.currentTime)
      gain.gain.linearRampToValueAtTime(0.18, ctx.currentTime + 2)
      const lp = ctx.createBiquadFilter()
      lp.type = 'lowpass'
      lp.frequency.value = lpFreq
      gain.connect(lp).connect(ctx.destination)
      const oscs = freqs.map((f) => {
        const o = ctx.createOscillator()
        o.type = 'sine'
        o.frequency.value = f
        const g = ctx.createGain()
        g.gain.value = 1 / freqs.length
        o.connect(g).connect(gain)
        o.start()
        return o
      })
      let active = true
      return {
        stop() {
          if (!active) return
          active = false
          gain.gain.linearRampToValueAtTime(0, ctx.currentTime + 1.2)
          setTimeout(() => {
            oscs.forEach((o) => { try { o.stop() } catch {} })
            try { ctx.close() } catch {}
          }, 1400)
        },
      }
    }
  }

  function noiseGen() {
    return (ctx) => {
      const gain = ctx.createGain()
      gain.gain.value = 0
      gain.connect(ctx.destination)
      const buf = ctx.createBuffer(1, ctx.sampleRate * 2, ctx.sampleRate)
      const data = buf.getChannelData(0)
      for (let i = 0; i < data.length; i++) data[i] = (Math.random() * 2 - 1) * 0.6
      const src = ctx.createBufferSource()
      src.buffer = buf
      src.loop = true
      const bp = ctx.createBiquadFilter()
      bp.type = 'bandpass'
      bp.frequency.value = 600
      bp.Q.value = 0.7
      src.connect(bp).connect(gain)
      src.start()
      let active = true
      function wave() {
        if (!active) return
        const t = ctx.currentTime
        gain.gain.cancelScheduledValues(t)
        gain.gain.setValueAtTime(0.02, t)
        gain.gain.linearRampToValueAtTime(0.22, t + 4)
        gain.gain.linearRampToValueAtTime(0.02, t + 9)
        setTimeout(wave, 9500)
      }
      wave()
      return {
        stop() {
          active = false
          gain.gain.linearRampToValueAtTime(0, ctx.currentTime + 1)
          setTimeout(() => {
            try { src.stop() } catch {}
            try { ctx.close() } catch {}
          }, 1200)
        },
      }
    }
  }

  // ── Timer ──
  const display = document.getElementById('qt-display') as HTMLDivElement
  const startBtn = document.getElementById('qt-start') as HTMLButtonElement
  const resetBtn = document.getElementById('qt-reset') as HTMLButtonElement
  const status = document.getElementById('qt-status') as HTMLDivElement
  const presets = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-preset]'))

  let total = 20 * 60
  let remaining = total
  let timer: ReturnType<typeof setInterval> | null = null
  let running = false

  const fmt = (s: number) => `${String(Math.floor(s / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`
  const render = () => { display.textContent = fmt(remaining) }

  presets.forEach((b) => b.addEventListener('click', () => {
    total = Number(b.dataset.preset) * 60
    remaining = total
    render()
    status.textContent = `${b.dataset.preset} min set`
  }))

  function tick() {
    remaining--
    render()
    if (remaining <= 0) {
      stop()
      status.textContent = 'complete · node lit'
      fetch('/api/admin/private/quiet', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ data: { minutes: Math.round(total / 60), completed: true } }),
      }).catch(() => {})
    }
  }
  function start() {
    if (running) return
    running = true
    startBtn.textContent = 'Pause'
    timer = setInterval(tick, 1000)
  }
  function stop() {
    running = false
    startBtn.textContent = 'Begin'
    if (timer) { clearInterval(timer); timer = null }
  }
  startBtn.addEventListener('click', () => (running ? stop() : start()))
  resetBtn.addEventListener('click', () => { stop(); remaining = total; render(); status.textContent = 'ready' })

  // ── Library playback ──
  let libPlaying: number | null = null
  let libHandle: { stop(): void } | null = null
  const libBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-library]'))

  function libIcon(btn: HTMLButtonElement, on: boolean) {
    const span = btn.querySelector('span')
    if (!span) return
    span.innerHTML = on
      ? '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>'
      : '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>'
    span.classList.toggle('bg-accent/20', on)
  }

  libBtns.forEach((btn) => {
    btn.addEventListener('click', async () => {
      const idx = Number(btn.dataset.library)
      if (libPlaying === idx) {
        libHandle?.stop()
        libHandle = null
        libPlaying = null
        libIcon(btn, false)
        return
      }
      // stop previous
      if (libHandle) {
        libHandle.stop()
        libHandle = null
        if (libPlaying !== null) libIcon(libBtns[libPlaying], false)
      }
      // start new
      const Ctx = window.AudioContext || (window as any).webkitAudioContext
      const ctx = new Ctx()
      if (ctx.state === 'suspended') await ctx.resume()
      const item = libData[idx]
      const builder = item.noise ? noiseGen() : oscBank(item.freqs!, item.lowpass!)
      libHandle = builder(ctx)
      libPlaying = idx
      libIcon(btn, true)
    })
  })

  render()
</script>
