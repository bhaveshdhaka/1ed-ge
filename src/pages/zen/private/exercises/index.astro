---
/**
 * Daily Exercises — today's practice + previous list.
 * Auth-gated. Private aesthetic.
 */
import Bare from '../../../../layouts/Bare.astro'
import PrivateNav from '../../../../components/private/PrivateNav.astro'
import PrivateStep from '../../../../components/private/PrivateStep.astro'
import Icon from '../../../../components/ui/Icon.astro'
import { sessionOk } from '../../../../lib/auth'

export const prerender = false

if (!sessionOk(Astro.request)) {
  return Astro.redirect('/zen')
}

const today = {
  title: "Trevor's Mini Mind Movie Meditation",
  meta: 'Audio · 20 Minutes',
  blurb: 'A short guided meditation from Trevor to anchor your mind movie and align with your intentions.',
  src: '/private/audio/trevor-mini-mind-movie-meditation.mp3',
}
const previous = {
  title: 'Full Moon Meditation',
  meta: 'Audio · 20 min',
  src: '/private/audio/full-moon-meditation.mp3',
}
---

<Bare title="exercises — private — 1ed.ge">
  <section class="shell pt-12 pb-32">
    <PrivateStep
      step="daily practice"
      title="Daily Exercises"
      desc="Small daily actions create extraordinary results over time."
    />

    <!-- Today's Exercise -->
    <div class="mx-auto mt-8 max-w-2xl">
      <div class="panel-hero overflow-hidden">
        <div class="card-hd">
          <div class="card-ico"><Icon name="book-open" size={15} /></div>
          <div class="card-lbl">Today's Exercise</div>
          <div id="ex-status" class="tmr">not started</div>
        </div>
        <div class="p-5">
          <div class="text-sm font-semibold text-ink">{today.title}</div>
          <div class="mt-1 card-sub">{today.meta}</div>
          <p class="mt-3 text-sm text-dim leading-relaxed">{today.blurb}</p>
          <audio class="mt-4 w-full" controls preload="none" src={today.src}></audio>
          <button id="ex-start" class="btn btn-primary mt-4 min-h-[48px] w-full justify-center text-sm">
            <Icon name="play" size={15} /> Start Exercise
          </button>
        </div>
      </div>
    </div>

    <!-- Streak -->
    <div class="mx-auto mt-6 max-w-2xl">
      <div class="panel p-5 text-center">
        <div class="text-3xl font-semibold text-ink" id="ex-streak">0</div>
        <div class="mt-1 capsule mx-auto">🔥 exercise streak · days</div>
      </div>
    </div>

    <!-- Previous -->
    <div class="mx-auto mt-6 max-w-2xl">
      <div class="panel">
        <div class="card-hd">
          <div class="card-ico"><Icon name="history" size={15} /></div>
          <div class="card-lbl">Previous Exercises</div>
        </div>
        <div class="p-5">
          <div class="text-sm font-semibold text-ink">{previous.title}</div>
          <div class="mt-1 card-sub">{previous.meta}</div>
          <audio class="mt-3 w-full" controls preload="none" src={previous.src}></audio>
        </div>
      </div>
    </div>
  </section>

  <PrivateNav active="exercises" />
</Bare>

<script>
  const startBtn = document.getElementById('ex-start') as HTMLButtonElement
  const status = document.getElementById('ex-status') as HTMLDivElement
  const streakEl = document.getElementById('ex-streak') as HTMLDivElement

  const todayKey = (d = new Date()) => d.toISOString().slice(0, 10)
  function loadStats() {
    fetch('/api/admin/private/exercise').then((r) => r.json()).then((d) => {
      const recs = (d.records ?? []) as { data: { date?: string } }[]
      const dates = new Set(recs.map((r) => (r.data.date ?? '').slice(0, 10)).filter(Boolean).sort())
      let streak = 0
      let cursor = new Date()
      while (dates.has(todayKey(cursor))) { streak++; cursor.setDate(cursor.getDate() - 1) }
      streakEl.textContent = String(streak)
    }).catch(() => {})
  }

  startBtn.addEventListener('click', () => {
    startBtn.toggleAttribute('disabled')
    status.textContent = 'saving…'
    fetch('/api/admin/private/exercise', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ data: { date: todayKey(), title: "Trevor's Mini Mind Movie Meditation", completed: true } }),
    }).then(() => { status.textContent = '✓ done'; loadStats() })
      .catch(() => { status.textContent = 'error'; startBtn.removeAttribute('disabled') })
  })

  loadStats()
</script>
