---
/**
 * 21-Day Practice — RAS reset, practice picker.
 * Auth-gated. Private aesthetic.
 */
import Bare from '../../../../layouts/Bare.astro'
import PrivateNav from '../../../../components/private/PrivateNav.astro'
import PrivateStep from '../../../../components/private/PrivateStep.astro'
import Icon from '../../../../components/ui/Icon.astro'
import { sessionOk } from '../../../../lib/auth'

export const prerender = false

if (!sessionOk(Astro.request)) {
  return Astro.redirect('/zen')
}

const practices = [
  { id: 'mental-diet', title: '7-Day Mental Diet', blurb: 'Only chosen thoughts. Change the channel whenever the old ones return.' },
  { id: 'window-shopping', title: 'Structured Window Shopping', blurb: 'Observe what you desire with awe, without urgency. Soak in the detail.' },
  { id: 'own', title: 'My own practice', blurb: 'Define your daily reset for the Reticular Activating System.' },
]
---

<Bare title="21 days — private — 1ed.ge">
  <section class="shell pt-12 pb-32">
    <PrivateStep
      step="practice"
      title="21-Day Practice"
      desc="Reticular Activating System reset. No streaks. Only certainty. Twenty-one days to re-tune your Reticular Activating System. No streaks. No pressure."
    />

    <div class="mx-auto mt-8 max-w-2xl">
      <div class="card-lbl mb-3">choose your practice</div>
      <div id="dd-grid" class="flex flex-col gap-3">
        {practices.map((p) => (
          <button data-practice={p.id} class="panel group flex items-start gap-3 p-4 text-left transition-colors hover:border-accent/50 data-[on=true]:border-accent data-[on=true]:bg-accent/5">
            <div class="card-ico mt-0.5"><Icon name="check" size={15} class="text-faint transition-colors group-data-[on=true]:text-accent" /></div>
            <div>
              <div class="text-sm font-semibold text-ink">{p.title}</div>
              <div class="mt-1 text-xs text-dim leading-relaxed">{p.blurb}</div>
            </div>
          </button>
        ))}
      </div>
      <p id="dd-status" class="mt-3 text-center text-2xs uppercase tracking-widest text-faint"></p>
    </div>
  </section>

  <PrivateNav active="21days" />
</Bare>

<script>
  const status = document.getElementById('dd-status') as HTMLParagraphElement
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-practice]'))

  function paint(selected: string | null) {
    buttons.forEach((b) => b.toggleAttribute('data-on', b.dataset.practice === selected))
  }

  function load() {
    fetch('/api/admin/routines?activity=21days').then((r) => r.json()).then((d) => {
      const recs = (d.records ?? []) as { practice?: string }[]
      paint(recs[0]?.practice ?? null)
    }).catch(() => {})
  }

  buttons.forEach((b) => b.addEventListener('click', () => {
    const practice = b.dataset.practice!
    status.textContent = 'saving…'
    fetch('/api/admin/routines', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ activity: '21days', practice }),
    }).then(() => { paint(practice); status.textContent = '✓ saved' }).catch(() => { status.textContent = 'error' })
  }))

  load()
</script>
