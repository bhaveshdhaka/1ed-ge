---
/**
 * Private home — the meditation corner.
 * SSR, auth-gated by zen session. Dark terminal aesthetic.
 */
import Bare from '../../../layouts/Bare.astro'
import Card from '../../../components/ui/Card.astro'
import Icon from '../../../components/ui/Icon.astro'
import PrivateNav from '../../../components/private/PrivateNav.astro'
import { sessionOk } from '../../../lib/auth'

export const prerender = false

// Auth gate — the zen session cookie must be present (passkey session).
if (!sessionOk(Astro.request)) {
  return Astro.redirect('/zen')
}

// Activity cards
const base = '/zen/private'
const activities = [
  { id: 'quiet', label: 'Quiet Time', icon: 'waves', href: `${base}/quiet/`, disabled: false },
  { id: 'nature', label: 'Nature Time', icon: 'leaf', href: `${base}/nature/`, disabled: false },
  { id: 'exercises', label: 'Daily Exercises', icon: 'book-open', href: `${base}/exercises/`, disabled: false },
  { id: 'intentions', label: 'Intentions', icon: 'feather', href: `${base}/intentions/`, disabled: false },
  { id: 'rewiring', label: 'Re-Wiring', icon: 'activity', href: `${base}/rewiring/`, disabled: false },
  { id: 'mindmovie', label: 'Mind Movie', icon: 'film', href: `${base}/movie/`, disabled: false },
  { id: '21days', label: '21 Days', icon: 'calendar-check', href: `${base}/21/`, disabled: false },
]
---

<Bare title="private — 1ed.ge">
  <section class="shell pt-12 pb-32">
    <!-- Hero quote -->
    <div class="mx-auto max-w-2xl text-center">
      <blockquote class="text-2xl font-medium leading-tight text-ink">
        "Reality is like a mirror. If you smile, it smiles back. If you want your reality to change, you must first change yourself. A mirror cannot smile before you do."
      </blockquote>
    </div>

    <!-- Tagline -->
    <div class="mx-auto mt-10 max-w-2xl">
      <div class="flex items-center gap-3">
        <div class="h-px w-6 bg-accent"></div>
        <span class="text-2xs uppercase tracking-widest text-dim">small daily actions create extraordinary results</span>
      </div>
    </div>

    <!-- Activity cards grid -->
    <div class="mx-auto mt-8 max-w-2xl">
      <div class="text-2xs uppercase tracking-widest text-faint mb-4">begin somewhere</div>
      <div class="grid grid-cols-3 gap-3 md:grid-cols-4">
        {activities.map((a) => (
          <a
            href={a.disabled ? undefined : a.href}
            class:list={[
              'flex flex-col items-center gap-2 rounded-lg border border-line p-4 transition-colors min-h-[100px] justify-center',
              a.disabled
                ? 'bg-raise/30 opacity-40 pointer-events-none'
                : 'bg-raise hover:border-accent/50 hover:bg-raise/80',
            ]}
          >
            <Icon name={a.icon} size={20} class={a.disabled ? 'text-dim' : 'text-accent'} />
            <span class="text-xs font-medium text-ink text-center">{a.label}</span>
          </a>
        ))}
      </div>
    </div>

    <!-- Today status (live from routines API) -->
    <div class="mx-auto mt-10 max-w-2xl">
      <div class="text-2xs uppercase tracking-widest text-faint mb-4">today</div>
      <Card variant="flat">
        <div class="divide-y divide-line/60">
          <div class="flex items-center justify-between px-4 py-3">
            <span class="text-xs text-dim">Quiet Time</span>
            <span id="st-quiet" class="text-xs font-medium text-dim">—</span>
          </div>
          <div class="flex items-center justify-between px-4 py-3">
            <span class="text-xs text-dim">Nature Time</span>
            <span id="st-nature" class="text-xs font-medium text-dim">—</span>
          </div>
          <div class="flex items-center justify-between px-4 py-3">
            <span class="text-xs text-dim">Daily Exercise</span>
            <span id="st-exercise" class="text-xs font-medium text-dim">—</span>
          </div>
          <div class="flex items-center justify-between px-4 py-3">
            <span class="text-xs text-dim">Re-Wiring</span>
            <span id="st-rewiring" class="text-xs font-medium text-dim">—</span>
          </div>
          <div class="flex items-center justify-between px-4 py-3">
            <span class="text-xs text-dim">21 Days</span>
            <span id="st-21days" class="text-xs font-medium text-dim">—</span>
          </div>
        </div>
      </Card>
    </div>

    <!-- Quick streaks -->
    <div class="mx-auto mt-6 grid max-w-2xl grid-cols-3 gap-3">
      <div class="panel p-4 text-center">
        <div class="text-2xl font-semibold text-ink" id="streak-nature">0</div>
        <div class="mt-1 text-2xs uppercase tracking-widest text-faint">nature streak</div>
      </div>
      <div class="panel p-4 text-center">
        <div class="text-2xl font-semibold text-ink" id="streak-exercise">0</div>
        <div class="mt-1 text-2xs uppercase tracking-widest text-faint">exercise streak</div>
      </div>
      <div class="panel p-4 text-center">
        <div class="text-2xl font-semibold text-ink" id="streak-rewiring">0</div>
        <div class="mt-1 text-2xs uppercase tracking-widest text-faint">rewiring nodes</div>
      </div>
    </div>
  </section>

  <PrivateNav active="home" zenHref="/zen" />
</Bare>

<script>
  // HKT date helper
  function todayHkt() {
    return new Date(Date.now() + 8 * 3600 * 1000).toISOString().slice(0, 10)
  }

  function computeStreak(records: { date?: string }[]): number {
    const dates = new Set(records.map(r => (r.date ?? '').slice(0, 10)).filter(Boolean))
    let streak = 0
    let checkDate = todayHkt()
    while (dates.has(checkDate)) {
      streak++
      const d = new Date(checkDate + 'T00:00:00+08:00')
      d.setDate(d.getDate() - 1)
      checkDate = d.toISOString().slice(0, 10)
    }
    return streak
  }

  async function loadToday() {
    const today = todayHkt()
    try {
      const res = await fetch(`/api/admin/routines?date=${today}`)
      const data = await res.json()
      const records = (data.records ?? []) as { activity: string; minutes?: number; practice?: string }[]
      const derived = data.derived ?? {}

      const quietDone = derived.quietDone || records.some(r => r.activity === 'quiet')
      const natureRec = records.find(r => r.activity === 'nature')
      const exerciseDone = records.some(r => r.activity === 'exercise')
      const rewiringDone = records.some(r => r.activity === 'rewiring')
      const days21 = records.find(r => r.activity === '21days')

      const done = (el: string, ok: boolean) => {
        const e = document.getElementById(el)
        if (e) { e.textContent = ok ? '✓ done' : 'not done'; e.className = `text-xs font-medium ${ok ? 'text-up' : 'text-dim'}` }
      }

      done('st-quiet', quietDone)
      const natureEl = document.getElementById('st-nature')
      if (natureEl) {
        if (natureRec?.minutes) { natureEl.textContent = `${natureRec.minutes} min`; natureEl.className = 'text-xs font-medium text-up' }
        else { natureEl.textContent = 'not done'; natureEl.className = 'text-xs font-medium text-dim' }
      }
      done('st-exercise', exerciseDone)
      done('st-rewiring', rewiringDone)
      const d21El = document.getElementById('st-21days')
      if (d21El) { d21El.textContent = days21?.practice ?? 'not set'; d21El.className = `text-xs font-medium ${days21 ? 'text-up' : 'text-dim'}` }
    } catch {}

    // Load streaks
    for (const act of ['nature', 'exercise']) {
      try {
        const res = await fetch(`/api/admin/routines?activity=${act}`)
        const data = await res.json()
        const streak = computeStreak(data.records ?? [])
        const el = document.getElementById(`streak-${act}`)
        if (el) el.textContent = String(streak)
      } catch {}
    }

    // Rewiring progress (from quiet completions 20+ min)
    try {
      const res = await fetch('/api/admin/routines?activity=quiet')
      const data = await res.json()
      const recs = (data.records ?? []) as { date?: string; minutes?: number }[]
      const qualifyingDays = new Set<string>()
      for (const r of recs) {
        const date = (r.date ?? '').slice(0, 10)
        if (date && (r.minutes ?? 0) >= 20) qualifyingDays.add(date)
      }
      let progress = 0
      let checkDate = todayHkt()
      while (qualifyingDays.has(checkDate) && progress < 21) {
        progress++
        const d = new Date(checkDate + 'T00:00:00+08:00')
        d.setDate(d.getDate() - 1)
        checkDate = d.toISOString().slice(0, 10)
      }
      const el = document.getElementById('streak-rewiring')
      if (el) el.textContent = `${progress}/21`
    } catch {}
  }

  loadToday()
</script>
