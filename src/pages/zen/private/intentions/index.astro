---
/**
 * Chamber of Intentions — write, validate, save.
 * SSR page with client-side 5 Ps validation. Dark terminal aesthetic.
 */
import Bare from '../../../../layouts/Bare.astro'
import PrivateNav from '../../../../components/private/PrivateNav.astro'
import IntentionOverlay from '../../../../components/private/IntentionOverlay.astro'
import Icon from '../../../../components/ui/Icon.astro'
import { listMds, readEntry } from '../../../../lib/content'
import { sessionOk } from '../../../../lib/auth'

export const prerender = false

// Auth gate — the zen session cookie must be present (passkey session).
if (!sessionOk(Astro.request)) {
  return Astro.redirect('/zen')
}

// Load saved intentions for the overlay
let intentions: { date: string; time?: string | null; text: string; file: string }[] = []
try {
  const files = listMds('intentions').sort().reverse()
  intentions = files.map(f => {
    const entry = readEntry('intentions', f)
    return {
      file: f,
      date: String(entry.data.date ?? ''),
      time: typeof entry.data.time === 'string' ? entry.data.time : null,
      text: entry.body?.trim() ?? '',
    }
  }).filter(i => i.text.length > 0)
} catch {}
---

<Bare title="intentions — private — 1ed.ge">
  <section class="shell pt-12 pb-32">
    <!-- Header -->
    <div class="mx-auto max-w-2xl">
      <div class="text-2xs uppercase tracking-widest text-accent">step two</div>
      <h1 class="mt-2 text-2xl font-semibold text-ink">Chamber of Intentions</h1>
      <p class="mt-2 text-sm text-dim">
        The 5 Ps: Personal · Positive · Powerful · Present · Private.
      </p>
    </div>

    <!-- Textarea -->
    <div class="mx-auto mt-8 max-w-2xl">
      <textarea
        id="intention-text"
        class="w-full min-h-[160px] rounded-lg border border-line bg-raise p-4 text-base text-ink placeholder:text-faint focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent/30 resize-none"
        placeholder="I am…"
        aria-label="Write your intention"
      ></textarea>
    </div>

    <!-- 5 Ps checklist -->
    <div class="mx-auto mt-6 max-w-2xl flex flex-col gap-3" id="ps-checklist">
      <!-- P1 Personal -->
      <div class="flex items-start gap-3 rounded-lg border border-line bg-raise/50 p-3" data-p="1">
        <div class="mt-0.5 h-5 w-5 shrink-0 rounded-full border-2 border-line flex items-center justify-center transition-colors" data-p-indicator="1">
          <div class="h-2.5 w-2.5 rounded-full bg-accent opacity-0 transition-opacity" data-p-fill="1"></div>
        </div>
        <div>
          <div class="text-sm font-semibold text-ink">Personal</div>
          <div class="text-xs text-dim">Begin with "I" — a declaration of self.</div>
        </div>
      </div>

      <!-- P2 Positive -->
      <div class="flex items-start gap-3 rounded-lg border border-line bg-raise/50 p-3" data-p="2">
        <div class="mt-0.5 h-5 w-5 shrink-0 rounded-full border-2 border-line flex items-center justify-center transition-colors" data-p-indicator="2">
          <div class="h-2.5 w-2.5 rounded-full bg-accent opacity-0 transition-opacity" data-p-fill="2"></div>
        </div>
        <div>
          <div class="text-sm font-semibold text-ink">Positive</div>
          <div class="text-xs text-dim">In favor of what you want, never against what you fear.</div>
        </div>
      </div>

      <!-- P3 Powerful -->
      <div class="flex items-start gap-3 rounded-lg border border-line bg-raise/50 p-3" data-p="3">
        <div class="mt-0.5 h-5 w-5 shrink-0 rounded-full border-2 border-line flex items-center justify-center transition-colors" data-p-indicator="3">
          <div class="h-2.5 w-2.5 rounded-full bg-accent opacity-0 transition-opacity" data-p-fill="3"></div>
        </div>
        <div>
          <div class="text-sm font-semibold text-ink">Powerful</div>
          <div class="text-xs text-dim">Stir awe — use vibrant, luminous words.</div>
        </div>
      </div>

      <!-- P4 Present -->
      <div class="flex items-start gap-3 rounded-lg border border-line bg-raise/50 p-3" data-p="4">
        <div class="mt-0.5 h-5 w-5 shrink-0 rounded-full border-2 border-line flex items-center justify-center transition-colors" data-p-indicator="4">
          <div class="h-2.5 w-2.5 rounded-full bg-accent opacity-0 transition-opacity" data-p-fill="4"></div>
        </div>
        <div>
          <div class="text-sm font-semibold text-ink">Present</div>
          <div class="text-xs text-dim">Written as if it has already come to pass.</div>
        </div>
      </div>

      <!-- P5 Private (locked) -->
      <div class="flex items-start gap-3 rounded-lg border border-accent/30 bg-accent/5 p-3" data-p="5">
        <div class="mt-0.5 h-5 w-5 shrink-0 flex items-center justify-center text-accent">
          <Icon name="lock" size={16} />
        </div>
        <div>
          <div class="text-sm font-semibold text-ink">Private</div>
          <div class="text-xs text-dim">Share this with no one — to protect its energy.</div>
        </div>
      </div>
    </div>

    <!-- Buttons -->
    <div class="mx-auto mt-8 max-w-2xl flex flex-col gap-3">
      <button
        id="save-intention-btn"
        class="flex w-full items-center justify-center gap-2 rounded-full bg-line px-6 py-3.5 text-sm font-medium text-dim transition-colors cursor-not-allowed min-h-[48px]"
        disabled
      >
        <Icon name="lock" size={16} />
        <span class="uppercase tracking-widest text-2xs">Save with Serenity</span>
      </button>

      <button
        id="read-intentions-btn"
        class="flex w-full items-center justify-center gap-2 rounded-full border border-line bg-transparent px-6 py-3.5 text-sm font-medium text-ink transition-colors hover:border-accent/50 min-h-[48px]"
      >
        <Icon name="book-open" size={16} />
        <span class="uppercase tracking-widest text-2xs">Read My Intentions</span>
      </button>
    </div>
  </section>

  <PrivateNav active="intentions" />
  <IntentionOverlay intentions={intentions} />
</Bare>

<script>
  // ── 5 Ps Auto-Validation (stemming + fuzzy + contractions) ──────────────────
  const textarea = document.getElementById('intention-text') as HTMLTextAreaElement
  const saveBtn = document.getElementById('save-intention-btn') as HTMLButtonElement
  const fills: Record<number, HTMLElement> = {}
  const indicators: Record<number, HTMLElement> = {}
  for (let i = 1; i <= 4; i++) {
    const fill = document.querySelector<HTMLElement>(`[data-p-fill="${i}"]`)
    const indicator = document.querySelector<HTMLElement>(`[data-p-indicator="${i}"]`)
    if (fill) fills[i] = fill
    if (indicator) indicators[i] = indicator
  }

  // ── Stemmer (conservative — only strip listed suffixes from words ≥5 chars) ─
  const STEM_SUFFIX = /(?:tion|ment|ness|ful|less|able|ous|ive|ize|ly|ing|ed)$/
  function stem(word: string): string {
    const w = word.toLowerCase()
    if (w.length < 5) return w // never stem words ≤4 chars
    return w.replace(STEM_SUFFIX, '') || w
  }

  // ── Levenshtein distance ──────────────────────────────────────────────────
  function lev(a: string, b: string): number {
    if (a === b) return 0
    if (!a.length) return b.length
    if (!b.length) return a.length
    const matrix: number[][] = []
    for (let i = 0; i <= b.length; i++) matrix[i] = [i]
    for (let j = 0; j <= a.length; j++) matrix[0][j] = j
    for (let i = 1; i <= b.length; i++) {
      for (let j = 1; j <= a.length; j++) {
        const cost = b[i - 1] === a[j - 1] ? 0 : 1
        matrix[i][j] = Math.min(matrix[i - 1][j] + 1, matrix[i][j - 1] + 1, matrix[i - 1][j - 1] + cost)
      }
    }
    return matrix[b.length][a.length]
  }

  // ── Word sets — targets pre-stemmed so input stems match exactly ───────────
  // P1: verbs showing personal agency (am/be/is are NOT agency verbs)
  const P1_VERBS = new Set([
    'have', 'live', 'get', 'create', 'attract', 'manifest', 'choose', 'welcome',
    'embrace', 'carry', 'hold', 'embody', 'exist', 'breathe', 'feel', 'know', 'see',
    'walk', 'run', 'speak', 'write', 'build', 'grow', 'rise', 'shine', 'stand', 'believe',
    'receive', 'give', 'share', 'move', 'act', 'decide', 'commit', 'dedicate', 'devote',
  ].map(stem))

  // P2: negation words — checked EXACT on raw tokens (no stemming, no fuzzy)
  const NEGATIONS = new Set([
    'not', 'never', 'no', 'hardly', 'barely', 'scarcely', 'nobody', 'nothing', 'nowhere',
    'neither', 'nor', 'cannot', 'cant', 'dont', 'wont',
  ])

  // P3: power/awe words — must be PRESENT in the text
  const P3_POWER = new Set([
    'master', 'universe', 'desire', 'abundant', 'powerful', 'magnificent',
    'extraordinary', 'thrive', 'flourish', 'radiate', 'limitless', 'boundless',
    'supreme', 'divine', 'blessed', 'grateful', 'joyful', 'peaceful', 'serene',
    'confident', 'unstoppable', 'luminous', 'vibrant', 'inspire', 'grace', 'courage',
    'strength', 'wisdom', 'clarity', 'resilient', 'fearless', 'glorious', 'triumphant',
    'sovereign', 'majestic', 'transcend', 'illuminate', 'phenomenal', 'invincible',
  ].map(stem))

  // P4: present-tense self-declaration verbs
  const P4_DECLARATIONS = new Set([
    'am', 'have', 'live', 'exist', 'breathe', 'feel', 'know', 'see',
    'walk', 'stand', 'rise', 'shine', 'carry', 'hold', 'embody', 'believe',
    'receive', 'create', 'attract', 'manifest', 'choose', 'embrace',
  ].map(stem))

  // Stop words — "substantive" = anything beyond these
  const STOP_WORDS = new Set([
    'i', 'am', 'a', 'the', 'my', 'me', 'is', 'be', 'and', 'or', 'but',
    'in', 'on', 'at', 'to', 'for', 'of', 'with', 'it',
  ])

  // ── Contraction expansion ─────────────────────────────────────────────────
  // Apostrophe-optional only where the typo cannot collide with a real word
  // ("ill" = sick, "id" = Freud — those keep the apostrophe requirement).
  const EXPANSIONS: [RegExp, string][] = [
    [/\bi['\u2019]?m\b/g, 'i am'],
    [/\bi['\u2019]?ve\b/g, 'i have'],
    [/\bi['\u2019]ll\b/g, 'i will'],
    [/\bi['\u2019]d\b/g, 'i would'],
    [/\bdon['\u2019]?t\b/g, 'do not'],
    [/\bcan['\u2019]?t\b/g, 'can not'],
    [/\bwon['\u2019]?t\b/g, 'will not'],
    [/\bis['\u2019]?nt\b/g, 'is not'],
    [/\baren['\u2019]?t\b/g, 'are not'],
    [/\bwas['\u2019]?nt\b/g, 'was not'],
    [/\bweren['\u2019]?t\b/g, 'were not'],
    [/\bshould['\u2019]?nt\b/g, 'should not'],
    [/\bwould['\u2019]?nt\b/g, 'would not'],
    [/\bcould['\u2019]?nt\b/g, 'could not'],
    [/\bdid['\u2019]?nt\b/g, 'did not'],
    [/\bdoes['\u2019]?nt\b/g, 'does not'],
    [/\bhave['\u2019]?nt\b/g, 'have not'],
    [/\bhas['\u2019]?nt\b/g, 'has not'],
    [/\bhad['\u2019]?nt\b/g, 'had not'],
  ]

  function tokenize(text: string): string[] {
    let s = text.toLowerCase()
    for (const [re, rep] of EXPANSIONS) s = s.replace(re, rep)
    return s.replace(/[^a-z\s]/g, ' ').split(/\s+/).filter(w => w.length > 0)
  }

  // ── Fuzzy match — adaptive distance by word length ────────────────────────
  // ≤4 chars: exact match only (no fuzzy). 5-6 chars: distance ≤1. 7+: ≤2.
  // Words ≤3 chars are never fuzzy-matched (exact matching still allowed).
  function fuzzyMatch(word: string, targets: Set<string>): boolean {
    const w = stem(word)
    if (targets.has(w)) return true
    if (w.length <= 4) return false
    const maxDist = w.length <= 6 ? 1 : 2
    for (const target of targets) {
      if (lev(w, target) <= maxDist) return true
    }
    return false
  }

  // ── Validation checks ─────────────────────────────────────────────────────
  function substantiveTokens(tokens: string[]): string[] {
    return tokens.filter(t => !STOP_WORDS.has(t))
  }

  function checkP1(tokens: string[]): boolean {
    // Must start with "I" + ≥2 substantive words + an agency verb
    if (tokens[0] !== 'i') return false
    const substantive = substantiveTokens(tokens)
    if (substantive.length < 2) return false
    return substantive.some(t => fuzzyMatch(t, P1_VERBS))
  }

  function checkP2(tokens: string[]): boolean {
    // Must actually declare something, and contain no negation words
    if (substantiveTokens(tokens).length < 1) return false
    return !tokens.some(t => NEGATIONS.has(t))
  }

  function checkP3(tokens: string[]): boolean {
    // Must contain at least one power word
    return tokens.some(t => fuzzyMatch(t, P3_POWER))
  }

  function checkP4(tokens: string[]): boolean {
    // Must declare something, and contain a self-declaration verb
    if (substantiveTokens(tokens).length < 1) return false
    return tokens.some(t => fuzzyMatch(t, P4_DECLARATIONS))
  }

  // ── Button rendering ──────────────────────────────────────────────────────
  const BTN_CLASS = 'flex w-full items-center justify-center gap-2 rounded-full px-6 py-3.5 text-sm font-medium min-h-[48px] transition-colors'
  const BTN_ENABLED = `${BTN_CLASS} bg-accent text-bg cursor-pointer`
  const BTN_DISABLED = `${BTN_CLASS} bg-line text-dim cursor-not-allowed`

  function renderSaveButton(enabled: boolean) {
    saveBtn.disabled = !enabled
    saveBtn.className = enabled ? BTN_ENABLED : BTN_DISABLED
  }

  function validate() {
    const text = textarea.value.trim()
    const tokens = tokenize(text)
    const results: Record<number, boolean> = {
      1: text.length > 0 && checkP1(tokens),
      2: text.length > 0 && checkP2(tokens),
      3: text.length > 0 && checkP3(tokens),
      4: text.length > 0 && checkP4(tokens),
      5: true, // always satisfied
    }

    // Update indicators (P5 is a static lock — nothing to light up)
    for (let i = 1; i <= 4; i++) {
      const ok = results[i]
      if (fills[i]) fills[i].style.opacity = ok ? '1' : '0'
      if (indicators[i]) indicators[i].style.borderColor = ok ? 'var(--color-accent)' : 'var(--color-line)'
    }

    // Enable only when all 5 Ps hold AND the intention has real length
    const allSatisfied = Object.values(results).every(Boolean) && text.length > 20
    renderSaveButton(allSatisfied)
  }

  textarea.addEventListener('input', validate)
  validate()

  // ── Save intention ────────────────────────────────────────────────────────
  saveBtn.addEventListener('click', async () => {
    const text = textarea.value.trim()
    if (!text || saveBtn.disabled) return

    saveBtn.disabled = true
    saveBtn.textContent = 'Saving…'

    try {
      const resp = await fetch('/api/admin/intentions', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text }),
      })
      const data = await resp.json().catch(() => null)
      if (data && data.ok) {
        textarea.value = ''
        validate()
        saveBtn.className = BTN_ENABLED
        saveBtn.innerHTML = '<span class="uppercase tracking-widest text-2xs">\u2713 Saved</span>'
        setTimeout(() => {
          saveBtn.textContent = 'Save with Serenity'
          validate()
        }, 2000)
      } else {
        flashSaveError()
      }
    } catch {
      flashSaveError()
    }
  })

  function flashSaveError() {
    saveBtn.textContent = 'Error — try again'
    setTimeout(() => validate(), 2000)
  }
</script>
