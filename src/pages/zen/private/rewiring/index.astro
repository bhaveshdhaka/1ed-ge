---
/**
 * Re-wiring — 21-day neural map, calendar sync (.ics), milestones.
 * Auth-gated. Private aesthetic. The neural map is the showpiece.
 */
import Bare from '../../../../layouts/Bare.astro'
import PrivateNav from '../../../../components/private/PrivateNav.astro'
import PrivateStep from '../../../../components/private/PrivateStep.astro'
import Icon from '../../../../components/ui/Icon.astro'
import { sessionOk } from '../../../../lib/auth'

export const prerender = false

if (!sessionOk(Astro.request)) {
  return Astro.redirect('/zen')
}

// 21 nodes on a single soft sine wave
const W = 680
const MID = 100
const AMP = 46
const nodes = Array.from({ length: 21 }, (_, i) => {
  const x = 26 + (i / 20) * (W - 52)
  const y = MID + Math.sin((i / 20) * Math.PI * 2) * AMP
  return { i, x: Math.round(x), y: Math.round(y) }
})
const pathD = nodes.map((n) => `${n.i === 0 ? 'M' : 'L'}${n.x},${n.y}`).join(' ')
const A = '#0af'
---

<Bare title="re-wiring — private — 1ed.ge">
  <section class="shell pt-12 pb-32">
    <PrivateStep
      step="neural map"
      title="Re-wiring in progress"
      desc="Each 20-minute Threshold lights a node and draws a filament of energy toward the day before. Twenty-one days to root new neural pathways."
    />

    <!-- Neural map -->
    <div class="mx-auto mt-8 max-w-2xl">
      <div class="panel-hero overflow-hidden">
        <div class="card-hd">
          <div class="card-ico"><Icon name="activity" size={15} /></div>
          <div class="card-lbl">Neural Integration</div>
          <div id="rw-days" class="tmr">0 / 21</div>
        </div>
        <div class="relative p-3">
          <div class="pointer-events-none absolute inset-0 opacity-60" style={`background: radial-gradient(60% 60% at 50% 30%, ${A}22, transparent 70%)`}></div>
          <svg id="rw-map" viewBox={`0 0 ${W} 200`} class="relative w-full h-auto" role="img" aria-label="21-day neural integration map" xmlns:xlink="http://www.w3.org/1999/xlink">
            <defs>
              <linearGradient id="rwGrad" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color={A} stop-opacity="0.2" />
                <stop offset="50%" stop-color={A} />
                <stop offset="100%" stop-color={A} stop-opacity="0.2" />
              </linearGradient>
              <radialGradient id="rwNode">
                <stop offset="0%" stop-color={A} />
                <stop offset="100%" stop-color={`${A}33`} />
              </radialGradient>
              <filter id="rwGlow" x="-60%" y="-60%" width="220%" height="220%">
                <feGaussianBlur stdDeviation="3.2" result="b" />
                <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
              </filter>
            </defs>

            <!-- base path -->
            <path d={pathD} fill="none" stroke="var(--color-line)" stroke-width="1.4" stroke-dasharray="2 5" />
            <!-- lit filament -->
            <path id="rw-lit" d={pathD} fill="none" stroke="url(#rwGrad)" stroke-width="2.4" pathLength="100" stroke-dasharray="0 100" stroke-linecap="round" filter="url(#rwGlow)" />
            <!-- traveling energy pulse -->
            <circle id="rw-pulse" r="3.4" fill={A} filter="url(#rwGlow)" opacity="0">
              <animateMotion id="rw-motion" dur="5s" repeatCount="indefinite">
                <mpath xlink:href="#rw-lit" />
              </animateMotion>
            </circle>
            <!-- newest node ring -->
            <circle id="rw-now" class="rw-now-ring" r="8" cx="-10" cy="-10" fill="none" stroke={A} stroke-width="1.6" opacity="0" />

            {nodes.map((n) => (
              <circle id={`rw-node-${n.i}`} cx={n.x} cy={n.y} r="6.5" class="rw-node" data-i={n.i} />
            ))}
          </svg>
        </div>
      </div>
    </div>

    <!-- Appointment with the Self -->
    <div class="mx-auto mt-6 max-w-2xl">
      <div class="panel">
        <div class="card-hd">
          <div class="card-ico"><Icon name="calendar" size={15} /></div>
          <div class="card-lbl">Appointment with the Self</div>
        </div>
        <div class="p-5">
          <p class="text-sm text-dim leading-relaxed">
            Treat your 20 minutes as a formal business appointment with the subconscious. Block them every day.
          </p>
          <a href="/private/rewiring-appointment.ics" download class="btn btn-primary mt-4 min-h-[48px] w-full justify-center text-sm">
            <Icon name="calendar" size={15} /> Apple · .ics
          </a>
        </div>
      </div>
    </div>

    <!-- Reinforcement -->
    <div class="mx-auto mt-6 max-w-2xl">
      <div class="panel">
        <div class="card-hd">
          <div class="card-ico"><Icon name="bell" size={15} /></div>
          <div class="card-lbl">Re-wiring milestones</div>
        </div>
        <div class="p-5">
          <p class="text-sm text-dim leading-relaxed">
            You'll be notified when crossing days 7, 14, and 21 — as the neural roots take hold.
          </p>
          <button id="rw-alerts" class="btn mt-4 min-h-[48px] w-full justify-center text-sm">
            <Icon name="bell" size={15} /> enable alerts
          </button>
          <p id="rw-alert-status" class="mt-2 text-center text-2xs uppercase tracking-widest text-faint"></p>
        </div>
      </div>
    </div>
  </section>

  <PrivateNav active="rewiring" />
</Bare>

<style>
  .rw-node {
    fill: rgba(255, 255, 255, 0.05);
    stroke: var(--color-line);
    stroke-width: 1.6;
    transition: fill 0.5s var(--ease-out), stroke 0.5s var(--ease-out);
  }
  .rw-node.lit {
    fill: url(#rwNode);
    stroke: #0af;
    filter: url(#rwGlow);
  }
  .rw-now-ring {
    transform-box: fill-box;
    transform-origin: center;
    animation: rwPulse 2.6s ease-out infinite;
  }
  @keyframes rwPulse {
    0%   { r: 8;  opacity: 0.7; }
    70%  { r: 24; opacity: 0; }
    100% { r: 24; opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .rw-now-ring { animation: none; }
    #rw-motion { display: none; }
  }
</style>

<script>
  const daysEl = document.getElementById('rw-days') as HTMLDivElement
  const alertBtn = document.getElementById('rw-alerts') as HTMLButtonElement
  const alertStatus = document.getElementById('rw-alert-status') as HTMLParagraphElement
  const lit = document.querySelector('#rw-lit') as SVGPathElement
  const pulse = document.querySelector('#rw-pulse') as SVGCircleElement
  const nowRing = document.querySelector('#rw-now') as SVGCircleElement
  const milestones = [7, 14, 21]

  const todayKey = (d = new Date()) => d.toISOString().slice(0, 10)

  function nodeXY(i: number): { x: number; y: number } {
    const svg = document.getElementById('rw-map')!
    const c = svg.querySelector<SVGCircleElement>(`#rw-node-${i}`)
    return { x: Number(c?.getAttribute('cx')), y: Number(c?.getAttribute('cy')) }
  }

  function paint(progress: number) {
    daysEl.textContent = `${progress} / 21`
    for (let i = 0; i < 21; i++) {
      const c = document.querySelector(`#rw-node-${i}`) as SVGCircleElement | null
      if (!c) continue
      c.classList.toggle('lit', i < progress)
    }
    lit.setAttribute('stroke-dasharray', `${(progress / 21) * 100} 100`)
    if (progress > 0) {
      const { x, y } = nodeXY(progress - 1)
      nowRing.setAttribute('cx', String(x))
      nowRing.setAttribute('cy', String(y))
      nowRing.setAttribute('opacity', '1')
      pulse.setAttribute('opacity', '1')
    } else {
      nowRing.setAttribute('opacity', '0')
      pulse.setAttribute('opacity', '0')
    }
    const hit = milestones.filter((m) => progress >= m)
    if (hit.length && progress === hit[hit.length - 1]) flash(`milestone · day ${hit[hit.length - 1]} reached`)
  }

  function flash(msg: string) {
    if (!('Notification' in window)) return
    if (Notification.permission === 'granted') new Notification('Re-wiring', { body: msg })
  }

  function load() {
    fetch('/api/admin/private/rewiring').then((r) => r.json()).then((d) => {
      const recs = (d.records ?? []) as { data: { date?: string } }[]
      const dates = new Set(recs.map((r) => (r.data.date ?? '').slice(0, 10)).filter(Boolean).sort())
      let progress = 0
      let cursor = new Date()
      while (dates.has(todayKey(cursor)) && progress < 21) { progress++; cursor.setDate(cursor.getDate() - 1) }
      paint(progress)
    }).catch(() => paint(0))
  }

  alertBtn.addEventListener('click', () => {
    if (!('Notification' in window)) { alertStatus.textContent = 'not supported'; return }
    Notification.requestPermission().then((p) => {
      alertStatus.textContent = p === 'granted' ? 'alerts enabled' : 'alerts blocked'
    })
  })

  load()
</script>
