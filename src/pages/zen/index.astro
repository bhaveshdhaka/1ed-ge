---
export const prerender = false
import Bare from '../../layouts/Bare.astro'
import AdminApp from '../../components/admin/AdminApp'
import LoginScreen from '../../components/admin/LoginScreen'
import MarketWidget from '../../components/MarketWidget.astro'
import MarketDay from '../../components/MarketDay.astro'
import { sessionOk } from '../../lib/auth'

const authed = sessionOk(Astro.request)
const manifestHref = '/zen/manifest.webmanifest'
---

<Bare title={authed ? 'admin — 1ed.ge' : 'admin sign in'} manifest={manifestHref}>
  {authed ? (
    <AdminApp client:only="react" />
  ) : (
    <LoginScreen client:only="react" />
  )}
  <footer class="shell pb-20 pt-10">
    <div class="flex flex-col gap-4">
      <MarketWidget />
      <MarketDay />
    </div>
  </footer>
</Bare>
