---
export const prerender = false
import Bare from '../../../layouts/Bare.astro'
import Card from '../../../components/ui/Card.astro'
import Tag from '../../../components/ui/Tag.astro'
import { sessionOk } from '../../../lib/auth'
import { readEntry, listMds } from '../../../lib/content'
import { renderMarkdown } from '../../../lib/markdown'
import { fmtDay } from '../../../lib/dates'
import { DEFAULT_HABIT_COLOR } from '../../../lib/constants'

const { date } = Astro.params
const ok = sessionOk(Astro.request) && /^\d{4}-\d{2}-\d{2}$/.test(date ?? '')
if (!ok) {
  Astro.response.status = 404
}

let day: Record<string, unknown> | null = null
let journal: { data: Record<string, unknown>; content: string } | null = null
let html = ''
if (ok) {
  if (listMds('days').includes(`${date}.md`)) {
    day = readEntry('days', `${date}.md`).data as Record<string, unknown>
  }
  if (listMds('journal').includes(`${date}.mdx`)) {
    const e = readEntry('journal', `${date}.mdx`)
    journal = { data: e.data as Record<string, unknown>, content: e.content }
    html = await renderMarkdown(e.content)
  }
}

const d: any = day ?? {}
const trades = Array.isArray(d.trades) ? d.trades : []
const sumR = trades.reduce((s: number, t: any) => s + (t.points / (t.riskPoints ?? (t.stop !== undefined ? Math.abs(t.entry - t.stop) : 1))), 0)
const totalPts = trades.reduce((s: number, t: any) => s + t.points, 0)
const habitDefs = listMds('habits').map((f) => {
  const h = readEntry('habits', f).data as Record<string, unknown>
  return { id: f.replace(/\.md$/, ''), name: h.name ?? f, emoji: h.emoji ?? '', color: h.color ?? DEFAULT_HABIT_COLOR }
})
const dayHabits = (d.habits ?? {}) as Record<string, boolean>
const accountList = listMds('accounts').map((f) => {
  const a = readEntry('accounts', f).data as Record<string, unknown>
  return { id: a.id ?? f, firm: a.firm ?? '', sizeLabel: a.sizeLabel ?? '', pointsValue: Number(a.pointsValue ?? 2) }
})
const accMap = new Map(accountList.map((a) => [a.id, a]))
---

<Bare title={`preview ${date} — 1ed.ge admin`}>
  {!ok ? (
    <div class="shell py-24 text-sm text-faint">404 — not found</div>
  ) : (
    <article class="shell max-w-4xl pt-safe-10 pb-20">
      <div class="mb-8 flex flex-wrap items-center justify-between gap-3 border border-accent/40 bg-accent/5 px-4 py-2 text-xs text-accent">
        <span>preview — saved but not yet published (pending rebuild)</span>
        <a href={`/day/${fmtDay(date!)}`} target="_blank" class="underline underline-offset-4 hover:text-ink">live page →</a>
      </div>

      <header class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
        <h1 class="text-2xl">day {date}</h1>
        <span class="text-sm text-dim">
          {trades.length} trades · {sumR > 0 ? '+' : ''}{sumR.toFixed(2)}R · {totalPts >= 0 ? '+' : ''}{totalPts}pts
        </span>
      </header>

      <div class="mt-8 grid gap-px border border-line bg-line sm:grid-cols-4">
        <div class="bg-bg p-4">
          <div class="text-3xs uppercase tracking-widest text-dim">mood</div>
          <div class="mt-1 text-lg">{d.mood ? `${d.mood}/5` : '—'}</div>
        </div>
        <div class="bg-bg p-4">
          <div class="text-3xs uppercase tracking-widest text-dim">sleep</div>
          <div class="mt-1 text-lg">{d.sleep?.hours !== undefined ? `${d.sleep.hours}h` : '—'}</div>
          <div class="text-2xs text-faint">quality {d.sleep?.quality ?? '—'}/5</div>
        </div>
        <div class="bg-bg p-4">
          <div class="text-3xs uppercase tracking-widest text-dim">phone screen</div>
          <div class="mt-1 text-lg">{d.device?.iphoneHours !== undefined ? `${d.device.iphoneHours}h` : '—'}</div>
          <div class="text-2xs text-faint">{d.device?.socialHours !== undefined ? `social ${d.device.socialHours}h` : ''}</div>
        </div>
        <div class="bg-bg p-4">
          <div class="text-3xs uppercase tracking-widest text-dim">mac</div>
          <div class="mt-1 text-lg">{d.device?.macHours !== undefined ? `${d.device.macHours}h` : '—'}</div>
        </div>
      </div>

      <div class="mt-10">
        <h2 class="text-lg">/ habits</h2>
        <div class="mt-3 flex flex-wrap gap-2">
          {habitDefs.map((h) => {
            const done = dayHabits[h.id] === true
            return (
              <span class="flex items-center gap-2 border px-3 py-1.5 text-sm" style={done ? `border-color:${h.color};color:${h.color}` : 'border-color:var(--color-line);color:var(--color-dim)'}>
                {h.emoji ?? '·'} {h.name} {done ? '✓' : '×'}
              </span>
            )
          })}
        </div>
      </div>

      {d.device && (d.device.screenshots?.length ?? 0) > 0 && (
        <div class="mt-10">
          <h2 class="text-lg">/ screen time — proof</h2>
          <p class="mt-2 text-sm text-dim">{d.device.notes ?? 'no note'}</p>
          <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2">
            {d.device.screenshots.map((s: string) => (
              <a href={s} target="_blank" class="block border border-line bg-panel">
                <img src={s} alt="screen time screenshot" loading="lazy" class="w-full" />
              </a>
            ))}
          </div>
        </div>
      )}

      <div class="mt-10">
        <h2 class="text-lg">/ trades</h2>
        {trades.length === 0 ? (
          <p class="mt-3 text-sm text-faint">no trades logged this day.</p>
        ) : (
          <div class="mt-4 space-y-4">
            {trades.map((t: any, i: number) => {
              const risk = t.riskPoints ?? (t.stop !== undefined ? Math.abs(t.entry - t.stop) : 1)
              const R = t.points / risk
              const ex = t.executions ?? []
              const totalPnl = ex.reduce((s: number, e: any) => s + t.points * (accMap.get(e.account)?.pointsValue ?? 2) * (e.size ?? 1), 0)
              return (
                <Card pad="md">
                  <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                    <span class="text-base text-ink">{t.direction === 'long' ? '▲' : '▼'} {t.market}</span>
                    <span class="text-xs text-dim">{t.session ?? '—'} · {t.setup ?? 'no setup'}</span>
                    <span class={`ml-auto text-base ${R > 0 ? 'text-up' : R < 0 ? 'text-down' : ''}`}>{R > 0 ? '+' : ''}{R.toFixed(2)}R</span>
                    <span class={`text-sm ${totalPnl >= 0 ? 'text-up' : 'text-down'}`}>{totalPnl >= 0 ? '+' : ''}${totalPnl.toLocaleString()}</span>
                  </div>
                  <div class="mt-2 grid grid-cols-2 gap-x-6 gap-y-1 text-xs text-dim md:grid-cols-4">
                    <span>entry <span class="text-ink">{t.entry}</span></span>
                    <span>exit <span class="text-ink">{t.exit}</span></span>
                    <span>stop <span class="text-ink">{t.stop ?? '—'}</span></span>
                    <span>points <span class={t.points >= 0 ? 'text-up' : 'text-down'}>{t.points >= 0 ? '+' : ''}{t.points}</span></span>
                  </div>
                  {ex.length > 0 && (
                    <div class="mt-2 text-xs text-dim">
                      accounts: {ex.map((e: any) => { const a = accMap.get(e.account); return `${a?.firm ?? ''} ${a?.sizeLabel ?? ''}${e.size && e.size > 1 ? ` ×${e.size}` : ''}` }).join(' · ')}
                    </div>
                  )}
                  {(t.screenshots?.length ?? 0) > 0 && (
                    <div class="mt-3 grid grid-cols-2 gap-3 md:grid-cols-4">
                      {t.screenshots.map((s: string) => (
                        <a href={s} target="_blank" class="block border border-line bg-bg">
                          <img src={s} alt={`trade ${i + 1} screenshot`} loading="lazy" class="w-full" />
                        </a>
                      ))}
                    </div>
                  )}
                </Card>
              )
            })}
          </div>
        )}
      </div>

      <div class="mt-12">
        <h2 class="text-lg">/ reflection</h2>
        {journal ? (
          <>
            <div class="mt-3 flex flex-wrap items-center gap-3 text-xs text-dim">
              {journal.data.day && <span class="text-ink">{journal.data.day}</span>}
              <span>{journal.data.date}</span>
              {(journal.data.tags as string[] ?? []).map((t) => <Tag>#{t}</Tag>)}
            </div>
            {journal.data.summary && <p class="mt-2 text-sm text-dim">{journal.data.summary}</p>}
            <div class="prose mt-6" set:html={html} />
          </>
        ) : (
          <p class="mt-3 text-sm text-faint">no reflection saved for this day.</p>
        )}
      </div>
    </article>
  )}
</Bare>
