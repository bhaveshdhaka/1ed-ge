---
// Old private-area path — thin SSR redirect to the zen mount, so old
// bookmarks still work. A wrong secret 404s like the zen page itself.
export const prerender = false
import { env } from '../../../lib/env'

const { secret } = Astro.params
if (secret !== env.adminSecret()) {
  Astro.response.status = 404
} else {
  return Astro.redirect(`/zen/${secret}`)
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 — not found</title>
  </head>
  <body style="font-family: ui-monospace, monospace; background: #0a0a0c; color: #8b8b93; padding: 6rem 1rem; text-align: center">
    404 — not found
  </body>
</html>
