---
export const prerender = false
import Bare from '../../../../../layouts/Bare.astro'
import Brand from '../../../../../components/Brand.astro'
import { env } from '../../../../../lib/env'
import { THEMES } from '../../../../../lib/site'

const { secret, name } = Astro.params
const ok = secret === env.adminSecret() && (THEMES as readonly string[]).includes(name ?? '')
if (!ok) {
  Astro.response.status = 404
}
---

<Bare title={`theme ${name} — preview`} theme={ok ? name : undefined}>
  {!ok ? (
    <div class="shell py-24 text-[13px] text-faint">404 — not found</div>
  ) : (
    <div class="shell flex min-h-screen flex-col py-10">
      <div class="flex items-center justify-between">
        <Brand theme={ok ? name : undefined} />
        <span class="text-[12px] text-faint">theme preview — {name}</span>
      </div>
      <div class="hero-fade mt-auto mb-auto max-w-md pt-24 pb-16">
        <p class="text-[12px] text-dim">
          <span class="text-faint">$</span> whoami
        </p>
        <h1 class="mt-4 text-3xl leading-tight" style="color:var(--color-ink)">
          the edge is all we need.
        </h1>
        <p class="mt-4 text-[13px] leading-relaxed" style="color:var(--color-soft)">
          a two-year public experiment — every trade, every account, every R. this is how the
          site re-skins when you apply this theme.
        </p>
        <div class="mt-8 flex gap-px border border-line bg-line">
          <div class="flex-1 p-3" style="background:var(--color-bg)">
            <div class="text-[9px] uppercase tracking-widest" style="color:var(--color-dim)">cumulative R</div>
            <div class="mt-1 text-[15px]" style="color:var(--color-accent)">+12.40R</div>
          </div>
          <div class="flex-1 p-3" style="background:var(--color-bg)">
            <div class="text-[9px] uppercase tracking-widest" style="color:var(--color-dim)">win rate</div>
            <div class="mt-1 text-[15px]" style="color:var(--color-ink)">64%</div>
          </div>
          <div class="flex-1 p-3" style="background:var(--color-bg)">
            <div class="text-[9px] uppercase tracking-widest" style="color:var(--color-dim)">trades</div>
            <div class="mt-1 text-[15px]" style="color:var(--color-up)">38</div>
          </div>
        </div>
      </div>
    </div>
  )}
</Bare>
