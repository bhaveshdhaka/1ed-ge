---
import Base from '../../layouts/Base.astro'
import { getCollection } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import { fmtDay } from '../../lib/dates'

const journal = (await getCollection('journal')).sort((a, b) => b.data.date.localeCompare(a.data.date))
const days = await getCollection('days')
const dayByDate = new Map(days.map((d) => [d.data.date, d.data]))

const monthLabel = (m: string) => {
  const [y, mo] = m.split('-')
  const names = ['jan', 'feb', 'mar', 'apr', 'may', 'jun', 'jul', 'aug', 'sep', 'oct', 'nov', 'dec']
  return `${names[parseInt(mo, 10) - 1]} ${y}`
}

const dayText = (d: CollectionEntry<'days'>['data'] | undefined) => {
  if (!d) return ''
  const p: string[] = []
  if (d.mood) p.push(`mood ${d.mood}/5`)
  if (d.sleep?.hours !== undefined) p.push(`sleep ${d.sleep.hours}h quality ${d.sleep.quality ?? ''}/5`)
  if (d.device) {
    p.push(`phone screen ${d.device.iphoneHours ?? ''}h social ${d.device.socialHours ?? ''}h mac ${d.device.macHours ?? ''}h`)
    if (d.device.notes) p.push(d.device.notes)
  }
  for (const t of d.trades ?? []) {
    p.push(`${t.market} ${t.direction} ${t.session ?? ''} ${t.setup ?? ''} entry ${t.entry} exit ${t.exit} stop ${t.stop ?? ''} points ${t.points} risk ${t.riskPoints ?? ''}`)
    if (t.note) p.push(t.note)
    for (const e of t.executions ?? []) p.push(`account ${e.account} size ${e.size ?? 1}`)
  }
  return p.join(' ')
}

const index = journal.map((j) => {
  const day = dayByDate.get(j.data.date)
  return {
    id: j.id,
    date: j.data.date,
    title: j.data.day ?? j.data.date,
    summary: j.data.summary ?? '',
    tags: j.data.tags ?? [],
    trades: (day?.trades ?? []).length,
    mood: day?.mood ?? null,
    meta: [j.data.date, j.data.summary ?? '', (j.data.tags ?? []).join(' '), dayText(day)].join(' '),
    body: j.body ?? '',
  }
})

const groups: { month: string; entries: typeof journal }[] = []
for (const j of journal) {
  const m = j.data.date.slice(0, 7)
  const last = groups[groups.length - 1]
  if (last && last.month === m) last.entries.push(j)
  else groups.push({ month: m, entries: [j] })
}

const ordered: typeof journal = []
for (const g of groups) ordered.push(...g.entries)
const numById = new Map(ordered.map((j, i) => [j.id, i]))
---

<Base title="journal — 1ed.ge" description="The daily trading journal — the thinking, the sessions, the misses, the lessons. Everything public.">
  <section class="shell pt-12 pb-20">
    <div class="flex flex-wrap items-baseline gap-3">
      <h1 class="text-2xl">/ journal</h1>
      <span id="journal-count" class="text-[12px] text-faint">{journal.length} entries</span>
    </div>

    <div class="mt-8 flex max-w-3xl flex-col gap-3">
      <form class="flex gap-2" role="search" onsubmit="return false">
        <input
          type="search"
          id="journal-q"
          placeholder="search title, tags, text, date…  ( / to focus )"
          class="input flex-1"
          aria-label="search journal"
          autocomplete="off"
        />
        <button type="button" id="search-clear" class="btn shrink-0 hidden">clear</button>
      </form>
      <label class="flex items-center gap-2 text-[12px] text-dim">
        <span class="text-faint">jump to day:</span>
        <input type="date" class="input w-40" onchange="window.__jumpDay && window.__jumpDay(this.value)" />
      </label>
    </div>

    <div id="month-strip" class="sticky top-0 z-10 mt-6 -mx-1 overflow-x-auto border-b border-line bg-bg/95 px-1 py-2 backdrop-blur">
      <div class="flex gap-1.5">
        {groups.map((g) => (
          <a href={`#m-${g.month}`} class="tag shrink-0 transition-colors hover:border-accent hover:text-accent">
            {monthLabel(g.month)}
          </a>
        ))}
      </div>
    </div>

    <div id="journal-list" class="mt-10 max-w-3xl">
      {groups.map((g) => (
        <div id={`m-${g.month}`} class="scroll-mt-16">
          <div class="-mx-1 px-1 py-1 text-[11px] uppercase tracking-widest text-dim">
            {monthLabel(g.month)} <span class="text-faint">· {g.entries.length}</span>
          </div>
          {g.entries.map((j) => (
            <a href={`/day/${fmtDay(j.data.date)}`} class="group block border-b border-line/70 py-6 first:pt-4">
              <div class="flex items-baseline justify-between gap-4">
                <div class="flex items-baseline gap-3">
                  <span class="text-[12px] text-faint">{String(journal.length - (numById.get(j.id) ?? 0)).padStart(2, '0')}</span>
                  <span class="text-[15px] text-ink group-hover:text-accent">{j.data.day ?? j.data.date}</span>
                </div>
                <span class="shrink-0 text-[12px] text-dim">{j.data.date}</span>
              </div>
              {j.data.summary && <p class="mt-2 text-[13px] leading-relaxed text-dim">{j.data.summary}</p>}
              <div class="mt-2 flex flex-wrap items-center gap-2 text-[11px]">
                {(dayByDate.get(j.data.date)?.trades?.length ?? 0) > 0 && (
                  <span class="tag text-up">{dayByDate.get(j.data.date)!.trades!.length} trades</span>
                )}
                {dayByDate.get(j.data.date)?.mood && <span class="tag">mood {dayByDate.get(j.data.date)!.mood}/5</span>}
                {j.data.tags?.map((t) => <span class="tag">#{t}</span>)}
              </div>
            </a>
          ))}
        </div>
      ))}
      {journal.length === 0 && (
        <p class="text-[13px] text-faint">no entries yet — the journal starts when the trading does.</p>
      )}
    </div>

    <div id="search-results" class="mt-10 max-w-3xl hidden"></div>

    <button id="back-top" class="fixed bottom-6 right-6 z-20 hidden h-10 w-10 items-center justify-center border border-line bg-panel text-dim transition-colors hover:border-accent hover:text-ink" aria-label="back to top">
      ↑
    </button>
  </section>
</Base>

<script type="application/json" id="journal-index" set:html={JSON.stringify(index).replace(/</g, '\\u003c')} is:inline></script>

<script is:inline>
  (() => {
    const input = document.getElementById('journal-q')
    const clearBtn = document.getElementById('search-clear')
    const count = document.getElementById('journal-count')
    const list = document.getElementById('journal-list')
    const strip = document.getElementById('month-strip')
    const results = document.getElementById('search-results')
    const backTop = document.getElementById('back-top')
    if (!input || !results || !count) return

    let index = []
    const indexEl = document.getElementById('journal-index')
    try { index = JSON.parse(indexEl.textContent || '[]') } catch {}

    const MON = ['jan', 'feb', 'mar', 'apr', 'may', 'jun', 'jul', 'aug', 'sep', 'oct', 'nov', 'dec']
    const fmt = (iso) => { const [y, m, d] = iso.split('-'); return d + '-' + MON[+m - 1] + '-' + y }
    window.__jumpDay = (v) => { if (v) location.href = '/day/' + fmt(v) }

    const escHtml = (s) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]))
    const tokenize = (t) => t.trim().toLowerCase().split(/\s+/).filter(Boolean)
    const hasDigit = /[0-9]/
    const escRe = (s) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
    const matchTok = (field, tok) => {
      const f = ' ' + String(field).toLowerCase()
      if (hasDigit.test(tok)) return f.includes(tok)
      return new RegExp('(^|[^a-z0-9])' + escRe(tok)).test(f)
    }

    const search = (term) => {
      const toks = tokenize(term)
      if (!toks.length) return []
      const out = []
      for (const e of index) {
        let ok = true
        let score = 0
        for (const tok of toks) {
          const t = matchTok(e.title, tok)
          const m = matchTok(e.meta, tok)
          const b = matchTok(e.body, tok)
          if (!(t || m || b)) { ok = false; break }
          score += (t ? 3 : 0) + (m ? 2 : 0) + (b ? 1 : 0)
        }
        if (ok) out.push({ e, score })
      }
      out.sort((a, b) => b.score - a.score || b.e.date.localeCompare(a.e.date))
      return out.map((r) => r.e)
    }

    const item = (e, i) => `
      <a href="/day/${fmt(e.date)}" class="group block border-b border-line/70 py-6">
        <div class="flex items-baseline justify-between gap-4">
          <div class="flex items-baseline gap-3">
            <span class="text-[12px] text-faint">${String(i + 1).padStart(2, '0')}</span>
            <span class="text-[15px] text-ink group-hover:text-accent">${escHtml(e.title)}</span>
          </div>
          <span class="shrink-0 text-[12px] text-dim">${escHtml(e.date)}</span>
        </div>
        ${e.summary ? `<p class="mt-2 text-[13px] leading-relaxed text-dim">${escHtml(e.summary)}</p>` : ''}
        <div class="mt-2 flex flex-wrap items-center gap-2 text-[11px]">
          ${e.trades > 0 ? '<span class="tag text-up">' + e.trades + ' trades</span>' : ''}
          ${e.mood ? '<span class="tag">mood ' + e.mood + '/5</span>' : ''}
          ${(e.tags || []).map((t) => '<span class="tag">#' + escHtml(t) + '</span>').join('')}
        </div>
      </a>`

    const apply = (term) => {
      const active = term.trim().length > 0
      if (list) list.style.display = active ? 'none' : ''
      if (strip) strip.style.display = active ? 'none' : ''
      results.classList.toggle('hidden', !active)
      if (clearBtn) clearBtn.classList.toggle('hidden', !active)
      if (!active) {
        results.innerHTML = ''
        count.textContent = index.length + ' entries'
        return
      }
      const hits = search(term)
      if (hits.length) {
        results.innerHTML = hits.map((e, i) => item(e, i)).join('')
      } else {
        results.innerHTML = '<p class="text-[13px] text-faint">no entries match &ldquo;' + escHtml(term.trim()) + '&rdquo;.</p>'
      }
      count.textContent = hits.length + ' of ' + index.length + ' entries'
    }

    input.addEventListener('input', () => apply(input.value))
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') { e.preventDefault(); apply(input.value) }
      if (e.key === 'Escape') { input.value = ''; apply(''); input.blur() }
    })
    if (clearBtn) clearBtn.addEventListener('click', () => { input.value = ''; apply(''); input.focus() })

    document.addEventListener('keydown', (e) => {
      if (e.key !== '/' && e.key !== 'Escape') return
      const t = e.target
      const typing = t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable)
      if (e.key === '/' && !typing) { e.preventDefault(); input.focus(); input.select() }
    })

    window.addEventListener('scroll', () => {
      if (backTop) backTop.classList.toggle('hidden', window.scrollY <= 400)
    }, { passive: true })
    if (backTop) backTop.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }))
  })()
</script>
