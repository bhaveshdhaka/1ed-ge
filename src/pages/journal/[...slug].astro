---
import Base from '../../layouts/Base.astro'
import { getCollection, render } from 'astro:content'

export async function getStaticPaths() {
  const journal = await getCollection('journal')
  return journal.map((j) => ({ params: { slug: j.id }, props: { entry: j } }))
}

const { entry } = Astro.props
const all = (await getCollection('journal')).sort((a, b) => a.data.date.localeCompare(b.data.date))
const idx = all.findIndex((j) => j.id === entry.id)
const prev = idx > 0 ? all[idx - 1] : null
const next = idx >= 0 && idx < all.length - 1 ? all[idx + 1] : null
const { Content } = await render(entry)

const days = await getCollection('days')
const day = days.find((d) => d.data.date === entry.data.date)

const dayR = (day?.data.trades ?? []).reduce((s, t) => {
  const risk = t.riskPoints ?? (t.stop !== undefined ? Math.abs(t.entry - t.stop) : 1)
  return s + (risk > 0 ? t.points / risk : 0)
}, 0)
const dayPts = (day?.data.trades ?? []).reduce((s, t) => s + t.points, 0)

const SITE = 'https://1ed.ge'
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.day ?? entry.data.date,
  description: entry.data.summary,
  datePublished: entry.data.date + 'T00:00:00Z',
  dateModified: entry.data.date + 'T00:00:00Z',
  author: { '@type': 'Person', name: '1ed.ge', url: SITE },
  mainEntityOfPage: `${SITE}/journal/${entry.id}`,
  publisher: { '@type': 'Organization', name: '1ed.ge', url: SITE },
}
---

<Base
  title={`${entry.data.day ?? entry.data.date} — journal — 1ed.ge`}
  description={entry.data.summary ?? 'journal entry'}
  ogImage={entry.data.featuredImage}
>
  <article class="shell max-w-3xl pt-12 pb-20">
    <a href="/journal" class="text-[12px] text-dim transition-colors hover:text-ink">← /journal</a>
    <header class="mt-6">
      <h1 class="text-2xl leading-tight">{entry.data.day ?? entry.data.date}</h1>
      <div class="mt-3 flex flex-wrap items-center gap-3 text-[12px] text-dim">
        <span>{entry.data.date}</span>
        {entry.data.tags?.map((t) => <span class="tag">#{t}</span>)}
        <a href={`/day/${entry.data.date}`} class="ml-auto border border-line px-2 py-0.5 text-accent transition-colors hover:border-accent">
          structured day →
        </a>
      </div>
    </header>

    {day && (
      <div class="mt-6 grid grid-cols-2 gap-px border border-line bg-line sm:grid-cols-4">
        <div class="bg-bg p-3">
          <div class="text-[10px] uppercase tracking-widest text-dim">mood</div>
          <div class="mt-0.5 text-[15px]">{day.data.mood ? `${day.data.mood}/5` : '—'}</div>
        </div>
        <div class="bg-bg p-3">
          <div class="text-[10px] uppercase tracking-widest text-dim">sleep</div>
          <div class="mt-0.5 text-[15px]">{day.data.sleep?.hours !== undefined ? day.data.sleep.hours + 'h' : '—'}</div>
        </div>
        <div class="bg-bg p-3">
          <div class="text-[10px] uppercase tracking-widest text-dim">screen</div>
          <div class="mt-0.5 text-[15px]">{day.data.device?.iphoneHours !== undefined ? day.data.device.iphoneHours + 'h' : '—'}</div>
        </div>
        <div class="bg-bg p-3">
          <div class="text-[10px] uppercase tracking-widest text-dim">trades</div>
          <div class:list={['mt-0.5 text-[15px]', dayR > 0 ? 'num-up' : dayR < 0 ? 'num-down' : '']}>
            {(day.data.trades ?? []).length} · {dayR > 0 ? '+' : ''}{dayR.toFixed(2)}R
          </div>
        </div>
      </div>
    )}

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline></script>
    <div class="prose mt-8">
      <Content />
    </div>
    <nav class="mt-14 grid grid-cols-2 gap-4 border-t border-line pt-6">
      {prev ? (
        <a href={`/journal/${prev.id}`} class="group">
          <div class="text-[11px] uppercase tracking-widest text-faint">← newer</div>
          <div class="mt-1 text-[14px] text-soft group-hover:text-accent">{prev.data.day ?? prev.data.date}</div>
        </a>
      ) : <span />}
      {next ? (
        <a href={`/journal/${next.id}`} class="group text-right">
          <div class="text-[11px] uppercase tracking-widest text-faint">older →</div>
          <div class="mt-1 text-[14px] text-soft group-hover:text-accent">{next.data.day ?? next.data.date}</div>
        </a>
      ) : <span />}
    </nav>
  </article>
</Base>
