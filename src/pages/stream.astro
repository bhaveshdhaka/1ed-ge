---
import Base from '../layouts/Base.astro'
import { getCollection } from 'astro:content'
import { todayHkt } from '../lib/sessions'
import { fmtDay } from '../lib/dates'
import { flattenStream, resolveMoments, momentMeta, dayFacts } from '../lib/stream'
import { readLiveState } from '../lib/live'
import type { DayData, MomentType } from '../lib/stream'
import MomentCard from '../components/stream/MomentCard.astro'
import DayFacts from '../components/stream/DayFacts.astro'

export const prerender = false

const [dayEntries, habitEntries] = await Promise.all([getCollection('days'), getCollection('habits')])
const days = dayEntries.map((d) => d.data as DayData)

const type = (Astro.url.searchParams.get('type') ?? 'all') as MomentType | 'all'
const TYPES: (MomentType | 'all')[] = ['all', 'pre-market', 'trade', 'note', 'quote', 'post-market', 'media']
const validType = TYPES.includes(type) ? type : 'all'

const all = flattenStream(days)
const feed = validType === 'all' ? all : all.filter((m) => m.type === validType)

const live = readLiveState()

const iso = todayHkt()
const today = days.find((d) => d.date === iso) ?? null
const todayMoments = today ? resolveMoments(today) : []
const todayCells = dayFacts(today, habitEntries.filter((h) => h.data.active).length)

const countByType = new Map<string, number>()
for (const m of all) countByType.set(m.type, (countByType.get(m.type) ?? 0) + 1)
---

<Base
  title="stream — 1ed.ge"
  description="The rolling feed of published moments — pre-market, trades, notes, quotes. Everything public."
>
  <section class="shell pt-12 pb-20">
    <div class="flex flex-wrap items-baseline gap-3">
      <h1 class="text-2xl text-ink">/ stream</h1>
      <span class="text-[12px] text-faint">{all.length} published moments</span>
      <span class:list={['ml-auto flex items-center gap-2 text-[12px]', live.live ? 'text-up' : 'text-faint']}>
        <span class:list={['inline-block h-1.5 w-1.5 rounded-full', live.live ? 'bg-up' : 'bg-line2']}></span>
        {live.live ? 'trader is live' : 'offline'}
      </span>
    </div>

    <div class="mt-6 flex max-w-2xl flex-col gap-3">
      <div class="border border-line bg-panel px-4 py-3">
        <div class="flex items-baseline justify-between gap-3">
          <span class="text-2xs uppercase tracking-widest text-dim">today so far · {fmtDay(iso)}</span>
          <a href={`/day/${fmtDay(iso)}`} class="text-2xs text-faint transition-colors hover:text-accent">day →</a>
        </div>
        <div class="mt-2">
          <DayFacts cells={todayCells} />
        </div>
        {todayMoments.length > 0 ? (
          <div class="mt-3 flex flex-wrap gap-2">
            {todayMoments.map((m) => (
              <span class="border border-line2 px-2 py-1 text-2xs text-dim">
                {momentMeta(m.type).glyph} {m.at} {m.type}
              </span>
            ))}
          </div>
        ) : (
          <p class="mt-3 text-2xs text-faint">nothing logged yet today.</p>
        )}
      </div>

      <div class="flex flex-wrap gap-1.5">
        {TYPES.map((t) => {
          const count = t === 'all' ? all.length : countByType.get(t) ?? 0
          const href = t === 'all' ? '/stream' : `/stream?type=${t}`
          return (
            <a
              href={href}
              aria-current={validType === t ? 'page' : undefined}
              class:list={[
                'border px-2.5 py-1 text-2xs transition-colors',
                validType === t ? 'border-accent text-accent' : 'border-line2 text-dim hover:border-accent hover:text-accent',
              ]}
            >
              {t} <span class="text-faint">{count}</span>
            </a>
          )
        })}
      </div>
    </div>

    <div class="mt-8 max-w-2xl">
      {feed.length === 0 ? (
        <p class="text-[13px] text-faint">no {validType !== 'all' ? validType : ''} moments yet.</p>
      ) : (
        <div class="flex flex-col gap-4">
          {feed.map((m) => <MomentCard moment={m} showDay />)}
        </div>
      )}
    </div>
  </section>
</Base>
