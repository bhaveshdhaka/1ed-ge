---
import Base from '../layouts/Base.astro'
import { listMds, readEntry } from '../lib/content'
import { cmeToday, nowHkt, hktDayNumber } from '../lib/sessions'
import { fmtDay, fmtDayWUpper } from '../lib/dates'
import { flattenStream, resolveThoughts, thoughtMeta, dayFacts } from '../lib/stream'
import { readLiveState } from '../lib/live'
import { liveLine } from '../lib/copy'
import type { DayData, ThoughtType } from '../lib/stream'
import ThoughtCard from '../components/stream/ThoughtCard.astro'
import DayFacts from '../components/stream/DayFacts.astro'
import Card from '../components/ui/Card.astro'
import EmptyState from '../components/ui/EmptyState.astro'

export const prerender = false

const dayFiles = listMds('days')
const habitFiles = listMds('habits')
const days: DayData[] = dayFiles.map((f) => readEntry('days', f).data as unknown as DayData)
const habitEntries = habitFiles.map((f) => readEntry('habits', f))

const type = (Astro.url.searchParams.get('type') ?? 'all') as ThoughtType | 'all'
const TYPES: (ThoughtType | 'all')[] = ['all', 'trade', 'note', 'quote']
const validType = TYPES.includes(type) ? type : 'all'

const all = flattenStream(days)
const feed = validType === 'all' ? all : all.filter((m) => m.type === validType)

const live = readLiveState()

// Calendar-day difference in HKT between the durable last-online stamp and now.
const lastSeenDays = live.lastOnlineIso
  ? Math.max(0, hktDayNumber(`${nowHkt()}:00+08:00`) - hktDayNumber(live.lastOnlineIso))
  : null

const iso = cmeToday()
const today = days.find((d) => d.date === iso) ?? null
const todayThoughts = today ? resolveThoughts(today) : []
const todayCells = dayFacts(today, habitEntries.filter((h) => h.data.active).length)

const countByType = new Map<string, number>()
for (const m of all) countByType.set(m.type, (countByType.get(m.type) ?? 0) + 1)

// Live page — never serve a stale cached copy (a published thought must show immediately).
Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate')
---

<Base
  title="stream — 1ed.ge"
  description="The rolling feed of published thoughts — trades, notes, quotes. Everything public."
>
  <section class="shell pt-12 pb-20">
    <div class="flex flex-wrap items-baseline gap-3">
      <h1 class="text-2xl text-ink">/ stream</h1>
      <span class="text-xs text-faint">{all.length} published thoughts</span>
      <span class:list={['ml-auto flex items-center gap-2 text-xs', live.live ? 'text-up' : 'text-faint']}>
        <span class:list={['inline-block h-1.5 w-1.5 rounded-full', live.live ? 'bg-up' : 'bg-line2']}></span>
        {liveLine(live.live, lastSeenDays)}
      </span>
    </div>

    <div class="mt-6 flex max-w-2xl flex-col gap-3">
      <Card icon="📊" label="today so far" subtitle={fmtDayWUpper(iso)}>
        <Fragment slot="actions">
          {live.live && <span class="tmr">● live</span>}
          <a href={`/day/${fmtDay(iso)}`} class="text-2xs text-faint transition-colors hover:text-accent">day →</a>
        </Fragment>
        <DayFacts cells={todayCells} />
        {todayThoughts.length > 0 ? (
          <div class="mt-3 flex flex-wrap gap-2">
            {todayThoughts.map((t) => (
              <span class="capsule">
                {thoughtMeta(t.type).glyph} {t.at} {t.type}
              </span>
            ))}
          </div>
        ) : (
          <div class="mt-3"><EmptyState text="nothing logged yet today." /></div>
        )}
      </Card>

      <div class="seg flex-wrap">
        {TYPES.map((t) => {
          const count = t === 'all' ? all.length : countByType.get(t) ?? 0
          const href = t === 'all' ? '/stream' : `/stream?type=${t}`
          return (
            <a
              href={href}
              aria-current={validType === t ? 'page' : undefined}
              class:list={[
                'rounded-lg px-2.5 py-1 text-2xs transition-colors',
                validType === t ? 'seg-on' : 'text-dim hover:text-accent',
              ]}
            >
              {t === 'note' ? 'thought' : t} <span class="text-faint">{count}</span>
            </a>
          )
        })}
      </div>
    </div>

    <div class="mt-8 max-w-2xl">
      {feed.length === 0 ? (
        <EmptyState text={`no ${validType !== 'all' ? `${validType} ` : ''}thoughts yet.`} />
      ) : (
        <div class="flex flex-col gap-4">
          {feed.map((t) => <ThoughtCard thought={t} showDay />)}
        </div>
      )}
    </div>
  </section>
</Base>
