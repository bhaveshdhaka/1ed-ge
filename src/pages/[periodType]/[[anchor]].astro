---
/**
 * [periodType]/[[anchor]].astro — one dynamic route for all period reviews.
 * /week, /month, /q1..q4, /h1/h2, /year  → current period (SSR, fresh)
 * /week/2026-32, /q1/2026, /month/2026-08 → anchored period (getStaticPaths)
 */
import Base from '../../layouts/Base.astro'
import { getCollection } from 'astro:content'
import { periodTypeFromSlug, slugFromType, periodRange, isoFromAnchor, periodRangesBetween, type PeriodType, type PeriodRange } from '../../lib/periods'
import { aggregatePeriod, trendSeries, type PeriodStats, type TrendPoint } from '../../lib/period-stats'
import { readEntry } from '../../lib/content'
import { todayHkt } from '../../lib/sessions'
import { flattenStream, type DayData } from '../../lib/stream'
import PeriodReview from '../../components/period/PeriodReview.astro'

export const prerender = false

export async function getStaticPaths() {
  const days = await getCollection('days')
  if (days.length === 0) return []
  const sorted = [...days].sort((a, b) => a.data.date.localeCompare(b.data.date))
  const earliest = sorted[0].data.date
  const today = todayHkt()
  const types: PeriodType[] = ['week', 'month', 'quarter', 'half', 'year']
  const paths: { params: { periodType: string; anchor: string }; props: { type: PeriodType; range: PeriodRange } }[] = []
  for (const type of types) {
    const ranges = periodRangesBetween(type, earliest, today)
    for (const range of ranges) {
      paths.push({
        params: { periodType: slugFromType(type, range.index), anchor: range.anchor },
        props: { type, range },
      })
    }
  }
  return paths
}

const periodTypeSlug = Astro.params.periodType
const type = periodTypeFromSlug(periodTypeSlug)
if (!type) return new Response(null, { status: 404 })

const anchor = Astro.params.anchor
let range: PeriodRange
if (anchor === undefined) {
  range = periodRange(type, todayHkt())
} else {
  let repIso: string
  if (type === 'quarter') {
    const qIndex = parseInt(periodTypeSlug[1], 10)
    repIso = isoFromAnchor(type, anchor, qIndex)
  } else if (type === 'half') {
    const hIndex = parseInt(periodTypeSlug[1], 10)
    repIso = isoFromAnchor(type, anchor, hIndex)
  } else {
    repIso = isoFromAnchor(type, anchor)
  }
  range = periodRange(type, repIso)
}

const [dayEntries, habitEntries, accountEntries, journalEntries, reviewEntries] = await Promise.all([
  getCollection('days'),
  getCollection('habits'),
  getCollection('accounts'),
  getCollection('journal'),
  getCollection('reviews'),
])

const days = dayEntries.map((d) => d.data as DayData)
const ctx = {
  habits: habitEntries
    .filter((h) => h.data.active)
    .map((h) => ({ id: h.id, kind: h.data.kind as 'bool' | 'count', target: h.data.target })),
  accounts: accountEntries.map((a) => ({ id: a.data.id, pointsValue: a.data.pointsValue })),
}

const stats: PeriodStats = aggregatePeriod(days, range, ctx)
const prevStats: PeriodStats | null = stats.daysCount > 0 && range.prev ? aggregatePeriod(days, range.prev, ctx) : null
const trend: TrendPoint[] = stats.daysCount > 0 ? trendSeries(type, days, 8, ctx) : []

const reviewEntry = reviewEntries.find((r) => r.data.type === type && r.data.anchor === range.anchor) ?? null

let comparisonBody = ''
try {
  const cmp = readEntry('reviews', `${type}-${range.anchor}.cmp.md`)
  comparisonBody = cmp.body
} catch {
  comparisonBody = ''
}

const journalsInPeriod = journalEntries
  .filter((j) => j.data.date >= range.startIso && j.data.date <= range.endIso)
  .sort((a, b) => a.data.date.localeCompare(b.data.date))

const daysInPeriod = days.filter((d) => d.date >= range.startIso && d.date <= range.endIso)
const dayIsos = daysInPeriod.map((d) => d.date).sort()
const moments = flattenStream(daysInPeriod)

const title = `${range.label} review — 1ed.ge`
const description = `${range.label}: ${stats.trades} trades, ${stats.sumR >= 0 ? '+' : ''}${stats.sumR.toFixed(2)}R. Public period review.`
---

<Base title={title} description={description}>
  <PeriodReview
    range={range}
    stats={stats}
    prevStats={prevStats}
    trend={trend}
    dayIsos={dayIsos}
    reviewEntry={reviewEntry}
    comparisonBody={comparisonBody}
    journals={journalsInPeriod}
    moments={moments}
  />
</Base>
