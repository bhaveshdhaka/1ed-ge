---
export const prerender = false
import DayArchive from '../../components/archive/DayArchive.astro'
import { listMds } from '../../lib/content'
import { parseDay } from '../../lib/dates'

const slug = Astro.params.date!
const iso = parseDay(slug)
if (!iso) return Astro.redirect('/404')

const dates = new Set<string>()
for (const f of listMds('days')) dates.add(f.replace(/\.md$/, ''))
for (const f of listMds('journal')) dates.add(f.replace(/\.mdx$/, ''))
for (const f of listMds('coach')) dates.add(f.replace(/\.md$/, ''))
const allDates = [...dates].sort()
---
<DayArchive iso={iso} allDates={allDates} />
