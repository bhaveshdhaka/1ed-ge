---
import Base from '../../layouts/Base.astro'
import { getCollection, render } from 'astro:content'
import { fmtDay } from '../../lib/dates'
import { marketMarker } from '../../lib/market'

export async function getStaticPaths() {
  const [days, journal, coach] = await Promise.all([
    getCollection('days'),
    getCollection('journal'),
    getCollection('coach'),
  ])
  const dates = new Set<string>()
  for (const c of [...days, ...journal, ...coach]) dates.add(c.data.date)
  const allDates = [...dates].sort()
  return allDates.map((iso) => ({
    params: { date: fmtDay(iso) },
    props: { iso, allDates },
  }))
}

const { iso, allDates } = Astro.props
const [days, accounts, journal, coach, habits, news] = await Promise.all([
  getCollection('days'),
  getCollection('accounts'),
  getCollection('journal'),
  getCollection('coach'),
  getCollection('habits'),
  getCollection('market-news'),
])
const entry = days.find((d) => d.data.date === iso) ?? null
const journalFor = journal.find((j) => j.data.date === iso) ?? null
const coachFor = coach.find((c) => c.data.date === iso) ?? null
const newsFor = news.find((n) => n.data.date === iso)

const accMap = new Map(accounts.map((a) => [a.data.id, a.data]))
const dayIdx = allDates.indexOf(iso)
const prevIso = dayIdx > 0 ? allDates[dayIdx - 1] : null
const nextIso = dayIdx >= 0 && dayIdx < allDates.length - 1 ? allDates[dayIdx + 1] : null

const d = entry?.data ?? null
const dayHabits = d?.habits ?? {}
const sleep = d?.sleep
const device = d?.device
const moodLabel = d?.mood ? `${d.mood}/5` : '—'
const trades = d?.trades ?? []
const sumR = trades.reduce((s, t) => s + (t.points / (t.riskPoints ?? (t.stop !== undefined ? Math.abs(t.entry - t.stop) : 1))), 0)
const totalPts = trades.reduce((s, t) => s + t.points, 0)
const mk = marketMarker(iso)

let Reflection: any = null
let Coaching: any = null
if (journalFor) ({ Content: Reflection } = await render(journalFor))
if (coachFor) ({ Content: Coaching } = await render(coachFor))

const statusClass = mk.status === 'open' ? 'text-up' : mk.status === 'early' ? 'text-warn' : 'text-down'
---

<Base
  title={`day ${fmtDay(iso)} — 1ed.ge`}
  description={`${fmtDay(iso)} — mood ${moodLabel}, ${trades.length} trades, ${sumR >= 0 ? '+' : ''}${sumR.toFixed(2)}R. Everything public.`}
>
  <article class="shell max-w-4xl pt-12 pb-20">
    <nav class="flex items-center justify-between text-[12px]">
      <a href="/journal" class="text-dim transition-colors hover:text-ink">← /journal</a>
      <span class="text-faint">all sessions</span>
      <a href="/coach" class="text-dim transition-colors hover:text-ink">/coach →</a>
    </nav>

    <header class="mt-6 flex flex-wrap items-baseline gap-x-4 gap-y-1">
      <h1 class="text-2xl">day {fmtDay(iso)}</h1>
      <span class:list={['text-[13px]', statusClass]} data-mkt-live>
        {mk.glyph} {mk.text}
      </span>
      <span class="text-[13px] text-dim">
        {trades.length} trades · {sumR > 0 ? '+' : ''}{sumR.toFixed(2)}R · {totalPts >= 0 ? '+' : ''}{totalPts}pts
      </span>
    </header>

    <nav class="mt-4 flex items-center justify-between gap-3 text-[12px]">
      {prevIso ? (
        <a href={`/day/${fmtDay(prevIso)}`} class="flex h-10 items-center border border-line px-3 text-dim transition-colors hover:border-accent hover:text-ink">
          ← {fmtDay(prevIso)}
        </a>
      ) : (
        <span class="text-faint">← older</span>
      )}
      <span class="text-faint">day {dayIdx + 1} of {allDates.length}</span>
      {nextIso ? (
        <a href={`/day/${fmtDay(nextIso)}`} class="flex h-10 items-center border border-line px-3 text-dim transition-colors hover:border-accent hover:text-ink">
          {fmtDay(nextIso)} →
        </a>
      ) : (
        <span class="text-faint">newer →</span>
      )}
    </nav>

    {newsFor && (newsFor.data.red.length > 0 || newsFor.data.orange.length > 0) && (
      <details class="group mt-6 border border-line bg-panel/50 px-4 py-3" open>
        <summary class="flex cursor-pointer list-none select-none items-center justify-between gap-3 text-[12px]">
          <span class="text-[10px] uppercase tracking-widest text-dim">
            USD news · HKT
            <span class="ml-2 normal-case tracking-normal text-faint">
              {newsFor.data.red.length > 0 && `red ${newsFor.data.red[0].time}`}
              {newsFor.data.red.length > 0 && newsFor.data.orange.length > 0 && ' · '}
              {newsFor.data.orange.length > 0 && `orange ${newsFor.data.orange[0].time}`}
            </span>
          </span>
          <span class="text-dim transition-transform group-open:rotate-180">▾</span>
        </summary>
        <div class="mt-2 flex flex-wrap gap-x-5 gap-y-1.5 border-t border-line/50 pt-2 text-[13px]">
          {newsFor.data.red.map((n) => (
            <span class="text-down">red {n.time} hkt — {n.title}</span>
          ))}
          {newsFor.data.orange.map((n) => (
            <span class="opacity-70 text-warn">orange {n.time} hkt — {n.title}</span>
          ))}
        </div>
      </details>
    )}

    <div class="mt-8 grid gap-px border border-line bg-line sm:grid-cols-4">
      <div class="bg-bg p-4">
        <div class="text-[10px] uppercase tracking-widest text-dim">mood</div>
        <div class="mt-1 text-lg">{moodLabel}</div>
      </div>
      <div class="bg-bg p-4">
        <div class="text-[10px] uppercase tracking-widest text-dim">sleep</div>
        <div class="mt-1 text-lg">{sleep?.hours !== undefined ? sleep.hours + 'h' : '—'}</div>
        <div class="text-[11px] text-faint">quality {sleep?.quality ?? '—'}/5</div>
      </div>
      <div class="bg-bg p-4">
        <div class="text-[10px] uppercase tracking-widest text-dim">phone screen</div>
        <div class="mt-1 text-lg">{device?.iphoneHours !== undefined ? device.iphoneHours + 'h' : '—'}</div>
        <div class="text-[11px] text-faint">{device?.socialHours !== undefined ? `social ${device.socialHours}h` : ''}</div>
      </div>
      <div class="bg-bg p-4">
        <div class="text-[10px] uppercase tracking-widest text-dim">mac</div>
        <div class="mt-1 text-lg">{device?.macHours !== undefined ? device.macHours + 'h' : '—'}</div>
      </div>
    </div>

    {d && (
      <div class="mt-10">
        <h2 class="text-lg">/ habits</h2>
        <div class="mt-3 flex flex-wrap gap-2">
          {habits.map((h) => {
            const done = dayHabits[h.id] === true
            return (
              <span class="flex items-center gap-2 border px-3 py-1.5 text-[13px]" style={done ? `border-color:${h.data.color};color:${h.data.color}` : 'border-color:var(--color-line);color:var(--color-dim)'}>
                {h.data.emoji ?? '·'} {h.data.name} {done ? '✓' : '×'}
              </span>
            )
          })}
        </div>
      </div>
    )}

    {device && (device.screenshots?.length ?? 0) > 0 && (
      <div class="mt-10">
        <h2 class="text-lg">/ screen time — proof</h2>
        <p class="mt-2 text-[13px] text-dim">{device.notes ?? 'no note'}</p>
        <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2">
          {device.screenshots!.map((s) => (
            <a href={s} target="_blank" class="block border border-line bg-panel transition-colors hover:border-accent">
              <img src={s} alt="screen time screenshot" loading="lazy" class="w-full" />
            </a>
          ))}
        </div>
      </div>
    )}

    <div class="mt-10">
      <h2 class="text-lg">/ trades</h2>
      {trades.length === 0 ? (
        <p class="mt-3 text-[13px] text-faint">no trades logged this day.</p>
      ) : (
        <div class="mt-4 space-y-4">
          {trades.map((t, i) => {
            const risk = t.riskPoints ?? (t.stop !== undefined ? Math.abs(t.entry - t.stop) : 1)
            const R = t.points / risk
            const ex = t.executions ?? []
            const totalPnl = ex.reduce((s, e) => s + t.points * (accMap.get(e.account)?.pointsValue ?? 2) * (e.size ?? 1), 0)
            return (
              <div class="panel p-4">
                <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                  <span class="text-[15px] text-ink">{t.direction === 'long' ? '▲' : '▼'} {t.market}</span>
                  <span class="text-[12px] text-dim">{t.session ?? '—'} · {t.setup ?? 'no setup'}</span>
                  <span class:list={['ml-auto text-[15px]', R > 0 ? 'num-up' : R < 0 ? 'num-down' : '']}>
                    {R > 0 ? '+' : ''}{R.toFixed(2)}R
                  </span>
                  <span class:list={['text-[13px]', totalPnl >= 0 ? 'num-up' : 'num-down']}>
                    {totalPnl >= 0 ? '+' : ''}${totalPnl.toLocaleString()}
                  </span>
                </div>
                <div class="mt-2 grid grid-cols-2 gap-x-6 gap-y-1 text-[12px] text-dim md:grid-cols-4">
                  <span>entry <span class="text-ink">{t.entry}</span></span>
                  <span>exit <span class="text-ink">{t.exit}</span></span>
                  <span>stop <span class="text-ink">{t.stop ?? '—'}</span></span>
                  <span>points <span class:list={[t.points >= 0 ? 'text-up' : 'text-down']}>{t.points >= 0 ? '+' : ''}{t.points}</span></span>
                </div>
                {(ex.length > 0 || t.note) && (
                  <div class="mt-2 text-[12px] text-dim">
                    {ex.length > 0 && (
                      <span>
                        accounts: {ex.map((e) => { const a = accMap.get(e.account); return `${a?.firm ?? ''} ${a?.sizeLabel ?? ''}${e.size && e.size > 1 ? ` ×${e.size}` : ''}` }).join(' · ')}
                      </span>
                    )}
                    {t.note && <span class="text-soft"> — {t.note}</span>}
                  </div>
                )}
                {(t.screenshots?.length ?? 0) > 0 && (
                  <div class="mt-3 grid grid-cols-2 gap-3 md:grid-cols-4">
                    {t.screenshots!.map((s) => (
                      <a href={s} target="_blank" class="block border border-line bg-bg transition-colors hover:border-accent">
                        <img src={s} alt={`trade ${i + 1} screenshot`} loading="lazy" class="w-full" />
                      </a>
                    ))}
                  </div>
                )}
              </div>
            )
          })}
        </div>
      )}
    </div>

    <div class="mt-10 border-t border-line pt-8">
      <h2 class="text-lg">/ reflection</h2>
      {journalFor && Reflection ? (
        <article class="mt-4 max-w-3xl">
          <div class="flex flex-wrap items-center gap-3 text-[12px] text-dim">
            {journalFor.data.day && <span class="text-ink">{journalFor.data.day}</span>}
            <span>{fmtDay(journalFor.data.date)}</span>
            {journalFor.data.tags?.map((t) => <span class="tag">#{t}</span>)}
          </div>
          {journalFor.data.summary && <p class="mt-2 text-[13px] text-dim">{journalFor.data.summary}</p>}
          <div class="prose mt-6">
            <Reflection />
          </div>
        </article>
      ) : (
        <p class="mt-3 border-t border-line/40 pt-3 text-[13px] text-faint">no journal entry this day.</p>
      )}
    </div>

    <div class="mt-10 border-t border-line pt-8">
      <h2 class="text-lg">/ coach</h2>
      {coachFor && Coaching ? (
        <article class="mt-4 max-w-3xl border-l-2 border-line2 pl-6">
          <div class="flex flex-wrap items-center gap-3 text-[12px] text-dim">
            <span>{fmtDay(coachFor.data.date)}</span>
            {coachFor.data.summary && <span class="text-soft">{coachFor.data.summary}</span>}
          </div>
          <div class="prose mt-4">
            <Coaching />
          </div>
        </article>
      ) : (
        <p class="mt-3 border-t border-line/40 pt-3 text-[13px] text-faint">no coaching session this day.</p>
      )}
    </div>
  </article>
</Base>
