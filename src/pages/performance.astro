---
import Base from '../layouts/Base.astro'
import { getCollection } from 'astro:content'
import { buildStats, fmtPnl, fmtPts } from '../lib/stats'
import { buildHabitStats } from '../lib/habits'
import { buildTrends } from '../lib/trends'
import { fmtDay, fmtDayWUpper } from '../lib/dates'
import EquityCurve from '../components/EquityCurve.astro'
import RHistogram from '../components/RHistogram.astro'
import Heatmap from '../components/Heatmap.astro'
import CorrTable from '../components/CorrTable.astro'

const [accounts, days, payouts, habits] = await Promise.all([
  getCollection('accounts'),
  getCollection('days'),
  getCollection('payouts'),
  getCollection('habits'),
])
const { trades, perAccount, overall, payoutTotal, sumPnl } = buildStats(days, accounts, payouts)
const habitStats = buildHabitStats(habits, days)
const trends = buildTrends(days, accounts)
const s = overall

const cards: { label: string; value: string; up?: boolean; dim?: boolean }[] = [
  { label: 'cumulative R', value: s.totalTrades ? `${s.sumR > 0 ? '+' : ''}${s.sumR.toFixed(2)}R` : '—', up: s.sumR > 0 ? true : s.sumR < 0 ? false : undefined },
  { label: 'trades', value: String(s.totalTrades || 0) },
  { label: 'win rate', value: s.winRate === null ? '—' : `${s.winRate.toFixed(1)}%` },
  { label: 'profit factor', value: s.totalTrades ? (s.profitFactor === Infinity ? '∞' : s.profitFactor === null ? '—' : s.profitFactor.toFixed(2)) : '—' },
  { label: 'expectancy', value: s.totalTrades ? `${s.expectancy > 0 ? '+' : ''}${s.expectancy.toFixed(2)}R` : '—', up: s.expectancy > 0 ? true : s.expectancy < 0 ? false : undefined },
  { label: 'avg R', value: s.totalTrades ? `${s.avgR > 0 ? '+' : ''}${s.avgR.toFixed(2)}R` : '—', up: s.avgR > 0 ? true : s.avgR < 0 ? false : undefined },
  { label: 'best trade', value: s.totalTrades ? `${s.bestR > 0 ? '+' : ''}${s.bestR.toFixed(2)}R` : '—', up: s.bestR > 0 ? true : s.bestR < 0 ? false : undefined },
  { label: 'worst trade', value: s.totalTrades ? `${s.worstR > 0 ? '+' : ''}${s.worstR.toFixed(2)}R` : '—', up: s.worstR > 0 ? true : s.worstR < 0 ? false : undefined },
  { label: 'max dd (R)', value: s.totalTrades ? `${s.maxDrawdownR.toFixed(2)}R` : '—', up: false },
  { label: 'gross $ pnl', value: s.totalTrades ? fmtPnl(sumPnl) : '—' },
  { label: 'payouts taken', value: payoutTotal ? fmtPnl(payoutTotal).replace('+', '') : '—', dim: true },
  { label: 'days traded', value: String(s.daysWithTrades || 0) },
]

const recent = [...trades].reverse().slice(0, 25)
const stageColor: Record<string, string> = { eval: 'text-warn', buffer: 'text-accent', payout: 'text-up', failed: 'text-down', paused: 'text-dim' }
const accountLabel = new Map(accounts.map((a) => [a.data.id, `${a.data.firm} ${a.data.sizeLabel}`]))
---

<Base title="performance — 1ed.ge" description="Live R performance dashboard: equity curve, win rate, profit factor, payouts, and every prop account tracked against its drawdown limit.">
  <section class="shell pt-12 pb-20">
    <div class="flex items-baseline gap-3">
      <h1 class="text-2xl">/ performance</h1>
      <span class="text-xs text-faint">R = points risked vs points made</span>
    </div>

    <div class="sticky top-0 z-10 mt-6 -mx-1 border-b border-line bg-bg/95 px-1 py-1 backdrop-blur">
      <div class="flex gap-1 overflow-x-auto text-xs" tabindex="0">
        {[
          ['summary', 'stats'],
          ['charts', 'charts'],
          ['accounts', 'accounts'],
          ['recent trades', 'recent'],
          ['habits', 'habits'],
          ['trends', 'trends'],
        ].map(([label, id]) => (
          <a href={`#${id}`} class="flex h-8 items-center whitespace-nowrap px-2 text-dim transition-colors hover:text-ink">
            {label}
          </a>
        ))}
      </div>
    </div>

    <div id="stats" class="mt-8 scroll-mt-28 panel">
      <div class="card-hd border-b border-sep">
        <span class="card-ico">📊</span>
        <span class="card-lbl">R performance</span>
        <span class="card-sub">{s.totalTrades || 0} trades</span>
      </div>
      <div class="grid grid-cols-2 gap-2 p-3 md:grid-cols-4 lg:grid-cols-6">
        {cards.map((c) => (
          <div class="well p-4">
            <div class="text-3xs uppercase tracking-widest text-dim">{c.label}</div>
            <div class:list={['mt-1.5 text-lg', c.dim ? 'text-dim' : c.up === undefined ? 'text-ink' : c.up ? 'text-up' : 'text-down']}>{c.value}</div>
          </div>
        ))}
      </div>
    </div>

    <div id="charts" class="mt-10 grid scroll-mt-28 gap-6 lg:grid-cols-2">
      <div class="panel">
        <div class="card-hd border-b border-sep">
          <span class="card-ico">📈</span>
          <span class="card-lbl">equity curve</span>
          <span class="card-sub">cumulative R</span>
        </div>
        <div class="p-4">
          <EquityCurve points={s.equityR} color="var(--color-up)" />
        </div>
      </div>
      <div class="panel">
        <div class="card-hd border-b border-sep">
          <span class="card-ico">💵</span>
          <span class="card-lbl">equity curve</span>
          <span class="card-sub">$ pnl · all accounts</span>
        </div>
        <div class="p-4">
          <EquityCurve points={s.equityPnl} color="var(--color-accent)" footer={`${s.equityPnl.length} executions`} />
        </div>
      </div>
    </div>

    <div class="mt-10 panel">
      <div class="card-hd border-b border-sep">
        <span class="card-ico">📊</span>
        <span class="card-lbl">R histogram</span>
        <span class="card-sub">{trades.length} trades</span>
      </div>
      <div class="p-4">
        <RHistogram rs={trades.map((t) => t.R)} />
      </div>
    </div>

    <div id="accounts" class="mt-14 scroll-mt-28 panel">
      <div class="card-hd border-b border-sep">
        <span class="card-ico">💰</span>
        <span class="card-lbl">accounts</span>
        <span class="card-sub">{perAccount.length} tracked</span>
      </div>
      <div class="overflow-x-auto" tabindex="0">
      <table class="w-full min-w-[820px] border-collapse">
        <thead>
          <tr>
            <th class="th">account</th>
            <th class="th">stage</th>
            <th class="th text-right">dd limit</th>
            <th class="th text-right">trades</th>
            <th class="th text-right">win%</th>
            <th class="th text-right">$ pnl</th>
            <th class="th text-right">payouts</th>
            <th class="th text-right">net</th>
            <th class="th text-right">R</th>
            <th class="th text-right">dd used</th>
          </tr>
        </thead>
        <tbody>
          {perAccount.map((a) => (
            <tr>
              <td class="td">
                <div class="text-ink">{a.firm}</div>
                <div class="text-2xs text-faint">{a.sizeLabel} · {a.id}</div>
              </td>
              <td class="td"><span class={stageColor[a.stage] ?? ''}>{a.stage}</span></td>
              <td class="td text-right text-dim">${a.drawdownLimit.toLocaleString()}</td>
              <td class="td text-right">{a.trades}</td>
              <td class="td text-right">{a.winRate === null ? '—' : a.winRate.toFixed(0) + '%'}</td>
              <td class:list={['td text-right', a.grossPnl >= 0 ? 'text-up' : 'text-down']}>{fmtPnl(a.grossPnl)}</td>
              <td class="td text-right text-dim">{a.payouts ? fmtPnl(-a.payouts) : '—'}</td>
              <td class:list={['td text-right', a.netPnl >= 0 ? 'text-up' : 'text-down']}>{fmtPnl(a.netPnl)}</td>
              <td class:list={['td text-right', a.sumR >= 0 ? 'text-up' : 'text-down']}>{a.sumR > 0 ? '+' : ''}{a.sumR.toFixed(2)}R</td>
              <td class="td">
                <div class="flex items-center justify-end gap-2">
                  <div class="h-1.5 w-20 bg-raise">
                    <div class="h-full" style={`width:${a.ddUsedPct}%`} class:list={[a.ddUsedPct > 70 ? 'bg-down' : 'bg-up']} />
                  </div>
                  <span class="w-24 text-right text-2xs text-dim">${a.buffer.toLocaleString()} left</span>
                </div>
              </td>
            </tr>
          ))}
          {perAccount.length === 0 && (
            <tr><td class="td text-faint" colspan="10">no accounts yet</td></tr>
          )}
        </tbody>
      </table>
      </div>
    </div>

    <div id="recent" class="mt-14 scroll-mt-28 panel">
      <div class="card-hd border-b border-sep">
        <span class="card-ico">📈</span>
        <span class="card-lbl">recent trades</span>
        <span class="card-sub">last {recent.length}</span>
      </div>
      <div class="overflow-x-auto" tabindex="0">
      <table class="w-full min-w-[820px] border-collapse">
        <thead>
          <tr>
            <th class="th">date</th>
            <th class="th">dir</th>
            <th class="th">setup</th>
            <th class="th text-right">entry</th>
            <th class="th text-right">exit</th>
            <th class="th text-right">points</th>
            <th class="th text-right">risk</th>
            <th class="th text-right">R</th>
            <th class="th">accounts</th>
            <th class="th">note</th>
          </tr>
        </thead>
        <tbody>
          {recent.map((t) => (
            <tr>
              <td class="td text-dim"><a class="hover:text-accent" href={`/day/${fmtDay(t.day)}`}>{fmtDayWUpper(t.day)}</a></td>
              <td class="td">
                <span class={t.direction === 'long' ? 'text-up' : 'text-down'}>{t.direction === 'long' ? '▲ L' : '▼ S'}</span>
              </td>
              <td class="td text-dim">{t.setup ?? '—'}</td>
              <td class="td text-right">{t.entry}</td>
              <td class="td text-right">{t.exit}</td>
              <td class="td text-right">{fmtPts(t.points)}</td>
              <td class="td text-right text-dim">{t.riskPoints}pts</td>
              <td class:list={['td text-right', t.R > 0 ? 'text-up' : t.R < 0 ? 'text-down' : '']}>{t.R > 0 ? '+' : ''}{t.R.toFixed(2)}R</td>
              <td class="td text-xs text-dim">
                {(() => {
                  const day = days.find((d) => d.data.date === t.day)
                  const exec = day?.data.trades[t.tradeId]?.executions ?? []
                  return exec.length ? exec.map((e) => accountLabel.get(e.account) ?? e.account).join(' · ') : '—'
                })()}
              </td>
              <td class="td max-w-[200px] truncate text-dim">{t.note ?? ''}</td>
            </tr>
          ))}
          {recent.length === 0 && (
            <tr><td class="td text-faint" colspan="10">no trades logged yet — the first one starts the curve.</td></tr>
          )}
        </tbody>
      </table>
      </div>
    </div>

    <div id="habits" class="mt-14 scroll-mt-28">
      <div class="grid min-w-0 gap-6 lg:grid-cols-2">
        {habitStats.map((h) => (
          <div class="min-w-0 panel">
            <div class="card-hd border-b border-sep">
              <span class="card-ico">{h.emoji ?? '✅'}</span>
              <span class="card-lbl">{h.name}</span>
              <span class="tmr">{h.currentStreak}d</span>
            </div>
            <div class="p-4">
              <div class="flex items-baseline gap-4">
                <span class="text-2xl" style={`color:${h.color}`}>{h.currentStreak}<span class="text-sm text-dim">d</span></span>
                <div class="text-xs text-dim">best {h.bestStreak}d · 30d {h.pct30 === null ? '—' : h.pct30.toFixed(0) + '%'} · all {h.pctAll === null ? '—' : h.pctAll.toFixed(0) + '%'}</div>
              </div>
              <div class="mt-5"><Heatmap data={h.heatmap} color={h.color} name={h.name} /></div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div id="trends" class="mt-14 scroll-mt-28 panel">
      <div class="card-hd border-b border-sep">
        <span class="card-ico">📈</span>
        <span class="card-lbl">trends</span>
        <span class="card-sub">rolling windows</span>
      </div>
      <div class="overflow-x-auto" tabindex="0">
      <table class="w-full min-w-[720px] border-collapse">
        <thead>
          <tr><th class="th">window</th><th class="th text-right">days</th><th class="th text-right">trades</th><th class="th text-right">win%</th><th class="th text-right">sum R</th><th class="th text-right">avg R</th><th class="th text-right">$ pnl</th></tr>
        </thead>
        <tbody>
          {trends.windows.map((w) => (
            <tr>
              <td class="td text-ink">{w.label}</td>
              <td class="td text-right">{w.days}</td>
              <td class="td text-right">{w.trades}</td>
              <td class="td text-right">{w.winRate === null ? '—' : w.winRate.toFixed(1) + '%'}</td>
              <td class="td text-right text-dim">{w.sumR > 0 ? '+' : ''}{w.sumR.toFixed(2)}</td>
              <td class:list={['td text-right', w.avgR > 0 ? 'text-up' : w.avgR < 0 ? 'text-down' : '']}>{w.avgR > 0 ? '+' : ''}{w.avgR.toFixed(2)}R</td>
              <td class:list={['td text-right', w.sumPnl >= 0 ? 'text-up' : 'text-down']}>{w.sumPnl >= 0 ? '+' : ''}${Math.round(w.sumPnl).toLocaleString()}</td>
            </tr>
          ))}
        </tbody>
      </table>
      </div>
    </div>

    <div class="mt-10 grid min-w-0 gap-6 lg:grid-cols-2">
      <div class="min-w-0 panel">
        <div class="card-hd border-b border-sep">
          <span class="card-ico">😴</span>
          <span class="card-lbl">R by sleep</span>
        </div>
        <div class="overflow-x-auto" tabindex="0"><CorrTable label="bucket" rows={trends.correlations.sleep} /></div>
      </div>
      <div class="min-w-0 panel">
        <div class="card-hd border-b border-sep">
          <span class="card-ico">🎭</span>
          <span class="card-lbl">R by mood</span>
        </div>
        <div class="overflow-x-auto" tabindex="0"><CorrTable label="bucket" rows={trends.correlations.mood} /></div>
      </div>
      <div class="min-w-0 panel">
        <div class="card-hd border-b border-sep">
          <span class="card-ico">✅</span>
          <span class="card-lbl">R by habits</span>
        </div>
        <div class="overflow-x-auto" tabindex="0"><CorrTable label="bucket" rows={trends.correlations.habits} /></div>
      </div>
      <div class="min-w-0 panel">
        <div class="card-hd border-b border-sep">
          <span class="card-ico">📱</span>
          <span class="card-lbl">R by screen</span>
        </div>
        <div class="overflow-x-auto" tabindex="0"><CorrTable label="bucket" rows={trends.correlations.screen} /></div>
      </div>
      <div class="min-w-0 panel">
        <div class="card-hd border-b border-sep">
          <span class="card-ico">🕐</span>
          <span class="card-lbl">R by session</span>
        </div>
        <div class="overflow-x-auto" tabindex="0"><CorrTable label="session" rows={trends.correlations.session} /></div>
      </div>
      <div class="min-w-0 panel">
        <div class="card-hd border-b border-sep">
          <span class="card-ico">🎯</span>
          <span class="card-lbl">R by setup</span>
        </div>
        <div class="overflow-x-auto" tabindex="0"><CorrTable label="setup" rows={trends.correlations.setup} /></div>
      </div>
    </div>

    {trends.flags.length > 0 && (
      <div class="mt-14">
        <h2 class="text-lg">/ observations</h2>
        <ul class="mt-4 space-y-2">
          {trends.flags.map((f) => (
            <li class="flex gap-3 border-b border-line/60 pb-2 text-sm text-soft"><span class="text-faint">›</span><span>{f}</span></li>
          ))}
        </ul>
      </div>
    )}
  </section>
</Base>
