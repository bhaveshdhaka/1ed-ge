---
import Base from '../layouts/Base.astro'
import { getCollection } from 'astro:content'
import { buildHabitStats } from '../lib/habits'
import Heatmap from '../components/Heatmap.astro'

const [habits, days] = await Promise.all([getCollection('habits'), getCollection('days')])
const stats = buildHabitStats(habits, days)
const doneToday = stats.filter((h) => h.doneToday === true).length

const wd = ['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat']

const last7 = stats.length
  ? Array.from({ length: 7 }, (_, i) => {
      const d = new Date()
      d.setDate(d.getDate() - (6 - i))
      return d
    }).map((d) => {
      const key = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`
      const done = stats.filter((h) => h.heatmap.find((x) => x.date === key)?.value === true).length
      return { key, done, total: stats.length, label: wd[d.getDay()] }
    })
  : []
---

<Base title="tracker — 1ed.ge" description="The six daily habits behind the trading: quiet time, trade clean, eat clean, write, work out, create art. Streaks and heatmaps, public.">
  <section class="shell pt-12 pb-20">
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <h1 class="text-2xl">/ tracker</h1>
      <span class="text-[12px] text-faint">the habits behind the trading</span>
      <span class="ml-auto text-[13px] text-dim">
        today: <span class={doneToday === stats.length && stats.length ? 'text-up' : 'text-ink'}>{doneToday}/{stats.length}</span>
        <span class="mx-2 text-faint">·</span>
        <span class="cursor-blink text-accent">▋</span>
      </span>
    </div>

    <div class="mt-8 grid grid-cols-7 gap-1">
      {last7.map((d) => (
        <a href={`/day/${d.key}`} class="panel p-3 text-center transition-colors hover:border-accent">
          <div class="text-[10px] uppercase tracking-widest text-dim">{d.label}</div>
          <div class:list={['mt-1 text-[15px]', d.done === d.total ? 'text-up' : 'text-ink']}>
            {d.done}/{d.total}
          </div>
        </a>
      ))}
    </div>

    <div class="mt-10 grid gap-10 lg:grid-cols-2">
      {stats.map((h) => (
        <div class="panel p-5">
          <div class="flex items-baseline justify-between">
            <div class="flex items-baseline gap-2">
              <span class="text-[15px] text-ink">{h.emoji ?? '·'} {h.name}</span>
            </div>
            <span class="text-[11px] uppercase tracking-widest text-faint">streak</span>
          </div>
          <div class="mt-1 flex items-baseline gap-4">
            <span class="text-2xl" style={`color:${h.color}`}>
              {h.currentStreak}
              <span class="text-sm text-dim">d</span>
            </span>
            <div class="text-[12px] text-dim">
              best {h.bestStreak}d · 30d {h.pct30 === null ? '—' : h.pct30.toFixed(0) + '%'} · all {h.pctAll === null ? '—' : h.pctAll.toFixed(0) + '%'}
            </div>
          </div>
          <div class="mt-4 flex items-center gap-1.5">
            {h.last7.map((v, i) => (
              <div
                class="flex h-8 w-8 items-center justify-center border text-[12px]"
                class:list={[v === null ? 'border-line bg-bg text-faint' : v ? 'border-transparent text-bg' : 'border-line bg-raise text-dim']}
                style={v === true ? `background:${h.color}` : ''}
              >
                {v === null ? '·' : v ? '✓' : '×'}
              </div>
            ))}
          </div>
          <div class="mt-5">
            <Heatmap data={h.heatmap} color={h.color} />
          </div>
        </div>
      ))}
      {stats.length === 0 && (
        <p class="col-span-full text-[13px] text-faint">no habits defined yet.</p>
      )}
    </div>
  </section>
</Base>
