---
import Base from '../layouts/Base.astro'
import Card from '../components/ui/Card.astro'

const VERSION = 'v0.1-alpha'
const VERSION_DATE = '2026-08-10'

const stack = [
  { layer: 'Framework', tech: 'Astro 5 (static-first) + @astrojs/node (SSR)', note: 'zero JS on public pages' },
  { layer: 'Styling', tech: 'Tailwind CSS v4', note: '3-layer token architecture' },
  { layer: 'Language', tech: 'TypeScript', note: 'strict mode' },
  { layer: 'Admin', tech: 'React (islands)', note: 'client-side, zen area only' },
  { layer: 'AI', tech: 'OpenRouter — DeepSeek + Qwen2.5-VL', note: 'day structuring, coach, screenshot reading' },
  { layer: 'Images', tech: 'sharp (webp)', note: 'auto-conversion on upload' },
  { layer: 'Content', tech: 'Markdown + gray-matter', note: 'files are the database' },
  { layer: 'Hosting', tech: 'VPS + Docker + nginx', note: 'preprod + prod worktrees' },
]

const tools = [
  { name: 'OpenCode', what: 'AI coding assistant', role: 'orchestrates all agent work' },
  { name: 'cline-pass/mimo-v2.5-pro', what: 'Orchestrator model', role: 'primary reasoning, planning, coordination' },
  { name: 'deepseek-v4-flash', what: 'Fast agent model', role: 'explorer, fixer, librarian, observer' },
  { name: 'qwen3.7-plus', what: 'Oracle + designer model', role: 'architecture review, UI/UX design' },
  { name: 'TypeScript LSP', what: 'Language server', role: 'type checking, diagnostics' },
  { name: 'AST grep', what: 'Structural search', role: 'codebase-wide pattern matching' },
  { name: 'Playwright', what: 'Browser automation', role: 'visual verification, testing' },
]

const features = [
  { category: 'Public Pages', items: [
    'Homepage — today card, market widget, stream feed',
    'Stream — rolling feed of published thoughts (trades, notes, quotes)',
    'Journal — daily entries with search, month grouping, tags',
    'Calendar — 8-day market calendar with session windows and news events',
    'Performance — R dashboard: equity curve, histogram, heatmap, correlations, trends',
    'Models — trading models with rules, stats, and trade history',
    'Accounts — prop firm lifecycle (eval → funded → buffer → payout), drawdown tracking',
    'Tape — period reviews (week, month, quarter, half, year) with AI comparison',
    'Coach — AI f-R-iend conversations (public)',
    'About — rules, prop firms, timeline',
    '/dev — this page (build log, stack, features, changelog, costs)',
    'Day archive — per-day page with facts, trades, news, brief, reflection, moments',
  ]},
  { category: 'Market Data', items: [
    'CME trading day as the organizing unit (17:00 CT boundary, DST-safe)',
    'Live market countdown — CME, NYSE, TSE, LSE session status',
    'Market widget — chronograph rail with event dots, session rows, live clock',
    'News events — deterministic fetch from TradingView + Faireconomy (no AI)',
    'Pre-market brief — AI-generated daily snapshot from verified data',
    'Market footer — collapsible market status on every page',
  ]},
  { category: 'Content Model', items: [
    'Day records — mood, sleep, habits, device/screen time, trades, stream, draft',
    'Trades — market, direction, session, setup, model tag, entry/stop/exit, R, commentary, screenshots',
    'Stream moments — trade, note, quote with timestamps and images',
    'Habits — boolean or count, streak tracking, heatmap visualization',
    'Journal — markdown with title, summary, tags, featured image',
    'Accounts — firm, size, stage, rules, platform IDs, stages history',
    'Payouts — per-account payout records',
    'Reviews — period review notes with AI comparison',
  ]},
  { category: 'Admin (Zen)', items: [
    'Passkey auth (WebAuthn) — biometric login, no passwords',
    'Day workspace — ephemeral capture → AI structure → evidence-first summary → trades → moments → reflection',
    'AI-first input — paste screenshots, AI reads and structures everything',
    'Markdown editor — write/preview with ghost text suggestions',
    'Trade import — CSV/PDF statement parsing with fill-id attribution',
    'Accounts tab — statement screenshot reader, account management, payout tracking',
    'Coach tab — AI conversation with data context',
    'Library — habits, models, rules, quotes CRUD with drag-reorder',
    'Review — period review notes with AI comparison generation',
    'Media — image/document management with alt-text',
    'Overview — today status, build queue, accounts, daily brief, system diagnostics',
    'Rebuild bar — queued changes with one-click rebuild',
    'Notification drawer — pending reflections, period reviews, rebuild status',
  ]},
  { category: 'Design System', items: [
    'WhatsApp Logger v2 aesthetic — glass cards, structured headers, body gradients',
    '3-layer token architecture — palette, semantic, material',
    'Unified Card component — 4 variants (default, hero, static, flat) + stat display',
    'Card header system — icon, label, subtitle, actions slot',
    'Motion tokens — --motion-fast/normal/slow, transitions on interactive elements',
    'Bottom-sheet lightbox — slide-up, swipe-to-close, image preload, keyboard nav',
    'Mobile-optimized — reduced blur, 44px touch targets, safe-area padding',
    'Display timezone — browser-local time conversion on public pages',
    'Admin timezone picker — 7 cities (LAX, NYC, LON, DEL, HKG, TYO, SYD)',
  ]},
  { category: 'Infrastructure', items: [
    'Preprod + prod worktrees on same repo (preprod ↔ main branches)',
    'Content guard — blocks test content from syncing to prod',
    'Docker compose deployment — bind-mounts content + media',
    'nginx reverse proxy — SSL, media proxying, vhost config',
    '30-min autosave cron — auto-commits uncommitted content changes',
    'Market-news fetch cron — every 8h, deterministic from TradingView + Faireconomy',
    'Ship script — preprod→main, main→preprod, prod-only, test-only directions',
    'Pipeline scripts — where-am-i, audit-pipeline, verify-env, deploy-test, deploy-prod',
  ]},
  { category: 'AI Integration', items: [
    'OpenRouter — DeepSeek for text, Qwen2.5-VL for screenshots',
    'Day structuring — paste text + screenshots → structured day record',
    'Coach — AI f-R-iend with full data context',
    'Draft reflection — AI writes first draft from day data',
    'Screenshot reading — trade charts, screen time, device stats',
    'Alt text — cheap model generates SEO alt text for uploaded media',
    'Review comparison — AI factual comparison of period stats',
    'Assist — general AI helper in the admin',
  ]},
]

const principles = [
  { rule: 'Everything public', detail: 'Every trade, every account, every R. The only private thing is the zen admin area.' },
  { rule: 'Files are the database', detail: 'Markdown frontmatter. No SQL, no ORM, no migrations.' },
  { rule: 'Zero JS on public pages', detail: 'All charts are server-rendered SVG. The lightbox and timezone script are the only exceptions.' },
  { rule: 'CME is the master clock', detail: 'Day status comes from the CME equity-index-futures calendar. NYSE/TSE/LSE are secondary.' },
  { rule: 'R is the only metric', detail: 'R = points risked vs points made. Performance math is risk-based.' },
  { rule: 'Security by obscurity', detail: 'The admin is at a secret URL. API keys are in .env (gitignored).' },
]

const changelog = [
  {
    version: 'v0.1-alpha',
    date: '2026-08-10',
    features: [
      'Design system audit — 81 items across 9 phases, 75 files',
      'CME trading day as the organizing unit (replaces calendar day)',
      'Display timezone — browser-local conversion on public pages, admin picker',
      'Lightbox as bottom sheet — slide-up, swipe-to-close, keyboard nav',
      'Unified Card system — one component, 4 variants, all surfaces',
      'Motion token system — seg transitions, btn active, capsule hover',
      'Mobile blur reduction — 4px on iPhone for smoother scrolling',
      'Ticker consolidation — single shared interval, pauses on hidden tab',
      'Dead dependency cleanup — 11 unused packages removed',
    ],
    fixes: [
      '3 UTC bugs (coach, media, NotificationDrawer)',
      'iOS/Safari: min-h-svh, safe-area nav, 44px touch targets, theme-color sync',
      'Date compliance: fmtDayWUpper across all surfaces (67 violations → 0)',
      'Type scale compliance: text-[12px]/text-[13px] → tokens (67 violations → 0)',
      'Legacy chart tokens removed (--chart-grid, --chart-alt)',
      '15 dead component files deleted',
    ],
  },
  {
    version: 'v0.0',
    date: 'pre-2026-08-10',
    features: [
      'Initial build — public trading journal with all core features',
      'Admin (zen) with passkey auth and AI-first day input',
      'Market news (deterministic fetch), pre-market brief',
      'Performance dashboard, period reviews, models & rules',
      'Accounts & payouts, coach (AI f-R-iend)',
      'Design system foundation (3-layer tokens, glass cards)',
    ],
    fixes: [],
  },
]

const costs = [
  { version: 'v0.0', date: 'pre-2026-08-10', what: 'Initial build — all core features, admin, design system foundation', estimate: '$50' },
  { version: 'v0.1-alpha', date: '2026-08-10', what: 'Design system audit, CME trading day, display timezone, lightbox, Card unification, motion tokens, polish', estimate: '$4' },
]

const totalCost = '$54'
---

<Base title="/dev — 1ed.ge" description="The build log: tech stack, features, principles, changelog, and token costs. Everything public.">
  <section class="shell pt-12 pb-20">
    <div class="flex flex-wrap items-baseline gap-3">
      <h1 class="text-2xl text-ink">/ dev</h1>
      <span class="text-xs text-faint">{VERSION} · {VERSION_DATE}</span>
    </div>
    <p class="mt-2 max-w-2xl text-sm text-dim">
      How this site was built. What it uses. What it cost. Everything public.
    </p>

    <!-- Principles -->
    <div class="mt-10">
      <Card icon="🧭" label="principles" subtitle="the rules we build by">
        <div class="flex flex-col gap-3">
          {principles.map((p) => (
            <div class="flex flex-col gap-0.5">
              <span class="text-sm text-ink">{p.rule}</span>
              <span class="text-xs text-dim">{p.detail}</span>
            </div>
          ))}
        </div>
      </Card>
    </div>

    <!-- Stack -->
    <div class="mt-6">
      <Card icon="🛠" label="stack" subtitle="what we use">
        <div class="overflow-x-auto">
          <table class="w-full border-collapse">
            <thead>
              <tr>
                <th class="th">layer</th>
                <th class="th">technology</th>
                <th class="th">note</th>
              </tr>
            </thead>
            <tbody>
              {stack.map((s) => (
                <tr>
                  <td class="td text-dim">{s.layer}</td>
                  <td class="td text-ink">{s.tech}</td>
                  <td class="td text-faint">{s.note}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </Card>
    </div>

    <!-- Build Tools -->
    <div class="mt-6">
      <Card icon="🤖" label="build tools" subtitle="AI-assisted development">
        <div class="overflow-x-auto">
          <table class="w-full border-collapse">
            <thead>
              <tr>
                <th class="th">tool</th>
                <th class="th">what</th>
                <th class="th">role</th>
              </tr>
            </thead>
            <tbody>
              {tools.map((t) => (
                <tr>
                  <td class="td text-ink">{t.name}</td>
                  <td class="td text-dim">{t.what}</td>
                  <td class="td text-faint">{t.role}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </Card>
    </div>

    <!-- Features -->
    <div class="mt-6">
      <Card icon="✨" label="features" subtitle="what the site does">
        <div class="grid gap-6 md:grid-cols-2">
          {features.map((f) => (
            <div>
              <div class="mb-2 text-2xs uppercase tracking-widest text-dim">{f.category}</div>
              <ul class="flex flex-col gap-1">
                {f.items.map((item) => (
                  <li class="flex items-start gap-2 text-xs text-soft">
                    <span class="mt-1 h-1 w-1 shrink-0 rounded-full bg-accent"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </Card>
    </div>

    <!-- Changelog -->
    <div class="mt-6">
      <Card icon="📋" label="changelog" subtitle="what changed">
        <div class="flex flex-col gap-6">
          {changelog.map((c) => (
            <div>
              <div class="mb-2 flex items-baseline gap-2">
                <span class="text-sm font-semibold text-ink">{c.version}</span>
                <span class="text-2xs text-faint">{c.date}</span>
              </div>
              {c.features.length > 0 && (
                <div class="mb-2">
                  <div class="mb-1 text-2xs uppercase tracking-widest text-dim">features</div>
                  <ul class="flex flex-col gap-1">
                    {c.features.map((f) => (
                      <li class="flex items-start gap-2 text-xs text-soft">
                        <span class="mt-1 h-1 w-1 shrink-0 rounded-full bg-up"></span>
                        <span>{f}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {c.fixes.length > 0 && (
                <div>
                  <div class="mb-1 text-2xs uppercase tracking-widest text-dim">fixes</div>
                  <ul class="flex flex-col gap-1">
                    {c.fixes.map((f) => (
                      <li class="flex items-start gap-2 text-xs text-soft">
                        <span class="mt-1 h-1 w-1 shrink-0 rounded-full bg-warn"></span>
                        <span>{f}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          ))}
        </div>
      </Card>
    </div>

    <!-- Token Costs -->
    <div class="mt-6">
      <Card icon="💰" label="token costs" subtitle="what it took to build this">
        <div class="overflow-x-auto">
          <table class="w-full border-collapse">
            <thead>
              <tr>
                <th class="th">version</th>
                <th class="th">date</th>
                <th class="th">what</th>
                <th class="th text-right">estimate</th>
              </tr>
            </thead>
            <tbody>
              {costs.map((c) => (
                <tr>
                  <td class="td text-ink">{c.version}</td>
                  <td class="td text-dim">{c.date}</td>
                  <td class="td text-faint">{c.what}</td>
                  <td class="td text-right text-ink">{c.estimate}</td>
                </tr>
              ))}
              <tr>
                <td class="td font-semibold text-ink" colspan="3">total</td>
                <td class="td text-right font-semibold text-ink">{totalCost}</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="mt-3 text-2xs text-faint">
          Estimates based on OpenRouter pricing for DeepSeek v4 Flash and Qwen 3.7 Plus.
          Actual costs vary by token volume and model selection per agent run.
        </p>
      </Card>
    </div>

    <!-- Footer note -->
    <p class="mt-10 text-2xs text-faint">
      this page is maintained by AI. every code change is accounted for here.
      the version increments when meaningful features ship. token costs are estimates.
    </p>
  </section>
</Base>
