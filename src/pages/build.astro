            <Table head={['token', 'value', 'purpose']} class="mt-1">
              {hueTokens.map((t) => (
                <tr>
                  <td class="td font-mono text-2xs text-accent">{t.token}</td>
                  <td class="td">
                    <span class="inline-flex items-center gap-2">
                      <span class="inline-block h-3 w-3 rounded-sm border border-line" style={`background:${t.value}`}></span>
                      <span class="font-mono text-2xs">{t.value}</span>
                    </span>
                  </td>
                  <td class="td text-dim">—</td>
                </tr>
              ))}
            </Table>
          </div>
        </Card>
      </div>

      <!-- Type Scale -->
      <div id="type" class="mt-6 scroll-mt-28">
        <Card icon="🔤" label="type scale" subtitle={`auto-generated · updated ${rel(buildAt)}`}>
          <p class="mb-3 text-xs text-dim">Syne Variable is reserved for the wordmark only. Auto-generated from app.css.</p>
          <div class="overflow-x-auto">
            <Table head={['token', 'value', 'usage']} class="mt-1">
              {textTokens.map((t) => (
                <tr>
                  <td class="td font-mono text-2xs text-accent">{t.token}</td>
                  <td class="td font-mono text-2xs">{t.value}</td>
                  <td class="td text-dim">—</td>
                </tr>
              ))}
            </Table>
          </div>
        </Card>
      </div>

      <!-- Material Tokens -->
      <div id="material" class="mt-6 scroll-mt-28">
        <Card icon="⚙️" label="material tokens" subtitle={`Layer 3 · auto-generated · updated ${rel(buildAt)}`}>
          <div class="overflow-x-auto">
            <Table head={['token', 'value', 'usage']} class="mt-1">
              {materialTokens.map((t) => (
                <tr>
                  <td class="td font-mono text-2xs text-accent">{t.token}</td>
                  <td class="td font-mono text-2xs">{t.value}</td>
                  <td class="td text-dim">—</td>
                </tr>
              ))}
            </Table>
          </div>
        </Card>
      </div>

      <!-- Card System -->
      <div id="cards" class="mt-10 scroll-mt-28">
        <Card icon="🃏" label="card system" subtitle="the one panel primitive">
          <p class="mb-4 text-sm text-soft">
            Every surface on 1ed.ge uses the <code class="border border-line bg-raise px-1.5 py-0.5 text-2xs text-accent">Card</code> component. Never hand-build <code class="border border-line bg-raise px-1.5 py-0.5 text-2xs text-accent">.panel</code> + <code class="border border-line bg-raise px-1.5 py-0.5 text-2xs text-accent">.card-hd</code> markup. This is non-negotiable.
          </p>

          <div class="mb-4 text-4xs font-bold uppercase text-faint" style="letter-spacing:0.6px">Variants</div>
          <div class="grid gap-3 md:grid-cols-2">
            {cardVariants.map((v) => (
              <div class="well p-3">
                <div class="flex items-baseline gap-2">
                  <span class="font-mono text-xs text-accent">{v.variant}</span>
                  <span class="font-mono text-2xs text-faint">.{v.class}</span>
                </div>
                <p class="mt-1 text-xs text-dim">{v.description}</p>
              </div>
            ))}
          </div>

          <Separator class="my-4" />

          <div class="mb-3 text-4xs font-bold uppercase text-faint" style="letter-spacing:0.6px">Props</div>
          <div class="overflow-x-auto">
            <table class="w-full border-collapse">
              <thead>
                <tr>
                  <th class="th">prop</th>
                  <th class="th">type</th>
                  <th class="th">default</th>
                  <th class="th">description</th>
                </tr>
              </thead>
              <tbody>
                <tr><td class="td font-mono text-2xs text-accent">icon</td><td class="td text-dim">string</td><td class="td text-dim">—</td><td class="td text-dim">Emoji for card-ico</td></tr>
                <tr><td class="td font-mono text-2xs text-accent">label</td><td class="td text-dim">string</td><td class="td text-dim">—</td><td class="td text-dim">Text for card-lbl (UPPERCASE)</td></tr>
                <tr><td class="td font-mono text-2xs text-accent">subtitle</td><td class="td text-dim">string</td><td class="td text-dim">—</td><td class="td text-dim">Text for card-sub</td></tr>
                <tr><td class="td font-mono text-2xs text-accent">variant</td><td class="td text-dim">'default' | 'hero' | 'static' | 'flat'</td><td class="td text-dim">'default'</td><td class="td text-dim">Panel variant</td></tr>
                <tr><td class="td font-mono text-2xs text-accent">pad</td><td class="td text-dim">'none' | 'sm' | 'md'</td><td class="td text-dim">'md'</td><td class="td text-dim">Body padding</td></tr>
                <tr><td class="td font-mono text-2xs text-accent">stat</td><td class="td text-dim">{`{ value, delta?, tone? }`}</td><td class="td text-dim">—</td><td class="td text-dim">Stat display mode (no card-hd)</td></tr>
                <tr><td class="td font-mono text-2xs text-accent">class</td><td class="td text-dim">string</td><td class="td text-dim">''</td><td class="td text-dim">Additional classes</td></tr>
              </tbody>
            </table>
          </div>

          <Separator class="my-4" />

          <div class="mb-3 text-4xs font-bold uppercase text-faint" style="letter-spacing:0.6px">Named Slots</div>
          <div class="flex gap-4">
            <div class="well p-3 flex-1">
              <span class="font-mono text-xs text-accent">actions</span>
              <p class="mt-1 text-xs text-dim">Rendered ml-auto in the card-hd row</p>
            </div>
            <div class="well p-3 flex-1">
              <span class="font-mono text-xs text-accent">default</span>
              <p class="mt-1 text-xs text-dim">Card body content</p>
            </div>
            <div class="well p-3 flex-1">
              <span class="font-mono text-xs text-accent">subtitle</span>
              <p class="mt-1 text-xs text-dim">Rich HTML subtitle (slot override)</p>
            </div>
          </div>

          <Separator class="my-4" />

          <div class="mb-3 text-4xs font-bold uppercase text-faint" style="letter-spacing:0.6px">Rendered Examples</div>
          <div class="grid gap-4 md:grid-cols-2">
            <Card icon="📈" label="default" subtitle="glass panel">
              <p class="text-xs text-dim">The standard card with backdrop blur and entrance animation.</p>
              <p class="mt-2 text-2xs text-faint">Used everywhere — stream, journal, about, this page.</p>
            </Card>
            <Card icon="⚡" label="hero" subtitle="accent glow" variant="hero">
              <p class="text-xs text-dim">Featured card with accent border and gradient background.</p>
              <p class="mt-2 text-2xs text-faint">Used for today's card on the homepage, calendar current day.</p>
            </Card>
            <Card icon="📊" label="static" subtitle="no animation" variant="static">
              <StatCard label="SAMPLE STAT" value="+2.50R" tone="up" />
              <p class="mt-2 text-2xs text-faint">Same glass panel, no entrance animation. For stat grids.</p>
            </Card>
            <Card icon="📋" label="flat" subtitle="nested" variant="flat">
              <p class="text-xs text-dim">Background + border only. No blur, no shadow, no animation.</p>
              <p class="mt-2 text-2xs text-faint">For nested cards, tables, inline details.</p>
            </Card>
          </div>
          <div class="mt-4">
            <Card label="stat mode" stat={{ value: '+3.20', delta: 'vs last week +0.75', tone: 'up' }}>
              <p class="text-2xs text-faint">Stat display mode — no card-hd header. Compact number display.</p>
            </Card>
          </div>
        </Card>
      </div>

      <!-- Typography Rules -->
      <div id="typography" class="mt-6 scroll-mt-28">
        <Card icon="📐" label="typography rules" subtitle="every element, one spec">
          <p class="mb-4 text-sm text-soft">
            Every text element in every card follows this spec. No exceptions.
          </p>
          <div class="overflow-x-auto">
            <table class="w-full border-collapse">
              <thead>
                <tr>
                  <th class="th">element</th>
                  <th class="th">token</th>
                  <th class="th">weight</th>
                  <th class="th">case</th>
                  <th class="th">tracking</th>
                  <th class="th">color</th>
                </tr>
              </thead>
              <tbody>
                {typographyRules.map((r) => (
                  <tr>
                    <td class="td text-ink">{r.element}</td>
                    <td class="td font-mono text-2xs text-accent">{r.token}</td>
                    <td class="td text-dim">{r.weight}</td>
                    <td class="td text-dim">{r.case}</td>
                    <td class="td text-dim">{r.tracking}</td>
                    <td class="td text-dim">{r.color}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </Card>
      </div>

      <!-- UI Primitives -->
      <div id="primitives" class="mt-10 scroll-mt-28">
        <Card icon="🧩" label="UI primitives" subtitle={`${primitives.length} primitives · auto-generated · updated ${rel(buildAt)}`} variant="flat">
          <p class="mb-3 text-xs text-dim">
            Auto-generated from src/components/ui/*.astro on each deploy.
          </p>
          <div class="grid gap-3 md:grid-cols-2">
            {primitives.map((p) => (
              <Card variant="flat" pad="sm">
                <div class="text-xs font-semibold text-ink">{p.name}</div>
                <p class="mt-1 text-2xs text-dim">{p.description}</p>
              </Card>
            ))}
          </div>
        </Card>
      </div>

      <!-- Composite Components -->
      <div id="composites" class="mt-6 scroll-mt-28">
        <Card icon="📦" label="composite components" subtitle="built on primitives · rendered live">
          <p class="mb-4 text-sm text-soft">
            These components are built entirely from the primitives above. Each is rendered live with real trading-shaped data — what you see is exactly what ships.
          </p>

          <div class="flex flex-col gap-6">
            <!-- DayFacts -->
            <Card icon="📊" label="DayFacts" subtitle="facts strip" variant="flat">
              <p class="mb-3 text-xs text-dim">Mood/sleep/screen/habits/trades/R in a flex-wrap row of Well cells. Only R carries color.</p>
              <DayFacts cells={sampleFactCells} />
            </Card>

            <!-- ThoughtCard — trade -->
            <Card icon="📈" label="ThoughtCard · trade" subtitle="long trade +2.50R" variant="flat">
              <p class="mb-3 text-xs text-dim">Published stream moment. Rail identity: trade = up/down matched to direction. Uses Card with pad="none".</p>
              <ThoughtCard thought={sampleThoughts[0]} />
            </Card>

            <!-- ThoughtCard — note -->
            <Card icon="💭" label="ThoughtCard · note" subtitle="pre-market note" variant="flat">
              <p class="mb-3 text-xs text-dim">Note = quiet rail. No color, muted framing.</p>
              <ThoughtCard thought={sampleThoughts[1]} />
            </Card>

            <!-- ThoughtCard — quote -->
            <Card icon="💬" label="ThoughtCard · quote" subtitle="trading wisdom" variant="flat">
              <p class="mb-3 text-xs text-dim">Quote = accent left rail. Distinct from notes and trades.</p>
              <ThoughtCard thought={sampleThoughts[2]} />
            </Card>
          </div>
        </Card>
      </div>

      <!-- CSS Classes Reference -->
      <div id="classes" class="mt-6 scroll-mt-28">
        <Card icon="📝" label="CSS classes" subtitle="the vocabulary">
          <div class="grid gap-3 md:grid-cols-2">
            <div class="well p-3">
              <code class="text-xs text-accent">.shell</code>
              <p class="mt-1 text-xs text-dim">Page wrapper. max-w-6xl, px-5 md:px-8.</p>
            </div>
            <div class="well p-3">
              <code class="text-xs text-accent">.panel</code> / <code class="text-xs text-accent">.panel-hero</code> / <code class="text-xs text-accent">.panel-static</code> / <code class="text-xs text-accent">.panel-flat</code>
              <p class="mt-1 text-xs text-dim">Card variants. Use via Card component.</p>
            </div>
            <div class="well p-3">
              <code class="text-xs text-accent">.card-hd</code> / <code class="text-xs text-accent">.card-ico</code> / <code class="text-xs text-accent">.card-lbl</code> / <code class="text-xs text-accent">.card-sub</code> / <code class="text-xs text-accent">.tmr</code>
              <p class="mt-1 text-xs text-dim">Card header system. Use via Card props.</p>
            </div>
            <div class="well p-3">
              <code class="text-xs text-accent">.well</code>
              <p class="mt-1 text-xs text-dim">Inset recessed surface. background: var(--color-inset).</p>
            </div>
            <div class="well p-3">
              <code class="text-xs text-accent">.capsule</code>
              <p class="mt-1 text-xs text-dim">Accent-tinted pill. Rounded-full, 10px, 600 weight.</p>
            </div>
            <div class="well p-3">
              <code class="text-xs text-accent">.seg</code> / <code class="text-xs text-accent">.seg-on</code>
              <p class="mt-1 text-xs text-dim">Segmented control. Shell + active segment.</p>
            </div>
            <div class="well p-3">
              <code class="text-xs text-accent">.btn</code> / <code class="text-xs text-accent">.btn-primary</code> / <code class="text-xs text-accent">.btn-danger</code> / <code class="text-xs text-accent">.btn-sm</code>
              <p class="mt-1 text-xs text-dim">Button system. Transitions at --motion-fast.</p>
            </div>
            <div class="well p-3">
              <code class="text-xs text-accent">.kv</code>
              <p class="mt-1 text-xs text-dim">Key-value row. flex justify-between, border-b.</p>
            </div>
            <div class="well p-3">
              <code class="text-xs text-accent">.th</code> / <code class="text-xs text-accent">.td</code>
              <p class="mt-1 text-xs text-dim">Table header (11px/UPPERCASE/dim) and cell (12px).</p>
            </div>
            <div class="well p-3">
              <code class="text-xs text-accent">.input</code> / <code class="text-xs text-accent">.label</code>
              <p class="mt-1 text-xs text-dim">Form input (13px, radius-sm) and label (11px/UPPERCASE).</p>
            </div>
            <div class="well p-3">
              <code class="text-xs text-accent">.prose</code>
              <p class="mt-1 text-xs text-dim">Journal prose. 13px, 1.8 line-height, soft color.</p>
            </div>
            <div class="well p-3">
              <code class="text-xs text-accent">.rail-up</code> / <code class="text-xs text-accent">.rail-down</code> / <code class="text-xs text-accent">.rail-accent</code> / <code class="text-xs text-accent">.rail-quiet</code>
              <p class="mt-1 text-xs text-dim">Left-rail identity bars. 2px solid border-left. Used on ThoughtCard.</p>
            </div>
            <div class="well p-3">
              <code class="text-xs text-accent">.lb*</code>
              <p class="mt-1 text-xs text-dim">Lightbox system. .lb, .lb-sheet, .lb-handle, .lb-header, .lb-body, .lb-nav.</p>
            </div>
          </div>
        </Card>
      </div>

      <!-- Backlog / Roadmap -->
      <div id="backlog" class="mt-6 scroll-mt-28">
        <Card icon="🗺" label="backlog" subtitle="remaining improvements">
          <div class="overflow-x-auto">
            <table class="w-full border-collapse">
              <thead>
                <tr>
                  <th class="th">item</th>
                  <th class="th">priority</th>
                  <th class="th">detail</th>
                </tr>
              </thead>
              <tbody>
                {roadmap.map((r) => (
                  <tr>
                    <td class="td text-ink">{r.item}</td>
                    <td class="td">
                      <Badge variant={r.priority === 'medium' ? 'warn' : r.priority === 'low' ? 'muted' : 'accent'}>{r.priority}</Badge>
                    </td>
                    <td class="td text-dim">{r.detail}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </Card>
      </div>
    </div>

    <!-- ══ Features ══ -->
    <div id="features-section" class="mt-10 scroll-mt-28">
      <Card icon="🔍" label="features" subtitle={`${traceability.reduce((s, c) => s + c.items.length, 0)} files · auto-generated · updated ${rel(buildAt)}`}>
        <p class="mb-3 text-xs text-dim">
          Auto-generated from filesystem on each deploy.
        </p>
        {traceability.map((cat) => (
          <div class="mb-4">
            <div class="text-2xs uppercase tracking-widest text-dim mb-2">{cat.category}</div>
            <Table head={['file', 'feature', 'what']} class="mt-1">
              {cat.items.map((item) => (
                <tr>
                  <td class="td font-mono text-2xs text-accent">{item.file}</td>
                  <td class="td text-ink">{item.feature}</td>
                  <td class="td text-dim">{item.what || '—'}</td>
                </tr>
              ))}
            </Table>
          </div>
        ))}
      </Card>
    </div>

    <!-- ══ Changelog ══ -->
    <div id="changelog-section" class="mt-10 scroll-mt-28">
      <div id="changelog-today" class="scroll-mt-28">
        <Card icon="📋" label="changelog" subtitle={`today · ${fmtDayWUpper(today)}`}>
          {changelogEntry ? (
            <Well class="p-4">
              <pre class="whitespace-pre-wrap font-mono text-xs leading-relaxed text-soft">{changelogEntry}</pre>
            </Well>
          ) : (
            <EmptyState text="no entry yet — generated on deploy" />
          )}
        </Card>
      </div>
    </div>

    <!-- ══ Tokenomics ══ -->
    <div id="tokenomics-section" class="mt-10 scroll-mt-28">
      <div id="tokenomics-summary" class="scroll-mt-28">
        <Card icon="💰" label="tokenomics" subtitle="what the builds cost">
          <div class="grid grid-cols-2 gap-2 md:grid-cols-5">
            <StatCard label="TOTAL COST" value={tokenomics ? `$${(tokenomics.totals?.cost ?? 0).toFixed(2)}` : '—'} />
            <StatCard label="SESSIONS" value={tokenomics ? String(tokenomics.totals?.sessions ?? 0) : '—'} />
            <StatCard label="CACHE RATE" value={tokenomics ? `${((tokenomics.totals?.cacheHitRate ?? 0) * 100).toFixed(1)}%` : '—'} />
            <StatCard label="COST/COMMIT" value={tokenomics ? `$${(tokenomics.totals?.costPerCommit ?? 0).toFixed(4)}` : '—'} />
            <StatCard label="AVG SESSION" value={tokenomics ? `${Math.round((tokenomics.totals?.avgSessionDuration ?? 0) / 60)}m` : '—'} />
          </div>
          {!tokenomics && <EmptyState text="no tokenomics data yet" class="mt-3" />}
        </Card>
      </div>

      <div id="tokenomics-daily" class="mt-6 scroll-mt-28">
        <Card icon="📊" label="daily cost" subtitle="per-day spend">
          {tokenomics?.byDay && tokenomics.byDay.length > 0 ? (
            <BarChart
              data={tokenomics.byDay.map(d => ({ label: d.date.slice(5), value: d.cost, color: d.cost > 10 ? 'var(--color-warn)' : 'var(--color-accent)' }))}
              title="daily cost"
              format={(v) => `$${v.toFixed(2)}`}
              orientation="vertical"
            />
          ) : (
            <EmptyState text="no daily data yet" />
          )}
        </Card>
      </div>

      <div id="tokenomics-models" class="mt-6 scroll-mt-28">
        <Card icon="🤖" label="cost by model" subtitle="top 10 by spend">
          {tokenomics?.byModel && tokenomics.byModel.length > 0 ? (
            <BarChart
              data={tokenomics.byModel.slice(0, 10).map(m => ({ label: m.model, value: m.cost }))}
              title="cost by model"
              format={(v) => `$${v.toFixed(2)}`}
              orientation="horizontal"
            />
          ) : (
            <EmptyState text="no model data yet" />
          )}
        </Card>
      </div>

      <div id="tokenomics-agents" class="mt-6 scroll-mt-28">
        <Card icon="🕵️" label="cost by agent" subtitle="per-agent spend">
          {tokenomics?.byAgent && tokenomics.byAgent.length > 0 ? (
            <BarChart
              data={tokenomics.byAgent.map(a => ({ label: a.agent, value: a.cost }))}
              title="cost by agent"
              format={(v) => `$${v.toFixed(2)}`}
              orientation="horizontal"
            />
          ) : (
            <EmptyState text="no agent data yet" />
          )}
        </Card>
      </div>

      <div id="tokenomics-sessions" class="mt-6 scroll-mt-28">
        <Card icon="📝" label="recent sessions" subtitle={tokenomics?.recentSessions ? `${tokenomics.recentSessions.length} sessions` : '—'}>
          {tokenomics?.recentSessions && tokenomics.recentSessions.length > 0 ? (
            <>
              <Table head={['date', 'title', 'model', 'agent', 'cost']} class="mt-1">
                {tokenomics.recentSessions.slice(0, 4).map((s) => (
                  <tr>
                    <td class="td">{s.date}</td>
                    <td class="td text-ink">{s.title}</td>
                    <td class="td">{s.model.split('/').pop()}</td>
                    <td class="td">{s.agent}</td>
                    <td class="td tabular-nums">${s.cost.toFixed(3)}</td>
                  </tr>
                ))}
              </Table>
              {tokenomics.recentSessions.length > 4 && (
                <details class="mt-2">
                  <summary class="cursor-pointer text-2xs text-faint select-none hover:text-dim">
                    +{tokenomics.recentSessions.length - 4} more
                  </summary>
                  <Table head={['date', 'title', 'model', 'agent', 'cost']} class="mt-1">
                    {tokenomics.recentSessions.slice(4).map((s) => (
                      <tr>
                        <td class="td">{s.date}</td>
                        <td class="td text-ink">{s.title}</td>
                        <td class="td">{s.model.split('/').pop()}</td>
                        <td class="td">{s.agent}</td>
                        <td class="td tabular-nums">${s.cost.toFixed(3)}</td>
                      </tr>
                    ))}
                  </Table>
                </details>
              )}
            </>
          ) : (
            <EmptyState text="no session data yet" />
          )}
        </Card>
      </div>
    </div>

    <!-- ══ Meta ══ -->
    <div id="meta-section" class="mt-10 scroll-mt-28">
      <div id="source" class="scroll-mt-28">
        <Card icon="📊" label="source code" subtitle="lines of code">
          <div class="grid gap-4 md:grid-cols-2">
            <div>
              <KvRow label="total lines" value={totalLines.toLocaleString()} />
              <KvRow label=".astro files" value={String(filesAstro)} />
              <KvRow label=".ts files" value={String(filesTs)} />
              <KvRow label=".tsx files" value={String(filesTsx)} />
              <KvRow label=".css files" value={String(filesCss)} />
            </div>
            <div>
              <KvRow label="astro lines" value={linesAstro.toLocaleString()} />
              <KvRow label="ts lines" value={linesTs.toLocaleString()} />
              <KvRow label="tsx lines" value={linesTsx.toLocaleString()} />
              <KvRow label="css lines" value={linesCss.toLocaleString()} />
            </div>
          </div>
        </Card>
      </div>

      <div id="content" class="mt-6 scroll-mt-28">
        <Card icon="📁" label="content" subtitle="live counts">
          <div class="grid gap-4 md:grid-cols-2">
            <KvRow label="days recorded" value={String(days)} />
            <KvRow label="journal entries" value={String(journals)} />
            <KvRow label="accounts" value={String(accounts)} />
            <KvRow label="habits" value={String(habits)} />
            <KvRow label="reviews" value={String(reviews)} />
            <KvRow label="market news days" value={String(marketNews)} />
            <KvRow label="media files" value={String(mediaCount)} />
          </div>
        </Card>
      </div>

      <div id="versions" class="mt-6 scroll-mt-28">
        <Card icon="⚙️" label="stack" subtitle="versions">
          <KvRow label="node.js" value={nodeVersion} />
          <KvRow label="astro" value={astroVersion} />
          <KvRow label="tailwind" value={tailwindVersion} />
          <KvRow label="os" value={osInfo} />
        </Card>
      </div>
    </div>

    <!-- Footer note -->
    <p class="mt-10 text-2xs text-faint">
      this page is maintained by AI. every code change is accounted for here.
      the version increments when meaningful features ship. tokenomics are measured from real sessions.
    </p>
  </section>
</Base>
