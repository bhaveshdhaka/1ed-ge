let mediaCount = 0
try { mediaCount = parseInt(execSync(`find ${MEDIA} -type f 2>/dev/null | wc -l`).toString().trim()) || 0 } catch {}

// ── stack versions (from /dev) ───────────────────────────────────────────────
const pkg = require('./package.json')
const nodeVersion = process.version
const astroVersion = pkg.dependencies?.astro || pkg.devDependencies?.astro || 'unknown'
const tailwindVersion = pkg.dependencies?.tailwindcss || pkg.devDependencies?.tailwindcss || 'unknown'
const osInfo = `${process.platform} ${process.arch}`

// ── page navigation (SideNav groups) ─────────────────────────────────────────
const navGroups = [
  { label: 'overview', items: [['build', 'build'], ['principles', 'principles'], ['stack', 'stack'], ['tools', 'tools']] as [string, string][] },
  { label: 'design', items: [['architecture', 'architecture'], ['palette', 'palette'], ['type', 'type'], ['material', 'material'], ['cards', 'cards'], ['typography', 'typography'], ['primitives', 'primitives'], ['composites', 'composites'], ['CSS', 'classes'], ['backlog', 'backlog']] as [string, string][] },
  { label: 'features', items: [['features', 'features-section']] as [string, string][] },
  { label: 'changelog', items: [['today', 'changelog-section']] as [string, string][] },
  { label: 'tokenomics', items: [['summary', 'tokenomics-summary'], ['daily', 'tokenomics-daily'], ['models', 'tokenomics-models'], ['agents', 'tokenomics-agents'], ['sessions', 'tokenomics-sessions']] as [string, string][] },
  { label: 'meta', items: [['source', 'source'], ['content', 'content'], ['versions', 'versions']] as [string, string][] },
]
---

<Base title="build — 1ed.ge" description="The build log: how this site was built, the design system, features, changelog, and what the builds cost. Everything public.">
  <section class="shell pt-12 pb-20 md:mr-48">
    <div class="flex flex-wrap items-baseline gap-3">
      <h1 class="text-2xl text-ink">/ build</h1>
      <span class="text-xs text-faint">{VERSION} · {VERSION_DATE}</span>
    </div>
    <SideNav groups={navGroups}>
      <SectionNav groups={navGroups} slot="mobile-nav" />
    </SideNav>
    <p class="mt-2 max-w-2xl text-sm text-dim">
      How this site was built. The stack, the design system, the features, what changed today, and what the builds cost. Everything public.
    </p>

    <!-- ══ Overview ══ -->
    <div id="overview-section" class="mt-10 scroll-mt-28">
      <div id="build" class="scroll-mt-28">
        <Card icon="🏗️" label="build" subtitle="deployed build snapshot">
          <div class="grid gap-4 md:grid-cols-2">
            <div>
              <KvRow label="version">
                <span class="inline-flex items-center gap-2 text-xs text-dim">
                  <span class="text-ink">{VERSION}</span>
                  {buildDrift && <Badge variant="warn">version drift</Badge>}
                </span>
              </KvRow>
              <KvRow label="last commit" value={buildData?.commit ?? '—'} />
              <KvRow label="build timestamp" value={buildStamp} />
            </div>
            <div>
              <KvRow label="version" value={fmtDayWUpper(VERSION_DATE)} />
            </div>
          </div>
        </Card>
      </div>

      <div id="principles" class="mt-6 scroll-mt-28">
        <Card icon="🧭" label="principles" subtitle="the rules we build by">
          <div class="flex flex-col gap-3">
            {principles.map((p) => (
              <div class="flex flex-col gap-0.5">
                <span class="text-sm text-ink">{p.rule}</span>
                <span class="text-xs text-dim">{p.detail}</span>
              </div>
            ))}
          </div>
        </Card>
      </div>

      <div id="stack" class="mt-6 scroll-mt-28">
        <Card icon="🛠" label="stack" subtitle="what we use">
          <div class="overflow-x-auto">
            <table class="w-full border-collapse">
              <thead>
                <tr>
                  <th class="th">layer</th>
                  <th class="th">technology</th>
                  <th class="th">note</th>
                </tr>
              </thead>
              <tbody>
                {stack.map((s) => (
                  <tr>
                    <td class="td text-dim">{s.layer}</td>
                    <td class="td text-ink">{s.tech}</td>
                    <td class="td text-faint">{s.note}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </Card>
      </div>

      <div id="tools" class="mt-6 scroll-mt-28">
        <Card icon="🤖" label="build tools" subtitle="AI-assisted development">
          <div class="overflow-x-auto">
            <table class="w-full border-collapse">
              <thead>
                <tr>
                  <th class="th">tool</th>
                  <th class="th">what</th>
                  <th class="th">role</th>
                </tr>
              </thead>
              <tbody>
                {tools.map((t) => (
                  <tr>
                    <td class="td text-ink">{t.name}</td>
                    <td class="td text-dim">{t.what}</td>
                    <td class="td text-faint">{t.role}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </Card>
      </div>

    </div>

    <!-- ══ Design ══ -->
    <div id="design-section" class="mt-10 scroll-mt-28">
      <div class="mb-4 flex flex-wrap items-baseline gap-3">
        <h2 class="text-lg font-semibold text-ink">design system</h2>
        <span class="text-xs text-faint">{VERSION} · the card system</span>
      </div>
      <p class="mb-6 max-w-2xl text-sm text-dim">
        Every surface on 1ed.ge uses the same design system. One Card component, one type scale, one token architecture. This documents every element, its rules, and how to use it.
      </p>

      <!-- Token Architecture -->
      <div id="architecture" class="scroll-mt-28">
        <Card icon="🎨" label="token architecture" subtitle="3-layer system">
          <p class="mb-4 text-sm text-soft">
            The design system uses a 3-layer token architecture. To re-theme, only Layer 1 changes. Layer 2 and Layer 3 are stable.
          </p>
          <div class="grid gap-4 md:grid-cols-3">
            <div class="well p-3">
              <div class="text-4xs font-bold uppercase text-faint" style="letter-spacing:0.6px">Layer 1 · Palette</div>
              <p class="mt-1 text-xs text-dim">Raw hue values. Swap these to re-theme.</p>
              <p class="mt-1 text-2xs text-faint">--hue-bg, --hue-ink, --hue-accent, --hue-up, --hue-down…</p>
            </div>
            <div class="well p-3">
              <div class="text-4xs font-bold uppercase text-faint" style="letter-spacing:0.6px">Layer 2 · Semantic</div>
              <p class="mt-1 text-xs text-dim">Component roles. Never change.</p>
              <p class="mt-1 text-2xs text-faint">--color-bg, --color-ink, --color-accent, --color-up, --color-down…</p>
            </div>
            <div class="well p-3">
              <div class="text-4xs font-bold uppercase text-faint" style="letter-spacing:0.6px">Layer 3 · Material</div>
              <p class="mt-1 text-xs text-dim">Radii, shadows, blur, motion.</p>
              <p class="mt-1 text-2xs text-faint">--radius, --shadow-card, --blur-card, --motion-fast…</p>
            </div>
          </div>
        </Card>
      </div>

      <!-- Palette -->
