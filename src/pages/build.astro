---
import fs from 'node:fs'
import path from 'node:path'
import { execSync } from 'node:child_process'
import { createRequire } from 'node:module'
import { join } from 'node:path'
import Base from '../layouts/Base.astro'
import Card from '../components/ui/Card.astro'
import KvRow from '../components/ui/KvRow.astro'
import Table from '../components/ui/Table.astro'
import Badge from '../components/ui/Badge.astro'
import StatCard from '../components/ui/StatCard.astro'
import Well from '../components/ui/Well.astro'
import EmptyState from '../components/ui/EmptyState.astro'
import SectionNav from '../components/ui/SectionNav.astro'
import BarChart from '../components/ui/BarChart.astro'
import { fmtDayWUpper } from '../lib/dates'
import SideNav from '../components/ui/SideNav.astro'
import { CONTENT, MEDIA, DATA_DIR, ROOT } from '../lib/paths'

// ── build version (data/build.json, written at deploy) ─────────────────────
const require = createRequire(join(ROOT, 'package.json'))
let buildData: { version?: string; at?: string; commit?: string } | null = null
try {
  buildData = JSON.parse(fs.readFileSync(path.join(DATA_DIR, 'build.json'), 'utf8'))
} catch {}
const VERSION = buildData?.version ?? new Date().toISOString().slice(0, 10)
const VERSION_DATE = VERSION
const today = new Date().toISOString().slice(0, 10)
const buildDrift = buildData?.version !== today
const buildStamp = (() => {
  if (!buildData?.at) return '—'
  const d = new Date(buildData.at)
  return isNaN(d.getTime()) ? buildData.at : d.toISOString().slice(0, 16).replace('T', ' ')
})()

/** Relative time: "3m ago", "2h 15m ago", "5d ago" (same as /status). */
function rel(iso: string | null | undefined): string {
  if (!iso) return 'never'
  const ms = Date.now() - Date.parse(iso)
  if (isNaN(ms)) return 'unknown'
  const s = Math.max(0, Math.floor(ms / 1000))
  if (s < 60) return `${s}s ago`
  const m = Math.floor(s / 60)
  if (m < 60) return `${m}m ago`
  const h = Math.floor(m / 60)
  if (h < 24) return `${h}h ${m % 60}m ago`
  const d = Math.floor(h / 24)
  return `${d}d ago`
}
const buildAt = buildData?.at ?? null

// ── tokenomics (data/tokenomics.json) ───────────────────────────────────────
interface Tokenomics {
  at?: string
  totals?: {
    cost?: number; sessions?: number; tokensInput?: number; tokensOutput?: number
    tokensReasoning?: number; tokensCacheRead?: number; cacheHitRate?: number
    avgSessionDuration?: number; commits?: number; costPerCommit?: number
  }
  byDay?: { date: string; sessions: number; cost: number; tokensInput: number; tokensOutput: number; cacheRead: number }[]
  byModel?: { model: string; provider: string; sessions: number; cost: number; tokensInput: number; tokensOutput: number }[]
  byAgent?: { agent: string; sessions: number; cost: number; tokensInput: number; tokensOutput: number }[]
  recentSessions?: { title: string; model: string; agent: string; cost: number; date: string; tokensInput: number; tokensOutput: number }[]
}
let tokenomics: Tokenomics | null = null
try {
  tokenomics = JSON.parse(fs.readFileSync(path.join(DATA_DIR, 'tokenomics.json'), 'utf8'))
} catch {}

// ── changelog (changelog/YYYY-MM-DD.md) ─────────────────────────────────────
let changelogEntry: string | null = null
try {
  changelogEntry = fs.readFileSync(path.join(ROOT, 'changelog', `${today}.md`), 'utf8')
} catch {}

// ── release history (git-cliff → changelog/YYYY-MM-DD.md) ───────────────────
// git-cliff generates a per-day changelog on deploy (changelog/<date>.md),
// each carrying a `<!-- last:<sha> -->` marker. Release history = newest-first
// list of those generated logs, showing the commit range each covers.
interface Release { date: string; sha: string | null; size: number }
const releases: Release[] = (() => {
  try {
    return fs
      .readdirSync(path.join(ROOT, 'changelog'))
      .filter((f) => /^\d{4}-\d{2}-\d{2}\.md$/.test(f))
      .sort()
      .reverse()
      .map((f) => {
        const content = fs.readFileSync(path.join(ROOT, 'changelog', f), 'utf8')
        const sha = content.match(/^<!-- last:([a-f0-9]+)\s-->[\s\S]*?$/) ||
                    content.match(/<!-- last:([a-f0-9]+) -->/)
        return { date: f.slice(0, 10), sha: sha?.[1] ?? null, size: content.split('\n').length }
      })
  } catch {
    return []
  }
})()

// ── stack / tools / principles (curated, from /dev) ─────────────────────────
const stack = [
  { layer: 'Framework', tech: 'Astro 5 (static-first) + @astrojs/node (SSR)', note: 'zero JS on public pages' },
  { layer: 'Styling', tech: 'Tailwind CSS v4', note: '3-layer token architecture' },
  { layer: 'Language', tech: 'TypeScript', note: 'strict mode' },
  { layer: 'Admin', tech: 'React (islands)', note: 'client-side, admin area only' },
  { layer: 'AI', tech: 'OpenRouter — DeepSeek + Qwen2.5-VL', note: 'day structuring, coach, screenshot reading' },
  { layer: 'Images', tech: 'sharp (webp)', note: 'auto-conversion on upload' },
  { layer: 'Content', tech: 'Markdown + gray-matter', note: 'files are the database' },
  { layer: 'Hosting', tech: 'VPS + Docker + nginx', note: 'preprod + prod worktrees' },
]

const tools = [
  { name: 'OpenCode', what: 'AI coding assistant', role: 'orchestrates all agent work' },
  { name: 'mimo-v2.5-pro', what: 'Orchestrator model', role: 'primary reasoning, planning, coordination' },
  { name: 'deepseek-v4-flash', what: 'Fast agent model', role: 'explorer, fixer, librarian, observer' },
  { name: 'qwen3.7-plus', what: 'Oracle + designer model', role: 'architecture review, UI/UX design' },
  { name: 'TypeScript LSP', what: 'Language server', role: 'type checking, diagnostics' },
  { name: 'AST grep', what: 'Structural search', role: 'codebase-wide pattern matching' },
  { name: 'Playwright', what: 'Browser automation', role: 'visual verification, testing' },
]

// ── traceability — auto-generated via import.meta.glob (recursive) ──────────
// Build-time file discovery: every page/component/lib file under src/, with a
// doc-comment reader for the "what" column. Replaces the non-recursive fs scan
// (which missed nested routes like pages/day/[date].astro and pages/api/*).
interface TraceItem { file: string; feature: string; what: string }
function globTrace(entries: string[], base: string): TraceItem[] {
  return entries
    .map((p) => {
      const rel = p.replace(/^\/src\//, '')
      const feature = rel.replace(/\.(astro|ts)$/, '').split('/').pop() ?? rel
      let what = ''
      try {
        const content = fs.readFileSync(path.join(ROOT, 'src', rel), 'utf8')
        const m = content.match(/\/\*\*\s*(?:\n\s*\*\s*)?(.+?)(?:\s*\*\/|\n)/)
        what = m?.[1]?.trim() ?? ''
      } catch { /* file gone at build — skip what */ }
      return { file: rel, feature, what }
    })
    .sort((a, b) => a.file.localeCompare(b.file))
}

const tracePages = globTrace(Object.keys(import.meta.glob('/src/pages/**/*.{astro,ts}')), 'src/pages')
const traceComponents = globTrace(Object.keys(import.meta.glob('/src/components/**/*.astro')), 'src/components')
const traceUi = globTrace(Object.keys(import.meta.glob('/src/components/ui/**/*.astro')), 'src/components/ui')
const tracePrivate = globTrace(Object.keys(import.meta.glob('/src/components/private/**/*.astro')), 'src/components/private')
const traceLib = globTrace(Object.keys(import.meta.glob('/src/lib/**/*.ts')), 'src/lib')

const traceability = [
  { category: 'Public Pages', items: tracePages },
  { category: 'Components', items: traceComponents },
  { category: 'UI Primitives', items: traceUi },
  { category: 'Private', items: tracePrivate },
  { category: 'Libraries', items: traceLib },
]

const principles = [
  { rule: 'Everything public', detail: 'I open every position, show every ticket, log every trade, every result, every move. Nothing hidden.' },
  { rule: 'Kaizen', detail: 'Trading is continuous daily improvement. Keep what works, drop what doesn\'t, tweak the exact same things every single day.' },
  { rule: 'Files are the database', detail: 'All data lives in markdown files on disk. Day records, journal entries, habits, accounts — each is a file with structured data at the top. No database server, no queries, no migrations.' },
  { rule: 'Minimal JS on public pages', detail: 'All charts are server-rendered SVG. ~15KB inline JS total (lightbox, timezone, market ticker). No external JS dependencies.' },
  { rule: 'CME is the master clock', detail: 'Day status comes from the CME equity-index-futures calendar. NYSE/TSE/LSE are secondary.' },
  { rule: 'R is the only metric', detail: 'R = points risked vs points made. Performance math is risk-based.' },
  { rule: 'Security by obscurity', detail: 'The admin is at a secret URL. API keys are in .env (gitignored). The route stays obscure.' },
  { rule: 'The rules are dead simple', detail: 'Trade every day. Never risk more than you can afford. Focus on the move, not the number. Stay small, nimble, consistent. Have fun. Surpass the S&P.' },
]

// ── design tokens + primitives now live on /design ─────────────────────────
// (moved to src/pages/design.astro on the design/restructure)

// ── source code stats (from /dev) ────────────────────────────────────────────
const countLines = (ext: string) => {
  try {
    return parseInt(execSync(`find src/ -name '*${ext}' -exec wc -l {} + 2>/dev/null | tail -1 | awk '{print $1}'`).toString().trim()) || 0
  } catch { return 0 }
}
const linesAstro = countLines('.astro')
const linesTs = countLines('.ts')
const linesTsx = countLines('.tsx')
const linesCss = countLines('.css')
const totalLines = linesAstro + linesTs + linesTsx + linesCss

const countFiles = (ext: string) => {
  try {
    return parseInt(execSync(`find src/ -name '*${ext}' | wc -l`).toString().trim()) || 0
  } catch { return 0 }
}
const filesAstro = countFiles('.astro')
const filesTs = countFiles('.ts')
const filesTsx = countFiles('.tsx')
const filesCss = countFiles('.css')

// ── content counts (from /dev) ───────────────────────────────────────────────
const countDir = (dir: string) => {
  try { return fs.readdirSync(dir).filter(f => f.endsWith('.md') || f.endsWith('.mdx')).length } catch { return 0 }
}
const days = countDir(path.join(CONTENT, 'days'))
const journals = countDir(path.join(CONTENT, 'journal'))
const accounts = countDir(path.join(CONTENT, 'accounts'))
const habits = countDir(path.join(CONTENT, 'habits'))
const reviews = countDir(path.join(CONTENT, 'reviews'))
const marketNews = countDir(path.join(CONTENT, 'market-news'))

let mediaCount = 0
try { mediaCount = parseInt(execSync(`find ${MEDIA} -type f 2>/dev/null | wc -l`).toString().trim()) || 0 } catch {}

// ── stack versions (from /dev) ───────────────────────────────────────────────
const pkg = require('./package.json')
const nodeVersion = process.version
const astroVersion = pkg.dependencies?.astro || pkg.devDependencies?.astro || 'unknown'
const tailwindVersion = pkg.dependencies?.tailwindcss || pkg.devDependencies?.tailwindcss || 'unknown'
const osInfo = `${process.platform} ${process.arch}`

// ── page navigation (SideNav groups) ─────────────────────────────────────────
const navGroups = [
  { label: 'overview', items: [['build', 'build'], ['principles', 'principles'], ['stack', 'stack'], ['tools', 'tools']] as [string, string][] },
  { label: 'releases', items: [['release', 'release'], ['changelog', 'changelog-section']] as [string, string][] },
  { label: 'features', items: [['features', 'features-section']] as [string, string][] },
  { label: 'tokenomics', items: [['summary', 'tokenomics-summary'], ['daily', 'tokenomics-daily'], ['models', 'tokenomics-models'], ['agents', 'tokenomics-agents'], ['sessions', 'tokenomics-sessions']] as [string, string][] },
  { label: 'meta', items: [['source', 'source'], ['content', 'content'], ['versions', 'versions']] as [string, string][] },
  { label: 'design', items: [['design system', '/design']] as [string, string][] },
]
---

<Base title="build — 1ed.ge" description="The build log: code release history, AI compute costs, features, and what the builds cost. Everything public. Design system lives on /design.">
  <section class="shell pt-12 pb-20 md:mr-48">
    <div class="flex flex-wrap items-baseline gap-3">
      <h1 class="text-2xl text-ink">/ build</h1>
      <span class="text-xs text-faint">{VERSION} · {VERSION_DATE}</span>
    </div>
    <SideNav groups={navGroups}>
      <SectionNav groups={navGroups} slot="mobile-nav" />
    </SideNav>
    <p class="mt-2 max-w-2xl text-sm text-dim">
      How this site was built. The stack, the design system, the features, what changed today, and what the builds cost. Everything public.
    </p>

    <!-- ══ Overview ══ -->
    <div id="overview-section" class="mt-10 scroll-mt-28">
      <div id="build" class="scroll-mt-28">
        <Card icon="🏗️" label="build" subtitle="deployed build snapshot">
          <div class="grid gap-4 md:grid-cols-2">
            <div>
              <KvRow label="version">
                <span class="inline-flex items-center gap-2 text-xs text-dim">
                  <span class="text-ink">{VERSION}</span>
                  {buildDrift && <Badge variant="warn">version drift</Badge>}
                </span>
              </KvRow>
              <KvRow label="last commit" value={buildData?.commit ?? '—'} />
              <KvRow label="build timestamp" value={buildStamp} />
            </div>
            <div>
              <KvRow label="version" value={fmtDayWUpper(VERSION_DATE)} />
            </div>
          </div>
        </Card>
      </div>

      <div id="principles" class="mt-6 scroll-mt-28">
        <Card icon="🧭" label="principles" subtitle="the rules we build by">
          <div class="flex flex-col gap-3">
            {principles.map((p) => (
              <div class="flex flex-col gap-0.5">
                <span class="text-sm text-ink">{p.rule}</span>
                <span class="text-xs text-dim">{p.detail}</span>
              </div>
            ))}
          </div>
        </Card>
      </div>

      <div id="stack" class="mt-6 scroll-mt-28">
        <Card icon="🛠" label="stack" subtitle="what we use">
          <div class="overflow-x-auto">
            <table class="w-full border-collapse">
              <thead>
                <tr>
                  <th class="th">layer</th>
                  <th class="th">technology</th>
                  <th class="th">note</th>
                </tr>
              </thead>
              <tbody>
                {stack.map((s) => (
                  <tr>
                    <td class="td text-dim">{s.layer}</td>
                    <td class="td text-ink">{s.tech}</td>
                    <td class="td text-faint">{s.note}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </Card>
      </div>

      <div id="tools" class="mt-6 scroll-mt-28">
        <Card icon="🤖" label="build tools" subtitle="AI-assisted development">
          <div class="overflow-x-auto">
            <table class="w-full border-collapse">
              <thead>
                <tr>
                  <th class="th">tool</th>
                  <th class="th">what</th>
                  <th class="th">role</th>
                </tr>
              </thead>
              <tbody>
                {tools.map((t) => (
                  <tr>
                    <td class="td text-ink">{t.name}</td>
                    <td class="td text-dim">{t.what}</td>
                    <td class="td text-faint">{t.role}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </Card>
      </div>

    </div>

    <!-- ══ Release History ══ -->
    <div id="release" class="mt-10 scroll-mt-28">
      <Card icon="🏷️" label="release history" subtitle={`${releases.length} generated changelogs · via build.json + git-cliff`}>
        <p class="mb-4 text-sm text-soft">
          Each deploy runs <code class="border border-line bg-raise px-1.5 py-0.5 text-2xs text-accent">post-deploy.mjs</code>
          → <code class="border border-line bg-raise px-1.5 py-0.5 text-2xs text-accent">git-cliff</code> to write a
          per-day changelog. The current build stamp (from <code class="border border-line bg-raise px-1.5 py-0.5 text-2xs text-accent">data/build.json</code>)
          anchors the latest release.
        </p>
        <div class="grid gap-4 md:grid-cols-2">
          <div>
            <KvRow label="current version" value={VERSION} />
            <KvRow label="build commit" value={buildData?.commit ?? '—'} />
            <KvRow label="latest release" value={releases[0]?.date ?? '—'} />
          </div>
          <div>
            <KvRow label="releases tracked" value={String(releases.length)} />
            <KvRow label="changelog entries" value={String(changelogEntry ? 1 : 0)} />
          </div>
        </div>
        {releases.length > 0 && (
          <div class="mt-4 overflow-x-auto">
            <Table head={['date', 'commit', 'lines']} class="mt-1">
              {releases.slice(0, 20).map((r) => (
                <tr>
                  <td class="td font-mono text-2xs text-accent">{r.date}</td>
                  <td class="td font-mono text-2xs text-dim">{r.sha ?? '—'}</td>
                  <td class="td text-dim">{r.size}</td>
                </tr>
              ))}
            </Table>
          </div>
        )}
      </Card>
    </div>

    <!-- ══ Features ══ -->
    <div id="features-section" class="mt-10 scroll-mt-28">
      <Card icon="🔍" label="features" subtitle={`${traceability.reduce((s, c) => s + c.items.length, 0)} files · auto-generated · updated ${rel(buildAt)}`}>
        <p class="mb-3 text-xs text-dim">
          Auto-generated from filesystem on each deploy.
        </p>
        {traceability.map((cat) => (
          <div class="mb-4">
            <div class="text-2xs uppercase tracking-widest text-dim mb-2">{cat.category}</div>
            <Table head={['file', 'feature', 'what']} class="mt-1">
              {cat.items.map((item) => (
                <tr>
                  <td class="td font-mono text-2xs text-accent">{item.file}</td>
                  <td class="td text-ink">{item.feature}</td>
                  <td class="td text-dim">{item.what || '—'}</td>
                </tr>
              ))}
            </Table>
          </div>
        ))}
      </Card>
    </div>

    <!-- ══ Changelog ══ -->
    <div id="changelog-section" class="mt-10 scroll-mt-28">
      <div id="changelog-today" class="scroll-mt-28">
        <Card icon="📋" label="changelog" subtitle={`today · ${fmtDayWUpper(today)}`}>
          {changelogEntry ? (
            <Well class="p-4">
              <pre class="whitespace-pre-wrap font-mono text-xs leading-relaxed text-soft">{changelogEntry}</pre>
            </Well>
          ) : (
            <EmptyState text="no entry yet — generated on deploy" />
          )}
        </Card>
      </div>
    </div>

    <!-- ══ Tokenomics ══ -->
    <div id="tokenomics-section" class="mt-10 scroll-mt-28">
      <div id="tokenomics-summary" class="scroll-mt-28">
        <Card icon="💰" label="tokenomics" subtitle="what the builds cost">
          <div class="grid grid-cols-2 gap-2 md:grid-cols-5">
            <StatCard label="TOTAL COST" value={tokenomics ? `$${(tokenomics.totals?.cost ?? 0).toFixed(2)}` : '—'} />
            <StatCard label="SESSIONS" value={tokenomics ? String(tokenomics.totals?.sessions ?? 0) : '—'} />
            <StatCard label="CACHE RATE" value={tokenomics ? `${((tokenomics.totals?.cacheHitRate ?? 0) * 100).toFixed(1)}%` : '—'} />
            <StatCard label="COST/COMMIT" value={tokenomics ? `$${(tokenomics.totals?.costPerCommit ?? 0).toFixed(4)}` : '—'} />
            <StatCard label="AVG SESSION" value={tokenomics ? `${Math.round((tokenomics.totals?.avgSessionDuration ?? 0) / 60)}m` : '—'} />
          </div>
          {!tokenomics && <EmptyState text="no tokenomics data yet" class="mt-3" />}
        </Card>
      </div>

      <div id="tokenomics-daily" class="mt-6 scroll-mt-28">
        <Card icon="📊" label="daily cost" subtitle="per-day spend">
          {tokenomics?.byDay && tokenomics.byDay.length > 0 ? (
            <BarChart
              data={tokenomics.byDay.map(d => ({ label: d.date.slice(5), value: d.cost, color: d.cost > 10 ? 'var(--color-warn)' : 'var(--color-accent)' }))}
              title="daily cost"
              format={(v) => `$${v.toFixed(2)}`}
              orientation="vertical"
            />
          ) : (
            <EmptyState text="no daily data yet" />
          )}
        </Card>
      </div>

      <div id="tokenomics-models" class="mt-6 scroll-mt-28">
        <Card icon="🤖" label="cost by model" subtitle="top 10 by spend">
          {tokenomics?.byModel && tokenomics.byModel.length > 0 ? (
            <BarChart
              data={tokenomics.byModel.slice(0, 10).map(m => ({ label: m.model, value: m.cost }))}
              title="cost by model"
              format={(v) => `$${v.toFixed(2)}`}
              orientation="horizontal"
            />
          ) : (
            <EmptyState text="no model data yet" />
          )}
        </Card>
      </div>

      <div id="tokenomics-agents" class="mt-6 scroll-mt-28">
        <Card icon="🕵️" label="cost by agent" subtitle="per-agent spend">
          {tokenomics?.byAgent && tokenomics.byAgent.length > 0 ? (
            <BarChart
              data={tokenomics.byAgent.map(a => ({ label: a.agent, value: a.cost }))}
              title="cost by agent"
              format={(v) => `$${v.toFixed(2)}`}
              orientation="horizontal"
            />
          ) : (
            <EmptyState text="no agent data yet" />
          )}
        </Card>
      </div>

      <div id="tokenomics-sessions" class="mt-6 scroll-mt-28">
        <Card icon="📝" label="recent sessions" subtitle={tokenomics?.recentSessions ? `${tokenomics.recentSessions.length} sessions` : '—'}>
          {tokenomics?.recentSessions && tokenomics.recentSessions.length > 0 ? (
            <>
              <Table head={['date', 'title', 'model', 'agent', 'cost']} class="mt-1">
                {tokenomics.recentSessions.slice(0, 4).map((s) => (
                  <tr>
                    <td class="td">{s.date}</td>
                    <td class="td text-ink">{s.title}</td>
                    <td class="td">{s.model.split('/').pop()}</td>
                    <td class="td">{s.agent}</td>
                    <td class="td tabular-nums">${s.cost.toFixed(3)}</td>
                  </tr>
                ))}
              </Table>
              {tokenomics.recentSessions.length > 4 && (
                <details class="mt-2">
                  <summary class="cursor-pointer text-2xs text-faint select-none hover:text-dim">
                    +{tokenomics.recentSessions.length - 4} more
                  </summary>
                  <Table head={['date', 'title', 'model', 'agent', 'cost']} class="mt-1">
                    {tokenomics.recentSessions.slice(4).map((s) => (
                      <tr>
                        <td class="td">{s.date}</td>
                        <td class="td text-ink">{s.title}</td>
                        <td class="td">{s.model.split('/').pop()}</td>
                        <td class="td">{s.agent}</td>
                        <td class="td tabular-nums">${s.cost.toFixed(3)}</td>
                      </tr>
                    ))}
                  </Table>
                </details>
              )}
            </>
          ) : (
            <EmptyState text="no session data yet" />
          )}
        </Card>
      </div>
    </div>

    <!-- ══ Meta ══ -->
    <div id="meta-section" class="mt-10 scroll-mt-28">
      <div id="source" class="scroll-mt-28">
        <Card icon="📊" label="source code" subtitle="lines of code">
          <div class="grid gap-4 md:grid-cols-2">
            <div>
              <KvRow label="total lines" value={totalLines.toLocaleString()} />
              <KvRow label=".astro files" value={String(filesAstro)} />
              <KvRow label=".ts files" value={String(filesTs)} />
              <KvRow label=".tsx files" value={String(filesTsx)} />
              <KvRow label=".css files" value={String(filesCss)} />
            </div>
            <div>
              <KvRow label="astro lines" value={linesAstro.toLocaleString()} />
              <KvRow label="ts lines" value={linesTs.toLocaleString()} />
              <KvRow label="tsx lines" value={linesTsx.toLocaleString()} />
              <KvRow label="css lines" value={linesCss.toLocaleString()} />
            </div>
          </div>
        </Card>
      </div>

      <div id="content" class="mt-6 scroll-mt-28">
        <Card icon="📁" label="content" subtitle="live counts">
          <div class="grid gap-4 md:grid-cols-2">
            <KvRow label="days recorded" value={String(days)} />
            <KvRow label="journal entries" value={String(journals)} />
            <KvRow label="accounts" value={String(accounts)} />
            <KvRow label="habits" value={String(habits)} />
            <KvRow label="reviews" value={String(reviews)} />
            <KvRow label="market news days" value={String(marketNews)} />
            <KvRow label="media files" value={String(mediaCount)} />
          </div>
        </Card>
      </div>

      <div id="versions" class="mt-6 scroll-mt-28">
        <Card icon="⚙️" label="stack" subtitle="versions">
          <KvRow label="node.js" value={nodeVersion} />
          <KvRow label="astro" value={astroVersion} />
          <KvRow label="tailwind" value={tailwindVersion} />
          <KvRow label="os" value={osInfo} />
        </Card>
      </div>
    </div>

    <!-- Footer note -->
    <p class="mt-10 text-2xs text-faint">
      this page is maintained by AI. every code change is accounted for here.
      the version increments when meaningful features ship. tokenomics are measured from real sessions.
    </p>
  </section>
</Base>
