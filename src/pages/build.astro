// ── source code stats (from /dev) ────────────────────────────────────────────
const countLines = (ext: string) => {
  try {
    return parseInt(execSync(`find src/ -name '*${ext}' -exec wc -l {} + 2>/dev/null | tail -1 | awk '{print $1}'`).toString().trim()) || 0
  } catch { return 0 }
}
const linesAstro = countLines('.astro')
const linesTs = countLines('.ts')
const linesTsx = countLines('.tsx')
const linesCss = countLines('.css')
const totalLines = linesAstro + linesTs + linesTsx + linesCss

const countFiles = (ext: string) => {
  try {
    return parseInt(execSync(`find src/ -name '*${ext}' | wc -l`).toString().trim()) || 0
  } catch { return 0 }
}
const filesAstro = countFiles('.astro')
const filesTs = countFiles('.ts')
const filesTsx = countFiles('.tsx')
const filesCss = countFiles('.css')

// ── content counts (from /dev) ───────────────────────────────────────────────
const countDir = (dir: string) => {
  try { return fs.readdirSync(dir).filter(f => f.endsWith('.md') || f.endsWith('.mdx')).length } catch { return 0 }
}
const days = countDir(path.join(CONTENT, 'days'))
