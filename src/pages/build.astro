// ── build version (data/build.json, written at deploy) ─────────────────────
const require = createRequire(join(process.cwd(), 'package.json'))
let buildData: { version?: string; at?: string; commit?: string } | null = null
try {
  buildData = JSON.parse(fs.readFileSync(path.join(process.cwd(), 'data', 'build.json'), 'utf8'))
} catch {}
const VERSION = buildData?.version ?? new Date().toISOString().slice(0, 10)
const VERSION_DATE = VERSION
const today = new Date().toISOString().slice(0, 10)
const buildDrift = buildData?.version !== today
const buildStamp = (() => {
  if (!buildData?.at) return '—'
  const d = new Date(buildData.at)
  return isNaN(d.getTime()) ? buildData.at : d.toISOString().slice(0, 16).replace('T', ' ')
})()

// ── tokenomics (data/tokenomics.json) ───────────────────────────────────────
interface Tokenomics {
  at?: string
  totals?: {
    cost?: number; sessions?: number; tokensInput?: number; tokensOutput?: number
    tokensReasoning?: number; tokensCacheRead?: number; cacheHitRate?: number
    avgSessionDuration?: number; commits?: number; costPerCommit?: number
  }
  byDay?: { date: string; sessions: number; cost: number; tokensInput: number; tokensOutput: number; cacheRead: number }[]
  byModel?: { model: string; provider: string; sessions: number; cost: number; tokensInput: number; tokensOutput: number }[]
  byAgent?: { agent: string; sessions: number; cost: number; tokensInput: number; tokensOutput: number }[]
  recentSessions?: { title: string; model: string; agent: string; cost: number; date: string; tokensInput: number; tokensOutput: number }[]
}
let tokenomics: Tokenomics | null = null
try {
  tokenomics = JSON.parse(fs.readFileSync(path.join(process.cwd(), 'data', 'tokenomics.json'), 'utf8'))
} catch {}

// ── changelog (changelog/YYYY-MM-DD.md) ─────────────────────────────────────
