// ── traceability — auto-generated from filesystem ───────────────────────────
function scanDir(dir: string, prefix: string) {
  try {
    return fs.readdirSync(dir)
      .filter(f => f.endsWith('.astro') || f.endsWith('.ts'))
      .map(f => {
        const fullPath = path.join(dir, f)
        const content = fs.readFileSync(fullPath, 'utf8')
        const descMatch = content.match(/\/\*\*\s*(?:\n\s*\*\s*)?(.+?)(?:\s*\*\/|\n)/)
        return {
          file: `${prefix}/${f}`,
          feature: f.replace(/\.(astro|ts)$/, ''),
          what: descMatch?.[1]?.trim() ?? '',
        }
      })
  } catch { return [] }
}

const traceability = [
  { category: 'Public Pages', items: scanDir('src/pages', 'pages') },
  { category: 'Components', items: scanDir('src/components', 'components') },
  { category: 'UI Primitives', items: scanDir('src/components/ui', 'components/ui') },
  { category: 'Private', items: scanDir('src/components/private', 'components/private') },
  { category: 'Libraries', items: scanDir('src/lib', 'lib') },
]

const principles = [
  { rule: 'Everything public', detail: 'I open every position, show every ticket, log every trade, every result, every move. Nothing hidden.' },
  { rule: 'Kaizen', detail: 'Trading is continuous daily improvement. Keep what works, drop what doesn\'t, tweak the exact same things every single day.' },
  { rule: 'Files are the database', detail: 'All data lives in markdown files on disk. Day records, journal entries, habits, accounts — each is a file with structured data at the top. No database server, no queries, no migrations.' },
  { rule: 'Minimal JS on public pages', detail: 'All charts are server-rendered SVG. ~15KB inline JS total (lightbox, timezone, market ticker). No external JS dependencies.' },
  { rule: 'CME is the master clock', detail: 'Day status comes from the CME equity-index-futures calendar. NYSE/TSE/LSE are secondary.' },
  { rule: 'R is the only metric', detail: 'R = points risked vs points made. Performance math is risk-based.' },
  { rule: 'Security by obscurity', detail: 'The admin is at a secret URL. API keys are in .env (gitignored). The route stays obscure.' },
  { rule: 'The rules are dead simple', detail: 'Trade every day. Never risk more than you can afford. Focus on the move, not the number. Stay small, nimble, consistent. Have fun. Surpass the S&P.' },
]

// ── design tokens — auto-generated from src/styles/app.css ───────────────────
const css = fs.readFileSync(path.join(ROOT, 'src/styles/app.css'), 'utf8')
const hueTokens = [...css.matchAll(/--hue-([\w-]+):\s*([^;]+);/g)].map(m => ({
  token: `--hue-${m[1]}`, value: m[2].trim()
}))
const colorTokens = [...css.matchAll(/--color-([\w-]+):\s*([^;]+);/g)].map(m => ({
  token: `--color-${m[1]}`, value: m[2].trim()
}))
const textTokens = [...css.matchAll(/--text-([\w-]+):\s*([^;]+);/g)].map(m => ({
  token: `--text-${m[1]}`, value: m[2].trim()
}))
const materialTokens = [...css.matchAll(/--(radius[\w-]*|shadow[\w-]*|blur[\w-]*|motion[\w-]*|ease[\w-]*):\s*([^;]+);/g)].map(m => ({
  token: `--${m[1]}`, value: m[2].trim()
}))

// ── UI primitives — auto-generated from src/components/ui/*.astro ───────────
const uiDir = path.join(ROOT, 'src/components/ui')
const primitiveFiles = fs.readdirSync(uiDir).filter(f => f.endsWith('.astro'))
const primitives = primitiveFiles.map(f => {
  const name = f.replace('.astro', '')
  const content = fs.readFileSync(path.join(uiDir, f), 'utf8')
  const descMatch = content.match(/\/\*\*\s*(?:\n\s*\*\s*)?(.+?)(?:\s*\*\/|\n)/)
  return { name, description: descMatch?.[1]?.trim() ?? name }
})

const cardVariants = [
  { variant: 'default', class: 'panel', description: 'Glass panel with backdrop blur. The standard card.' },
  { variant: 'hero', class: 'panel panel-hero', description: 'Accent border, gradient bg, glow top-line. Featured cards.' },
  { variant: 'static', class: 'panel-static', description: 'Same as default but no entrance animation. Stat grids.' },
  { variant: 'flat', class: 'panel-flat', description: 'Background + border only. Nested cards, tables.' },
]

const typographyRules = [
