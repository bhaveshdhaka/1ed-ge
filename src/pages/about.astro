---
import Base from '../layouts/Base.astro'
import Card from '../components/ui/Card.astro'
import { getCollection } from 'astro:content'

const accounts = await getCollection('accounts')
const byFirm = new Map<string, typeof accounts>()
for (const a of accounts) {
  if (!byFirm.has(a.data.firm)) byFirm.set(a.data.firm, [])
  byFirm.get(a.data.firm)!.push(a)
}

const rules = [
  'trade every day i can.',
  'never risk more than i can afford to lose.',
  'focus on the move, not the number.',
  'stay small, nimble, and consistent.',
  'have fun and surpass the S&P by a big margin every year.',
]

const timeline = [
  { d: 'now', t: 'every day, public' },
  { d: '2y', t: 'funded scale, public record, R as the unit of truth' },
  { d: '3y', t: 'a real fund, managed with the same rules' },
]
---

<Base title="about — 1ed.ge" description="The public proof: rules, prop firms, accounts, and the plan to turn a public trading record into a hedge fund.">
  <section class="shell pt-12 pb-20 max-w-3xl">
    <div class="flex items-baseline gap-3">
      <h1 class="text-2xl">/ about</h1>
      <span class="text-xs text-faint">why this exists</span>
    </div>

    <Card icon="📖" label="about" class="mt-8">
        <p class="text-sm leading-relaxed text-soft">
          i want to run a hedge fund. but before anyone — including me — should trust me with money,
          i need to prove i can trade. properly. consistently. without hiding the bad days.
        </p>
        <p class="mt-3 text-sm leading-relaxed text-soft">
          so everything goes public. every trade. every account. every journal entry.
          every habit logged. the numbers are the numbers, and <span class="text-up">R</span> — points
          risked vs points made — is the centerpiece. it is the one metric that survives changing
          account sizes, changing firms, and changing bankrolls.
        </p>
    </Card>

    <Card icon="📏" label="the rules" class="mt-6">
      <ul class="flex flex-col gap-0">
        {rules.map((r, i) => (
          <li class="flex gap-3 border-b border-line/60 py-2 text-sm last:border-0">
            <span class="w-6 shrink-0 text-faint">{String(i + 1).padStart(2, '0')}</span>
            <span class="text-soft">{r}</span>
          </li>
        ))}
      </ul>
    </Card>

    <Card icon="💰" label="the accounts" subtitle={`${accounts.length} live`} class="mt-6">
      <p class="mb-3 text-xs text-dim">
        trading mnq (micro e-mini nasdaq-100) through prop firms. the live P&amp;L of every account is on
        <a href="/performance" class="text-accent underline underline-offset-4">/performance</a>.
      </p>
      <div class="overflow-x-auto" tabindex="0">
      <table class="w-full min-w-[540px] border-collapse">
        <thead>
          <tr>
            <th class="th">firm</th>
            <th class="th">size</th>
            <th class="th text-right">drawdown</th>
            <th class="th">status</th>
          </tr>
        </thead>
        <tbody>
          {accounts.map((a) => (
            <tr>
              <td class="td">{a.data.firm}</td>
              <td class="td text-dim">{a.data.sizeLabel}</td>
              <td class="td text-right text-dim">${a.data.drawdownLimit.toLocaleString()}</td>
              <td class="td"><span class={a.data.stage === 'failed' ? 'text-down' : a.data.stage === 'paused' ? 'text-dim' : 'text-up'}>{a.data.stage}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
      </div>
    </Card>

    <Card icon="🗺" label="the plan" class="mt-6">
      {timeline.map((t) => (
        <div class="kv">
          <span class="w-12 shrink-0 text-sm text-accent">{t.d}</span>
          <span class="text-sm text-soft">{t.t}</span>
        </div>
      ))}
    </Card>

    <Card icon="🛠" label="how this was built" subtitle="100% OpenCode" class="mt-6">
      <p class="text-sm leading-relaxed text-soft">
        this site was built entirely using <span class="text-accent">OpenCode</span> — an AI coding assistant
        that orchestrates multiple specialized agents (explorer, fixer, oracle, designer, librarian)
        to plan, implement, and ship features. the full stack, features, changelog, token costs,
        and a file-by-file traceability map are at <a href="/dev" class="text-accent underline underline-offset-4">/dev</a>.
      </p>
    </Card>

    <Card class="mt-6">
      <p class="text-sm leading-relaxed text-dim">
        <span class="text-warn">disclaimer:</span> nothing here is financial advice. i am not a
        licensed advisor. these are the trades of one person proving himself in public. do your
        own work. prop accounts can and do fail — that is part of the record.
      </p>
    </Card>
  </section>
</Base>
