---
import { execSync } from 'node:child_process'
import fs from 'node:fs'
import Base from '../layouts/Base.astro'
import Card from '../components/ui/Card.astro'
import KvRow from '../components/ui/KvRow.astro'
import Well from '../components/ui/Well.astro'
import Badge from '../components/ui/Badge.astro'
import Table from '../components/ui/Table.astro'
import { fmtDayWUpper } from '../lib/dates'
import { readLiveState } from '../lib/live'

export const prerender = false

// ── helpers ────────────────────────────────────────────────────────────────
/** Run a shell command; return trimmed stdout, or null on any failure. */
function sh(cmd: string): string | null {
  try {
    return execSync(cmd, { encoding: 'utf8', timeout: 10_000 }).toString().trim()
  } catch {
    return null
  }
}

/** Read a file; return raw text, or null on any failure. */
function readFile(p: string): string | null {
  try {
    return fs.readFileSync(p, 'utf8')
  } catch {
    return null
  }
}

/** Parse a JSON file; return the parsed value, or null on any failure. */
function readJson(p: string): unknown {
  try {
    return JSON.parse(fs.readFileSync(p, 'utf8'))
  } catch {
    return null
  }
}

/** Human relative time from an ISO timestamp. */
function rel(iso: string | null): string {
  if (!iso) return 'never'
  const ms = Date.now() - Date.parse(iso)
  if (isNaN(ms)) return 'unknown'
  const s = Math.max(0, Math.floor(ms / 1000))
  if (s < 60) return `${s}s ago`
  const m = Math.floor(s / 60)
  if (m < 60) return `${m}m ago`
  const h = Math.floor(m / 60)
  if (h < 24) return `${h}h ${m % 60}m ago`
  const d = Math.floor(h / 24)
  return `${d}d ago`
}

// ── 1. market news fetch ───────────────────────────────────────────────────
const logTail = (readFile('/tmp/1edge-market.log') ?? '').split('\n').slice(-50)

// Last summary line wins:  market-news: 39 tv + 11 ff -> 50 events (16 red, 25 verified)
const SUMMARY = /market-news: (\d+) tv \+ (\d+) ff -> (\d+) events \((\d+) red, (\d+) verified\)/
const UNVERIFIED_COUNT = /market-news: (\d+) unverified \(single source\):/

let mkt = { tv: null as number | null, ff: null as number | null, events: null as number | null, red: null as number | null, verified: null as number | null }
let unverifiedCount: number | null = null
for (const line of logTail) {
  const m = SUMMARY.exec(line)
  if (m) mkt = { tv: Number(m[1]), ff: Number(m[2]), events: Number(m[3]), red: Number(m[4]), verified: Number(m[5]) }
  const u = UNVERIFIED_COUNT.exec(line)
  if (u) unverifiedCount = Number(u[1])
}
// Unverified event rows appear as indented "  TV …" / "  FF …" lines.
const unverified = logTail.filter((l) => /^\s{2}(TV|FF) /.test(l)).slice(0, 20)

// Newest market-news day file → last fetch date.
let lastFetch: string | null = null
try {
  const files = fs
    .readdirSync('src/content/market-news')
    .filter((f) => /^\d{4}-\d{2}-\d{2}\.md$/.test(f))
    .sort()
  if (files.length) lastFetch = files[files.length - 1].slice(0, 10)
} catch {}

// ── 2. rebuild history ─────────────────────────────────────────────────────
const rebuilds = (readJson('/tmp/1edge-rebuilds.json') ?? []) as Array<{ at?: string; ok?: boolean; applied?: string[] }>
const pending = (readJson('/tmp/1edge-pending.json') ?? []) as Array<{ at?: string; kind?: string; label?: string }>
const lastRebuild = rebuilds.length ? rebuilds[rebuilds.length - 1] : null
const lastRebuilds = rebuilds.slice(-10).reverse()

// ── 3. system health ───────────────────────────────────────────────────────
const docker = sh('docker ps --filter name=1edge-site --format "{{.Status}}"')
const dockerUp = !!docker && /^Up/.test(docker)

const dfRaw = sh('df -h / | tail -1')
const dfParts = dfRaw ? dfRaw.split(/\s+/) : null
const disk = dfParts && dfParts.length >= 5 ? { total: dfParts[1], used: dfParts[2], pct: dfParts[4] } : null

const memRaw = sh('free -h | grep Mem')
const memParts = memRaw ? memRaw.split(/\s+/) : null
const mem = memParts && memParts.length >= 3 ? { total: memParts[1], used: memParts[2] } : null

const uptime = sh('uptime -p')
const nodeCount = sh('pgrep -c node')

// ── 4. git state ───────────────────────────────────────────────────────────
const branch = sh('git rev-parse --abbrev-ref HEAD')
const lastCommit = sh('git log -1 --format="%h %s (%cr)"')
const syncRaw = sh('git rev-list --left-right --count "HEAD...@{upstream}" 2>/dev/null')
let sync: { ahead: string; behind: string } | null = null
if (syncRaw) {
  const [a, b] = syncRaw.split(/\s+/)
  if (a && b) sync = { ahead: a, behind: b }
}

// ── 5. live state ──────────────────────────────────────────────────────────
const live = readLiveState()

// Live operational data — never serve a stale cached copy.
Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate')
---

<Base title="status — 1ed.ge" description="Operational health dashboard — cron, rebuilds, system, git, live state.">
  <section class="shell pt-12 pb-20">
    <header class="flex items-baseline gap-3">
      <h1 class="text-2xl text-ink">/ status</h1>
      <span class="text-xs text-faint">operational health</span>
    </header>

    <div class="mt-6 flex max-w-2xl flex-col gap-4">
      <!-- market news fetch -->
      <Card icon="📡" label="market news fetch" subtitle={lastFetch ? `last fetch ${fmtDayWUpper(lastFetch)}` : 'no fetch yet'}>
        <KvRow label="tv sources" value={mkt.tv !== null ? String(mkt.tv) : 'unavailable'} />
        <KvRow label="ff sources" value={mkt.ff !== null ? String(mkt.ff) : 'unavailable'} />
        <KvRow label="events" value={mkt.events !== null ? String(mkt.events) : 'unavailable'} />
        <KvRow label="red" value={mkt.red !== null ? String(mkt.red) : 'unavailable'} />
        <KvRow label="verified" value={mkt.verified !== null ? String(mkt.verified) : 'unavailable'} />
        <KvRow label="unverified" value={unverifiedCount !== null ? String(unverifiedCount) : 'unavailable'} />

        {unverified.length > 0 && (
          <div class="mt-3">
            <div class="text-2xs uppercase tracking-widest text-dim">unverified (single source)</div>
            <Well class="mt-1 p-3">
              <ul class="space-y-1">
                {unverified.map((u) => (
                  <li class="font-mono text-2xs leading-relaxed text-dim">{u.trim()}</li>
                ))}
              </ul>
            </Well>
          </div>
        )}

        <div class="mt-3">
          <div class="text-2xs uppercase tracking-widest text-dim">log tail · last 50 lines</div>
          <Well class="mt-1 p-3">
            <pre class="whitespace-pre-wrap break-words font-mono text-2xs leading-relaxed text-dim">{logTail.join('\n')}</pre>
          </Well>
        </div>
      </Card>

      <!-- rebuilds -->
      <Card icon="🔨" label="rebuilds" subtitle={`${pending.length} pending change${pending.length === 1 ? '' : 's'}`}>
        <KvRow label="last rebuild" value={lastRebuild ? `${rel(lastRebuild.at ?? null)} · ${lastRebuild.ok ? 'ok' : 'failed'}` : 'none yet'} />
        <KvRow label="pending changes" value={String(pending.length)} />
        {pending.length > 0 && (
          <div class="mt-1">
            <div class="text-2xs uppercase tracking-widest text-dim">queued</div>
            <ul class="mt-1 space-y-0.5">
              {pending.slice(-5).reverse().map((p) => (
                <li class="text-2xs text-dim"><span class="text-faint">{rel(p.at ?? null)}</span> · {p.label ?? p.kind ?? '—'}</li>
              ))}
            </ul>
          </div>
        )}

        {rebuilds.length > 0 && (
          <div class="mt-3">
            <div class="text-2xs uppercase tracking-widest text-dim">last 10 rebuilds</div>
            <Table head={['at', 'status', 'changes']} class="mt-1">
              {lastRebuilds.map((r) => (
                <tr>
                  <td class="td">
                    {fmtDayWUpper((r.at ?? '').slice(0, 10))} <span class="text-faint">· {rel(r.at ?? null)}</span>
                  </td>
                  <td class="td">
                    <Badge variant={r.ok ? 'up' : 'down'}>{r.ok ? 'ok' : 'fail'}</Badge>
                  </td>
                  <td class="td">{(r.applied ?? []).join(', ') || '—'}</td>
                </tr>
              ))}
            </Table>
          </div>
        )}
      </Card>

      <!-- system -->
      <Card icon="💻" label="system">
        <KvRow label="container">
          <Badge variant={dockerUp ? 'up' : 'down'}>{dockerUp ? 'up' : 'down'}</Badge>
          <span class="ml-1">{docker ?? 'unavailable'}</span>
        </KvRow>
        <KvRow label="disk" value={disk ? `${disk.used} / ${disk.total} (${disk.pct})` : 'unavailable'} />
        <KvRow label="memory" value={mem ? `${mem.used} / ${mem.total}` : 'unavailable'} />
        <KvRow label="uptime" value={uptime ?? 'unavailable'} />
        <KvRow label="node processes" value={nodeCount ?? 'unavailable'} />
      </Card>

      <!-- git -->
      <Card icon="🌿" label="git">
        <KvRow label="branch" value={branch ?? 'unavailable'} />
        <KvRow label="last commit" value={lastCommit ?? 'unavailable'} />
        <KvRow label="sync">
          {sync ? (
            <span>
              {Number(sync.ahead) > 0 || Number(sync.behind) > 0 ? (
                <Badge variant={Number(sync.behind) > 0 ? 'down' : 'warn'}>{Number(sync.behind) > 0 ? 'behind' : 'ahead'}</Badge>
              ) : (
                <Badge variant="up">synced</Badge>
              )}
              <span class="ml-1">{sync.ahead} ahead · {sync.behind} behind</span>
            </span>
          ) : (
            'unavailable (no upstream)'
          )}
        </KvRow>
      </Card>

      <!-- live -->
      <Card icon="🟢" label="live">
        <KvRow label="trader">
          <Badge variant={live.live ? 'up' : 'down'}>{live.live ? '● live' : '○ offline'}</Badge>
        </KvRow>
        <KvRow label="last heartbeat" value={live.at ? `${rel(live.at)} · ${live.at}` : 'never'} />
        {live.lastOnlineIso && (
          <KvRow label="last seen (durable)" value={`${rel(live.lastOnlineIso)} · ${fmtDayWUpper(live.lastOnlineIso.slice(0, 10))}`} />
        )}
      </Card>
    </div>
  </section>
</Base>
