---
import Base from '../layouts/Base.astro'
import Card from '../components/ui/Card.astro'
import { getCollection } from 'astro:content'
import { buildStats, flatten, fmtPnl } from '../lib/stats'
import { accountRuleStatus } from '../lib/account-rules'
import { todayHkt } from '../lib/sessions'

export const prerender = false

const [accounts, days, payouts] = await Promise.all([
  getCollection('accounts'),
  getCollection('days'),
  getCollection('payouts'),
])
const { perAccount, executions } = buildStats(days, accounts, payouts)
const payoutRows = [...payouts].sort((a, b) => b.data.date.localeCompare(a.data.date))
const todayIso = todayHkt()

// Live rule status per account — composed from the same buildStats/flatten math.
const statusByAccount = new Map<string, ReturnType<typeof accountRuleStatus>>()
for (const acc of accounts) {
  const stat = perAccount.find((s) => s.id === acc.data.id)
  statusByAccount.set(acc.data.id, accountRuleStatus(acc.data, stat, executions, todayIso))
}

const stageColor: Record<string, string> = {
  eval: 'text-warn',
  funded: 'text-accent',
  buffer: 'text-accent',
  payout: 'text-up',
  failed: 'text-down',
  paused: 'text-dim',
}
const stageOrder: Record<string, number> = { eval: 0, funded: 1, buffer: 2, payout: 3, failed: 4, paused: 5 }
const sorted = [...perAccount].sort((a, b) => stageOrder[a.stage] - stageOrder[b.stage] || a.id.localeCompare(b.id))
const active = sorted.filter((a) => a.active)
---

<Base title="accounts — 1ed.ge" description="Every prop account live: stage, drawdown buffer, P&L net of payouts, and payout history.">
  <section class="shell pt-12 pb-20">
    <div class="flex items-baseline gap-3">
      <h1 class="text-2xl">/ accounts</h1>
      <span class="text-xs text-faint">eval → funded → buffer → payout</span>
    </div>

    <Card icon="💰" label="accounts" subtitle={`${sorted.length} · ${active.length} active`} class="mt-8">
      <div class="overflow-x-auto" tabindex="0">
      <table class="w-full min-w-[860px] border-collapse">
        <thead>
          <tr>
            <th class="th">account</th>
            <th class="th">stage</th>
            <th class="th text-right">size</th>
            <th class="th text-right">dd limit</th>
            <th class="th text-right">trades</th>
            <th class="th text-right">$ pnl</th>
            <th class="th text-right">payouts</th>
            <th class="th text-right">net</th>
            <th class="th text-right">R</th>
            <th class="th text-right">buffer left</th>
            <th class="th">live</th>
          </tr>
        </thead>
        <tbody>
          {sorted.map((a) => {
            const muted = !a.active
            const rs = statusByAccount.get(a.id) ?? null
            const accRules = accounts.find((x) => x.data.id === a.id)?.data.rules ?? null
            return (
            <tr>
              <td class="td">
                <div class:list={[muted ? 'text-faint' : 'text-ink']}>{a.firm}</div>
                <div class="text-2xs text-faint">{a.id}</div>
              </td>
              <td class="td"><span class={stageColor[a.stage] ?? ''}>{a.stage}</span></td>
              <td class="td text-right text-dim">{a.sizeLabel}</td>
              <td class="td text-right text-dim">${a.drawdownLimit.toLocaleString()}</td>
              <td class="td text-right" class:list={[muted && 'text-faint']}>{a.trades}</td>
              <td class="td text-right" class:list={[muted ? 'text-faint' : a.grossPnl > 0 ? 'text-up' : a.grossPnl < 0 ? 'text-down' : 'text-dim']}>{fmtPnl(a.grossPnl)}</td>
              <td class="td text-right text-dim">{a.payouts ? fmtPnl(-a.payouts) : '—'}</td>
              <td class="td text-right" class:list={[muted ? 'text-faint' : a.netPnl > 0 ? 'text-up' : a.netPnl < 0 ? 'text-down' : 'text-dim']}>{fmtPnl(a.netPnl)}</td>
              <td class="td text-right" class:list={[muted ? 'text-faint' : a.sumR > 0 ? 'text-up' : a.sumR < 0 ? 'text-down' : 'text-dim']}>{a.sumR > 0 ? '+' : ''}{a.sumR.toFixed(2)}R</td>
              <td class="td">
                <div class="flex items-center justify-end gap-2">
                  <div class="h-1.5 w-20 bg-raise">
                    <div class="h-full" style={`width:${a.ddUsedPct}%`} class:list={[a.ddUsedPct > 70 ? 'bg-down' : a.ddUsedPct > 40 ? 'bg-warn' : 'bg-up']} />
                  </div>
                  <span class="w-24 text-right text-2xs text-dim">${a.buffer.toLocaleString()}</span>
                </div>
              </td>
              {rs && (
                <td class="td">
                  <div class="whitespace-nowrap text-2xs text-dim">
                    net {fmtPnl(rs.netPnl)} / ${(rs.drawdownLimit ?? 0).toLocaleString()} dd
                    {rs.dailyLossLimit ? ` · today ${rs.todayPnl > 0 ? '+' : ''}$${Math.round(rs.todayPnl).toLocaleString()} / ${rs.dailyLossLimit.toLocaleString()} day` : ''}
                  </div>
                  <div class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-0.5 text-2xs">
                    {rs.breach === 'drawdown' && <span class="text-down">● breached — drawdown</span>}
                    {rs.breach === 'daily' && <span class="text-down">● breached — daily</span>}
                    {rs.breach === 'none' && <span class="text-dim">○ {accRules?.drawdownMode ?? 'eod'} — ok</span>}
                    <span class:list={[rs.consistencyPct != null ? 'text-up' : 'text-dim']}>
                      consistency: {rs.consistencyPct != null ? `${rs.consistencyPct}%` : '—'}
                    </span>
                  </div>
                </td>
              )}
            </tr>
            )
          })}
          {sorted.length === 0 && (
            <tr><td class="td text-faint" colspan="11">no accounts yet</td></tr>
          )}
        </tbody>
      </table>
      </div>
    </Card>

    <div class="mt-6 flex flex-wrap gap-x-4 gap-y-1 text-xs text-dim">
      <span><span class="text-up">●</span> active: {active.length}</span>
      <span><span class="text-warn">●</span> eval</span>
      <span><span class="text-accent">●</span> funded / building buffer</span>
      <span><span class="text-up">●</span> payout stage</span>
      <span><span class="text-down">●</span> failed — stays in the record forever</span>
      <span><span class="text-down">●</span> breached</span>
      <span><span class="text-up">●</span> consistency applies</span>
    </div>

    <Card icon="📤" label="payout history" subtitle={`${payoutRows.length} paid`} class="mt-14">
      <div class="overflow-x-auto" tabindex="0">
      <table class="w-full min-w-[560px] border-collapse">
        <thead>
          <tr>
            <th class="th">date</th>
            <th class="th">account</th>
            <th class="th text-right">amount</th>
            <th class="th">status</th>
            <th class="th">note</th>
          </tr>
        </thead>
        <tbody>
          {payoutRows.map((p) => {
            const acc = accounts.find((a) => a.data.id === p.data.account)
            return (
              <tr>
                <td class="td text-dim">{p.data.date}</td>
                <td class="td">{acc?.data.firm ?? ''} {acc?.data.sizeLabel ?? ''} <span class="text-faint">·{p.data.account}</span></td>
                <td class="td text-right text-up">{fmtPnl(p.data.amount).replace(/^\+/, '')}</td>
                <td class="td"><span class={p.data.status === 'paid' ? 'text-up' : 'text-warn'}>{p.data.status}</span></td>
                <td class="td text-dim">{p.data.note ?? ''}</td>
              </tr>
            )
          })}
          {payoutRows.length === 0 && (
            <tr><td class="td text-faint" colspan="5">no payouts yet — the first one arrives after the buffer is built.</td></tr>
          )}
        </tbody>
      </table>
      </div>
    </Card>
  </section>
</Base>
