---
import Base from '../layouts/Base.astro'
import MarketWidget from '../components/MarketWidget.astro'
import { getCollection } from 'astro:content'
import { marketEvents, todayHkt, addDaysIso, scheduledDayMarker, daySessionWindows } from '../lib/sessions'
import { groupNewsByTime, newsEmoji } from '../lib/market-news'
import { fmtDay } from '../lib/dates'

const today = todayHkt()
const events = marketEvents(today, 8)
const news = (await getCollection('market-news')).sort((a, b) => a.data.date.localeCompare(b.data.date))
const newsByDate = new Map(news.map((n) => [n.data.date, n.data]))

const days = Array.from({ length: 8 }, (_, i) => addDaysIso(today, i))
const evByDay = new Map<string, typeof events>()
for (const e of events) {
  const d = e.hkt.slice(0, 10)
  if (!evByDay.has(d)) evByDay.set(d, [])
  evByDay.get(d)!.push(e)
}

const rowsByDay = days.map((d) => {
  const dm = scheduledDayMarker(d)
  const wins = daySessionWindows(d)
  const n = newsByDate.get(d)
  const redGroups = groupNewsByTime(n?.red ?? [])
  const orangeGroups = groupNewsByTime(n?.orange ?? [])
  return {
    d,
    fmt: fmtDay(d),
    dm,
    wins,
    redGroups,
    orangeGroups,
    redFirst: redGroups[0],
    orangeFirst: orangeGroups[0],
  }
})
---

<Base title="calendar — 1ed.ge" description="The next week in HKT: USD red/orange events, session times, and market status — deterministic, DST-aware, zero-inference.">
  <section class="shell pt-12 pb-20">
    <div class="flex flex-wrap items-baseline gap-3">
      <h1 class="text-2xl">/ calendar</h1>
      <span class="text-[12px] text-faint">the next week in HKT · deterministic, DST-aware</span>
    </div>

    <div class="mt-8 max-w-3xl">
      <MarketWidget />
    </div>

    <div class="mt-10 space-y-6">
      {rowsByDay.map((row) => (
        <div class="panel p-4">
          <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
            <span class="text-[15px] text-ink">{row.fmt}</span>
            <span class:list={['text-[12px] tabular-nums', row.dm.cls]} data-mkt-live={row.dm.live ? true : undefined}>
              {row.dm.glyph} {row.dm.text}
            </span>
            {row.redFirst && <span class="text-[12px] text-down">red {row.redFirst.time}</span>}
            {!row.redFirst && row.orangeFirst && <span class="text-[12px] opacity-70 text-warn">orange {row.orangeFirst.time}</span>}
          </div>

          <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 border-t border-line/50 pt-2 text-[12px] text-dim">
            <span class="flex items-center gap-1.5"><span>🇺🇸</span><span class="tabular-nums">{row.wins.nyse}</span></span>
            <span class="flex items-center gap-1.5"><span>🇯🇵</span><span class="tabular-nums">{row.wins.tse}</span></span>
            <span class="flex items-center gap-1.5"><span>🇬🇧</span><span class="tabular-nums">{row.wins.lse}</span></span>
            <span class="flex items-center gap-1.5"><span>📈</span><span class="tabular-nums">{row.wins.cme}</span></span>
          </div>

          {(row.redGroups.length > 0 || row.orangeGroups.length > 0) && (
            <div class="mt-2 flex flex-col gap-1 border-t border-line/50 pt-2 text-[13px]">
              {row.redGroups.map((g) => (
                <div class="flex items-baseline gap-3">
                  <span class="w-20 shrink-0 text-right text-[12px] tabular-nums text-down">{newsEmoji(g.titles[0])} {g.time}</span>
                  <span class="text-down">{g.titles.join(' · ')}</span>
                </div>
              ))}
              {row.orangeGroups.map((g) => (
                <div class="flex items-baseline gap-3">
                  <span class="w-20 shrink-0 text-right text-[12px] tabular-nums opacity-70 text-warn">{newsEmoji(g.titles[0])} {g.time}</span>
                  <span class="opacity-70 text-warn">{g.titles.join(' · ')}</span>
                </div>
              ))}
            </div>
          )}
          {row.redGroups.length === 0 && row.orangeGroups.length === 0 && (
            <p class="mt-2 border-t border-line/50 pt-2 text-[12px] text-faint">no major USD news · {row.dm.text}</p>
          )}
        </div>
      ))}
    </div>
  </section>
</Base>
