---
import Base from '../layouts/Base.astro'
import MarketWidget from '../components/MarketWidget.astro'
import NewsEventsCard from '../components/NewsEventsCard.astro'
import { getCollection } from 'astro:content'
import { marketEvents, todayHkt, addDaysIso, scheduledDayMarker, daySessionWindows } from '../lib/sessions'
import { fmtDayWUpper } from '../lib/dates'

const today = todayHkt()
const events = marketEvents(today, 8)
const news = (await getCollection('market-news')).sort((a, b) => a.data.date.localeCompare(b.data.date))
const newsByDate = new Map(news.map((n) => [n.data.date, n.data]))

const days = Array.from({ length: 8 }, (_, i) => addDaysIso(today, i))
const evByDay = new Map<string, typeof events>()
for (const e of events) {
  const d = e.hkt.slice(0, 10)
  if (!evByDay.has(d)) evByDay.set(d, [])
  evByDay.get(d)!.push(e)
}

const rowsByDay = days.map((d) => {
  const dm = scheduledDayMarker(d)
  const wins = daySessionWindows(d)
  const n = newsByDate.get(d)
  return {
    d,
    fmt: fmtDayWUpper(d),
    dm,
    wins,
    red: n?.red ?? [],
    orange: n?.orange ?? [],
  }
})
---

<Base title="calendar — 1ed.ge" description="The next week in HKT: news events, session times, and market status — deterministic, DST-aware, zero-inference.">
  <section class="shell pt-12 pb-20">
    <div class="flex flex-wrap items-baseline gap-3">
      <h1 class="text-2xl">/ calendar</h1>
      <span class="text-xs text-faint">the next week in HKT · deterministic, DST-aware</span>
    </div>

    <div class="mt-8 max-w-3xl">
      <MarketWidget />
    </div>

    <div class="mt-10 space-y-6">
      {rowsByDay.map((row) => (
        <div class:list={['panel', row.d === today && 'panel-hero']}>
          <div class="card-hd border-b border-sep">
            <span class="card-ico">📅</span>
            <span class="card-lbl">{row.fmt}</span>
            <span class:list={['card-sub tabular-nums', row.dm.cls]}>
              {row.dm.glyph} {row.dm.text}
            </span>
          </div>
          <div class="p-3 md:p-4">
            <div class="well px-3 py-2">
              <div class="flex flex-wrap gap-x-3 gap-y-1 text-xs text-dim">
                <span class="flex items-center gap-1.5"><span>🇺🇸</span><span class="tabular-nums">{row.wins.nyse}</span></span>
                <span class="flex items-center gap-1.5"><span>🇯🇵</span><span class="tabular-nums">{row.wins.tse}</span></span>
                <span class="flex items-center gap-1.5"><span>🇬🇧</span><span class="tabular-nums">{row.wins.lse}</span></span>
                <span class="flex items-center gap-1.5"><span>📈</span><span class="tabular-nums">{row.wins.cme}</span></span>
              </div>
            </div>

            <div class="mt-3">
              <NewsEventsCard red={row.red} orange={row.orange} dayIso={row.d} isToday={row.d === today} hideDate />
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>
</Base>
