---
import Base from '../layouts/Base.astro'
import MarketWidget from '../components/MarketWidget.astro'
import { getCollection } from 'astro:content'
import { marketEvents, todayHkt, addDaysIso } from '../lib/sessions'
import { marketMarker } from '../lib/market'
import { fmtDay } from '../lib/dates'

const today = todayHkt()
const events = marketEvents(today, 8)
const news = (await getCollection('market-news')).sort((a, b) => a.data.date.localeCompare(b.data.date))
const newsByDate = new Map(news.map((n) => [n.data.date, n.data]))

const days = Array.from({ length: 8 }, (_, i) => addDaysIso(today, i))
const evByDay = new Map<string, typeof events>()
for (const e of events) {
  const d = e.hkt.slice(0, 10)
  if (!evByDay.has(d)) evByDay.set(d, [])
  evByDay.get(d)!.push(e)
}

const marketLabel: Record<string, string> = { cme: 'MNQ futures', nyse: 'New York', tse: 'Tokyo', lse: 'London' }
const typeLabel: Record<string, string> = { open: 'open', close: 'close', halt: 'halt', resume: 'resume' }
const t = (hkt: string) => hkt.slice(11, 16)
const dLabel = (d: string) => {
  const diff = Math.round((Date.parse(d + 'T00:00+08:00') - Date.parse(today + 'T00:00+08:00')) / 86400000)
  return diff === 0 ? '' : diff > 0 ? `+${diff}d` : `${diff}d`
}

const rowsByDay = days.map((d) => {
  const mk = marketMarker(d)
  const evs = evByDay.get(d) ?? []
  const n = newsByDate.get(d)
  const red = n?.red ?? []
  const orange = n?.orange ?? []
  const sessions = (['cme', 'nyse', 'tse', 'lse'] as const)
    .map((m) => {
      const list = evs.filter((e) => e.market === m)
      return {
        label: marketLabel[m],
        parts: list.map((e) => `${t(e.hkt)}${dLabel(e.hkt.slice(0, 10))} ${typeLabel[e.type] ?? ''}${e.label ? ` (${e.label})` : ''}`),
      }
    })
    .filter((s) => s.parts.length > 0)
  return { d, fmt: fmtDay(d), mk, red, orange, sessions }
})
---

<Base title="calendar — 1ed.ge" description="This week's USD market events and session times in HKT — red/orange news, CME/TSE/LSE/NYSE opens and closes, deterministic and verified.">
  <section class="shell pt-12 pb-20">
    <div class="flex flex-wrap items-baseline gap-3">
      <h1 class="text-2xl">/ calendar</h1>
      <span class="text-[12px] text-faint">the next week in HKT · deterministic, DST-aware</span>
    </div>

    <div class="mt-8 max-w-3xl">
      <MarketWidget />
    </div>

    <div class="mt-10 space-y-6">
      {rowsByDay.map((row) => (
        <div class="panel p-4">
          <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
            <span class="text-[15px] text-ink">{row.fmt}</span>
            <span class:list={['text-[12px]', row.mk.status === 'open' ? 'text-up' : row.mk.status === 'early' ? 'text-warn' : 'text-down']}>
              {row.mk.glyph} {row.mk.text}
            </span>
            {row.red.length > 0 && <span class="text-[12px] text-down">red {row.red[0].time} hkt</span>}
            {row.orange.length > 0 && <span class="text-[12px] opacity-70 text-warn">orange {row.orange[0].time} hkt</span>}
          </div>
          <div class="mt-3 grid gap-px border border-line bg-line md:grid-cols-4">
            {row.sessions.map((s) => (
              <div class="bg-bg p-3">
                <div class="text-[10px] uppercase tracking-widest text-dim">{s.label}</div>
                <div class="mt-1 text-[12px] text-soft">
                  {s.parts.map((p) => (
                    <div>{p}</div>
                  ))}
                </div>
              </div>
            ))}
          </div>
          {(row.red.length > 0 || row.orange.length > 0) && (
            <div class="mt-2 flex flex-wrap gap-x-5 gap-y-1 text-[13px]">
              {row.red.map((x) => (
                <span class="text-down">red {x.time} hkt — {x.title} <span class="text-[10px] text-faint">[{x.source ?? ''}{x.verified ? ' ✦' : ''}]</span></span>
              ))}
              {row.orange.map((x) => (
                <span class="opacity-70 text-warn">orange {x.time} hkt — {x.title} <span class="text-[10px] text-faint">[{x.source ?? ''}{x.verified ? ' ✦' : ''}]</span></span>
              ))}
            </div>
          )}
          {row.sessions.length === 0 && row.red.length === 0 && row.orange.length === 0 && (
            <p class="mt-2 text-[12px] text-faint">—</p>
          )}
        </div>
      ))}
    </div>
  </section>
</Base>
