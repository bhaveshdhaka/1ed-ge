---
import Base from '../layouts/Base.astro'
import Card from '../components/ui/Card.astro'
import Badge from '../components/ui/Badge.astro'
import Tag from '../components/ui/Tag.astro'
import EmptyState from '../components/ui/EmptyState.astro'
import Separator from '../components/ui/Separator.astro'
import Icon from '../components/ui/Icon.astro'
import StatCard from '../components/ui/StatCard.astro'
import Table from '../components/ui/Table.astro'
import KvRow from '../components/ui/KvRow.astro'
import SegControl from '../components/ui/SegControl.astro'
import Capsule from '../components/ui/Capsule.astro'
import Well from '../components/ui/Well.astro'
import Button from '../components/ui/Button.astro'
import SectionNav from '../components/ui/SectionNav.astro'
import DayFacts from '../components/stream/DayFacts.astro'
import ThoughtCard from '../components/stream/ThoughtCard.astro'
import type { FactCell, ResolvedThought } from '../lib/stream'

const DESIGN_VERSION = 'v0.3-alpha'

const palette = [
  { token: '--hue-bg', value: '#07080c', purpose: 'base page background' },
  { token: '--hue-panel', value: '#0d0f16', purpose: 'solid panel' },
  { token: '--hue-raise', value: '#12141d', purpose: 'raised surface' },
  { token: '--hue-line', value: '#1c2030', purpose: 'hairline border' },
  { token: '--hue-line2', value: '#2a2f42', purpose: 'stronger border' },
  { token: '--hue-ink', value: '#e6ebf5', purpose: 'primary text' },
  { token: '--hue-soft', value: '#aab2c6', purpose: 'secondary text' },
  { token: '--hue-dim', value: '#8b93a6', purpose: 'tertiary text' },
  { token: '--hue-faint', value: '#7d859a', purpose: 'faintest text' },
  { token: '--hue-accent', value: '#0af', purpose: 'electric blue accent' },
  { token: '--hue-up', value: '#6ea88a', purpose: 'up/green (muted sage)' },
  { token: '--hue-down', value: '#c2725e', purpose: 'down/red (muted clay)' },
  { token: '--hue-warn', value: '#d9a441', purpose: 'warn/amber' },
]

const typeScale = [
  { token: 'text-4xs', px: '9px', rem: '0.5625rem', usage: 'Micro labels (fact labels, stat labels)' },
  { token: 'text-3xs', px: '10px', rem: '0.625rem', usage: 'Pills, timers, card subtitles, meta' },
  { token: 'text-2xs', px: '11px', rem: '0.6875rem', usage: 'Card labels, nav tabs, table headers' },
  { token: 'text-xs', px: '12px', rem: '0.75rem', usage: 'Body secondary, table cells, details' },
  { token: 'text-sm', px: '13px', rem: '0.8125rem', usage: 'Body default, thoughts, prose' },
  { token: 'text-base', px: '15px', rem: '0.9375rem', usage: 'Trade names, key values' },
  { token: 'text-lg', px: '18px', rem: '1.125rem', usage: 'Stat values, section headings' },
  { token: 'text-xl', px: '20px', rem: '1.25rem', usage: 'Admin page headers' },
  { token: 'text-2xl', px: '24px', rem: '1.5rem', usage: 'Public page headers' },
  { token: 'text-3xl', px: '32px', rem: '2rem', usage: 'Homepage hero' },
  { token: 'text-4xl', px: '40px', rem: '2.5rem', usage: 'Homepage hero (desktop)' },
]

const materialTokens = [
  { token: '--radius', value: '14px', usage: 'Panel border-radius' },
  { token: '--radius-sm', value: '10px', usage: 'Button/input/well radius' },
  { token: '--shadow-card', value: 'inset glow + drop shadow', usage: 'Panel shadow' },
  { token: '--blur-card', value: '18px', usage: 'Glass blur (8px on mobile)' },
  { token: '--ease-out', value: 'cubic-bezier(0.25, 0.1, 0.25, 1)', usage: 'Standard easing' },
  { token: '--ease-spring', value: 'cubic-bezier(0.34, 1.2, 0.64, 1)', usage: 'Spring easing' },
  { token: '--motion-fast', value: '0.15s', usage: 'Button/seg/capsule transitions' },
  { token: '--motion-normal', value: '0.3s', usage: 'Panel-hero hover' },
  { token: '--motion-slow', value: '0.5s', usage: 'Deliberate animations' },
]

const cardVariants = [
  { variant: 'default', class: 'panel', description: 'Glass panel with backdrop blur. The standard card.' },
  { variant: 'hero', class: 'panel panel-hero', description: 'Accent border, gradient bg, glow top-line. Featured cards.' },
  { variant: 'static', class: 'panel-static', description: 'Same as default but no entrance animation. Stat grids.' },
  { variant: 'flat', class: 'panel-flat', description: 'Background + border only. Nested cards, tables.' },
]

const typographyRules = [
  { element: 'Card header label', token: 'text-2xs', weight: '700', case: 'UPPERCASE', tracking: '0.6px', color: 'soft' },
  { element: 'Card subtitle', token: 'text-3xs', weight: '500', case: '—', tracking: '—', color: 'faint' },
  { element: 'Card icon', token: '14px', weight: '—', case: '—', tracking: '—', color: '—' },
  { element: 'Timer pill', token: 'text-3xs', weight: '600', case: '—', tracking: '0.2px', color: 'accent' },
  { element: 'Stat label', token: 'text-4xs', weight: '700', case: 'UPPERCASE', tracking: '0.6px', color: 'faint' },
  { element: 'Stat value', token: 'text-lg', weight: '600', case: '—', tracking: '—', color: 'ink' },
  { element: 'Fact cell label', token: 'text-4xs', weight: '700', case: 'UPPERCASE', tracking: '0.6px', color: 'faint' },
  { element: 'Fact cell value', token: 'text-sm', weight: '600', case: '—', tracking: '—', color: 'ink' },
  { element: 'Table header', token: 'text-2xs', weight: '400', case: 'UPPERCASE', tracking: '0.14em', color: 'dim' },
  { element: 'Table cell', token: 'text-xs', weight: '400', case: '—', tracking: '—', color: 'inherit' },
  { element: 'Thought body', token: 'text-sm', weight: '400', case: '—', tracking: '—', color: 'soft' },
  { element: 'Button', token: 'text-sm', weight: '—', case: '—', tracking: '—', color: 'soft' },
  { element: 'Segment', token: 'text-2xs', weight: '600', case: '—', tracking: '—', color: 'dim' },
  { element: 'Capsule', token: 'text-3xs', weight: '600', case: '—', tracking: '—', color: 'dim' },
  { element: 'Page h1', token: 'text-2xl', weight: '600', case: '—', tracking: '—', color: 'ink' },
  { element: 'Section h2', token: 'text-lg', weight: '600', case: '—', tracking: '—', color: 'ink' },
]

const roadmap = [
  { item: 'SheetFrame keyframes → app.css', priority: 'low', detail: 'The shared SheetFrame.tsx injects @keyframes via inline <style>. Move to app.css for dedup.' },
  { item: 'MarketFooter/Widget DOM-update dedup', priority: 'low', detail: 'Both components duplicate the same countdown-update logic. Extract shared updater.' },
  { item: 'Chart SVG font-size tokens', priority: 'low', detail: 'Chart axes use inline font-size="9". Could use text-4xs token.' },
  { item: 'Dark/light theme support', priority: 'future', detail: 'data-theme="summit" is inert. Could wire up for theme swapping.' },
  { item: 'Component storybook', priority: 'future', detail: 'Interactive preview of all components with props. Would replace this static page.' },
]

// ── composite fixtures ──────────────────────────────────────────────────────
const sampleFactCells: FactCell[] = [
  { key: 'mood', label: 'MOOD', value: '😐 okay', ok: true, up: undefined },
  { key: 'sleep', label: 'SLEEP', value: '6.5h · 3/5', ok: true, up: undefined },
  { key: 'r', label: 'R', value: '+2.50R', ok: true, up: true },
  { key: 'trades', label: 'TRADES', value: '4 · 75% win', ok: true, up: undefined },
  { key: 'screen', label: 'SCREEN', value: '5.2h', ok: true, up: undefined },
  { key: 'habits', label: 'HABITS', value: '5/6', ok: true, up: undefined },
]

const sampleThoughts: ResolvedThought[] = [
  {
    iso: '2026-08-11', at: '09:15', type: 'trade',
    text: undefined, images: [], author: undefined,
    trade: { R: 2.5, direction: 'long' as const, market: 'MNQ', model: 'orb-drive', setup: 'ORB', session: 'ny-am', points: 25, entry: 20800.5, exit: 20825.5, stop: 20790.5, note: 'Clean break above ORB, held to +2.5R.', screenshots: [] },
  },
  {
    iso: '2026-08-11', at: '08:30', type: 'note',
    text: 'Pre-market: CPI at 20:30 HKT. Flat 15 min before. No chasing.', images: [], author: undefined,
    trade: null,
  },
  {
    iso: '2026-08-11', at: '07:00', type: 'quote',
    text: 'The goal is not to be right. The goal is to make money when right and lose less when wrong.', images: [], author: undefined,
    trade: null,
  },
]
---

<Base title="design system — 1ed.ge" description="The 1ed.ge design system: tokens, components, typography, motion, and rules. Every card, every pixel.">
  <section class="shell pt-12 pb-20">
    <div class="flex flex-wrap items-baseline gap-3">
      <h1 class="text-2xl text-ink">/ design</h1>
      <span class="text-xs text-faint">{DESIGN_VERSION} · the card system</span>
    </div>
    <SectionNav sections={[
      ['architecture', 'architecture'],
      ['palette', 'palette'],
      ['type', 'type'],
      ['material', 'material'],
      ['cards', 'cards'],
      ['typography', 'typography'],
      ['primitives', 'primitives'],
      ['composites', 'composites'],
      ['rules', 'rules'],
      ['skill', 'skill'],
      ['backlog', 'backlog'],
      ['changelog', 'changelog'],
    ]} />
    <p class="mt-2 max-w-2xl text-sm text-dim">
      Every surface on 1ed.ge uses the same design system. One Card component, one type scale, one token architecture. This page documents every element, its rules, and how to use it.
    </p>

    <!-- Token Architecture -->
    <div id="architecture" class="mt-10 scroll-mt-28">
      <Card icon="🎨" label="token architecture" subtitle="3-layer system">
        <p class="mb-4 text-sm text-soft">
          The design system uses a 3-layer token architecture. To re-theme, only Layer 1 changes. Layer 2 and Layer 3 are stable.
        </p>
        <div class="grid gap-4 md:grid-cols-3">
          <div class="well p-3">
            <div class="text-4xs font-bold uppercase text-faint" style="letter-spacing:0.6px">Layer 1 · Palette</div>
            <p class="mt-1 text-xs text-dim">Raw hue values. Swap these to re-theme.</p>
            <p class="mt-1 text-2xs text-faint">--hue-bg, --hue-ink, --hue-accent, --hue-up, --hue-down…</p>
          </div>
          <div class="well p-3">
            <div class="text-4xs font-bold uppercase text-faint" style="letter-spacing:0.6px">Layer 2 · Semantic</div>
            <p class="mt-1 text-xs text-dim">Component roles. Never change.</p>
            <p class="mt-1 text-2xs text-faint">--color-bg, --color-ink, --color-accent, --color-up, --color-down…</p>
          </div>
          <div class="well p-3">
            <div class="text-4xs font-bold uppercase text-faint" style="letter-spacing:0.6px">Layer 3 · Material</div>
            <p class="mt-1 text-xs text-dim">Radii, shadows, blur, motion.</p>
            <p class="mt-1 text-2xs text-faint">--radius, --shadow-card, --blur-card, --motion-fast…</p>
          </div>
        </div>
      </Card>
    </div>

    <!-- Palette -->
    <div id="palette" class="mt-6 scroll-mt-28">
      <Card icon="🎨" label="palette" subtitle="Layer 1">
        <div class="overflow-x-auto">
          <table class="w-full border-collapse">
            <thead>
              <tr>
                <th class="th">token</th>
                <th class="th">value</th>
                <th class="th">purpose</th>
              </tr>
            </thead>
            <tbody>
              {palette.map((p) => (
                <tr>
                  <td class="td font-mono text-2xs text-accent">{p.token}</td>
                  <td class="td">
                    <span class="inline-flex items-center gap-2">
                      <span class="inline-block h-3 w-3 rounded-sm border border-line" style={`background:${p.value}`}></span>
                      <span class="font-mono text-2xs">{p.value}</span>
                    </span>
                  </td>
                  <td class="td text-dim">{p.purpose}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </Card>
    </div>

    <!-- Type Scale -->
    <div id="type" class="mt-6 scroll-mt-28">
      <Card icon="🔤" label="type scale" subtitle="mono-only · JetBrains Mono Variable">
        <p class="mb-3 text-xs text-dim">Syne Variable is reserved for the wordmark only.</p>
        <div class="overflow-x-auto">
          <table class="w-full border-collapse">
            <thead>
              <tr>
                <th class="th">token</th>
                <th class="th">px</th>
                <th class="th">rem</th>
                <th class="th">usage</th>
              </tr>
            </thead>
            <tbody>
              {typeScale.map((t) => (
                <tr>
                  <td class="td font-mono text-2xs text-accent">{t.token}</td>
                  <td class="td font-mono text-2xs">{t.px}</td>
                  <td class="td font-mono text-2xs text-dim">{t.rem}</td>
                  <td class="td text-dim">{t.usage}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </Card>
    </div>

    <!-- Material Tokens -->
    <div id="material" class="mt-6 scroll-mt-28">
      <Card icon="⚙️" label="material tokens" subtitle="Layer 3">
        <div class="overflow-x-auto">
          <table class="w-full border-collapse">
            <thead>
              <tr>
                <th class="th">token</th>
                <th class="th">value</th>
                <th class="th">usage</th>
              </tr>
            </thead>
            <tbody>
              {materialTokens.map((t) => (
                <tr>
                  <td class="td font-mono text-2xs text-accent">{t.token}</td>
                  <td class="td font-mono text-2xs">{t.value}</td>
                  <td class="td text-dim">{t.usage}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </Card>
    </div>

    <!-- Card System -->
    <div id="cards" class="mt-10 scroll-mt-28">
      <Card icon="🃏" label="card system" subtitle="the one panel primitive">
        <p class="mb-4 text-sm text-soft">
          Every surface on 1ed.ge uses the <code class="border border-line bg-raise px-1.5 py-0.5 text-2xs text-accent">Card</code> component. Never hand-build <code class="border border-line bg-raise px-1.5 py-0.5 text-2xs text-accent">.panel</code> + <code class="border border-line bg-raise px-1.5 py-0.5 text-2xs text-accent">.card-hd</code> markup. This is non-negotiable.
        </p>

        <div class="mb-4 text-4xs font-bold uppercase text-faint" style="letter-spacing:0.6px">Variants</div>
        <div class="grid gap-3 md:grid-cols-2">
          {cardVariants.map((v) => (
            <div class="well p-3">
              <div class="flex items-baseline gap-2">
                <span class="font-mono text-xs text-accent">{v.variant}</span>
                <span class="font-mono text-2xs text-faint">.{v.class}</span>
              </div>
              <p class="mt-1 text-xs text-dim">{v.description}</p>
            </div>
          ))}
        </div>

        <Separator class="my-4" />

        <div class="mb-3 text-4xs font-bold uppercase text-faint" style="letter-spacing:0.6px">Props</div>
        <div class="overflow-x-auto">
          <table class="w-full border-collapse">
            <thead>
              <tr>
                <th class="th">prop</th>
                <th class="th">type</th>
                <th class="th">default</th>
                <th class="th">description</th>
              </tr>
            </thead>
            <tbody>
              <tr><td class="td font-mono text-2xs text-accent">icon</td><td class="td text-dim">string</td><td class="td text-dim">—</td><td class="td text-dim">Emoji for card-ico</td></tr>
              <tr><td class="td font-mono text-2xs text-accent">label</td><td class="td text-dim">string</td><td class="td text-dim">—</td><td class="td text-dim">Text for card-lbl (UPPERCASE)</td></tr>
              <tr><td class="td font-mono text-2xs text-accent">subtitle</td><td class="td text-dim">string</td><td class="td text-dim">—</td><td class="td text-dim">Text for card-sub</td></tr>
              <tr><td class="td font-mono text-2xs text-accent">variant</td><td class="td text-dim">'default' | 'hero' | 'static' | 'flat'</td><td class="td text-dim">'default'</td><td class="td text-dim">Panel variant</td></tr>
              <tr><td class="td font-mono text-2xs text-accent">pad</td><td class="td text-dim">'none' | 'sm' | 'md'</td><td class="td text-dim">'md'</td><td class="td text-dim">Body padding</td></tr>
              <tr><td class="td font-mono text-2xs text-accent">stat</td><td class="td text-dim">{`{ value, delta?, tone? }`}</td><td class="td text-dim">—</td><td class="td text-dim">Stat display mode (no card-hd)</td></tr>
              <tr><td class="td font-mono text-2xs text-accent">class</td><td class="td text-dim">string</td><td class="td text-dim">''</td><td class="td text-dim">Additional classes</td></tr>
            </tbody>
          </table>
        </div>

        <Separator class="my-4" />

        <div class="mb-3 text-4xs font-bold uppercase text-faint" style="letter-spacing:0.6px">Named Slots</div>
        <div class="flex gap-4">
          <div class="well p-3 flex-1">
            <span class="font-mono text-xs text-accent">actions</span>
            <p class="mt-1 text-xs text-dim">Rendered ml-auto in the card-hd row</p>
          </div>
          <div class="well p-3 flex-1">
            <span class="font-mono text-xs text-accent">default</span>
            <p class="mt-1 text-xs text-dim">Card body content</p>
          </div>
          <div class="well p-3 flex-1">
            <span class="font-mono text-xs text-accent">subtitle</span>
            <p class="mt-1 text-xs text-dim">Rich HTML subtitle (slot override)</p>
          </div>
        </div>

        <Separator class="my-4" />

        <div class="mb-3 text-4xs font-bold uppercase text-faint" style="letter-spacing:0.6px">Rendered Examples</div>
        <div class="grid gap-4 md:grid-cols-2">
          <Card icon="📈" label="default" subtitle="glass panel">
            <p class="text-xs text-dim">The standard card with backdrop blur and entrance animation.</p>
            <p class="mt-2 text-2xs text-faint">Used everywhere — stream, journal, about, this page.</p>
          </Card>
          <Card icon="⚡" label="hero" subtitle="accent glow" variant="hero">
            <p class="text-xs text-dim">Featured card with accent border and gradient background.</p>
            <p class="mt-2 text-2xs text-faint">Used for today's card on the homepage, calendar current day.</p>
          </Card>
          <Card icon="📊" label="static" subtitle="no animation" variant="static">
            <StatCard label="SAMPLE STAT" value="+2.50R" tone="up" />
            <p class="mt-2 text-2xs text-faint">Same glass panel, no entrance animation. For stat grids.</p>
          </Card>
          <Card icon="📋" label="flat" subtitle="nested" variant="flat">
            <p class="text-xs text-dim">Background + border only. No blur, no shadow, no animation.</p>
            <p class="mt-2 text-2xs text-faint">For nested cards, tables, inline details.</p>
          </Card>
        </div>
        <div class="mt-4">
          <Card label="stat mode" stat={{ value: '+3.20', delta: 'vs last week +0.75', tone: 'up' }}>
            <p class="text-2xs text-faint">Stat display mode — no card-hd header. Compact number display.</p>
          </Card>
        </div>
      </Card>
    </div>

    <!-- Typography Rules -->
    <div id="typography" class="mt-6 scroll-mt-28">
      <Card icon="📐" label="typography rules" subtitle="every element, one spec">
        <p class="mb-4 text-sm text-soft">
          Every text element in every card follows this spec. No exceptions.
        </p>
        <div class="overflow-x-auto">
          <table class="w-full border-collapse">
            <thead>
              <tr>
                <th class="th">element</th>
                <th class="th">token</th>
                <th class="th">weight</th>
                <th class="th">case</th>
                <th class="th">tracking</th>
                <th class="th">color</th>
              </tr>
            </thead>
            <tbody>
              {typographyRules.map((r) => (
                <tr>
                  <td class="td text-ink">{r.element}</td>
                  <td class="td font-mono text-2xs text-accent">{r.token}</td>
                  <td class="td text-dim">{r.weight}</td>
                  <td class="td text-dim">{r.case}</td>
                  <td class="td text-dim">{r.tracking}</td>
                  <td class="td text-dim">{r.color}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </Card>
    </div>

    <!-- UI Primitives -->
    <div id="primitives" class="mt-10 scroll-mt-28">
      <Card icon="🧩" label="UI primitives" subtitle="14 primitives + CSS tokens">
        <p class="mb-4 text-sm text-soft">
          The <code class="border border-line bg-raise px-1.5 py-0.5 text-2xs text-accent">src/components/ui/</code> directory contains 14 components. Every other component builds on these. Below, each primitive is rendered live — what you see is exactly what you get.
        </p>

        <div class="flex flex-col gap-6">

          <!-- Card -->
          <Card icon="🃏" label="Card" subtitle="the one panel primitive" variant="flat">
            <p class="mb-3 text-xs text-dim">4 variants + stat mode. Every surface uses Card.</p>
            <div class="grid gap-3 md:grid-cols-2">
              <Card variant="default" pad="sm">
                <p class="text-2xs text-faint">default — glass panel, backdrop blur</p>
              </Card>
              <Card variant="hero" pad="sm">
                <p class="text-2xs text-faint">hero — accent border, gradient glow</p>
              </Card>
              <Card variant="static" pad="sm">
                <p class="text-2xs text-faint">static — no entrance animation</p>
              </Card>
              <Card variant="flat" pad="sm">
                <p class="text-2xs text-faint">flat — bg + border only, nested</p>
              </Card>
            </div>
            <div class="mt-3">
              <Card label="stat mode" stat={{ value: '+3.20', delta: 'vs last week +0.75', tone: 'up' }} />
            </div>
          </Card>

          <!-- StatCard -->
          <Card icon="📊" label="StatCard" subtitle="headline numbers" variant="flat">
            <div class="flex gap-4">
              <StatCard label="WIN RATE" value="55%" tone="up" />
              <StatCard label="TOTAL R" value="-1.20" tone="down" />
              <StatCard label="TRADES" value="147" />
            </div>
          </Card>

          <!-- Badge -->
          <Card icon="🏷" label="Badge" subtitle="status chips" variant="flat">
            <div class="flex flex-wrap gap-2">
              <Badge variant="up">funded</Badge>
              <Badge variant="down">failed</Badge>
              <Badge variant="warn">eval</Badge>
              <Badge variant="accent">live</Badge>
              <Badge variant="muted">paused</Badge>
              <Badge variant="default">buffer</Badge>
              <Badge variant="outline">payout</Badge>
            </div>
          </Card>

          <!-- Tag -->
          <Card icon="🏷" label="Tag" subtitle="neutral labels" variant="flat">
            <div class="flex flex-wrap gap-2">
              <Tag>MNQ</Tag>
              <Tag>ORB</Tag>
              <Tag href="#">#kaizen</Tag>
            </div>
          </Card>

          <!-- Table -->
          <Card icon="📋" label="Table" subtitle="data tables" variant="flat">
            <Table head={['day', 'R', 'points', 'setup']}>
