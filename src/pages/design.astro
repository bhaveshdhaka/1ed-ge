---
/**
 * /design — the design system catalogue + UI drift backlog.
 * Live previews + JSDoc @example snippets via import.meta.glob over ui/*.astro.
 * UI Drift Backlog reads data/ui-audit.json (generated by scripts/ui-audit.mjs).
 * Zero client JS.
 */
import fs from 'node:fs'
import path from 'node:path'
import Base from '../layouts/Base.astro'
import Card from '../components/ui/Card.astro'
import KvRow from '../components/ui/KvRow.astro'
import Table from '../components/ui/Table.astro'
import Badge from '../components/ui/Badge.astro'
import StatCard from '../components/ui/StatCard.astro'
import Well from '../components/ui/Well.astro'
import EmptyState from '../components/ui/EmptyState.astro'
import Separator from '../components/ui/Separator.astro'
import SectionNav from '../components/ui/SectionNav.astro'
import Button from '../components/ui/Button.astro'
import Tag from '../components/ui/Tag.astro'
import DayFacts from '../components/stream/DayFacts.astro'
import ThoughtCard from '../components/stream/ThoughtCard.astro'
import type { FactCell, ResolvedThought } from '../lib/stream'
import SideNav from '../components/ui/SideNav.astro'
import { ROOT, DATA_DIR } from '../lib/paths'

// ── build version (data/build.json) ─────────────────────────────────────────
let buildData: { version?: string; at?: string; commit?: string } | null = null
try {
  buildData = JSON.parse(fs.readFileSync(path.join(DATA_DIR, 'build.json'), 'utf8'))
} catch {}
const VERSION = buildData?.version ?? new Date().toISOString().slice(0, 10)
const buildAt = buildData?.at ?? null

/** Relative time: "3m ago", "2h 15m ago", "5d ago" */
function rel(iso: string | null | undefined): string {
  if (!iso) return 'never'
  const ms = Date.now() - Date.parse(iso)
  if (isNaN(ms)) return 'unknown'
  const s = Math.max(0, Math.floor(ms / 1000))
  if (s < 60) return `${s}s ago`
  const m = Math.floor(s / 60)
  if (m < 60) return `${m}m ago`
  const h = Math.floor(m / 60)
  if (h < 24) return `${h}h ${m % 60}m ago`
  const d = Math.floor(h / 24)
  return `${d}d ago`
}

// ── design tokens — auto-generated from src/styles/app.css ───────────────────
const css = fs.readFileSync(path.join(ROOT, 'src/styles/app.css'), 'utf8')
const hueTokens = [...css.matchAll(/--hue-([\w-]+):\s*([^;]+);/g)].map(m => ({
  token: `--hue-${m[1]}`, value: m[2].trim()
}))
const textTokens = [...css.matchAll(/--text-([\w-]+):\s*([^;]+);/g)].map(m => ({
  token: `--text-${m[1]}`, value: m[2].trim()
}))
const materialTokens = [...css.matchAll(/--(radius[\w-]*|shadow[\w-]*|blur[\w-]*|motion[\w-]*|ease[\w-]*):\s*([^;]+);/g)].map(m => ({
  token: `--${m[1]}`, value: m[2].trim()
}))

// ── UI primitives — auto-generated from src/components/ui/*.astro ───────────
// Extracts the leading doc comment AND zero-or-more JSDoc @example blocks.
const uiDir = path.join(ROOT, 'src/components/ui')
const primitiveFiles = fs.readdirSync(uiDir).filter(f => f.endsWith('.astro'))
const primitives = primitiveFiles.map(f => {
  const name = f.replace('.astro', '')
  const content = fs.readFileSync(path.join(uiDir, f), 'utf8')
  const descMatch = content.match(/\/\*\*\s*(?:\n\s*\*\s*)?(.+?)(?:\s*\*\/|\n)/)
  const examples = [...content.matchAll(/@example\n\s*\*\s*([\s\S]*?)(?=\n\s*\*\s*(?:@\w+|\*\/))/g)]
    .map(m => m[1].trim().replace(/^\s*\*\s?/gm, ''))
    .filter(Boolean)
  return { name, description: descMatch?.[1]?.trim() ?? name, examples }
})

// Curated live previews — map of primitive name → { label }. The actual
// preview markup renders in the template via per-primitive conditionals.
const liveCards: Record<string, { label: string }> = {
  Badge: { label: 'status chips' },
  Button: { label: 'button + link' },
  Card: { label: 'panel + header' },
  Well: { label: 'inset surface' },
  StatCard: { label: 'stat display' },
  KvRow: { label: 'key/value row' },
  Separator: { label: 'divider' },
  Table: { label: 'table' },
  Tag: { label: 'tag' },
  EmptyState: { label: 'empty state' },
}

const cardVariants = [
  { variant: 'default', class: 'panel', description: 'Glass panel with backdrop blur. The standard card.' },
  { variant: 'hero', class: 'panel panel-hero', description: 'Accent border, gradient bg, glow top-line. Featured cards.' },
  { variant: 'static', class: 'panel-static', description: 'Same as default but no entrance animation. Stat grids.' },
  { variant: 'flat', class: 'panel-flat', description: 'Background + border only. Nested cards, tables.' },
]

const typographyRules = [
  { element: 'Card header label', token: 'text-2xs', weight: '700', case: 'UPPERCASE', tracking: '0.6px', color: 'soft' },
  { element: 'Card subtitle', token: 'text-3xs', weight: '500', case: '—', tracking: '—', color: 'faint' },
  { element: 'Card icon', token: '14px', weight: '—', case: '—', tracking: '—', color: '—' },
  { element: 'Timer pill', token: 'text-3xs', weight: '600', case: '—', tracking: '0.2px', color: 'accent' },
  { element: 'Stat label', token: 'text-4xs', weight: '700', case: 'UPPERCASE', tracking: '0.6px', color: 'faint' },
  { element: 'Stat value', token: 'text-lg', weight: '600', case: '—', tracking: '—', color: 'ink' },
  { element: 'Fact cell label', token: 'text-4xs', weight: '700', case: 'UPPERCASE', tracking: '0.6px', color: 'faint' },
  { element: 'Fact cell value', token: 'text-sm', weight: '600', case: '—', tracking: '—', color: 'ink' },
  { element: 'Table header', token: 'text-2xs', weight: '400', case: 'UPPERCASE', tracking: '0.14em', color: 'dim' },
  { element: 'Table cell', token: 'text-xs', weight: '400', case: '—', tracking: '—', color: 'inherit' },
  { element: 'Thought body', token: 'text-sm', weight: '400', case: '—', tracking: '—', color: 'soft' },
  { element: 'Button', token: 'text-sm', weight: '—', case: '—', tracking: '—', color: 'soft' },
  { element: 'Segment', token: 'text-2xs', weight: '600', case: '—', tracking: '—', color: 'dim' },
  { element: 'Capsule', token: 'text-3xs', weight: '600', case: '—', tracking: '—', color: 'dim' },
  { element: 'Page h1', token: 'text-2xl', weight: '600', case: '—', tracking: '—', color: 'ink' },
  { element: 'Section h2', token: 'text-lg', weight: '600', case: '—', tracking: '—', color: 'ink' },
]

// ── composite fixtures ───────────────────────────────────────────────────────
const sampleFactCells: FactCell[] = [
  { key: 'mood', label: 'MOOD', value: '😐 okay', ok: true, up: undefined },
  { key: 'sleep', label: 'SLEEP', value: '6.5h · 3/5', ok: true, up: undefined },
  { key: 'r', label: 'R', value: '+2.50R', ok: true, up: true },
  { key: 'trades', label: 'TRADES', value: '4 · 75% win', ok: true, up: undefined },
  { key: 'screen', label: 'SCREEN', value: '5.2h', ok: true, up: undefined },
  { key: 'habits', label: 'HABITS', value: '5/6', ok: true, up: undefined },
]

const sampleThoughts: ResolvedThought[] = [
  {
    iso: '2026-08-11', at: '09:15', type: 'trade',
    text: undefined, images: [], author: undefined,
    trade: { R: 2.5, direction: 'long' as const, market: 'MNQ', model: 'orb-drive', setup: 'ORB', session: 'ny-am', points: 25, entry: 20800.5, exit: 20825.5, stop: 20790.5, note: 'Clean break above ORB, held to +2.5R.', screenshots: [] },
  },
  {
    iso: '2026-08-11', at: '08:30', type: 'note',
    text: 'Pre-market: CPI at 20:30 HKT. Flat 15 min before. No chasing.', images: [], author: undefined,
    trade: null,
  },
  {
    iso: '2026-08-11', at: '07:00', type: 'quote',
    text: 'The goal is not to be right. The goal is to make money when right and lose less when wrong.', images: [], author: undefined,
    trade: null,
  },
]

// ── UI drift backlog (data/ui-audit.json) ───────────────────────────────────
interface AuditReport {
  at?: string
  totalDuplicates?: number
  byCluster?: { name: string; primitive: string; count: number; files: string[] }[]
  files?: { path: string; matches: { cluster: string; primitive: string; count: number; sample: string }[] }[]
}
let audit: AuditReport | null = null
try {
  audit = JSON.parse(fs.readFileSync(path.join(DATA_DIR, 'ui-audit.json'), 'utf8'))
} catch {}
const driftClusters = (audit?.byCluster ?? []).filter((c) => c.count > 0).sort((a, b) => b.count - a.count)
const driftTotal = audit?.totalDuplicates ?? 0

// ── page navigation (SideNav groups) ─────────────────────────────────────────
const navGroups = [
  { label: 'tokens', items: [['architecture', 'architecture'], ['palette', 'palette'], ['type', 'type'], ['material', 'material']] as [string, string][] },
  { label: 'primitives', items: [['cards', 'cards'], ['typography', 'typography'], ['primitives', 'primitives'], ['composites', 'composites'], ['classes', 'classes']] as [string, string][] },
  { label: 'governance', items: [['drift', 'drift']] as [string, string][] },
]
---

<Base title="design — 1ed.ge" description="The design system — tokens, primitives, live previews, and the UI drift backlog that keeps the site standardized.">
  <section class="shell pt-12 pb-20 md:mr-48">
    <header class="flex flex-wrap items-baseline gap-3">
      <h1 class="text-2xl text-ink">/ design</h1>
      <span class="text-xs text-faint">{VERSION} · the design system</span>
    </header>
    <SideNav groups={navGroups}>
      <SectionNav groups={navGroups} slot="mobile-nav" />
    </SideNav>
    <p class="mt-2 max-w-2xl text-sm text-dim">
      Every surface on 1ed.ge uses the same design system. One Card component, one type scale, one token architecture. This documents every element, its rules, and how to use it — plus the drift backlog that keeps the codebase honest.
    </p>

    <!-- ══ Tokens ══ -->
    <div id="architecture" class="mt-10 scroll-mt-28">
      <Card icon="🎨" label="token architecture" subtitle="3-layer system">
        <p class="mb-4 text-sm text-soft">
          The design system uses a 3-layer token architecture. To re-theme, only Layer 1 changes. Layer 2 and Layer 3 are stable.
        </p>
        <div class="grid gap-4 md:grid-cols-3">
          <div class="well p-3">
            <div class="text-4xs font-bold uppercase text-faint" style="letter-spacing:0.6px">Layer 1 · Palette</div>
            <p class="mt-1 text-xs text-dim">Raw hue values. Swap these to re-theme.</p>
            <p class="mt-1 text-2xs text-faint">--hue-bg, --hue-ink, --hue-accent, --hue-up, --hue-down…</p>
          </div>
          <div class="well p-3">
            <div class="text-4xs font-bold uppercase text-faint" style="letter-spacing:0.6px">Layer 2 · Semantic</div>
            <p class="mt-1 text-xs text-dim">Component roles. Never change.</p>
            <p class="mt-1 text-2xs text-faint">--color-bg, --color-ink, --color-accent, --color-up, --color-down…</p>
          </div>
          <div class="well p-3">
            <div class="text-4xs font-bold uppercase text-faint" style="letter-spacing:0.6px">Layer 3 · Material</div>
            <p class="mt-1 text-xs text-dim">Radii, shadows, blur, motion.</p>
            <p class="mt-1 text-2xs text-faint">--radius, --shadow-card, --blur-card, --motion-fast…</p>
          </div>
        </div>
      </Card>
    </div>

    <div id="palette" class="mt-6 scroll-mt-28">
      <Card icon="🎨" label="palette" subtitle={`Layer 1 · auto-generated · updated ${rel(buildAt)}`}>
        <div class="overflow-x-auto">
          <Table head={['token', 'value', 'purpose']} class="mt-1">
            {hueTokens.map((t) => (
              <tr>
                <td class="td font-mono text-2xs text-accent">{t.token}</td>
                <td class="td">
                  <span class="inline-flex items-center gap-2">
                    <span class="inline-block h-3 w-3 rounded-sm border border-line" style={`background:${t.value}`}></span>
                    <span class="font-mono text-2xs">{t.value}</span>
                  </span>
                </td>
                <td class="td text-dim">—</td>
              </tr>
            ))}
          </Table>
        </div>
      </Card>
    </div>

    <div id="type" class="mt-6 scroll-mt-28">
      <Card icon="🔤" label="type scale" subtitle={`auto-generated · updated ${rel(buildAt)}`}>
        <p class="mb-3 text-xs text-dim">Syne Variable is reserved for the wordmark only. Auto-generated from app.css.</p>
        <div class="overflow-x-auto">
          <Table head={['token', 'value', 'usage']} class="mt-1">
            {textTokens.map((t) => (
              <tr>
                <td class="td font-mono text-2xs text-accent">{t.token}</td>
                <td class="td font-mono text-2xs">{t.value}</td>
                <td class="td text-dim">—</td>
              </tr>
            ))}
          </Table>
        </div>
      </Card>
    </div>

    <div id="material" class="mt-6 scroll-mt-28">
      <Card icon="⚙️" label="material tokens" subtitle={`Layer 3 · auto-generated · updated ${rel(buildAt)}`}>
        <div class="overflow-x-auto">
          <Table head={['token', 'value', 'usage']} class="mt-1">
            {materialTokens.map((t) => (
              <tr>
                <td class="td font-mono text-2xs text-accent">{t.token}</td>
                <td class="td font-mono text-2xs">{t.value}</td>
                <td class="td text-dim">—</td>
              </tr>
            ))}
          </Table>
        </div>
      </Card>
    </div>

    <!-- ══ Primitives ══ -->
    <div id="cards" class="mt-10 scroll-mt-28">
      <Card icon="🃏" label="card system" subtitle="the one panel primitive">
        <p class="mb-4 text-sm text-soft">
          Every surface on 1ed.ge uses the <code class="border border-line bg-raise px-1.5 py-0.5 text-2xs text-accent">Card</code> component. Never hand-build <code class="border border-line bg-raise px-1.5 py-0.5 text-2xs text-accent">.panel</code> + <code class="border border-line bg-raise px-1.5 py-0.5 text-2xs text-accent">.card-hd</code> markup. This is non-negotiable.
        </p>
        <div class="mb-4 text-4xs font-bold uppercase text-faint" style="letter-spacing:0.6px">Variants</div>
        <div class="grid gap-3 md:grid-cols-2">
          {cardVariants.map((v) => (
            <div class="well p-3">
              <div class="flex items-baseline gap-2">
                <span class="font-mono text-xs text-accent">{v.variant}</span>
                <span class="font-mono text-2xs text-faint">.{v.class}</span>
              </div>
              <p class="mt-1 text-xs text-dim">{v.description}</p>
            </div>
          ))}
        </div>
        <Separator class="my-4" />
        <div class="mb-3 text-4xs font-bold uppercase text-faint" style="letter-spacing:0.6px">Props</div>
        <div class="overflow-x-auto">
          <table class="w-full border-collapse">
            <thead>
              <tr>
                <th class="th">prop</th>
                <th class="th">type</th>
                <th class="th">default</th>
                <th class="th">description</th>
              </tr>
            </thead>
            <tbody>
              <tr><td class="td font-mono text-2xs text-accent">icon</td><td class="td text-dim">string</td><td class="td text-dim">—</td><td class="td text-dim">Emoji for card-ico</td></tr>
              <tr><td class="td font-mono text-2xs text-accent">label</td><td class="td text-dim">string</td><td class="td text-dim">—</td><td class="td text-dim">Text for card-lbl (UPPERCASE)</td></tr>
              <tr><td class="td font-mono text-2xs text-accent">subtitle</td><td class="td text-dim">string</td><td class="td text-dim">—</td><td class="td text-dim">Text for card-sub</td></tr>
              <tr><td class="td font-mono text-2xs text-accent">variant</td><td class="td text-dim">'default' | 'hero' | 'static' | 'flat'</td><td class="td text-dim">'default'</td><td class="td text-dim">Panel variant</td></tr>
              <tr><td class="td font-mono text-2xs text-accent">pad</td><td class="td text-dim">'none' | 'sm' | 'md'</td><td class="td text-dim">'md'</td><td class="td text-dim">Body padding</td></tr>
              <tr><td class="td font-mono text-2xs text-accent">stat</td><td class="td text-dim">{`{ value, delta?, tone? }`}</td><td class="td text-dim">—</td><td class="td text-dim">Stat display mode (no card-hd)</td></tr>
              <tr><td class="td font-mono text-2xs text-accent">class</td><td class="td text-dim">string</td><td class="td text-dim">''</td><td class="td text-dim">Additional classes</td></tr>
            </tbody>
          </table>
        </div>
        <Separator class="my-4" />
        <div class="mb-3 text-4xs font-bold uppercase text-faint" style="letter-spacing:0.6px">Named Slots</div>
        <div class="flex gap-4">
          <div class="well p-3 flex-1">
            <span class="font-mono text-xs text-accent">actions</span>
            <p class="mt-1 text-xs text-dim">Rendered ml-auto in the card-hd row</p>
          </div>
          <div class="well p-3 flex-1">
            <span class="font-mono text-xs text-accent">default</span>
            <p class="mt-1 text-xs text-dim">Card body content</p>
          </div>
          <div class="well p-3 flex-1">
            <span class="font-mono text-xs text-accent">subtitle</span>
            <p class="mt-1 text-xs text-dim">Rich HTML subtitle (slot override)</p>
          </div>
        </div>
        <Separator class="my-4" />
        <div class="mb-3 text-4xs font-bold uppercase text-faint" style="letter-spacing:0.6px">Rendered Examples</div>
        <div class="grid gap-4 md:grid-cols-2">
          <Card icon="📈" label="default" subtitle="glass panel">
            <p class="text-xs text-dim">The standard card with backdrop blur and entrance animation.</p>
            <p class="mt-2 text-2xs text-faint">Used everywhere — stream, journal, about, this page.</p>
          </Card>
          <Card icon="⚡" label="hero" subtitle="accent glow" variant="hero">
            <p class="text-xs text-dim">Featured card with accent border and gradient background.</p>
            <p class="mt-2 text-2xs text-faint">Used for today's card on the homepage, calendar current day.</p>
          </Card>
          <Card icon="📊" label="static" subtitle="no animation" variant="static">
            <StatCard label="SAMPLE STAT" value="+2.50R" tone="up" />
            <p class="mt-2 text-2xs text-faint">Same glass panel, no entrance animation. For stat grids.</p>
          </Card>
          <Card icon="📋" label="flat" subtitle="nested" variant="flat">
            <p class="text-xs text-dim">Background + border only. No blur, no shadow, no animation.</p>
            <p class="mt-2 text-2xs text-faint">For nested cards, tables, inline details.</p>
          </Card>
        </div>
        <div class="mt-4">
          <Card label="stat mode" stat={{ value: '+3.20', delta: 'vs last week +0.75', tone: 'up' }}>
            <p class="text-2xs text-faint">Stat display mode — no card-hd header. Compact number display.</p>
          </Card>
        </div>
      </Card>
    </div>

    <div id="typography" class="mt-6 scroll-mt-28">
      <Card icon="📐" label="typography rules" subtitle="every element, one spec">
        <p class="mb-4 text-sm text-soft">
          Every text element in every card follows this spec. No exceptions.
        </p>
        <div class="overflow-x-auto">
          <table class="w-full border-collapse">
            <thead>
              <tr>
                <th class="th">element</th>
                <th class="th">token</th>
                <th class="th">weight</th>
                <th class="th">case</th>
                <th class="th">tracking</th>
                <th class="th">color</th>
              </tr>
            </thead>
            <tbody>
              {typographyRules.map((r) => (
                <tr>
                  <td class="td text-ink">{r.element}</td>
                  <td class="td font-mono text-2xs text-accent">{r.token}</td>
                  <td class="td text-dim">{r.weight}</td>
                  <td class="td text-dim">{r.case}</td>
                  <td class="td text-dim">{r.tracking}</td>
                  <td class="td text-dim">{r.color}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </Card>
    </div>

    <div id="primitives" class="mt-10 scroll-mt-28">
      <Card icon="🧩" label="UI primitives" subtitle={`${primitives.length} primitives · auto-generated · updated ${rel(buildAt)}`} variant="flat">
        <p class="mb-3 text-xs text-dim">
          Auto-generated from src/components/ui/*.astro. Each card shows the <code class="border border-line bg-raise px-1.5 py-0.5 text-2xs text-accent">@example</code>
          snippet from the primitive's JSDoc, plus a <em>live rendered</em> preview.
        </p>
        <div class="grid gap-3 md:grid-cols-2">
          {primitives.map((p) => {
            const lc = liveCards[p.name]
            return (
              <Card variant="flat" pad="sm">
                <div class="flex items-center justify-between gap-2">
                  <div class="text-xs font-semibold text-ink">{p.name}</div>
                  <span class="text-2xs text-faint">{lc ? '⚡ live' : '—'}</span>
                </div>
                <p class="mt-1 text-2xs text-dim">{p.description}</p>
                {lc ? (
                  <div class="mt-3 rounded-sm border border-line bg-raise/40 p-3">
                    <div class="mb-2 text-3xs uppercase tracking-widest text-faint">{lc.label}</div>
                    {p.name === 'Badge' && (
                      <div class="flex flex-wrap gap-2">
                        <Badge variant="up">+2.5R</Badge>
                        <Badge variant="down">-1.0R</Badge>
                        <Badge variant="warn">pending</Badge>
                        <Badge variant="accent">feature</Badge>
                        <Badge variant="muted">log only</Badge>
                      </div>
                    )}
                    {p.name === 'Button' && (
                      <div class="flex flex-wrap items-center gap-2">
                        <Button variant="primary">Save</Button>
                        <Button>Cancel</Button>
                        <Button variant="danger">Delete</Button>
                        <Button href="/about">About</Button>
                      </div>
                    )}
                    {p.name === 'Card' && (
                      <div class="grid gap-3 md:grid-cols-2">
                        <Card icon="📈" label="default" subtitle="glass panel">
                          <p class="text-xs text-dim">The standard card.</p>
                        </Card>
                        <Card icon="⚡" label="hero" subtitle="accent glow" variant="hero">
                          <p class="text-xs text-dim">Featured card.</p>
                        </Card>
                      </div>
                    )}
                    {p.name === 'Well' && (
                      <Well class="p-3"><p class="text-xs text-dim">Recessed inset panel content.</p></Well>
                    )}
                    {p.name === 'StatCard' && (
                      <div class="grid grid-cols-2 gap-2 md:grid-cols-4">
                        <StatCard label="TOTAL R" value="+12.40" tone="up" />
                        <StatCard label="SESSIONS" value="42" />
                        <StatCard label="WIN RATE" value="58%" />
                        <StatCard label="DRAWDOWN" value="-3.2" tone="down" />
                      </div>
                    )}
                    {p.name === 'KvRow' && (
                      <div class="flex flex-col gap-1">
                        <KvRow label="account" value="lucid-50k-a" />
                        <KvRow label="stage" value="funded" />
                      </div>
                    )}
                    {p.name === 'Separator' && (
                      <div class="flex flex-col gap-2">
                        <span class="text-2xs text-faint">above</span>
                        <Separator />
                        <span class="text-2xs text-faint">below</span>
                      </div>
                    )}
                    {p.name === 'Table' && (
                      <Table head={['col', 'value']} class="mt-1">
                        <tr><td class="td text-dim">a</td><td class="td">1</td></tr>
                        <tr><td class="td text-dim">b</td><td class="td">2</td></tr>
                      </Table>
                    )}
                    {p.name === 'Tag' && (
                      <div class="flex flex-wrap gap-2">
                        <Tag>orb</Tag>
                        <Tag>ny-am</Tag>
                      </div>
                    )}
                    {p.name === 'EmptyState' && <EmptyState text="no data yet" />}
                  </div>
                ) : (
                  p.examples.length > 0 && (
                    <div class="mt-3 rounded-sm border border-line bg-raise/40 p-3">
                      <div class="mb-2 text-3xs uppercase tracking-widest text-faint">@example</div>
                      <pre class="overflow-x-auto whitespace-pre-wrap font-mono text-2xs leading-relaxed text-soft">{p.examples[0]}</pre>
                    </div>
                  )
                )}
                {p.examples.length > 0 && (
                  <details class="mt-2">
                    <summary class="cursor-pointer text-2xs text-faint select-none hover:text-dim">@example source</summary>
                    <pre class="mt-1 overflow-x-auto whitespace-pre-wrap rounded-sm border border-line bg-raise/40 p-2 font-mono text-2xs leading-relaxed text-soft">{p.examples.join('\n\n')}</pre>
                  </details>
                )}
              </Card>
            )
          })}
        </div>
      </Card>
    </div>

    <div id="composites" class="mt-6 scroll-mt-28">
      <Card icon="📦" label="composite components" subtitle="built on primitives · rendered live">
        <p class="mb-4 text-sm text-soft">
          These components are built entirely from the primitives above. Each is rendered live with real trading-shaped data — what you see is exactly what ships.
        </p>
        <div class="flex flex-col gap-6">
          <Card icon="📊" label="DayFacts" subtitle="facts strip" variant="flat">
            <p class="mb-3 text-xs text-dim">Mood/sleep/screen/habits/trades/R in a flex-wrap row of Well cells. Only R carries color.</p>
            <DayFacts cells={sampleFactCells} />
          </Card>
          <Card icon="📈" label="ThoughtCard · trade" subtitle="long trade +2.50R" variant="flat">
            <p class="mb-3 text-xs text-dim">Published stream moment. Rail identity: trade = up/down matched to direction. Uses Card with pad="none".</p>
            <ThoughtCard thought={sampleThoughts[0]} />
          </Card>
          <Card icon="💭" label="ThoughtCard · note" subtitle="pre-market note" variant="flat">
            <p class="mb-3 text-xs text-dim">Note = quiet rail. No color, muted framing.</p>
            <ThoughtCard thought={sampleThoughts[1]} />
          </Card>
          <Card icon="💬" label="ThoughtCard · quote" subtitle="trading wisdom" variant="flat">
            <p class="mb-3 text-xs text-dim">Quote = accent left rail. Distinct from notes and trades.</p>
            <ThoughtCard thought={sampleThoughts[2]} />
          </Card>
        </div>
      </Card>
    </div>

    <div id="classes" class="mt-6 scroll-mt-28">
      <Card icon="📝" label="CSS classes" subtitle="the vocabulary">
        <div class="grid gap-3 md:grid-cols-2">
          <div class="well p-3"><code class="text-xs text-accent">.shell</code><p class="mt-1 text-xs text-dim">Page wrapper. max-w-6xl, px-5 md:px-8.</p></div>
          <div class="well p-3"><code class="text-xs text-accent">.panel</code> / <code class="text-xs text-accent">.panel-hero</code> / <code class="text-xs text-accent">.panel-static</code> / <code class="text-xs text-accent">.panel-flat</code><p class="mt-1 text-xs text-dim">Card variants. Use via Card component.</p></div>
          <div class="well p-3"><code class="text-xs text-accent">.card-hd</code> / <code class="text-xs text-accent">.card-ico</code> / <code class="text-xs text-accent">.card-lbl</code> / <code class="text-xs text-accent">.card-sub</code> / <code class="text-xs text-accent">.tmr</code><p class="mt-1 text-xs text-dim">Card header system. Use via Card props.</p></div>
          <div class="well p-3"><code class="text-xs text-accent">.well</code><p class="mt-1 text-xs text-dim">Inset recessed surface. background: var(--color-inset).</p></div>
          <div class="well p-3"><code class="text-xs text-accent">.capsule</code><p class="mt-1 text-xs text-dim">Accent-tinted pill. Rounded-full, 10px, 600 weight.</p></div>
          <div class="well p-3"><code class="text-xs text-accent">.seg</code> / <code class="text-xs text-accent">.seg-on</code><p class="mt-1 text-xs text-dim">Segmented control. Shell + active segment.</p></div>
          <div class="well p-3"><code class="text-xs text-accent">.btn</code> / <code class="text-xs text-accent">.btn-primary</code> / <code class="text-xs text-accent">.btn-danger</code> / <code class="text-xs text-accent">.btn-sm</code><p class="mt-1 text-xs text-dim">Button system. Transitions at --motion-fast.</p></div>
          <div class="well p-3"><code class="text-xs text-accent">.kv</code><p class="mt-1 text-xs text-dim">Key-value row. flex justify-between, border-b.</p></div>
          <div class="well p-3"><code class="text-xs text-accent">.th</code> / <code class="text-xs text-accent">.td</code><p class="mt-1 text-xs text-dim">Table header (11px/UPPERCASE/dim) and cell (12px).</p></div>
          <div class="well p-3"><code class="text-xs text-accent">.input</code> / <code class="text-xs text-accent">.label</code><p class="mt-1 text-xs text-dim">Form input (13px, radius-sm) and label (11px/UPPERCASE).</p></div>
          <div class="well p-3"><code class="text-xs text-accent">.prose</code><p class="mt-1 text-xs text-dim">Journal prose. 13px, 1.8 line-height, soft color.</p></div>
          <div class="well p-3"><code class="text-xs text-accent">.rail-up</code> / <code class="text-xs text-accent">.rail-down</code> / <code class="text-xs text-accent">.rail-accent</code> / <code class="text-xs text-accent">.rail-quiet</code><p class="mt-1 text-xs text-dim">Left-rail identity bars. 2px solid border-left. Used on ThoughtCard.</p></div>
          <div class="well p-3"><code class="text-xs text-accent">.lb*</code><p class="mt-1 text-xs text-dim">Lightbox system. .lb, .lb-sheet, .lb-handle, .lb-header, .lb-body, .lb-nav.</p></div>
        </div>
      </Card>
    </div>

    <!-- ══ Governance ══ -->
    <div id="drift" class="mt-10 scroll-mt-28">
      <Card icon="🧰" label="UI drift backlog" subtitle={`${driftTotal} primitive-adjacent duplicates · ${driftClusters.length} clusters · regen ${rel(audit?.at)}`} variant="hero">
        <p class="mb-4 text-sm text-soft">
          These are the raw, hand-inlined class clusters that should live in <code class="border border-line bg-raise px-1.5 py-0.5 text-2xs text-accent">src/components/ui/*</code>.
          Generated by <code class="border border-line bg-raise px-1.5 py-0.5 text-2xs text-accent">scripts/ui-audit.mjs</code> — the design-steward agent works this backlog.
          Replace each with the owning primitive; the cluster should then drop from this list.
        </p>
        {!audit || driftClusters.length === 0 ? (
          <EmptyState text="no drift detected — ui-audit.json is clean or not yet generated (run node scripts/ui-audit.mjs)" class="mt-2" />
        ) : (
          <div class="overflow-x-auto">
            <Table head={['cluster', 'primitive', 'count', 'files']} class="mt-1">
              {driftClusters.map((c) => (
                <tr>
                  <td class="td font-mono text-2xs text-accent">{c.name}</td>
                  <td class="td">
                    <Badge variant="accent">{c.primitive}</Badge>
                  </td>
                  <td class="td">
                    <Badge variant={c.count > 50 ? 'warn' : 'up'}>{c.count}</Badge>
                  </td>
                  <td class="td text-dim">{c.files.length} files</td>
                </tr>
              ))}
            </Table>
          </div>
        )}
        {audit?.files && audit.files.length > 0 && (
          <details class="mt-3">
            <summary class="cursor-pointer text-2xs text-faint select-none hover:text-dim">
              affected files ({audit.files.length})
            </summary>
            <ul class="mt-2 space-y-1">
              {audit.files.slice(0, 30).map((f) => (
                <li class="text-2xs text-dim">
                  <span class="font-mono text-accent">{f.path}</span>
                  <span class="ml-2 text-faint">{f.matches.map((m) => `${m.cluster}×${m.count}`).join(' · ')}</span>
                </li>
              ))}
            </ul>
          </details>
        )}
      </Card>
    </div>

    <p class="mt-10 text-2xs text-faint">
      this page is maintained by AI. every code change is accounted for here. the drift backlog is regenerated from ui-audit.json on each deploy.
    </p>
  </section>
</Base>