# Pipeline env-typing contract — every worktree's .env must declare these.
# See docs/PIPELINE.md for the full design.

# prod: 1ed.ge, port 4321, noindex 0
# test: test.1ed.ge, port 4323, noindex 1
SITE_ENV=prod
SITE_URL=https://1ed.ge
SITE_PORT=4321
# SITE_NOINDEX is derived from SITE_ENV (0 for prod, 1 for test). Override only if you know why.

# Admin secret URL slug — /zen/<this value> is the private control room
ADMIN_SECRET=

# OpenRouter key for AI structuring (DeepSeek) + screenshot reading (Qwen2.5-VL)
OPENROUTER_API_KEY=

# Optional overrides
OPENROUTER_BASE=https://openrouter.ai/api/v1
AI_MODEL_STRUCTURE=deepseek/deepseek-chat
AI_MODEL_VISION=qwen/qwen-2.5-vl-72b-instruct
AI_MODEL_ASSIST=deepseek/deepseek-chat
AI_MODEL_ALT=qwen/qwen-2.5-vl-7b-instruct
AI_MODEL_INGEST=deepseek/deepseek-v4-flash-0731

HOST=0.0.0.0

# Content/data location (env-driven; falls back to in-repo src/content,
# public/media, data when unset). Lets content live outside git.
#   prod:  DATA_PATH=/srv/1edge/content  MEDIA_PATH=/srv/1edge/media  DATA_DIR=/srv/1edge/data
#   test:  DATA_PATH=/var/data/test/content  MEDIA_PATH=/var/data/test/media  DATA_DIR=/var/data/test/data
# DATA_PATH=
# MEDIA_PATH=
# DATA_DIR=
